      // Function to dynamically recompute all 560 3D sensor tiles when WWR, Glazing, or Climate changes
      const dummyObj = new THREE.Object3D();
      const tempColor = new THREE.Color();

      function updateDaylightGrid(wwrPct: number, glazingKey: string, climateKey: string) {
        const g = glazingData[glazingKey] || glazingData.lowe;
        const c = climateData[climateKey] || climateData.bengaluru;
        // Effective daylight transmittance factor (scales vividly with WWR slider & glazing choice)
        const vltFactor = (wwrPct / 40) * (0.72 + g.shgc * 0.95) * c.solarFactor;

        let idx = 0;
        for (let r = 0; r < rowsZ; r++) {
          const z = -gridSpanD / 2 + (r + 0.5) * stepCellZ;
          const dNorth = z - (-gridSpanD / 2);
          const dSouth = (gridSpanD / 2) - z;

          for (let col = 0; col < colsX; col++) {
            const x = -gridSpanW / 2 + (col + 0.5) * stepCellX;
            const dWest = x - (-gridSpanW / 2);
            const dEast = (gridSpanW / 2) - x;

            // Check if inside central structural core (2.5m x 1.7m)
            const inCore = Math.abs(x) < 1.25 && Math.abs(z) < 0.85;

            let lux = 12;
            if (!inCore) {
              // Directional solar illumination: South (+Z) and East (+X) receive intense direct solar perimeter glow (crimson/orange -> yellow -> green -> navy)
              const decayRate = 0.74 / Math.max(0.55, Math.pow(vltFactor, 0.52));
              const luxSouth = 2150 * vltFactor * Math.exp(-dSouth * decayRate * 0.88);
              const luxEast  = 1900 * vltFactor * Math.exp(-dEast  * decayRate * 0.94);
              const luxWest  = 1500 * vltFactor * Math.exp(-dWest  * decayRate * 1.05);
              const luxNorth = 1200 * vltFactor * Math.exp(-dNorth * decayRate * 1.12);

              lux = Math.max(luxSouth, luxEast, luxWest, luxNorth) +
                    0.26 * (luxSouth + luxEast + luxWest + luxNorth - Math.max(luxSouth, luxEast, luxWest, luxNorth));
            }

            const [cr, cg, cb] = getLuxColorRGB(lux);
            tempColor.setRGB(cr, cg, cb);

            // Slight 3D height extrusion proportional to illuminance for dramatic tactile relief
            const tileHeightScale = inCore ? 0.2 : 0.75 + Math.min(1.5, lux / 1100);
            dummyObj.position.set(x, workplaneY + (0.04 * tileHeightScale), z);
            dummyObj.scale.set(1, tileHeightScale, 1);
            dummyObj.updateMatrix();
            tileInstancedMesh.setMatrixAt(idx, dummyObj.matrix);
            tileInstancedMesh.setColorAt(idx, tempColor);

            idx++;
          }
        }

        tileInstancedMesh.instanceMatrix.needsUpdate = true;
        if (tileInstancedMesh.instanceColor) tileInstancedMesh.instanceColor.needsUpdate = true;

        // Update 300 lx emerald compliance contour ring inset based on daylight penetration depth
        const penetrationInset = Math.min(2.6, Math.max(0.85, 1.55 * Math.pow(vltFactor, 0.55)));
        const cw = Math.max(1.5, gridSpanW / 2 - penetrationInset);
        const cd = Math.max(1.1, gridSpanD / 2 - penetrationInset * 0.85);
        const cPts = [
          new THREE.Vector3(-cw, contourY, -cd),
          new THREE.Vector3(cw, contourY, -cd),
          new THREE.Vector3(cw, contourY, cd),
          new THREE.Vector3(-cw, contourY, cd),
        ];
        contourRingGeo.setFromPoints(cPts);
      }

