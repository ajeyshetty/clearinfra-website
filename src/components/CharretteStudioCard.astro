---
// Self-contained Clearinfra Studio Interactive CAD Card
---

<div id="interactive-demo" class="w-full max-w-5xl mx-auto">
        <div id="studio-cad-card" class="rounded-2xl border border-slate-700/60 ring-1 ring-white/10 bg-[#131924] text-slate-100 shadow-2xl shadow-slate-950/30 overflow-hidden transition-all duration-300">
          <!-- Top CAD Window Bar (Matte Slate) -->
          <div class="cad-card-topbar flex items-center justify-between gap-3 px-3.5 sm:px-5 py-2 sm:py-2 bg-[#171E2B] border-b border-white/[0.08] text-xs font-mono">
            <div class="flex items-center gap-2 min-w-0">
              <div class="hidden sm:flex items-center gap-1.5 shrink-0">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
              </div>
              <span class="text-slate-200 font-medium whitespace-nowrap text-[11px] sm:text-xs tracking-wide">CLEARINFRA STUDIO</span>
              <span class="hidden sm:inline-block text-slate-600">|</span>
              <span id="cad-top-title" class="hidden sm:inline-block text-slate-400 truncate">12-Story Commercial Model · Full Envelope</span>
            </div>
            <div class="flex items-center gap-1.5 sm:gap-2 text-sky-400 shrink-0 text-[11px] sm:text-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
              <span class="hidden sm:inline">Interactive Charrette Sandbox</span>
              <span class="sm:hidden font-mono text-[10px] uppercase tracking-wider font-semibold">Live Sandbox</span>
              
              <!-- Close button for Full-Screen Studio Mode -->
              <button
                type="button"
                id="btn-close-mobile-studio"
                class="hidden p-1.5 rounded-lg text-slate-200 hover:text-white border border-white/25 bg-white/10 active:bg-white/25 transition-all cursor-pointer ml-2"
                aria-label="Close Full-Screen Studio"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Main Interactive Grid inside Matte CAD Viewport -->
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <!-- Left 7 Cols of Card: Animated Isometric Building + Solar Path Canvas -->
            <div class="lg:col-span-7 p-3 sm:p-3.5 sm:pb-2.5 flex flex-col justify-start bg-blueprint-sub border-b lg:border-b-0 lg:border-r border-white/[0.07] relative min-h-[280px] sm:min-h-[320px] overflow-hidden">
              <!-- Viewport Mode Toolbar (CAD Standard: Placed cleanly above the 3D canvas) -->
              <div id="cad-viewport-toolbar" class="flex items-center justify-between gap-2 text-xs font-mono select-none z-10 mb-1 overflow-hidden">
                <div class="flex items-center gap-0.5 sm:gap-1 bg-[#161D2B]/95 p-1 rounded-lg border border-white/12 text-[8.5px] sm:text-[9.5px] shadow-sm shrink-0">
                  <button id="btn-mode-twin" type="button" title="01 Architectural 3D Twin" class="mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-emerald-500/40 bg-emerald-500/20 text-emerald-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                    <span class="opacity-65 text-[8px]">01</span>
                    <span>Twin</span>
                    <span id="prog-mode-twin" class="pointer-events-none absolute bottom-0 left-0 h-[1.5px] bg-emerald-400/90" style="width: 0%;"></span>
                  </button>
                  <button id="btn-mode-daylight" type="button" title="02 Daylight sDA Lux Heatmap (LM-83)" class="mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
                    <span class="opacity-65 text-[8px]">02</span>
                    <span>Daylight</span>
                    <span id="prog-mode-daylight" class="pointer-events-none absolute bottom-0 left-0 h-[1.5px] bg-amber-400/90" style="width: 0%;"></span>
                  </button>
                  <button id="btn-mode-shading" type="button" title="03 Facade Shading Lab (Overhangs, Vertical Fins & Sun Ingress)" class="mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-orange-400 shrink-0"></span>
                    <span class="opacity-65 text-[8px]">03</span>
                    <span>Shading</span>
                    <span id="prog-mode-shading" class="pointer-events-none absolute bottom-0 left-0 h-[1.5px] bg-orange-400/90" style="width: 0%;"></span>
                  </button>
                  <button id="btn-mode-nbc" type="button" title="04 NBC 2026 Statutory 3D Setbacks & Refuge Area" class="mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shrink-0"></span>
                    <span class="opacity-65 text-[8px]">04</span>
                    <span>NBC</span>
                    <span id="prog-mode-nbc" class="pointer-events-none absolute bottom-0 left-0 h-[1.5px] bg-sky-400/90" style="width: 0%;"></span>
                  </button>
                  <button id="btn-mode-autoplay" type="button" title="Pause / Resume 4-Stage Auto-Tour" aria-label="Pause or resume layer auto-tour" class="ml-0.5 pl-1.5 pr-1 py-0.5 rounded-r border-l border-white/10 text-emerald-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer flex items-center justify-center">
                    <span id="autoplay-icon" class="text-[8.5px] leading-none">⏸</span>
                  </button>
                </div>

                <div class="flex items-center gap-1.5 text-[9px] sm:text-[10px] font-mono shrink-0">
                  <span id="viz-climate-label" class="hidden">Bengaluru</span>
                  <span id="three-layer-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span id="three-layer-status" class="text-emerald-400 uppercase tracking-wider font-medium">3D Twin</span>
                </div>
              </div>

              <!-- Central 3D Three.js Building Viewport (Clearinfra Studio Twin - 100% Unobstructed) -->
              <div id="three-container" class="relative w-full h-[250px] sm:h-[285px] lg:h-[305px] xl:h-[330px] 2xl:h-[365px] mt-1.5 overflow-hidden rounded-xl border border-white/[0.08] bg-[#0E131E]/80 backdrop-blur-xs">
                <canvas id="three-building-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>

                <!-- Overlay Daylight Lux Scale Bar (Smoothly Fades in Daylight sDA Mode at bottom-2.5) -->
                <div id="daylight-lux-legend" class="opacity-0 pointer-events-none transition-opacity duration-300 absolute bottom-2.5 left-2.5 flex items-center gap-1.5 px-2 py-1 rounded-md bg-[#161D2B]/95 border border-white/15 text-[8.5px] sm:text-[9px] font-mono text-slate-300 backdrop-blur-xs shadow-lg z-10">
                  <span class="text-amber-300 font-semibold" id="daylight-sda-callout">sDA: 55%</span>
                  <span class="text-slate-500">|</span>
                  <span class="text-slate-400">0 lx</span>
                  <div class="w-14 sm:w-16 2xl:w-20 h-1.5 rounded-xs border border-white/20" style="background: linear-gradient(90deg, #060914 0%, #1e3a8a 18%, #16a34a 38%, #84cc16 56%, #eab308 74%, #ea580c 88%, #dc2626 100%);"></div>
                  <span class="text-red-400 font-semibold">2k+ lx</span>
                  <span class="hidden 2xl:inline text-emerald-400 border-l border-white/15 pl-1.5">≥300 lx</span>
                </div>

                <!-- Overlay Bottom-Left: Real-time Dynamic Status Callout Badge -->
                <div id="status-pill-container" class="absolute bottom-2.5 left-2.5 pointer-events-none flex items-center gap-1.5 text-[9px] sm:text-[9.5px] font-mono text-slate-400 bg-[#161D2B]/90 px-2 py-1 rounded-md border border-white/12 backdrop-blur-xs transition-opacity duration-200">
                  <span id="viz-wwr-callout" class="text-emerald-400 font-semibold">WWR: 40%</span>
                  <span class="text-slate-600">·</span>
                  <span id="viz-dni-label" class="text-amber-300">760 W/m²</span>
                </div>

                <!-- Overlay Bottom-Right: Streamlined View Toggle & Reset -->
                <div class="absolute top-2.5 right-2.5 flex items-center gap-0.5 bg-[#161D2B]/90 p-1 rounded-md border border-white/12 text-[8.5px] sm:text-[9px] font-mono shadow-sm select-none z-10">
                  <button id="btn-cam-iso" type="button" title="3D Isometric View" class="cam-btn px-2 py-0.5 rounded border border-emerald-500/35 bg-emerald-500/20 text-emerald-300 transition-colors duration-200 cursor-pointer font-medium">3D</button>
                  <button id="btn-cam-top" type="button" title="Top-down Floor Plan View" class="cam-btn px-2 py-0.5 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium">Plan</button>
                  <button id="btn-reset-cam" type="button" title="Reset Camera Orbit" class="px-1.5 py-0.5 rounded text-slate-400 hover:text-white hover:bg-white/[0.06] border-l border-white/10 transition-colors duration-200 cursor-pointer" aria-label="Reset Camera Orbit">↺</button>
                </div>
              </div>
            </div>

            <!-- Right 5 Cols of Card: Interactive Controls & Live Simulation Readout -->
            <div class="lg:col-span-5 p-3 sm:p-3.5 lg:p-3 xl:p-4 flex flex-col justify-between bg-[#141A25]">
              <!-- Simulated Physics Output Readout (Elevated to top on mobile for instant zero-distance feedback) -->
              <div class="order-1 lg:order-2 pt-0 lg:pt-2 xl:pt-2.5 border-b lg:border-b-0 lg:border-t border-white/[0.07] pb-2.5 lg:pb-0 flex flex-col gap-1.5 sm:gap-2">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-slate-400">Envelope Performance</span>
                  <span id="out-badge" class="px-2 py-0.5 rounded text-[9.5px] sm:text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                    Optimized Balance
                  </span>
                </div>

                <div class="kpi-card-group grid grid-cols-3 gap-1.5 sm:gap-2">
                  <div class="kpi-card group/tip relative p-1.5 sm:p-2 xl:p-2.5 rounded-xl bg-[#18202D] hover:bg-[#1D273A] border border-white/[0.08] hover:border-white/20 transition-all cursor-help text-center sm:text-left">
                    <span class="text-[8.5px] sm:text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap border-b border-dotted border-slate-600 inline-block">Annual EPI</span>
                    <span id="out-epi" class="text-sm sm:text-base xl:text-lg font-semibold text-white font-mono mt-0.5 block">80.2</span>
                    <span class="text-[8px] sm:text-[9px] font-mono text-slate-500">kWh/m²·yr</span>
                    <!-- Tooltip -->
                    <div class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2 rounded-lg bg-[#1A2334] border border-white/20 text-[10px] font-sans text-slate-200 shadow-2xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-center leading-tight">
                      Energy Performance Index per conditioned floor area. Statutory submittals run full 8,760-hr engine.
                    </div>
                  </div>

                  <div class="kpi-card group/tip relative p-1.5 sm:p-2 xl:p-2.5 rounded-xl bg-[#18202D] hover:bg-[#1D273A] border border-white/[0.08] hover:border-white/20 transition-all cursor-help text-center sm:text-left">
                    <span class="text-[8.5px] sm:text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap border-b border-dotted border-slate-600 inline-block">Plant Load</span>
                    <span id="out-cooling" class="text-sm sm:text-base xl:text-lg font-semibold text-white font-mono mt-0.5 block">246</span>
                    <span class="text-[8px] sm:text-[9px] font-mono text-slate-500">Peak TR</span>
                    <!-- Tooltip -->
                    <div class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-44 p-2 rounded-lg bg-[#1A2334] border border-white/20 text-[10px] font-sans text-slate-200 shadow-2xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-center leading-tight">
                      Peak chiller capacity required to offset envelope and internal sensible/latent heat gain.
                    </div>
                  </div>

                  <div class="kpi-card group/tip relative p-1.5 sm:p-2 xl:p-2.5 rounded-xl bg-[#18202D] hover:bg-[#1D273A] border border-white/[0.08] hover:border-white/20 transition-all cursor-help text-center sm:text-left">
                    <span class="text-[8.5px] sm:text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap border-b border-dotted border-slate-600 inline-block">Daylight</span>
                    <span id="out-sda" class="text-sm sm:text-base xl:text-lg font-semibold text-emerald-400 font-mono mt-0.5 block">55%</span>
                    <span class="text-[8px] sm:text-[9px] font-mono text-slate-500">sDA &gt;300lx</span>
                    <!-- Tooltip -->
                    <div class="pointer-events-none absolute bottom-full right-0 mb-2 w-48 p-2 rounded-lg bg-[#1A2334] border border-white/20 text-[10px] font-sans text-slate-200 shadow-2xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-center leading-tight">
                      Spatial Daylight Autonomy: percentage of floor plate achieving ≥300 lux on the workplane.
                    </div>
                  </div>
                </div>

                <!-- Status Strip: Screening estimate + Glazing / Mode Readout -->
                <div class="flex items-center justify-between gap-2 pt-1 border-t border-white/[0.06] text-[9px] sm:text-[9.5px] font-mono text-slate-400 whitespace-nowrap overflow-hidden">
                  <div class="shrink-0 text-slate-400">Screening estimate</div>
                  <div id="viz-shgc-readout" class="truncate text-right font-medium"><span class="text-emerald-400">SHGC 0.28 · U 1.6 W/m²K</span></div>
                </div>

                <!-- Mobile Launch Studio Button (Displayed on Mobile Homepage) -->
                <div class="lg:hidden pt-2" id="mobile-studio-trigger-wrap">
                  <button
                    type="button"
                    id="btn-open-mobile-studio"
                    class="w-full py-2.5 px-3.5 rounded-xl bg-gradient-to-r from-emerald-600/25 via-sky-600/25 to-emerald-600/25 hover:from-emerald-600/35 hover:to-sky-600/35 border border-emerald-500/40 hover:border-emerald-400 text-white font-mono text-xs font-semibold flex items-center justify-between shadow-md shadow-emerald-950/25 transition-all duration-200 active:scale-[0.98] cursor-pointer"
                  >
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                      <span class="tracking-wide">Launch Full-Screen Studio</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-emerald-400 text-[11px]">
                      <span>Tune Parameters</span>
                      <span class="text-sm font-bold">⛶</span>
                    </div>
                  </button>
                </div>
              </div>

              <!-- Charrette Parameters & Interactive Sliders -->
              <div id="charrette-params-container" class="order-2 lg:order-1 flex flex-col gap-2 sm:gap-2.5 xl:gap-3.5 pt-0.5 lg:pt-0 hidden lg:flex">
                <div class="flex items-center justify-between">
                  <span class="text-[10.5px] xl:text-xs font-mono uppercase tracking-wider text-slate-400">Charrette Parameters</span>
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-[9px] xl:text-[10px] font-mono font-medium text-emerald-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Tune live ↺</span>
                  </span>
                </div>

                <!-- Climate Selector: Quick-Tap Chips on Mobile, Select on Desktop -->
                <div>
                  <div class="flex items-center justify-between mb-1 xl:mb-1.5">
                    <span class="text-[10.5px] xl:text-xs text-slate-300 font-medium">Climate Zone (ECBC)</span>
                    <span id="climate-quick-desc" class="text-[9.5px] xl:text-[10px] font-mono text-emerald-400 lg:hidden">Temperate</span>
                  </div>
                  <!-- Mobile 1-Tap Chips (Instant tactile feedback, zero popup wheel) -->
                  <div class="grid grid-cols-5 gap-1 lg:hidden" id="ctrl-climate-chips">
                    <button type="button" data-climate="bengaluru" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-emerald-500/50 bg-emerald-500/20 text-emerald-300 font-medium transition-all text-center cursor-pointer truncate">
                      Bengaluru
                    </button>
                    <button type="button" data-climate="mumbai" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate">
                      Mumbai
                    </button>
                    <button type="button" data-climate="delhi" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate">
                      Delhi
                    </button>
                    <button type="button" data-climate="ahmedabad" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate">
                      Ahmedabad
                    </button>
                    <button type="button" data-climate="shimla" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate">
                      Shimla
                    </button>
                  </div>
                  <!-- Desktop Select Dropdown (Preserved for Desktop) -->
                  <select
                    id="ctrl-climate"
                    class="hidden lg:block w-full rounded-lg bg-[#1A2230] border border-white/12 px-2.5 py-1.5 xl:px-3 xl:py-2 text-[10.5px] xl:text-xs text-white font-mono focus:outline-none focus:border-emerald-500 transition-colors"
                  >
                    <option value="bengaluru" selected>Bengaluru — Temperate</option>
                    <option value="mumbai">Mumbai — Warm-Humid</option>
                    <option value="delhi">New Delhi — Composite</option>
                    <option value="ahmedabad">Ahmedabad — Hot-Dry</option>
                    <option value="shimla">Shimla — Cold</option>
                  </select>
                </div>

                <!-- WWR Slider -->
                <div>
                  <div class="flex justify-between text-[10.5px] xl:text-xs mb-1 xl:mb-1.5">
                    <label for="ctrl-wwr" class="text-slate-300 font-medium">Window-to-Wall Ratio (WWR)</label>
                    <span id="slider-hint-cue" class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/35 text-[9px] font-mono text-emerald-300 animate-pulse">← Drag to test physics live</span>
                    <span id="val-wwr" class="font-mono text-emerald-400">40%</span>
                  </div>
                  <input
                    id="ctrl-wwr"
                    type="range"
                    min="20"
                    max="70"
                    step="1"
                    value="40"
                    class="ci-slider"
                  />
                  <div class="flex justify-between text-[8.5px] xl:text-[10px] font-mono text-slate-500 mt-1">
                    <span>20%</span>
                    <span>40% (ECBC)</span>
                    <span>70%</span>
                  </div>
                </div>

                <!-- Glazing Spec Selector -->
                <div>
                  <span class="block text-[10.5px] xl:text-xs text-slate-300 mb-1 xl:mb-1.5 font-medium">Glazing Specification</span>
                  <div class="grid grid-cols-3 gap-1.5" id="ctrl-glazing-group">
                    <button
                      type="button"
                      data-glazing="single"
                      class="glazing-btn px-2 py-1.5 xl:py-2 rounded-lg text-[9px] xl:text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white hover:border-white/25 transition-all text-center cursor-pointer"
                    >
                      Clear DGU<br/><span class="opacity-75">0.58</span>
                    </button>
                    <button
                      type="button"
                      data-glazing="lowe"
                      class="glazing-btn px-2 py-1.5 xl:py-2 rounded-lg text-[9px] xl:text-[10px] font-mono font-semibold border border-emerald-400 bg-emerald-500/25 text-emerald-200 ring-1 ring-emerald-400/40 shadow-xs shadow-emerald-500/25 transition-all text-center cursor-pointer"
                    >
                      Low-E DGU<br/><span class="text-emerald-300 font-semibold">0.28</span>
                    </button>
                    <button
                      type="button"
                      data-glazing="triple"
                      class="glazing-btn px-2 py-1.5 xl:py-2 rounded-lg text-[9px] xl:text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white hover:border-white/25 transition-all text-center cursor-pointer"
                    >
                      Selective<br/><span class="opacity-75">0.22</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CI Agent Diagnostic Bar & Studio Bottom Dock -->
          <div id="studio-bottom-dock" class="px-3 sm:px-6 py-1.5 sm:py-2 bg-[#0F141E] border-t border-white/10 min-h-[46px] sm:min-h-[50px] xl:min-h-[56px] flex items-center justify-between gap-2.5 sm:gap-4 text-xs font-mono shrink-0 overflow-x-auto scrollbar-none">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3.5 text-slate-300 min-w-0 flex-1">
              <span class="px-2 py-0.5 rounded bg-sky-500/15 text-sky-300 border border-sky-500/35 text-[9.5px] sm:text-[10.5px] font-mono font-semibold tracking-wider shrink-0 whitespace-nowrap w-fit">ILLUSTRATIVE DEMO</span>
              <div id="charrette-chain" class="flex items-center gap-2.5 sm:gap-4 min-w-0 shrink-0">
                <div class="flex flex-col min-w-0">
                  <span class="text-[8.5px] sm:text-[9.5px] tracking-[0.08em] uppercase text-slate-400 font-medium leading-tight whitespace-nowrap">Glazing</span>
                  <span class="text-[12px] sm:text-[14px] font-semibold text-white leading-snug whitespace-nowrap" data-chain="glass">0.28</span>
                  <span class="text-[8px] sm:text-[9px] text-slate-400 leading-tight whitespace-nowrap" data-chain-sub="glass">SHGC</span>
                </div>
                <span class="text-emerald-400/60 text-[11px] sm:text-[13px] font-bold pb-2 shrink-0" aria-hidden="true">&rsaquo;</span>
                <div class="flex flex-col min-w-0">
                  <span class="text-[8.5px] sm:text-[9.5px] tracking-[0.08em] uppercase text-slate-400 font-medium leading-tight whitespace-nowrap">Envelope gain</span>
                  <span class="text-[12px] sm:text-[14px] font-semibold text-white leading-snug whitespace-nowrap" data-chain="gain">18.2</span>
                  <span class="text-[8px] sm:text-[9px] text-slate-400 leading-tight whitespace-nowrap" data-chain-sub="gain">kWh/m²·yr</span>
                </div>
                <span class="text-emerald-400/60 text-[11px] sm:text-[13px] font-bold pb-2 shrink-0" aria-hidden="true">&rsaquo;</span>
                <div class="flex flex-col min-w-0">
                  <span class="text-[8.5px] sm:text-[9.5px] tracking-[0.08em] uppercase text-slate-400 font-medium leading-tight whitespace-nowrap">Annual EPI</span>
                  <span class="text-[12px] sm:text-[14px] font-semibold text-white leading-snug whitespace-nowrap" data-chain="epi">80.2</span>
                  <span class="text-[8px] sm:text-[9px] text-slate-400 leading-tight whitespace-nowrap" data-chain-sub="epi">kWh/m²·yr</span>
                </div>
                <span class="text-emerald-400/60 text-[11px] sm:text-[13px] font-bold pb-2 shrink-0" aria-hidden="true">&rsaquo;</span>
                <div class="flex flex-col min-w-0">
                  <span class="text-[8.5px] sm:text-[9.5px] tracking-[0.08em] uppercase text-slate-400 font-medium leading-tight whitespace-nowrap">Plant load</span>
                  <span class="text-[12px] sm:text-[14px] font-semibold text-white leading-snug whitespace-nowrap" data-chain="tr">246</span>
                  <span class="text-[8px] sm:text-[9px] text-slate-400 leading-tight whitespace-nowrap" data-chain-sub="tr">TR</span>
                </div>
                <span class="text-emerald-400/60 text-[11px] sm:text-[13px] font-bold pb-2 shrink-0" aria-hidden="true">&rsaquo;</span>
                <div class="flex flex-col min-w-0">
                  <span class="text-[8.5px] sm:text-[9.5px] tracking-[0.08em] uppercase text-slate-400 font-medium leading-tight whitespace-nowrap">Daylight</span>
                  <span class="text-[12px] sm:text-[14px] font-semibold text-white leading-snug whitespace-nowrap" data-chain="sda">55%</span>
                  <span class="text-[8px] sm:text-[9px] text-slate-400 leading-tight whitespace-nowrap" data-chain-sub="sda">sDA &gt;300 lx</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>


<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const climateData: Record<string, { label: string; baseEpi: number; solarFactor: number; dni: string; sunPos: [number, number, number] }> = {
    bengaluru: { label: 'Bengaluru (Temperate)', baseEpi: 62, solarFactor: 0.72, dni: '760 W/m²', sunPos: [16, 22, 14] },
    mumbai:    { label: 'Mumbai (Warm-Humid)',   baseEpi: 88, solarFactor: 1.05, dni: '840 W/m²', sunPos: [18, 20, 16] },
    delhi:     { label: 'New Delhi (Composite)', baseEpi: 92, solarFactor: 1.12, dni: '890 W/m²', sunPos: [20, 18, 12] },
    ahmedabad: { label: 'Ahmedabad (Hot-Dry)',   baseEpi: 98, solarFactor: 1.25, dni: '960 W/m²', sunPos: [15, 24, 10] },
    shimla:    { label: 'Shimla (Cold)',         baseEpi: 54, solarFactor: 0.64, dni: '680 W/m²', sunPos: [14, 15, 18] },
  };

  const glazingData: Record<string, { shgc: number; uval: number }> = {
    single: { shgc: 0.58, uval: 2.8 },
    lowe:   { shgc: 0.28, uval: 1.6 },
    triple: { shgc: 0.22, uval: 1.1 },
  };

  let currentClimate = 'bengaluru';
  let currentWwr = 40;
  let currentGlazing = 'lowe';

  const climateSelect = document.getElementById('ctrl-climate') as HTMLSelectElement | null;
  const climateChips = document.querySelectorAll('.climate-chip');
  const climateDesc = document.getElementById('climate-quick-desc');
  const wwrSlider = document.getElementById('ctrl-wwr') as HTMLInputElement | null;
  const wwrVal = document.getElementById('val-wwr');
  const glazingBtns = document.querySelectorAll('.glazing-btn');

  const outEpi = document.getElementById('out-epi');
  const outCooling = document.getElementById('out-cooling');
  const outSda = document.getElementById('out-sda');
  const outBadge = document.getElementById('out-badge');

  // ─── CHARRETTE CHAIN: glazing → envelope gain → EPI → plant → daylight ───
  // Each step shows its value, and the value it held before the last change.
  type ChainValues = { glass: number; gain: number; epi: number; tr: number; sda: number };
  const chainValues: Record<keyof ChainValues, Element | null> = {
    glass: document.querySelector('[data-chain="glass"]'),
    gain: document.querySelector('[data-chain="gain"]'),
    epi: document.querySelector('[data-chain="epi"]'),
    tr: document.querySelector('[data-chain="tr"]'),
    sda: document.querySelector('[data-chain="sda"]'),
  };
  const chainSubs: Record<keyof ChainValues, Element | null> = {
    glass: document.querySelector('[data-chain-sub="glass"]'),
    gain: document.querySelector('[data-chain-sub="gain"]'),
    epi: document.querySelector('[data-chain-sub="epi"]'),
    tr: document.querySelector('[data-chain-sub="tr"]'),
    sda: document.querySelector('[data-chain-sub="sda"]'),
  };
  let chainPrev: ChainValues | null = null;

  function paintChain(cur: ChainValues, prev: ChainValues | null) {
    const paint = (key: keyof ChainValues, text: string, unit: string, was: (p: ChainValues) => string) => {
      const valueEl = chainValues[key];
      if (valueEl) valueEl.textContent = text;
      const subEl = chainSubs[key];
      if (subEl) subEl.textContent = prev ? was(prev) : unit;
    };
    paint('glass', cur.glass.toFixed(2), 'SHGC', (p) => `was ${p.glass.toFixed(2)}`);
    paint('gain', cur.gain.toFixed(1), 'kWh/m²·yr', (p) => `was ${p.gain.toFixed(1)}`);
    paint('epi', cur.epi.toFixed(1), 'kWh/m²·yr', (p) => `was ${p.epi.toFixed(1)}`);
    paint('tr', `${cur.tr}`, 'TR', (p) => `was ${p.tr} TR`);
    paint('sda', `${cur.sda}%`, 'sDA >300 lx', (p) => `was ${p.sda}%`);
  }

  const vizClimateLabel = document.getElementById('viz-climate-label');
  const vizDniLabel = document.getElementById('viz-dni-label');
  const vizWwrCallout = document.getElementById('viz-wwr-callout');
  const vizShgcReadout = document.getElementById('viz-shgc-readout');

  // ─── 3D THREE.JS DIGITAL TWIN (CLEARINFRA STUDIO RUNTIME) ───
  const container = document.getElementById('three-container') as HTMLDivElement | null;
  const canvas = document.getElementById('three-building-canvas') as HTMLCanvasElement | null;

  let updateThreeBuilding: ((wwr: number, glazing: string, climate: string) => void) | null = null;
  let pauseAutoTourExternal: (() => void) | null = null;
  let orbitControls: any = null;

  if (container && canvas) {
    try {
      const scene = new THREE.Scene();

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const camera = new THREE.PerspectiveCamera(34, container.clientWidth / Math.max(1, container.clientHeight), 0.1, 160);
      const defaultCamPos = new THREE.Vector3(21.8, 15.0, 21.8);
      const defaultTarget = new THREE.Vector3(0, 8.1, 0);
      camera.position.copy(defaultCamPos);

      const controls = new OrbitControls(camera, canvas);
      orbitControls = controls;
      controls.target.copy(defaultTarget);
      controls.enableDamping = true;
      controls.enableZoom = false;
      controls.dampingFactor = 0.06;
      controls.maxPolarAngle = Math.PI / 2 - 0.05;
      controls.minDistance = 12;
      controls.maxDistance = 60;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.45;

      // Prevent 3D canvas from trapping natural 1-finger vertical page scroll on touch devices in inline mode
      const isCoarseTouch = typeof window !== 'undefined' && (window.matchMedia('(pointer: coarse)').matches || ('ontouchstart' in window));
      if (isCoarseTouch) {
        controls.enableRotate = false;
        if (canvas) canvas.style.touchAction = 'pan-y';
      }

      // Smooth Camera Flight Animator (easeOutCubic)
      let camAnimActive = false;
      let camAnimStart = 0;
      const camAnimDuration = 420; // ms
      const camFromPos = new THREE.Vector3();
      const camToPos = new THREE.Vector3();
      const camFromTarget = new THREE.Vector3();
      const camToTarget = new THREE.Vector3();

      function flyCameraTo(px: number, py: number, pz: number, tx: number, ty: number, tz: number) {
        camFromPos.copy(camera.position);
        camToPos.set(px, py, pz);
        camFromTarget.copy(controls.target);
        camToTarget.set(tx, ty, tz);
        camAnimStart = performance.now();
        camAnimActive = true;
      }

      let idleTimer: any = null;
      controls.addEventListener('start', () => {
        camAnimActive = false;
        controls.autoRotate = false;
        pauseAutoTourExternal?.();
        clearTimeout(idleTimer);
      });
      controls.addEventListener('end', () => {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(() => {
          controls.autoRotate = true;
        }, 4000);
      });

      // Streamlined Camera Presets & Orbit Control HUD Handlers
      const btnCamIso = document.getElementById('btn-cam-iso');
      const btnCamTop = document.getElementById('btn-cam-top');
      const resetBtn = document.getElementById('btn-reset-cam');
      const camBtns = document.querySelectorAll('.cam-btn');

      function setCamActive(activeBtn: HTMLElement | null) {
        camBtns.forEach((b) => {
          b.className = 'cam-btn px-2 py-0.5 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium';
        });
        if (activeBtn) {
          activeBtn.className = 'cam-btn px-2 py-0.5 rounded border border-emerald-500/35 bg-emerald-500/20 text-emerald-300 transition-colors duration-200 cursor-pointer font-medium';
        }
      }

      function getIsoPresetForMode(mode: 'twin' | 'daylight' | 'shading' | 'nbc'): [number, number, number, number, number, number] {
        if (mode === 'daylight') return [12.6, 14.0, 12.6, 0, 1.2, 0];
        if (mode === 'shading') return [11.5, 10.2, 12.0, 0, 0.9, 0];
        if (mode === 'nbc') return [26.0, 18.0, 26.0, 0, 8.1, 0];
        return [21.8, 15.0, 21.8, 0, 8.1, 0];
      }

      btnCamIso?.addEventListener('click', () => {
        pauseAutoTourExternal?.();
        const [px, py, pz, tx, ty, tz] = getIsoPresetForMode(currentViewMode);
        flyCameraTo(px, py, pz, tx, ty, tz);
        setCamActive(btnCamIso);
      });
      btnCamTop?.addEventListener('click', () => {
        pauseAutoTourExternal?.();
        if (currentViewMode === 'daylight' || currentViewMode === 'shading') {
          flyCameraTo(0.01, 16.5, 0, 0, 0.3, 0);
        } else {
          flyCameraTo(0.01, 28.5, 0, 0, 0, 0);
        }
        setCamActive(btnCamTop);
      });
      resetBtn?.addEventListener('click', () => {
        pauseAutoTourExternal?.();
        const [px, py, pz, tx, ty, tz] = getIsoPresetForMode(currentViewMode);
        flyCameraTo(px, py, pz, tx, ty, tz);
        setCamActive(btnCamIso);
      });

      // Dark Site Plot Plane (Matching Studio 3,334m² Site)
      const sitePlane = new THREE.Mesh(
        new THREE.PlaneGeometry(28, 26),
        new THREE.MeshStandardMaterial({ color: 0x090d15, roughness: 0.95 })
      );
      sitePlane.rotation.x = -Math.PI / 2;
      sitePlane.position.y = -0.02;
      sitePlane.receiveShadow = true;
      scene.add(sitePlane);

      // Cyan Dashed Property Setback Perimeter (Matching Studio Twin)
      const setbackHalfW = 8.8;
      const setbackHalfD = 7.6;
      const setbackPoints = [
        new THREE.Vector3(-setbackHalfW, 0.02, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.02, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.02, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.02, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.02, -setbackHalfD),
      ];
      const setbackGeo = new THREE.BufferGeometry().setFromPoints(setbackPoints);
      const setbackMat = new THREE.LineDashedMaterial({
        color: 0x00e5ff,
        dashSize: 0.8,
        gapSize: 0.45,
        transparent: true,
        opacity: 0.75,
      });
      const setbackLine = new THREE.Line(setbackGeo, setbackMat);
      setbackLine.computeLineDistances();
      scene.add(setbackLine);

      // Subtle Grid Datum
      const gridHelper = new THREE.GridHelper(30, 16, 0x00c4df, 0x1e293b);
      gridHelper.position.y = -0.01;
      const gridMat = gridHelper.material as THREE.Material;
      gridMat.transparent = true;
      gridMat.opacity = 0.22;
      scene.add(gridHelper);

      // Studio Lighting
      const ambientLight = new THREE.AmbientLight(0x1e293b, 1.6);
      scene.add(ambientLight);

      const hemiLight = new THREE.HemisphereLight(0x00e5ff, 0x090d16, 0.75);
      scene.add(hemiLight);

      const sunLight = new THREE.DirectionalLight(0xfffbeb, 2.6);
      sunLight.position.set(18, 25, 16);
      sunLight.castShadow = true;
      sunLight.shadow.mapSize.width = 1024;
      sunLight.shadow.mapSize.height = 1024;
      sunLight.shadow.camera.near = 1;
      sunLight.shadow.camera.far = 70;
      sunLight.shadow.camera.left = -16;
      sunLight.shadow.camera.right = 16;
      sunLight.shadow.camera.top = 22;
      sunLight.shadow.camera.bottom = -10;
      sunLight.shadow.bias = -0.0005;
      scene.add(sunLight);

      // Sun Indicator Orb
      const sunOrb = new THREE.Mesh(
        new THREE.SphereGeometry(0.55, 16, 16),
        new THREE.MeshBasicMaterial({ color: 0xfbbf24 })
      );
      sunOrb.position.copy(sunLight.position);
      scene.add(sunOrb);

      // 12-Story Commercial Office Asset (Clearinfra Studio Digital Twin)
      const numFloors = 12;
      const floorHeight = 1.35;
      const slabH = 0.16;
      const towerW = 9.2;
      const towerD = 6.8;
      const clearHeight = floorHeight - slabH;

      const buildingGroup = new THREE.Group();
      scene.add(buildingGroup);

      // Materials
      const slabMat = new THREE.MeshStandardMaterial({
        color: 0x18202c,
        roughness: 0.6,
        metalness: 0.35,
      });
      const slabEdgeMat = new THREE.LineBasicMaterial({
        color: 0x00c4df,
        transparent: true,
        opacity: 0.35,
      });

      const coreMat = new THREE.MeshStandardMaterial({
        color: 0x0f1522,
        roughness: 0.9,
      });

      const columnMat = new THREE.MeshStandardMaterial({
        color: 0x27354a,
        roughness: 0.4,
        metalness: 0.5,
      });

      const spandrelMat = new THREE.MeshStandardMaterial({
        color: 0x141b26,
        roughness: 0.55,
        metalness: 0.3,
      });

      const mullionMat = new THREE.MeshStandardMaterial({
        color: 0x222c3d,
        roughness: 0.4,
        metalness: 0.55,
      });

      // Signature Electric Cyan Glazing Material
      const glassMat = new THREE.MeshPhysicalMaterial({
        color: new THREE.Color(0x00c4df),
        emissive: new THREE.Color(0x0891b2),
        emissiveIntensity: 0.32,
        roughness: 0.05,
        metalness: 0.1,
        transmission: 0.6,
        transparent: true,
        opacity: 0.78,
        depthWrite: false,
        side: THREE.FrontSide,
      });

      const glassEdgeMat = new THREE.LineBasicMaterial({
        color: 0x22d3ee,
        transparent: true,
        opacity: 0.45,
      });

      // Target material states for smooth, organic transitions (zero visual flash/strobe)
      const targetGlassColor = new THREE.Color(0x00c4df);
      const targetGlassEmissive = new THREE.Color(0x0891b2);
      let targetGlassEmissiveIntensity = 0.32;
      let targetGlassOpacity = 0.78;
      const targetGlassEdgeColor = new THREE.Color(0x22d3ee);

      // Central Structural Core
      const coreMesh = new THREE.Mesh(
        new THREE.BoxGeometry(3.6, numFloors * floorHeight, 2.8),
        coreMat
      );
      coreMesh.position.set(0, (numFloors * floorHeight) / 2, 0);
      coreMesh.castShadow = true;
      buildingGroup.add(coreMesh);

      // Arrays for dynamic update & mode cutaway
      const glassMeshes: THREE.Mesh[] = [];
      const mullionGroups: THREE.Group[] = [];
      const slabMeshes: THREE.Mesh[] = [];
      const floorPlates: THREE.Mesh[] = [];

      // Build 12 Floors with Slabs, Glazing & Vertical Mullions
      for (let i = 0; i < numFloors; i++) {
        // Floor Slab / Spandrel
        const slabGeo = new THREE.BoxGeometry(towerW + 0.25, slabH, towerD + 0.25);
        const slabMesh = new THREE.Mesh(slabGeo, slabMat);
        slabMesh.position.set(0, i * floorHeight + slabH / 2, 0);
        slabMesh.castShadow = true;
        slabMesh.receiveShadow = true;
        buildingGroup.add(slabMesh);
        slabMesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(slabGeo), slabEdgeMat));
        slabMeshes.push(slabMesh);

        // Floor Interior Plate
        const floorPlate = new THREE.Mesh(
          new THREE.BoxGeometry(towerW - 0.2, 0.04, towerD - 0.2),
          new THREE.MeshBasicMaterial({ color: 0x090d14 })
        );
        floorPlate.position.set(0, i * floorHeight + slabH + 0.02, 0);
        buildingGroup.add(floorPlate);
        floorPlates.push(floorPlate);

        // Dynamic Glazing Ribbon (height scaled by updateThreeBuilding)
        const glassGeo = new THREE.BoxGeometry(towerW - 0.02, 1, towerD - 0.02);
        const glassMesh = new THREE.Mesh(glassGeo, glassMat);
        glassMesh.castShadow = false;
        buildingGroup.add(glassMesh);
        glassMesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(glassGeo), glassEdgeMat));
        glassMeshes.push(glassMesh);

        // Vertical Mullion Fins (High-Tech Curtain Wall Articulation)
        const floorMullionGroup = new THREE.Group();
        const mullionGeoX = new THREE.BoxGeometry(0.06, 1, 0.1);
        const numMullionsX = 9;
        const stepX = (towerW - 0.6) / (numMullionsX - 1);
        for (let mx = 0; mx < numMullionsX; mx++) {
          const xPos = -(towerW - 0.6) / 2 + mx * stepX;
          const mF = new THREE.Mesh(mullionGeoX, mullionMat);
          mF.position.set(xPos, 0, towerD / 2 + 0.04);
          floorMullionGroup.add(mF);
          const mB = new THREE.Mesh(mullionGeoX, mullionMat);
          mB.position.set(xPos, 0, -towerD / 2 - 0.04);
          floorMullionGroup.add(mB);
        }
        const mullionGeoZ = new THREE.BoxGeometry(0.1, 1, 0.06);
        const numMullionsZ = 6;
        const stepZ = (towerD - 0.6) / (numMullionsZ - 1);
        for (let mz = 1; mz < numMullionsZ - 1; mz++) {
          const zPos = -(towerD - 0.6) / 2 + mz * stepZ;
          const mL = new THREE.Mesh(mullionGeoZ, mullionMat);
          mL.position.set(-towerW / 2 - 0.04, 0, zPos);
          floorMullionGroup.add(mL);
          const mR = new THREE.Mesh(mullionGeoZ, mullionMat);
          mR.position.set(towerW / 2 + 0.04, 0, zPos);
          floorMullionGroup.add(mR);
        }

        buildingGroup.add(floorMullionGroup);
        mullionGroups.push(floorMullionGroup);
      }

      // Ground Floor Architectural Entrance Canopy (Warm Brass/Timber Portal)
      const portalW = 3.4;
      const portalH = 1.05;
      const portalD = 1.2;
      const entranceGroup = new THREE.Group();
      entranceGroup.position.set(0, 0, towerD / 2 + 0.35);

      const entranceMat = new THREE.MeshStandardMaterial({
        color: 0xd97706, // warm gold / brass
        roughness: 0.35,
        metalness: 0.75,
      });
      const canopyRoofMat = new THREE.MeshStandardMaterial({
        color: 0xf59e0b,
        roughness: 0.25,
        metalness: 0.85,
      });
      const entranceGlassMat = new THREE.MeshBasicMaterial({
        color: 0xfef08a,
        transparent: true,
        opacity: 0.85,
      });

      // Canopy Slab projecting forward
      const canopyRoof = new THREE.Mesh(
        new THREE.BoxGeometry(portalW + 0.4, 0.08, portalD + 0.5),
        canopyRoofMat
      );
      canopyRoof.position.set(0, portalH + 0.04, 0.1);
      canopyRoof.castShadow = true;
      entranceGroup.add(canopyRoof);

      // Entrance Box Frame
      const portalBox = new THREE.Mesh(
        new THREE.BoxGeometry(portalW, portalH, portalD),
        entranceMat
      );
      portalBox.position.set(0, portalH / 2, 0);
      portalBox.castShadow = true;
      entranceGroup.add(portalBox);

      // Entrance Glass Light
      const portalGlass = new THREE.Mesh(
        new THREE.BoxGeometry(portalW - 0.5, portalH - 0.15, portalD + 0.02),
        entranceGlassMat
      );
      portalGlass.position.set(0, portalH / 2, 0);
      entranceGroup.add(portalGlass);

      // Thin Canopy Support Columns
      const colGeoP = new THREE.CylinderGeometry(0.04, 0.04, portalH, 12);
      const colL = new THREE.Mesh(colGeoP, canopyRoofMat);
      colL.position.set(-portalW / 2 - 0.12, portalH / 2, portalD / 2 + 0.2);
      entranceGroup.add(colL);
      const colR = new THREE.Mesh(colGeoP, canopyRoofMat);
      colR.position.set(portalW / 2 + 0.12, portalH / 2, portalD / 2 + 0.2);
      entranceGroup.add(colR);

      buildingGroup.add(entranceGroup);

      // Roof Slab
      const roofSlabGeo = new THREE.BoxGeometry(towerW + 0.25, slabH + 0.05, towerD + 0.25);
      const roofSlab = new THREE.Mesh(roofSlabGeo, slabMat);
      roofSlab.position.set(0, numFloors * floorHeight + slabH / 2, 0);
      roofSlab.castShadow = true;
      roofSlab.receiveShadow = true;
      buildingGroup.add(roofSlab);
      roofSlab.add(new THREE.LineSegments(new THREE.EdgesGeometry(roofSlabGeo), slabEdgeMat));

      // Roof Parapet
      const parapetGeo = new THREE.BoxGeometry(towerW + 0.25, 0.25, towerD + 0.25);
      const parapetMesh = new THREE.Mesh(parapetGeo, spandrelMat);
      parapetMesh.position.set(0, numFloors * floorHeight + slabH + 0.13, 0);
      buildingGroup.add(parapetMesh);

      // Roof Lift Penthouse
      const penthouseGeo = new THREE.BoxGeometry(3.2, 1.2, 2.6);
      const penthouse = new THREE.Mesh(penthouseGeo, slabMat);
      penthouse.position.set(-1.8, numFloors * floorHeight + slabH + 0.6, 0);
      penthouse.castShadow = true;
      buildingGroup.add(penthouse);
      penthouse.add(new THREE.LineSegments(new THREE.EdgesGeometry(penthouseGeo), slabEdgeMat));

      // Rooftop Solar PV Pergola
      const pvRack = new THREE.Group();
      pvRack.position.set(2.0, numFloors * floorHeight + slabH + 0.5, 0);
      pvRack.rotation.x = 0.18;
      const pvGeo = new THREE.BoxGeometry(3.6, 0.05, 2.6);
      const pvMat = new THREE.MeshStandardMaterial({
        color: 0x0284c7,
        roughness: 0.2,
        metalness: 0.65,
      });
      const pvMesh = new THREE.Mesh(pvGeo, pvMat);
      pvMesh.castShadow = true;
      pvRack.add(pvMesh);
      pvRack.add(new THREE.LineSegments(new THREE.EdgesGeometry(pvGeo), new THREE.LineBasicMaterial({ color: 0x38bdf8, opacity: 0.4, transparent: true })));
      buildingGroup.add(pvRack);

      // Rooftop HVAC Chiller Unit
      const chillerGeo = new THREE.BoxGeometry(1.4, 0.6, 1.1);
      const chiller = new THREE.Mesh(chillerGeo, columnMat);
      chiller.position.set(-1.8, numFloors * floorHeight + slabH + 1.2 + 0.3, 0);
      chiller.castShadow = true;
      buildingGroup.add(chiller);

      // ─── VIEW LAYERS: DAYLIGHT sDA LUX GRID, SHADING LAB (BRISE-SOLEIL) & NBC 2026 STATUTORY ENVELOPE ───
      const btnModeTwin = document.getElementById('btn-mode-twin');
      const btnModeDaylight = document.getElementById('btn-mode-daylight');
      const btnModeShading = document.getElementById('btn-mode-shading');
      const btnModeNbc = document.getElementById('btn-mode-nbc');
      const threeLayerDot = document.getElementById('three-layer-dot');
      const threeLayerStatus = document.getElementById('three-layer-status');
      const cadTopTitle = document.getElementById('cad-top-title');
      const daylightLegendEl = document.getElementById('daylight-lux-legend');
      const statusPillContainer = document.getElementById('status-pill-container');
      const daylightSdaCallout = document.getElementById('daylight-sda-callout');
      const shadingSunlitPctEl = document.getElementById('shading-sunlit-pct');
      const modeBtns = [btnModeTwin, btnModeDaylight, btnModeShading, btnModeNbc];

      // Helper to create crisp 3D floating text sprites (for Compass N/S/E/W & Statutory Callouts)
      function makeBadgeSprite(text: string, bgHex: string, borderHex: string, textHex: string, widthWorld = 1.6, heightWorld = 0.65) {
        const isWide = text.length > 3;
        const can = document.createElement('canvas');
        can.width = isWide ? 420 : 140;
        can.height = 112;
        const ctx = can.getContext('2d');
        if (ctx) {
          ctx.fillStyle = bgHex;
          ctx.beginPath();
          ctx.roundRect(6, 6, can.width - 12, can.height - 12, 22);
          ctx.fill();
          ctx.lineWidth = 4;
          ctx.strokeStyle = borderHex;
          ctx.stroke();
          ctx.font = `bold ${isWide ? 36 : 46}px "JetBrains Mono", monospace, sans-serif`;
          ctx.fillStyle = textHex;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(text, can.width / 2, can.height / 2 + 2);
        }
        const tex = new THREE.CanvasTexture(can);
        const mat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false, depthWrite: false });
        const sprite = new THREE.Sprite(mat);
        sprite.renderOrder = 999;
        sprite.scale.set(widthWorld, heightWorld, 1);
        return sprite;
      }

      // 1. Clearinfra Studio Daylight sDA Cutaway Mode Group
      const daylightGroup = new THREE.Group();
      daylightGroup.visible = false;
      scene.add(daylightGroup);

      // Exact Clearinfra Studio Lux False-Color Ramp (from daylightGridCalc.ts)
      const LUX_STOPS: [number, [number, number, number]][] = [
        [0,    [6, 9, 20]],       // deep navy (core)
        [50,   [12, 26, 61]],     // dark blue
        [150,  [30, 58, 138]],    // royal blue (under-lit)
        [300,  [22, 163, 74]],    // vibrant emerald green (ECBC 300 lx threshold!)
        [500,  [132, 204, 22]],   // chartreuse / lime (well-lit)
        [750,  [234, 179, 8]],    // vivid amber / yellow
        [1150, [249, 115, 22]],   // bright solar orange
        [1650, [220, 38, 38]],    // crimson red (perimeter direct solar)
      ];

      function getLuxColorRGB(lux: number): [number, number, number] {
        const clamped = Math.max(0, Math.min(2000, lux));
        for (let i = 0; i < LUX_STOPS.length - 1; i++) {
          const [l0, c0] = LUX_STOPS[i];
          const [l1, c1] = LUX_STOPS[i + 1];
          if (clamped <= l1) {
            const t = (clamped - l0) / (l1 - l0 || 1);
            return [
              (c0[0] + (c1[0] - c0[0]) * t) / 255,
              (c0[1] + (c1[1] - c0[1]) * t) / 255,
              (c0[2] + (c1[2] - c0[2]) * t) / 255,
            ];
          }
        }
        const last = LUX_STOPS[LUX_STOPS.length - 1][1];
        return [last[0] / 255, last[1] / 255, last[2] / 255];
      }

      // Architectural Ghost Volume (Skeletal Tower Wireframe + Translucent Floating Roof Cap, matching Studio)
      const totalTowerH = numFloors * floorHeight;
      const ghostRoofGeo = new THREE.BoxGeometry(towerW + 0.2, 0.12, towerD + 0.2);
      const ghostRoofMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.11,
        depthWrite: false,
      });
      const ghostRoof = new THREE.Mesh(ghostRoofGeo, ghostRoofMat);
      ghostRoof.position.set(0, totalTowerH, 0);
      daylightGroup.add(ghostRoof);
      ghostRoof.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(ghostRoofGeo),
        new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.50 })
      ));

      // Ghost Skeletal Corner Columns & Subtle Floor Ring Outlines (Unobstructed 12-story 3D volume like Studio)
      const skeletonMat = new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.22 });
      const cornerCoords = [
        [-towerW / 2, -towerD / 2],
        [towerW / 2, -towerD / 2],
        [towerW / 2, towerD / 2],
        [-towerW / 2, towerD / 2],
      ];
      cornerCoords.forEach(([cx, cz]) => {
        const pts = [new THREE.Vector3(cx, 0, cz), new THREE.Vector3(cx, totalTowerH, cz)];
        daylightGroup.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), skeletonMat));
      });
      for (let f = 3; f < numFloors; f += 3) {
        const ringY = f * floorHeight;
        const ringPts = [
          new THREE.Vector3(-towerW / 2, ringY, -towerD / 2),
          new THREE.Vector3(towerW / 2, ringY, -towerD / 2),
          new THREE.Vector3(towerW / 2, ringY, towerD / 2),
          new THREE.Vector3(-towerW / 2, ringY, towerD / 2),
          new THREE.Vector3(-towerW / 2, ringY, -towerD / 2),
        ];
        daylightGroup.add(new THREE.Line(
          new THREE.BufferGeometry().setFromPoints(ringPts),
          new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.10 })
        ));
      }

      // Discrete 3D Workplane Tile Grid (28 x 20 Individual Glowing Sensor Cells with Crisp Gaps)
      const colsX = 28;
      const rowsZ = 20;
      const gridSpanW = towerW - 0.24;
      const gridSpanD = towerD - 0.24;
      const stepCellX = gridSpanW / colsX;
      const stepCellZ = gridSpanD / rowsZ;
      const gapRatio = 0.85; // leaves crisp dark CAD channel between every tile

      // Primary Workplane Base Dark Plate
      const workplaneY = slabH + 0.08;
      const wpBacking = new THREE.Mesh(
        new THREE.BoxGeometry(towerW + 0.12, 0.06, towerD + 0.12),
        new THREE.MeshBasicMaterial({ color: 0x050811 })
      );
      wpBacking.position.set(0, workplaneY - 0.04, 0);
      daylightGroup.add(wpBacking);
      wpBacking.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.BoxGeometry(towerW + 0.14, 0.06, towerD + 0.14)),
        new THREE.LineBasicMaterial({ color: 0x00e5ff, transparent: true, opacity: 0.75 })
      ));

      const tileGeo = new THREE.BoxGeometry(stepCellX * gapRatio, 0.08, stepCellZ * gapRatio);
      const totalTiles = colsX * rowsZ;
      const tileInstancedMat = new THREE.MeshBasicMaterial({
        color: 0xffffff,
        toneMapped: false,
      });
      const tileInstancedMesh = new THREE.InstancedMesh(tileGeo, tileInstancedMat, totalTiles);
      tileInstancedMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
      daylightGroup.add(tileInstancedMesh);

      // Glowing Emerald-Green 300 lx ECBC Compliance Contour Ring (Dynamically sized by WWR/Glazing)
      const contourY = workplaneY + 0.08;
      const contourRingMat = new THREE.LineBasicMaterial({ color: 0x4ade80, linewidth: 2 });
      const contourRingGeo = new THREE.BufferGeometry();
      const contourRingLine = new THREE.LineLoop(contourRingGeo, contourRingMat);
      daylightGroup.add(contourRingLine);

      // Service Core Wireframe Cutout on Workplane
      const coreCutoutGeo = new THREE.BoxGeometry(2.5, 0.15, 1.7);
      const coreCutoutMesh = new THREE.Mesh(
        coreCutoutGeo,
        new THREE.MeshBasicMaterial({ color: 0x050811 })
      );
      coreCutoutMesh.position.set(0, workplaneY + 0.02, 0);
      daylightGroup.add(coreCutoutMesh);
      coreCutoutMesh.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(coreCutoutGeo),
        new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.65 })
      ));

      // Cardinal Compass Markers (N, S, E, W) around the floor plate, matching Clearinfra Studio
      const compassN = makeBadgeSprite('N', 'rgba(14,19,30,0.92)', '#ef4444', '#f87171', 0.85, 0.65);
      compassN.position.set(0, workplaneY + 0.35, -towerD / 2 - 0.9);
      daylightGroup.add(compassN);

      const compassS = makeBadgeSprite('S', 'rgba(14,19,30,0.92)', '#f59e0b', '#fbbf24', 0.85, 0.65);
      compassS.position.set(0, workplaneY + 0.35, towerD / 2 + 0.9);
      daylightGroup.add(compassS);

      const compassE = makeBadgeSprite('E', 'rgba(14,19,30,0.92)', '#38bdf8', '#7dd3fc', 0.85, 0.65);
      compassE.position.set(towerW / 2 + 0.9, workplaneY + 0.35, 0);
      daylightGroup.add(compassE);

      const compassW = makeBadgeSprite('W', 'rgba(14,19,30,0.92)', '#38bdf8', '#7dd3fc', 0.85, 0.65);
      compassW.position.set(-towerW / 2 - 0.9, workplaneY + 0.35, 0);
      daylightGroup.add(compassW);

      // 300 lx Compliance Badge Floating on Workplane
      const sdaTargetBadge = makeBadgeSprite('300 lx sDA', 'rgba(6,78,59,0.94)', '#10b981', '#6ee7b7', 2.4, 0.64);
      sdaTargetBadge.position.set(-towerW / 2 + 1.6, workplaneY + 0.55, -towerD / 2 + 1.0);
      daylightGroup.add(sdaTargetBadge);

      // Function to dynamically recompute all 560 3D sensor tiles when WWR, Glazing, or Climate changes
      const dummyObj = new THREE.Object3D();
      const tempColor = new THREE.Color();

      function updateDaylightGrid(wwrPct: number, glazingKey: string, climateKey: string) {
        const g = glazingData[glazingKey] || glazingData.lowe;
        const c = climateData[climateKey] || climateData.bengaluru;
        // Effective daylight transmittance factor (scales vividly with WWR slider & glazing choice)
        const vltFactor = (wwrPct / 40) * (0.72 + g.shgc * 0.95) * c.solarFactor;

        let idx = 0;
        for (let r = 0; r < rowsZ; r++) {
          const z = -gridSpanD / 2 + (r + 0.5) * stepCellZ;
          const dNorth = z - (-gridSpanD / 2);
          const dSouth = (gridSpanD / 2) - z;

          for (let col = 0; col < colsX; col++) {
            const x = -gridSpanW / 2 + (col + 0.5) * stepCellX;
            const dWest = x - (-gridSpanW / 2);
            const dEast = (gridSpanW / 2) - x;

            // Check if inside central structural core (2.5m x 1.7m)
            const inCore = Math.abs(x) < 1.25 && Math.abs(z) < 0.85;

            let lux = 12;
            if (!inCore) {
              // Directional solar illumination: South (+Z) and East (+X) receive intense direct solar perimeter glow (crimson/orange -> yellow -> green -> navy)
              const decayRate = 0.74 / Math.max(0.55, Math.pow(vltFactor, 0.52));
              const luxSouth = 2150 * vltFactor * Math.exp(-dSouth * decayRate * 0.88);
              const luxEast  = 1900 * vltFactor * Math.exp(-dEast  * decayRate * 0.94);
              const luxWest  = 1500 * vltFactor * Math.exp(-dWest  * decayRate * 1.05);
              const luxNorth = 1200 * vltFactor * Math.exp(-dNorth * decayRate * 1.12);

              lux = Math.max(luxSouth, luxEast, luxWest, luxNorth) +
                    0.26 * (luxSouth + luxEast + luxWest + luxNorth - Math.max(luxSouth, luxEast, luxWest, luxNorth));
            }

            const [cr, cg, cb] = getLuxColorRGB(lux);
            tempColor.setRGB(cr, cg, cb);

            // Slight 3D height extrusion proportional to illuminance for dramatic tactile relief
            const tileHeightScale = inCore ? 0.2 : 0.75 + Math.min(1.5, lux / 1100);
            dummyObj.position.set(x, workplaneY + (0.04 * tileHeightScale), z);
            dummyObj.scale.set(1, tileHeightScale, 1);
            dummyObj.updateMatrix();
            tileInstancedMesh.setMatrixAt(idx, dummyObj.matrix);
            tileInstancedMesh.setColorAt(idx, tempColor);

            idx++;
          }
        }

        tileInstancedMesh.instanceMatrix.needsUpdate = true;
        if (tileInstancedMesh.instanceColor) tileInstancedMesh.instanceColor.needsUpdate = true;

        // Update 300 lx emerald compliance contour ring inset based on daylight penetration depth
        const penetrationInset = Math.min(2.6, Math.max(0.85, 1.55 * Math.pow(vltFactor, 0.55)));
        const cw = Math.max(1.5, gridSpanW / 2 - penetrationInset);
        const cd = Math.max(1.1, gridSpanD / 2 - penetrationInset * 0.85);
        const cPts = [
          new THREE.Vector3(-cw, contourY, -cd),
          new THREE.Vector3(cw, contourY, -cd),
          new THREE.Vector3(cw, contourY, cd),
          new THREE.Vector3(-cw, contourY, cd),
        ];
        contourRingGeo.setFromPoints(cPts);
      }

      // 1B. Clearinfra Studio Shading Lab Group (Audited Floor Volume, South Overhangs, E/W Vertical Fins & Solar Ingress)
      const shadingGroup = new THREE.Group();
      shadingGroup.visible = false;
      scene.add(shadingGroup);

      // Dark Audited Floor Slab Base & Cyan Wireframe Single-Story Volume (Matches Studio twin_shading_lab.png)
      const shFloorY = slabH + 0.02;
      const shFloorMat = new THREE.MeshStandardMaterial({
        color: 0x070b14,
        roughness: 0.92,
        metalness: 0.1,
      });
      const shFloorBase = new THREE.Mesh(new THREE.BoxGeometry(towerW - 0.1, 0.06, towerD - 0.1), shFloorMat);
      shFloorBase.position.set(0, shFloorY, 0);
      shadingGroup.add(shFloorBase);

      // Central Core Footprint inside Audited Floor
      const shCoreBox = new THREE.Mesh(
        new THREE.BoxGeometry(2.5, floorHeight - 0.08, 1.7),
        new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.85, transparent: true, opacity: 0.65 })
      );
      shCoreBox.position.set(0, floorHeight / 2 + 0.04, 0);
      shadingGroup.add(shCoreBox);
      shCoreBox.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.BoxGeometry(2.5, floorHeight - 0.08, 1.7)),
        new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.45 })
      ));

      // Cyan Wireframe Single-Story Audited Volume Box
      const shVolGeo = new THREE.BoxGeometry(towerW + 0.06, floorHeight, towerD + 0.06);
      const shVolEdges = new THREE.LineSegments(
        new THREE.EdgesGeometry(shVolGeo),
        new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.82 })
      );
      shVolEdges.position.set(0, floorHeight / 2 + 0.02, 0);
      shadingGroup.add(shVolEdges);

      // Subtle Ghost Tower Corner Plumb Lines to 12-Story Roof (keeps spatial context)
      const shGhostMat = new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.14 });
      cornerCoords.forEach(([cx, cz]) => {
        shadingGroup.add(new THREE.Line(
          new THREE.BufferGeometry().setFromPoints([
            new THREE.Vector3(cx, floorHeight, cz),
            new THREE.Vector3(cx, totalTowerH, cz),
          ]),
          shGhostMat
        ));
      });

      // Terracotta / Copper Brise-Soleil Materials (Matches Studio Shading Lab warm bronze/orange fins & overhangs)
      const shadeFinMat = new THREE.MeshStandardMaterial({
        color: 0xd97706,
        emissive: 0xb45309,
        emissiveIntensity: 0.42,
        roughness: 0.3,
        metalness: 0.35,
      });
      const shadeFinEdgeMat = new THREE.LineBasicMaterial({ color: 0xfbbf24, transparent: true, opacity: 0.95 });
      const windowBayMat = new THREE.MeshBasicMaterial({
        color: 0x0f172a,
        transparent: true,
        opacity: 0.82,
      });
      const windowBayEdgeMat = new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.45 });

      // South (+Z) & North (-Z) Window Bays + South Horizontal Overhangs
      const southOverhangMeshes: THREE.Mesh[] = [];
      const southSunPatches: THREE.Mesh[] = [];
      const southSunWedges: THREE.Mesh[] = [];
      const eastWestFinMeshes: THREE.Mesh[] = [];
      const eastSunPatches: THREE.Mesh[] = [];
      const eastSunWedges: THREE.Mesh[] = [];

      const sunPatchMat = new THREE.MeshBasicMaterial({
        color: 0xfbbf24,
        transparent: true,
        opacity: 0.46,
        depthWrite: false,
        side: THREE.DoubleSide,
      });
      const sunPatchEdgeMat = new THREE.LineBasicMaterial({ color: 0xf59e0b, transparent: true, opacity: 0.92 });
      const sunWedgeMat = new THREE.MeshBasicMaterial({
        color: 0xf59e0b,
        transparent: true,
        opacity: 0.22,
        depthWrite: false,
        side: THREE.DoubleSide,
      });

      const numSouthBays = 8;
      const southSpanW = towerW - 1.0;
      const southBayStep = southSpanW / numSouthBays;
      const southBayW = southBayStep * 0.78;
      const bayWinH = clearHeight * 0.72;
      const bayCenterY = slabH + clearHeight * 0.52;
      const lintelY = slabH + clearHeight * 0.88;

      for (let i = 0; i < numSouthBays; i++) {
        const bx = -southSpanW / 2 + (i + 0.5) * southBayStep;

        // South (+Z) dark window bay
        const sBayGeo = new THREE.BoxGeometry(southBayW, bayWinH, 0.05);
        const sBay = new THREE.Mesh(sBayGeo, windowBayMat);
        sBay.position.set(bx, bayCenterY, towerD / 2 + 0.01);
        shadingGroup.add(sBay);
        sBay.add(new THREE.LineSegments(new THREE.EdgesGeometry(sBayGeo), windowBayEdgeMat));

        // North (-Z) dark window bay
        const nBay = new THREE.Mesh(sBayGeo, windowBayMat);
        nBay.position.set(bx, bayCenterY, -towerD / 2 - 0.01);
        shadingGroup.add(nBay);
        nBay.add(new THREE.LineSegments(new THREE.EdgesGeometry(sBayGeo), windowBayEdgeMat));

        // South (+Z) Terracotta Horizontal Overhang Canopy (projects outward along +Z)
        const ovhGeo = new THREE.BoxGeometry(southBayW + 0.08, 0.07, 0.65);
        const ovhMesh = new THREE.Mesh(ovhGeo, shadeFinMat);
        ovhMesh.position.set(bx, lintelY, towerD / 2 + 0.34);
        ovhMesh.rotation.x = 0.08; // slight downward solar tilt
        shadingGroup.add(ovhMesh);
        ovhMesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(ovhGeo), shadeFinEdgeMat));
        southOverhangMeshes.push(ovhMesh);

        // Secondary Mid-Transom Horizontal Louver on South Bay
        const midOvhGeo = new THREE.BoxGeometry(southBayW + 0.04, 0.045, 0.38);
        const midOvh = new THREE.Mesh(midOvhGeo, shadeFinMat);
        midOvh.position.set(bx, slabH + clearHeight * 0.58, towerD / 2 + 0.20);
        shadingGroup.add(midOvh);
        midOvh.add(new THREE.LineSegments(new THREE.EdgesGeometry(midOvhGeo), shadeFinEdgeMat));

        // South Floor Sunlit Patch (inside perimeter along +Z wall)
        const sPatchGeo = new THREE.PlaneGeometry(southBayW * 0.92, 1.0);
        const sPatch = new THREE.Mesh(sPatchGeo, sunPatchMat);
        sPatch.rotation.x = -Math.PI / 2;
        sPatch.position.set(bx, shFloorY + 0.04, towerD / 2 - 0.55);
        shadingGroup.add(sPatch);
        sPatch.add(new THREE.LineSegments(new THREE.EdgesGeometry(sPatchGeo), sunPatchEdgeMat));
        southSunPatches.push(sPatch);

        // South 3D Translucent Solar Ray Wedge (slanting from window sill/lintel onto floor patch)
        const sWedgeGeo = new THREE.BoxGeometry(southBayW * 0.88, bayWinH * 0.65, 1.0);
        const sWedge = new THREE.Mesh(sWedgeGeo, sunWedgeMat);
        sWedge.position.set(bx, shFloorY + 0.38, towerD / 2 - 0.52);
        sWedge.rotation.x = -0.42;
        shadingGroup.add(sWedge);
        southSunWedges.push(sWedge);
      }

      // East (+X) & West (-X) Window Bays + Full-Height Angled Vertical Brise-Soleil Fins
      const numSideBays = 6;
      const sideSpanD = towerD - 1.0;
      const sideBayStep = sideSpanD / numSideBays;
      const sideBayD = sideBayStep * 0.76;
      const finH = clearHeight * 0.86;

      for (let j = 0; j < numSideBays; j++) {
        const bz = -sideSpanD / 2 + (j + 0.5) * sideBayStep;

        // East (+X) & West (-X) dark window bays
        const eBayGeo = new THREE.BoxGeometry(0.05, bayWinH, sideBayD);
        const eBay = new THREE.Mesh(eBayGeo, windowBayMat);
        eBay.position.set(towerW / 2 + 0.01, bayCenterY, bz);
        shadingGroup.add(eBay);
        eBay.add(new THREE.LineSegments(new THREE.EdgesGeometry(eBayGeo), windowBayEdgeMat));

        const wBay = new THREE.Mesh(eBayGeo, windowBayMat);
        wBay.position.set(-towerW / 2 - 0.01, bayCenterY, bz);
        shadingGroup.add(wBay);
        wBay.add(new THREE.LineSegments(new THREE.EdgesGeometry(eBayGeo), windowBayEdgeMat));

        // 2 Vertical Fins per Side Bay on East (+X) and West (-X)
        [-sideBayD * 0.32, sideBayD * 0.32].forEach((zOff) => {
          const finGeo = new THREE.BoxGeometry(0.58, finH, 0.065);

          // East (+X) Vertical Fin (angled to block morning/low-angle sun)
          const eFin = new THREE.Mesh(finGeo, shadeFinMat);
          eFin.position.set(towerW / 2 + 0.30, bayCenterY, bz + zOff);
          eFin.rotation.y = 0.28;
          shadingGroup.add(eFin);
          eFin.add(new THREE.LineSegments(new THREE.EdgesGeometry(finGeo), shadeFinEdgeMat));
          eastWestFinMeshes.push(eFin);

          // West (-X) Vertical Fin (angled to block harsh afternoon West sun)
          const wFin = new THREE.Mesh(finGeo, shadeFinMat);
          wFin.position.set(-towerW / 2 - 0.30, bayCenterY, bz + zOff);
          wFin.rotation.y = -0.28;
          shadingGroup.add(wFin);
          wFin.add(new THREE.LineSegments(new THREE.EdgesGeometry(finGeo), shadeFinEdgeMat));
          eastWestFinMeshes.push(wFin);
        });

        // East (+X) Floor Sunlit Ingress Patch & 3D Solar Ray Wedge (Matches Studio 1.9m East Ingress)
        const ePatchGeo = new THREE.PlaneGeometry(1.0, sideBayD * 0.88);
        const ePatch = new THREE.Mesh(ePatchGeo, sunPatchMat);
        ePatch.rotation.x = -Math.PI / 2;
        ePatch.position.set(towerW / 2 - 0.85, shFloorY + 0.045, bz);
        shadingGroup.add(ePatch);
        ePatch.add(new THREE.LineSegments(new THREE.EdgesGeometry(ePatchGeo), sunPatchEdgeMat));
        eastSunPatches.push(ePatch);

        const eWedgeGeo = new THREE.BoxGeometry(1.0, bayWinH * 0.68, sideBayD * 0.84);
        const eWedge = new THREE.Mesh(eWedgeGeo, sunWedgeMat);
        eWedge.position.set(towerW / 2 - 0.80, shFloorY + 0.40, bz);
        eWedge.rotation.z = 0.46;
        shadingGroup.add(eWedge);
        eastSunWedges.push(eWedge);
      }

      // Golden Solar Path Trajectory Arc Overhead (Matches Studio solar path arc in twin_shading_lab.png)
      const solarArcPts: THREE.Vector3[] = [];
      for (let s = 0; s <= 32; s++) {
        const t = s / 32;
        const ang = (t - 0.5) * Math.PI * 0.88; // East (+X) through South (+Z) to West (-X)
        const sx = Math.sin(-ang) * (towerW * 0.68);
        const sz = Math.cos(ang) * (towerD * 0.48) + 1.8;
        const sy = 1.6 + Math.cos(ang * 0.95) * 4.2;
        solarArcPts.push(new THREE.Vector3(sx, sy, sz));
      }
      const solarArcLine = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(solarArcPts),
        new THREE.LineBasicMaterial({ color: 0xfbbf24, transparent: true, opacity: 0.78 })
      );
      shadingGroup.add(solarArcLine);

      // Glowing Sun Position Marker on the Solar Path Arc (10:30 AM Design Sun)
      const arcSunIdx = 11;
      const arcSunPos = solarArcPts[arcSunIdx];
      const shSunMarker = new THREE.Mesh(
        new THREE.SphereGeometry(0.28, 16, 16),
        new THREE.MeshBasicMaterial({ color: 0xfde047 })
      );
      shSunMarker.position.copy(arcSunPos);
      shadingGroup.add(shSunMarker);

      // Dashed Solar Ray Vector from Sun Marker to South-East Facade Corner
      const solarRayLine = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          arcSunPos.clone(),
          new THREE.Vector3(towerW / 2 - 0.6, shFloorY + 0.1, towerD / 2 - 0.6),
        ]),
        new THREE.LineDashedMaterial({ color: 0xfbbf24, dashSize: 0.4, gapSize: 0.25, transparent: true, opacity: 0.75 })
      );
      solarRayLine.computeLineDistances();
      shadingGroup.add(solarRayLine);

      // Cardinal N / S / E / W Badges & Studio Shading Callout Sprites
      const shCompassN = makeBadgeSprite('N', 'rgba(15,23,42,0.92)', '#475569', '#94a3b8', 0.82, 0.64);
      shCompassN.position.set(0, shFloorY + 0.35, -towerD / 2 - 1.15);
      shadingGroup.add(shCompassN);

      const shCompassS = makeBadgeSprite('S', 'rgba(120,53,15,0.95)', '#f59e0b', '#fde68a', 0.82, 0.64);
      shCompassS.position.set(0, shFloorY + 0.35, towerD / 2 + 1.25);
      shadingGroup.add(shCompassS);

      const shCompassE = makeBadgeSprite('E', 'rgba(120,53,15,0.95)', '#f59e0b', '#fde68a', 0.82, 0.64);
      shCompassE.position.set(towerW / 2 + 1.25, shFloorY + 0.35, 0);
      shadingGroup.add(shCompassE);

      const shCompassW = makeBadgeSprite('W', 'rgba(15,23,42,0.92)', '#f59e0b', '#fcd34d', 0.82, 0.64);
      shCompassW.position.set(-towerW / 2 - 1.25, shFloorY + 0.35, 0);
      shadingGroup.add(shCompassW);

      const shIngressBadge = makeBadgeSprite('☀ 1.9m Ingress', 'rgba(120,53,15,0.95)', '#f59e0b', '#fef08a', 2.8, 0.68);
      shIngressBadge.position.set(towerW / 2 + 0.3, floorHeight + 0.55, 2.1);
      shadingGroup.add(shIngressBadge);

      const shOverhangBadge = makeBadgeSprite('Overhangs + Fins', 'rgba(15,23,42,0.95)', '#f59e0b', '#fed7aa', 3.0, 0.68);
      shOverhangBadge.position.set(-1.8, floorHeight + 0.55, towerD / 2 + 0.4);
      shadingGroup.add(shOverhangBadge);

      function updateShadingLab(wwrPct: number, glazingKey: string, climateKey: string) {
        const g = glazingData[glazingKey] || glazingData.lowe;
        const c = climateData[climateKey] || climateData.bengaluru;

        // Overhang & Fin Depth scales slightly with solar intensity & WWR
        const finScale = 0.85 + (wwrPct / 60) * 0.45 * c.solarFactor;
        southOverhangMeshes.forEach((m) => {
          m.scale.z = finScale;
        });
        eastWestFinMeshes.forEach((m) => {
          m.scale.x = finScale;
        });

        // Direct Sunlight Ingress Depth (m) scales with WWR, SHGC, and Climate solar factor (1.9m at 40% WWR + Low-E + Bengaluru)
        const ingressDepthM = Math.max(0.9, Math.min(3.1, 1.32 + (wwrPct / 40) * g.shgc * c.solarFactor * 2.30));
        const southPatchDepth = Math.max(0.65, ingressDepthM * 0.52);
        const eastPatchDepth = Math.max(0.85, ingressDepthM * 0.72);

        southSunPatches.forEach((p) => {
          p.scale.y = southPatchDepth;
          p.position.z = towerD / 2 - 0.14 - southPatchDepth / 2;
        });
        southSunWedges.forEach((w) => {
          w.scale.z = southPatchDepth;
          w.position.z = towerD / 2 - 0.14 - southPatchDepth / 2;
        });

        eastSunPatches.forEach((p) => {
          p.scale.x = eastPatchDepth;
          p.position.x = towerW / 2 - 0.14 - eastPatchDepth / 2;
        });
        eastSunWedges.forEach((w) => {
          w.scale.x = eastPatchDepth;
          w.position.x = towerW / 2 - 0.14 - eastPatchDepth / 2;
        });

        const sunlitPct = Math.max(2, Math.min(14, Math.round((wwrPct / 40) * g.shgc * c.solarFactor * 12.0)));
        if (shadingSunlitPctEl) {
          shadingSunlitPctEl.textContent = `${sunlitPct}% (${ingressDepthM.toFixed(1)}m)`;
        }
        return { ingressDepthM: ingressDepthM.toFixed(1), sunlitPct };
      }

      // 2. NBC 2026 Statutory Layer Group (Zero Z-Fighting, Full Studio Setback Apron & 3D Zoning Envelope)
      const nbcGroup = new THREE.Group();
      nbcGroup.visible = false;
      scene.add(nbcGroup);

      // Level 6 Statutory Refuge Floor (Floor index 5: replaces standard slab/glass when NBC mode is active -> ZERO flicker!)
      const refugeFlIdx = 5;
      const refugeBaseY = refugeFlIdx * floorHeight;

      // Glowing Cyan Refuge Slab Deck (slightly cantilevered like Studio RefugeBands.tsx)
      const refugeDeckGeo = new THREE.BoxGeometry(towerW + 0.55, slabH + 0.04, towerD + 0.55);
      const refugeDeckMat = new THREE.MeshStandardMaterial({
        color: 0x06b6d4,
        emissive: 0x00e5ff,
        emissiveIntensity: 0.75,
        roughness: 0.2,
        metalness: 0.3,
      });
      const refugeDeckMesh = new THREE.Mesh(refugeDeckGeo, refugeDeckMat);
      refugeDeckMesh.position.set(0, refugeBaseY + slabH / 2, 0);
      nbcGroup.add(refugeDeckMesh);
      refugeDeckMesh.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(refugeDeckGeo),
        new THREE.LineBasicMaterial({ color: 0xa5f3fc })
      ));

      // Recessed Illuminated Cyan Refuge Volume & Open Safety Perimeter Railings
      const refugeVolH = clearHeight - 0.04;
      const refugeVolGeo = new THREE.BoxGeometry(towerW + 0.16, refugeVolH, towerD + 0.16);
      const refugeVolMat = new THREE.MeshBasicMaterial({
        color: 0x22d3ee,
        transparent: true,
        opacity: 0.38,
        depthWrite: false,
      });
      const refugeVolMesh = new THREE.Mesh(refugeVolGeo, refugeVolMat);
      refugeVolMesh.position.set(0, refugeBaseY + slabH + refugeVolH / 2, 0);
      nbcGroup.add(refugeVolMesh);
      refugeVolMesh.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(refugeVolGeo),
        new THREE.LineBasicMaterial({ color: 0x67e8f9, transparent: true, opacity: 0.95 })
      ));

      // Top Ring Outline of Refuge Floor
      const refugeCapGeo = new THREE.BoxGeometry(towerW + 0.50, 0.06, towerD + 0.50);
      const refugeCapMesh = new THREE.Mesh(refugeCapGeo, refugeDeckMat);
      refugeCapMesh.position.set(0, refugeBaseY + floorHeight - 0.03, 0);
      nbcGroup.add(refugeCapMesh);

      // Full-Perimeter Emerald Setback Apron (Matches Studio twin_nbc_3d.png green compliance lawn + boundary wall)
      const setbackApronGeo = new THREE.PlaneGeometry(setbackHalfW * 2, setbackHalfD * 2);
      const setbackApronMat = new THREE.MeshBasicMaterial({
        color: 0x10b981,
        transparent: true,
        opacity: 0.14,
        depthWrite: false,
        polygonOffset: true,
        polygonOffsetFactor: -1,
        polygonOffsetUnits: -1,
      });
      const setbackApron = new THREE.Mesh(setbackApronGeo, setbackApronMat);
      setbackApron.rotation.x = -Math.PI / 2;
      setbackApron.position.set(0, 0.025, 0);
      nbcGroup.add(setbackApron);

      // Crisp Solid Emerald Setback Compliance Perimeter Ring
      const apronRingPts = [
        new THREE.Vector3(-setbackHalfW, 0.05, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.05, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.05, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.05, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.05, -setbackHalfD),
      ];
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(apronRingPts),
        new THREE.LineBasicMaterial({ color: 0x34d399 })
      ));

      // 3D Low Perimeter Boundary Wall around Plot (Matches SiteEnvironment.tsx boundary_wall_height_m)
      const bWallH = 0.35;
      const bWallMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.24, depthWrite: false });
      const bWallF = new THREE.Mesh(new THREE.BoxGeometry(setbackHalfW * 2, bWallH, 0.06), bWallMat);
      bWallF.position.set(0, bWallH / 2, setbackHalfD);
      nbcGroup.add(bWallF);
      const bWallB = new THREE.Mesh(new THREE.BoxGeometry(setbackHalfW * 2, bWallH, 0.06), bWallMat);
      bWallB.position.set(0, bWallH / 2, -setbackHalfD);
      nbcGroup.add(bWallB);
      const bWallL = new THREE.Mesh(new THREE.BoxGeometry(0.06, bWallH, setbackHalfD * 2), bWallMat);
      bWallL.position.set(-setbackHalfW, bWallH / 2, 0);
      nbcGroup.add(bWallL);
      const bWallR = new THREE.Mesh(new THREE.BoxGeometry(0.06, bWallH, setbackHalfD * 2), bWallMat);
      bWallR.position.set(setbackHalfW, bWallH / 2, 0);
      nbcGroup.add(bWallR);

      // Architectural Setback Dimension Leader Lines with Tick Marks (Front +Z & Right Side +X)
      const leaderMat = new THREE.LineBasicMaterial({ color: 0x4ade80 });
      // Front Leader (+Z)
      const frontWallZ = towerD / 2 + 0.15;
      const frontPlotZ = setbackHalfD;
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(-2.4, 0.08, frontWallZ),
          new THREE.Vector3(-2.4, 0.08, frontPlotZ),
        ]),
        leaderMat
      ));
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(-2.8, 0.08, frontWallZ),
          new THREE.Vector3(-2.0, 0.08, frontWallZ),
        ]),
        leaderMat
      ));
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(-2.8, 0.08, frontPlotZ),
          new THREE.Vector3(-2.0, 0.08, frontPlotZ),
        ]),
        leaderMat
      ));

      // Right Side Leader (+X)
      const rightWallX = towerW / 2 + 0.15;
      const rightPlotX = setbackHalfW;
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(rightWallX, 0.08, 1.2),
          new THREE.Vector3(rightPlotX, 0.08, 1.2),
        ]),
        leaderMat
      ));
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(rightWallX, 0.08, 0.8),
          new THREE.Vector3(rightWallX, 0.08, 1.6),
        ]),
        leaderMat
      ));
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(rightPlotX, 0.08, 0.8),
          new THREE.Vector3(rightPlotX, 0.08, 1.6),
        ]),
        leaderMat
      ));

      // 3D Permissible Height Envelope Ceiling Frame & Corner Plumb Guides (Matches SiteEnvironment.tsx §4.3)
      const maxH = totalTowerH + 1.3;
      const ew = towerW / 2 + 1.1;
      const ed = towerD / 2 + 1.1;
      const ceilingPts = [
        new THREE.Vector3(-ew, maxH, -ed),
        new THREE.Vector3(ew, maxH, -ed),
        new THREE.Vector3(ew, maxH, ed),
        new THREE.Vector3(-ew, maxH, ed),
        new THREE.Vector3(-ew, maxH, -ed),
      ];
      const ceilingLine = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(ceilingPts),
        new THREE.LineDashedMaterial({ color: 0x38bdf8, dashSize: 0.6, gapSize: 0.35, transparent: true, opacity: 0.65 })
      );
      ceilingLine.computeLineDistances();
      nbcGroup.add(ceilingLine);

      [[-ew, -ed], [ew, -ed], [ew, ed], [-ew, ed]].forEach(([cx, cz]) => {
        const plumb = new THREE.Line(
          new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(cx, 0.05, cz), new THREE.Vector3(cx, maxH, cz)]),
          new THREE.LineDashedMaterial({ color: 0x38bdf8, dashSize: 0.5, gapSize: 0.5, transparent: true, opacity: 0.32 })
        );
        plumb.computeLineDistances();
        nbcGroup.add(plumb);
      });

      // Floating 3D Callout Chips for NBC 2026 Mode (Matching Studio twin_nbc_3d.png)
      const refugeCallout = makeBadgeSprite('REFUGE L6: +20.5m', 'rgba(8,47,73,0.95)', '#22d3ee', '#a5f3fc', 3.4, 0.78);
      refugeCallout.position.set(towerW / 2 + 1.8, refugeBaseY + floorHeight / 2, towerD / 2 + 0.4);
      nbcGroup.add(refugeCallout);

      const frontSetbackChip = makeBadgeSprite('Front: 15.6m', 'rgba(6,78,59,0.95)', '#10b981', '#86efac', 2.7, 0.70);
      frontSetbackChip.position.set(-2.5, 0.55, (frontWallZ + frontPlotZ) / 2 + 0.2);
      nbcGroup.add(frontSetbackChip);

      const sideSetbackChip = makeBadgeSprite('Right Side: 15.6m', 'rgba(6,78,59,0.95)', '#10b981', '#86efac', 3.1, 0.70);
      sideSetbackChip.position.set((rightWallX + rightPlotX) / 2 + 0.2, 0.55, -1.6);
      nbcGroup.add(sideSetbackChip);

      const maxHtChip = makeBadgeSprite('MAX HT 49.2m PASS', 'rgba(15,23,42,0.95)', '#38bdf8', '#bae6fd', 3.3, 0.72);
      maxHtChip.position.set(ew - 0.8, maxH - 0.5, -ed + 0.8);
      nbcGroup.add(maxHtChip);

      // Helper to toggle solid tower geometry vs. Studio Cutaway Ghost mode or NBC Refuge Floor replacement
      function setBuildingCutaway(mode: 'twin' | 'daylight' | 'shading' | 'nbc') {
        const isCutaway = mode === 'daylight' || mode === 'shading';
        const isNbc = mode === 'nbc';

        coreMesh.visible = !isCutaway;
        entranceGroup.visible = !isCutaway;
        roofSlab.visible = !isCutaway;
        parapetMesh.visible = !isCutaway;
        penthouse.visible = !isCutaway;
        pvRack.visible = !isCutaway;
        chiller.visible = !isCutaway;

        slabMeshes.forEach((m, idx) => {
          if (isCutaway) {
            m.visible = idx === 0;
          } else if (isNbc && idx === refugeFlIdx) {
            // Hide standard slab on Level 6 so the NBC Refuge Deck replaces it cleanly with zero z-fighting!
            m.visible = false;
          } else {
            m.visible = true;
          }
        });
        floorPlates.forEach((m, idx) => {
          m.visible = !isCutaway && !(isNbc && idx === refugeFlIdx);
        });
        glassMeshes.forEach((m, idx) => {
          // Hide standard curtain wall glass on Level 6 in NBC mode so the recessed Refuge Floor doesn't flicker!
          m.visible = !isCutaway && !(isNbc && idx === refugeFlIdx);
        });
        mullionGroups.forEach((g, idx) => {
          g.visible = !isCutaway && !(isNbc && idx === refugeFlIdx);
        });
      }

      // View Mode Toggle Handler & 4-Stage Idle Auto-Tour (01 Twin -> 02 Daylight -> 03 Shading -> 04 NBC)
      let currentViewMode: 'twin' | 'daylight' | 'shading' | 'nbc' = 'twin';
      const btnModeAutoplay = document.getElementById('btn-mode-autoplay');
      const autoplayIcon = document.getElementById('autoplay-icon');
      const progModeTwin = document.getElementById('prog-mode-twin');
      const progModeDaylight = document.getElementById('prog-mode-daylight');
      const progModeShading = document.getElementById('prog-mode-shading');
      const progModeNbc = document.getElementById('prog-mode-nbc');
      const progBars: Record<'twin' | 'daylight' | 'shading' | 'nbc', HTMLElement | null> = {
        twin: progModeTwin,
        daylight: progModeDaylight,
        shading: progModeShading,
        nbc: progModeNbc,
      };

      let autoTourActive = true;
      let autoTourHoverPaused = false;
      let autoTourElapsed = 0;
      const AUTO_TOUR_DURATION = 5200; // 5.2s per stage
      const TOUR_SEQUENCE: ('twin' | 'daylight' | 'shading' | 'nbc')[] = ['twin', 'daylight', 'shading', 'nbc'];

      function clearAllProgressBars() {
        if (progModeTwin) progModeTwin.style.width = '0%';
        if (progModeDaylight) progModeDaylight.style.width = '0%';
        if (progModeShading) progModeShading.style.width = '0%';
        if (progModeNbc) progModeNbc.style.width = '0%';
      }

      function stopAutoTour() {
        if (!autoTourActive) return;
        autoTourActive = false;
        autoTourElapsed = 0;
        clearAllProgressBars();
        if (autoplayIcon) autoplayIcon.textContent = '▶';
        if (btnModeAutoplay) {
          btnModeAutoplay.classList.remove('text-emerald-400');
          btnModeAutoplay.classList.add('text-slate-400');
        }
      }

      function startAutoTour() {
        autoTourActive = true;
        autoTourElapsed = 0;
        clearAllProgressBars();
        if (autoplayIcon) autoplayIcon.textContent = '⏸';
        if (btnModeAutoplay) {
          btnModeAutoplay.classList.remove('text-slate-400');
          btnModeAutoplay.classList.add('text-emerald-400');
        }
      }

      pauseAutoTourExternal = stopAutoTour;

      // Freeze auto-tour timer while user is hovering inside the 3D viewport
      container.addEventListener('mouseenter', () => {
        autoTourHoverPaused = true;
      });
      container.addEventListener('mouseleave', () => {
        autoTourHoverPaused = false;
      });

      btnModeAutoplay?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (autoTourActive) {
          stopAutoTour();
        } else {
          startAutoTour();
        }
      });

      function setViewMode(mode: 'twin' | 'daylight' | 'shading' | 'nbc', isManual = true) {
        if (isManual) {
          stopAutoTour();
        } else {
          autoTourElapsed = 0;
          clearAllProgressBars();
        }
        currentViewMode = mode;

        modeBtns.forEach((btn) => {
          if (!btn) return;
          btn.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
        });

        setCamActive(btnCamIso);

        if (mode === 'daylight') {
          if (btnModeDaylight) {
            btnModeDaylight.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-amber-500/40 bg-amber-500/20 text-amber-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
          }
          if (threeLayerDot) threeLayerDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse';
          if (threeLayerStatus) {
            threeLayerStatus.className = 'text-amber-300 uppercase tracking-wider font-medium';
            threeLayerStatus.textContent = 'Daylight sDA';
          }
          if (cadTopTitle) {
            cadTopTitle.textContent = 'Level 04 Typical Floor Plate · sDA Heatmap (LM-83)';
          }
          setBuildingCutaway('daylight');
          daylightGroup.visible = true;
          shadingGroup.visible = false;
          nbcGroup.visible = false;
          statusPillContainer?.classList.add('opacity-0');
          daylightLegendEl?.classList.remove('opacity-0');
          daylightLegendEl?.classList.add('opacity-100');

          // Smoothly glide camera to frame the glowing 3D workplane & translucent floating roof cap
          const [px, py, pz, tx, ty, tz] = getIsoPresetForMode('daylight');
          flyCameraTo(px, py, pz, tx, ty, tz);

          updateDaylightGrid(currentWwr, currentGlazing, currentClimate);

          const c = climateData[currentClimate] || climateData.bengaluru;
          const g = glazingData[currentGlazing] || glazingData.lowe;
          const sda = Math.min(92, Math.round(24 + currentWwr * (0.65 + g.shgc * 0.45)));
          if (daylightSdaCallout) daylightSdaCallout.textContent = `sDA: ${sda}%`;
          if (vizShgcReadout) vizShgcReadout.innerHTML = `<span class="text-amber-300 font-medium">LM-83 · ${sda}% sDA</span>`;
        } else if (mode === 'shading') {
          if (btnModeShading) {
            btnModeShading.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-orange-500/40 bg-orange-500/20 text-orange-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
          }
          if (threeLayerDot) threeLayerDot.className = 'w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse';
          if (threeLayerStatus) {
            threeLayerStatus.className = 'text-orange-300 uppercase tracking-wider font-medium';
            threeLayerStatus.textContent = 'Shading Lab';
          }
          if (cadTopTitle) {
            cadTopTitle.textContent = 'Solar Radiation & Shading Vectors';
          }
          setBuildingCutaway('shading');
          daylightGroup.visible = false;
          shadingGroup.visible = true;
          nbcGroup.visible = false;
          daylightLegendEl?.classList.add('opacity-0');
          daylightLegendEl?.classList.remove('opacity-100');
          statusPillContainer?.classList.remove('opacity-0');

          const [px, py, pz, tx, ty, tz] = getIsoPresetForMode('shading');
          flyCameraTo(px, py, pz, tx, ty, tz);

          const shMetrics = updateShadingLab(currentWwr, currentGlazing, currentClimate);
          if (vizWwrCallout) vizWwrCallout.innerHTML = `<span class="text-orange-300 font-semibold">☀ Ingress: ${shMetrics.ingressDepthM}m</span>`;
          if (vizDniLabel) vizDniLabel.textContent = `${shMetrics.sunlitPct}% Floor`;
          if (vizShgcReadout) vizShgcReadout.innerHTML = `<span class="text-orange-300 font-medium">S: Overhang · E/W: Fins</span>`;
        } else if (mode === 'nbc') {
          if (btnModeNbc) {
            btnModeNbc.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-sky-500/40 bg-sky-500/20 text-sky-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
          }
          if (threeLayerDot) threeLayerDot.className = 'w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse';
          if (threeLayerStatus) {
            threeLayerStatus.className = 'text-sky-300 uppercase tracking-wider font-medium';
            threeLayerStatus.textContent = 'NBC 2026';
          }
          if (cadTopTitle) {
            cadTopTitle.textContent = 'NBC 2026 Statutory Compliance Model';
          }
          setBuildingCutaway('nbc');
          daylightGroup.visible = false;
          shadingGroup.visible = false;
          nbcGroup.visible = true;
          daylightLegendEl?.classList.add('opacity-0');
          daylightLegendEl?.classList.remove('opacity-100');
          statusPillContainer?.classList.remove('opacity-0');
          targetGlassOpacity = 0.68;

          // Smoothly glide camera to frame the 12-story tower, emerald setback apron, and +49.2m zoning ceiling
          const [px, py, pz, tx, ty, tz] = getIsoPresetForMode('nbc');
          flyCameraTo(px, py, pz, tx, ty, tz);

          if (vizWwrCallout) vizWwrCallout.innerHTML = '<span class="text-sky-400 font-semibold">Refuge L6</span>';
          if (vizDniLabel) vizDniLabel.textContent = '+20.5m · PASS';
          if (vizShgcReadout) vizShgcReadout.innerHTML = '<span class="text-emerald-400 font-medium">NBC Pt.4 Refuge · PASS</span>';
        } else {
          if (btnModeTwin) {
            btnModeTwin.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-emerald-500/40 bg-emerald-500/20 text-emerald-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
          }
          if (threeLayerDot) threeLayerDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse';
          if (threeLayerStatus) {
            threeLayerStatus.className = 'text-emerald-400 uppercase tracking-wider font-medium';
            threeLayerStatus.textContent = '3D Twin';
          }
          if (cadTopTitle) {
            cadTopTitle.textContent = '12-Story Commercial Model · Full Envelope';
          }
          setBuildingCutaway('twin');
          daylightGroup.visible = false;
          shadingGroup.visible = false;
          nbcGroup.visible = false;
          daylightLegendEl?.classList.add('opacity-0');
          daylightLegendEl?.classList.remove('opacity-100');
          statusPillContainer?.classList.remove('opacity-0');
          targetGlassOpacity = currentGlazing === 'single' ? 0.62 : currentGlazing === 'triple' ? 0.82 : 0.78;
          if (currentGlazing === 'single') {
            targetGlassColor.setHex(0x94a3b8);
            targetGlassEmissive.setHex(0x334155);
            targetGlassEmissiveIntensity = 0.16;
            targetGlassEdgeColor.setHex(0x94a3b8);
          } else if (currentGlazing === 'triple') {
            targetGlassColor.setHex(0x10b981);
            targetGlassEmissive.setHex(0x059669);
            targetGlassEmissiveIntensity = 0.36;
            targetGlassEdgeColor.setHex(0x34d399);
          } else {
            targetGlassColor.setHex(0x00c4df);
            targetGlassEmissive.setHex(0x0891b2);
            targetGlassEmissiveIntensity = 0.32;
            targetGlassEdgeColor.setHex(0x22d3ee);
          }

          const [px, py, pz, tx, ty, tz] = getIsoPresetForMode('twin');
          flyCameraTo(px, py, pz, tx, ty, tz);

          if (vizWwrCallout) vizWwrCallout.innerHTML = `<span class="text-emerald-400 font-semibold">WWR: ${currentWwr}%</span>`;
          const c = climateData[currentClimate];
          if (vizDniLabel && c) vizDniLabel.textContent = c.dni;
          const g = glazingData[currentGlazing];
          if (vizShgcReadout && g) vizShgcReadout.innerHTML = `<span class="text-emerald-400">SHGC ${g.shgc} · U ${g.uval} W/m²K</span>`;
        }
      }

      btnModeTwin?.addEventListener('click', () => setViewMode('twin', true));
      btnModeDaylight?.addEventListener('click', () => setViewMode('daylight', true));
      btnModeShading?.addEventListener('click', () => setViewMode('shading', true));
      btnModeNbc?.addEventListener('click', () => setViewMode('nbc', true));

      // Initialize the daylight grid and shading lab once at startup
      updateDaylightGrid(currentWwr, currentGlazing, currentClimate);
      updateShadingLab(currentWwr, currentGlazing, currentClimate);

      // Function to dynamically update 3D building from simulator controls
      updateThreeBuilding = (wwrPct: number, glazingKey: string, climateKey: string) => {
        // 1. Update Glass Bands & Mullions Height & Position
        const gHeight = Math.max(0.25, (wwrPct / 100) * clearHeight);
        glassMeshes.forEach((mesh, idx) => {
          mesh.scale.y = gHeight;
          const posY = idx * floorHeight + slabH + (clearHeight - gHeight) / 2 + gHeight / 2;
          mesh.position.y = posY;
          if (mullionGroups[idx]) {
            mullionGroups[idx].scale.y = gHeight;
            mullionGroups[idx].position.y = posY;
          }
        });

        // 2. Only recompute 3D Daylight Lux Grid or Shading Lab when their respective mode is active
        if (currentViewMode === 'daylight') {
          updateDaylightGrid(wwrPct, glazingKey, climateKey);
        } else if (currentViewMode === 'shading') {
          updateShadingLab(wwrPct, glazingKey, climateKey);
        }

        // 3. Update Glass Material Color & Opacity Targets (Smoothly tweened in animate loop)
        if (currentViewMode === 'daylight') {
          const c = climateData[climateKey] || climateData.bengaluru;
          const g = glazingData[glazingKey] || glazingData.lowe;
          const sda = Math.min(92, Math.round(24 + wwrPct * (0.65 + g.shgc * 0.45)));
          if (vizWwrCallout) vizWwrCallout.innerHTML = `<span class="text-amber-300 font-semibold">sDA: ${sda}%</span>`;
          if (vizDniLabel) vizDniLabel.textContent = '300 lx';
          if (vizShgcReadout) vizShgcReadout.innerHTML = `<span class="text-amber-300 font-medium">LM-83 Grid · ${sda}% ≥ 300 lx</span>`;
        } else if (currentViewMode === 'shading') {
          const shMetrics = updateShadingLab(wwrPct, glazingKey, climateKey);
          if (vizWwrCallout) vizWwrCallout.innerHTML = `<span class="text-orange-300 font-semibold">☀ ${shMetrics.ingressDepthM}m Ingress</span>`;
          if (vizDniLabel) vizDniLabel.textContent = `${shMetrics.sunlitPct}% Floor`;
          if (vizShgcReadout) vizShgcReadout.innerHTML = `<span class="text-orange-300 font-medium">S: Overhang · E/W: Fins</span>`;
        } else if (currentViewMode === 'nbc') {
          targetGlassOpacity = 0.68;
        } else {
          if (glazingKey === 'single') {
            targetGlassColor.setHex(0x94a3b8);
            targetGlassEmissive.setHex(0x334155);
            targetGlassEmissiveIntensity = 0.16;
            targetGlassOpacity = 0.62;
            targetGlassEdgeColor.setHex(0x94a3b8);
          } else if (glazingKey === 'triple') {
            targetGlassColor.setHex(0x10b981);
            targetGlassEmissive.setHex(0x059669);
            targetGlassEmissiveIntensity = 0.36;
            targetGlassOpacity = 0.82;
            targetGlassEdgeColor.setHex(0x34d399);
          } else {
            // lowe default (signature electric cyan)
            targetGlassColor.setHex(0x00c4df);
            targetGlassEmissive.setHex(0x0891b2);
            targetGlassEmissiveIntensity = 0.32;
            targetGlassOpacity = 0.78;
            targetGlassEdgeColor.setHex(0x22d3ee);
          }
        }

        // 4. Update Sun Angle & Intensity based on Climate
        const c = climateData[climateKey];
        if (c) {
          sunLight.intensity = c.solarFactor * 2.5;
          sunLight.position.set(c.sunPos[0] * 1.1, c.sunPos[1] * 1.1, c.sunPos[2] * 1.1);
          sunOrb.position.copy(sunLight.position);
        }
      };

      // Render Loop with Off-Screen Intersection Pause (120fps Page Scroll Optimization)
      let isHeroVisible = true;
      let lastFrameTime = performance.now();

      function animate() {
        if (!isHeroVisible) return;
        requestAnimationFrame(animate);
        const now = performance.now();
        const dt = Math.min(100, now - lastFrameTime);
        lastFrameTime = now;

        // 1. 3-Stage Layer Auto-Tour Progress & Mode Cycling
        if (autoTourActive && !autoTourHoverPaused) {
          autoTourElapsed += dt;
          const pct = Math.min(100, (autoTourElapsed / AUTO_TOUR_DURATION) * 100);
          const activeProg = progBars[currentViewMode];
          if (activeProg) activeProg.style.width = `${pct.toFixed(1)}%`;

          if (autoTourElapsed >= AUTO_TOUR_DURATION) {
            autoTourElapsed = 0;
            const nextIdx = (TOUR_SEQUENCE.indexOf(currentViewMode) + 1) % TOUR_SEQUENCE.length;
            setViewMode(TOUR_SEQUENCE[nextIdx], false);
          }
        }

        // 2. Smooth Lerp for Glass Material Properties (Zero flicker / visual flash on glazing switch)
        glassMat.color.lerp(targetGlassColor, 0.16);
        glassMat.emissive.lerp(targetGlassEmissive, 0.16);
        glassMat.emissiveIntensity += (targetGlassEmissiveIntensity - glassMat.emissiveIntensity) * 0.16;
        glassMat.opacity += (targetGlassOpacity - glassMat.opacity) * 0.16;
        glassEdgeMat.color.lerp(targetGlassEdgeColor, 0.16);

        // 3. Smooth Camera Flight Interpolation
        if (camAnimActive) {
          const elapsed = now - camAnimStart;
          const t = Math.min(1, elapsed / camAnimDuration);
          // easeOutCubic
          const ease = 1 - Math.pow(1 - t, 3);
          camera.position.lerpVectors(camFromPos, camToPos, ease);
          controls.target.lerpVectors(camFromTarget, camToTarget, ease);
          if (t >= 1) {
            camAnimActive = false;
          }
        }
        controls.update();
        renderer.render(scene, camera);
      }
      animate();

      const heroVisObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (!isHeroVisible) {
              isHeroVisible = true;
              lastFrameTime = performance.now();
              animate();
            }
          } else {
            isHeroVisible = false;
          }
        });
      }, { threshold: 0.01 });
      heroVisObserver.observe(container);

      // Resize Observer
      const ro = new ResizeObserver(() => {
        if (!container || !renderer || !camera) return;
        const w = container.clientWidth;
        const h = container.clientHeight;
        if (w === 0 || h === 0) return;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });
      ro.observe(container);

    } catch (err) {
      console.warn('Three.js initialization notice:', err);
    }
  }

  // ─── CHARRETTE SIMULATION STATE & CONTROLS ───
  function updateSimulation() {
    const c = climateData[currentClimate];
    const g = glazingData[currentGlazing];

    const envelopeGain = currentWwr * g.shgc * c.solarFactor * 1.15 + (currentWwr * g.uval * 0.14);
    const epi = (c.baseEpi + envelopeGain).toFixed(1);
    const coolingTr = Math.round(180 + envelopeGain * 3.6);
    const sda = Math.min(92, Math.round(24 + currentWwr * (0.65 + g.shgc * 0.45)));

    if (wwrVal) wwrVal.textContent = `${currentWwr}%`;
    if (outEpi) outEpi.textContent = epi;
    if (outCooling) outCooling.textContent = `${coolingTr}`;
    if (outSda) outSda.textContent = `${sda}%`;

    const chainCur: ChainValues = { glass: g.shgc, gain: envelopeGain, epi: parseFloat(epi), tr: coolingTr, sda };
    paintChain(chainCur, chainPrev);
    chainPrev = chainCur;

    if (vizClimateLabel) vizClimateLabel.textContent = c.label;
    if (vizDniLabel) vizDniLabel.textContent = c.dni;
    if (vizWwrCallout) vizWwrCallout.textContent = `WWR: ${currentWwr}%`;
    if (vizShgcReadout) {
      vizShgcReadout.innerHTML = `<span class="text-emerald-400">SHGC ${g.shgc} · U ${g.uval} W/m²K</span>`;
    }

    if (outBadge) {
      const epiNum = parseFloat(epi);
      if (currentWwr > 40 && g.shgc > 0.3) {
        outBadge.textContent = 'Elevated Solar Gain';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30';
      } else if (epiNum < c.baseEpi + 14) {
        outBadge.textContent = 'ECBC Super-Compliant';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
      } else if (epiNum < c.baseEpi + 24) {
        outBadge.textContent = 'Optimized Balance';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
      } else {
        outBadge.textContent = 'Baseline Envelope';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-sky-500/15 text-sky-300 border border-sky-500/30';
      }
    }

    function updateSliderTrack(val: number) {
      if (!wwrSlider) return;
      const pct = Math.max(0, Math.min(100, ((val - 20) / (70 - 20)) * 100));
      wwrSlider.style.background = `linear-gradient(to right, #10b981 0%, #10b981 ${pct}%, rgba(255, 255, 255, 0.12) ${pct}%, rgba(255, 255, 255, 0.12) 100%)`;
    }

    updateSliderTrack(currentWwr);

    // Sync live 3D building geometry, glass tint, and climate illumination
    if (updateThreeBuilding) {
      updateThreeBuilding(currentWwr, currentGlazing, currentClimate);
    }
  }

  function syncClimateUI(climateKey: string) {
    if (climateSelect) climateSelect.value = climateKey;
    climateChips.forEach((chip) => {
      const val = chip.getAttribute('data-climate');
      if (val === climateKey) {
        chip.className = 'climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-emerald-500/50 bg-emerald-500/20 text-emerald-300 font-medium transition-all text-center cursor-pointer truncate';
      } else {
        chip.className = 'climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate';
      }
    });
    if (climateDesc) {
      const c = climateData[climateKey];
      if (c) {
        const match = c.label.match(/\((.*?)\)/);
        climateDesc.textContent = match ? match[1] : '';
      }
    }
  }

  climateChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      pauseAutoTourExternal?.();
      currentClimate = chip.getAttribute('data-climate') || 'bengaluru';
      syncClimateUI(currentClimate);
      updateSimulation();
    });
  });

  climateSelect?.addEventListener('change', (e) => {
    pauseAutoTourExternal?.();
    currentClimate = (e.target as HTMLSelectElement).value;
    syncClimateUI(currentClimate);
    updateSimulation();
  });

  let animFrame: number | null = null;
  wwrSlider?.addEventListener('input', (e) => {
    pauseAutoTourExternal?.();
    const rawVal = parseFloat((e.target as HTMLInputElement).value);
    currentWwr = Math.round(rawVal);
    if (animFrame) cancelAnimationFrame(animFrame);
    animFrame = requestAnimationFrame(() => {
      updateSimulation();
    });
  });

  glazingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      pauseAutoTourExternal?.();
      currentGlazing = btn.getAttribute('data-glazing') || 'lowe';
      glazingBtns.forEach((b) => {
        b.className = 'glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white hover:border-white/25 transition-all text-center cursor-pointer';
      });
      btn.className = 'glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono font-semibold border border-emerald-400 bg-emerald-500/25 text-emerald-200 ring-1 ring-emerald-400/40 shadow-xs shadow-emerald-500/25 transition-all text-center cursor-pointer';
      updateSimulation();
    });
  });

  // Initial call to paint track gradient & initialize 3D building state
  updateSimulation();

  // ─── FULL-SCREEN MOBILE CAD STUDIO MODAL LOGIC ───
  const studioCard = document.getElementById('studio-cad-card');
  const btnOpenStudio = document.getElementById('btn-open-mobile-studio');
  const btnCloseStudio = document.getElementById('btn-close-mobile-studio');

  function openFullScreenStudio() {
    if (!studioCard) return;
    studioCard.classList.add('studio-fullscreen');
    document.body.style.overflow = 'hidden';
    const globalHeader = document.querySelector('header');
    if (globalHeader) globalHeader.style.display = 'none';
    if (orbitControls) {
      orbitControls.enableRotate = true;
      orbitControls.enableZoom = true;
    }
    if (canvas) canvas.style.touchAction = 'none';

    setTimeout(() => {
      if (container && renderer && camera) {
        const w = container.clientWidth;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }
    }, 60);
  }

  function closeFullScreenStudio() {
    if (!studioCard) return;
    studioCard.classList.remove('studio-fullscreen');
    document.body.style.overflow = '';
    const globalHeader = document.querySelector('header');
    if (globalHeader) globalHeader.style.display = '';
    const isCoarseTouch = typeof window !== 'undefined' && (window.matchMedia('(pointer: coarse)').matches || ('ontouchstart' in window));
    if (orbitControls) {
      orbitControls.enableRotate = !isCoarseTouch;
      orbitControls.enableZoom = false;
    }
    if (canvas) {
      canvas.style.touchAction = isCoarseTouch ? 'pan-y' : 'none';
    }

    setTimeout(() => {
      if (container && renderer && camera) {
        const w = container.clientWidth;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }
    }, 60);
  }

  btnOpenStudio?.addEventListener('click', openFullScreenStudio);
  btnCloseStudio?.addEventListener('click', closeFullScreenStudio);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && studioCard?.classList.contains('studio-fullscreen')) {
      closeFullScreenStudio();
    }
  });
</script>



