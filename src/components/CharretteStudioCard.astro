    <!-- Single-Line Causal Physics Trace Dock -->
    <div id="studio-bottom-dock" class="px-4 sm:px-6 py-2.5 bg-[#080B12] border-t border-white/[0.07] flex items-center justify-between gap-4 text-[11px] font-mono text-slate-400 overflow-x-auto scrollbar-none">
      <div id="charrette-chain" class="flex items-center gap-2 sm:gap-3 whitespace-nowrap">
        <span class="inline-flex items-center gap-1.5 text-emerald-400 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>PHYSICS TRACE</span>
        </span>
        <span class="text-slate-700">|</span>
        <span>SHGC <strong class="text-slate-200 font-normal" data-chain="glass">0.28</strong></span>
        <span class="text-slate-600">→</span>
        <span>Coil <strong class="text-slate-200 font-normal" data-chain="gain">18.2</strong> kWh/m²</span>
        <span class="text-slate-600">→</span>
        <span>Plant <strong class="text-slate-200 font-normal" data-chain="tr">246 TR</strong> <span class="text-emerald-400" data-chain-sub="tr">(-60 TR Saved)</span></span>
        <span class="text-slate-600">→</span>
        <span>CAPEX <strong class="text-emerald-400 font-medium" data-chain="capex">-₹7.8L</strong></span>
        <span class="text-slate-600">→</span>
        <span>Payback <strong class="text-white font-normal" data-chain="roi">Day 1</strong></span>
        <span class="hidden sm:inline text-slate-600">→</span>
        <span class="hidden sm:inline">Carbon <strong class="text-emerald-400 font-normal" data-chain="carbon">-119 t</strong></span>
      </div>
      <div id="viz-shgc-readout" class="hidden md:block text-slate-400 whitespace-nowrap shrink-0">
        <span class="text-emerald-400">SHGC 0.28 · U 1.6 W/m²K</span>
      </div>
    </div>

  </div>
</div>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const climateData: Record<string, { label: string; baseEpi: number; solarFactor: number; dni: string; sunPos: [number, number, number] }> = {
    bengaluru: { label: 'Bengaluru (Temperate)', baseEpi: 59.7, solarFactor: 0.72, dni: '760 W/m²', sunPos: [16, 22, 14] },
    mumbai:    { label: 'Mumbai (Warm-Humid)',   baseEpi: 88.4, solarFactor: 1.05, dni: '840 W/m²', sunPos: [18, 20, 16] },
    delhi:     { label: 'New Delhi (Composite)', baseEpi: 92.1, solarFactor: 1.12, dni: '890 W/m²', sunPos: [20, 18, 12] },
    ahmedabad: { label: 'Ahmedabad (Hot-Dry)',   baseEpi: 98.5, solarFactor: 1.25, dni: '960 W/m²', sunPos: [15, 24, 10] },
    shimla:    { label: 'Shimla (Cold)',         baseEpi: 54.2, solarFactor: 0.64, dni: '680 W/m²', sunPos: [14, 15, 18] },
  };

  const glazingData: Record<string, { shgc: number; uval: number }> = {
    single: { shgc: 0.58, uval: 2.8 },
    lowe:   { shgc: 0.28, uval: 1.6 },
    triple: { shgc: 0.22, uval: 1.1 },
  };

  let currentClimate = 'bengaluru';
  let currentWwr = 38;
  let currentGlazing = 'lowe';

  const climateSelect = document.getElementById('ctrl-climate') as HTMLSelectElement | null;
  const climateChips = document.querySelectorAll('.climate-chip');
  const climateDesc = document.getElementById('climate-quick-desc');
  const wwrSlider = document.getElementById('ctrl-wwr') as HTMLInputElement | null;
  const wwrVal = document.getElementById('val-wwr');
  const glazingBtns = document.querySelectorAll('.glazing-btn');

  // Real-App Clearinfra Studio Strategic Targets Card Bindings
  const outEpi = document.getElementById('out-epi');
  const realAfterPvEpi = document.getElementById('real-after-pv-epi');
  const realSolarOffset = document.getElementById('real-solar-offset');
  const realEpiBar = document.getElementById('real-epi-bar') as HTMLElement | null;

  const outCarbon = document.getElementById('out-carbon');
  const realEvOffset = document.getElementById('real-ev-offset');
  const realCarbonBar = document.getElementById('real-carbon-bar') as HTMLElement | null;

  const outCapex = document.getElementById('out-capex');
  const outCapexSub = document.getElementById('out-capex-sub');
  const outCapexBadge = document.getElementById('out-capex-badge');
  const realCapexBar = document.getElementById('real-capex-bar') as HTMLElement | null;

  const outPayback = document.getElementById('out-payback');
  const outPaybackUnit = document.getElementById('out-payback-unit');
  const outYield = document.getElementById('out-yield');
  const realRoiBar = document.getElementById('real-roi-bar') as HTMLElement | null;

  const outWellness = document.getElementById('out-wellness');
  const outSda = document.getElementById('out-sda');
  const realWellnessBar = document.getElementById('real-wellness-bar') as HTMLElement | null;

  const outCooling = document.getElementById('out-cooling');
  const outBadge = document.getElementById('out-badge');
  const sweetSpotBanner = document.getElementById('sweet-spot-banner');
  const btnAutoOptimize = document.getElementById('btn-auto-optimize');

  // ─── CHARRETTE CHAIN: glazing → coil gain → chiller TR → CAPEX → Payback → Carbon ───
  type ChainValues = { glass: number; gain: number; epi: number; tr: number; sda: number; capex: string; roi: string; carbon: string; trSaved: string };
  const chainValues: Record<string, Element | null> = {
    glass: document.querySelector('[data-chain="glass"]'),
    gain: document.querySelector('[data-chain="gain"]'),
    tr: document.querySelector('[data-chain="tr"]'),
    capex: document.querySelector('[data-chain="capex"]'),
    roi: document.querySelector('[data-chain="roi"]'),
    carbon: document.querySelector('[data-chain="carbon"]'),
  };
  const chainSubs: Record<string, Element | null> = {
    glass: document.querySelector('[data-chain-sub="glass"]'),
    gain: document.querySelector('[data-chain-sub="gain"]'),
    tr: document.querySelector('[data-chain-sub="tr"]'),
    capex: document.querySelector('[data-chain-sub="capex"]'),
    roi: document.querySelector('[data-chain-sub="roi"]'),
    carbon: document.querySelector('[data-chain-sub="carbon"]'),
  };
  let chainPrev: ChainValues | null = null;

  function paintChain(cur: ChainValues, prev: ChainValues | null) {
    const paint = (key: string, text: string, unit: string) => {
      const valueEl = chainValues[key];
      if (valueEl) valueEl.textContent = text;
      const subEl = chainSubs[key];
      if (subEl) subEl.textContent = unit;
    };
    paint('glass', cur.glass.toFixed(2), 'SHGC');
    paint('gain', cur.gain.toFixed(1), 'kWh/m²');
    paint('tr', `${cur.tr} TR`, cur.trSaved);
    paint('capex', cur.capex, 'Equipment Saved');
    paint('roi', cur.roi, cur.roi === 'Day 1' ? 'Immediate ROI' : 'Simple Payback');
    paint('carbon', cur.carbon, 'tCO₂e / yr');
  }

  const vizClimateLabel = document.getElementById('viz-climate-label');
  const vizDniLabel = document.getElementById('viz-dni-label');
  const vizWwrCallout = document.getElementById('viz-wwr-callout');
  const vizShgcReadout = document.getElementById('viz-shgc-readout');

  // ─── 3D THREE.JS DIGITAL TWIN (CLEARINFRA STUDIO RUNTIME) ───
  const container = document.getElementById('three-container') as HTMLDivElement | null;
  const canvas = document.getElementById('three-building-canvas') as HTMLCanvasElement | null;

  let updateThreeBuilding: ((wwr: number, glazing: string, climate: string) => void) | null = null;
  let pauseAutoTourExternal: (() => void) | null = null;
  let orbitControls: any = null;
  let resumeRenderLoop: (() => void) | null = null;

  if (container && canvas) {
    try {
      const scene = new THREE.Scene();

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
        preserveDrawingBuffer: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const camera = new THREE.PerspectiveCamera(34, container.clientWidth / Math.max(1, container.clientHeight), 0.1, 160);
      const defaultCamPos = new THREE.Vector3(28.0, 18.5, 28.0);
      const defaultTarget = new THREE.Vector3(0, 7.8, 0);
      camera.position.copy(defaultCamPos);

      const controls = new OrbitControls(camera, canvas);
      orbitControls = controls;
      controls.target.copy(defaultTarget);
      controls.enableDamping = true;
      controls.enableZoom = false;
      controls.dampingFactor = 0.06;
      controls.maxPolarAngle = Math.PI / 2 - 0.05;
      controls.minDistance = 12;
      controls.maxDistance = 60;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.45;

      // Prevent 3D canvas from trapping natural 1-finger vertical page scroll on touch devices in inline mode
      const isCoarseTouch = typeof window !== 'undefined' && (window.matchMedia('(pointer: coarse)').matches || ('ontouchstart' in window));
      if (isCoarseTouch) {
        controls.enableRotate = false;
        if (canvas) canvas.style.touchAction = 'pan-y';
      }

      // Smooth Camera Flight Animator (easeOutCubic)
      let camAnimActive = false;
      let camAnimStart = 0;
      const camAnimDuration = 420; // ms
      const camFromPos = new THREE.Vector3();
      const camToPos = new THREE.Vector3();
      const camFromTarget = new THREE.Vector3();
      const camToTarget = new THREE.Vector3();

      function flyCameraTo(px: number, py: number, pz: number, tx: number, ty: number, tz: number) {
        camFromPos.copy(camera.position);
        camToPos.set(px, py, pz);
        camFromTarget.copy(controls.target);
        camToTarget.set(tx, ty, tz);
        camAnimStart = performance.now();
        camAnimActive = true;
      }

      let idleTimer: any = null;
      controls.addEventListener('start', () => {
        camAnimActive = false;
        controls.autoRotate = false;
        pauseAutoTourExternal?.();
        clearTimeout(idleTimer);
      });
      controls.addEventListener('end', () => {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(() => {
          controls.autoRotate = true;
        }, 4000);
      });

      // Streamlined Camera Presets & Orbit Control HUD Handlers
      const btnCamIso = document.getElementById('btn-cam-iso');
      const btnCamTop = document.getElementById('btn-cam-top');
      const resetBtn = document.getElementById('btn-reset-cam');
      const camBtns = document.querySelectorAll('.cam-btn');

      function setCamActive(activeBtn: HTMLElement | null) {
        camBtns.forEach((b) => {
          b.className = 'cam-btn px-2 py-0.5 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium';
        });
        if (activeBtn) {
          activeBtn.className = 'cam-btn px-2 py-0.5 rounded border border-emerald-500/35 bg-emerald-500/20 text-emerald-300 transition-colors duration-200 cursor-pointer font-medium';
        }
      }

      function getIsoPresetForMode(mode: 'twin' | 'daylight' | 'shading' | 'nbc'): [number, number, number, number, number, number] {
        if (mode === 'daylight') return [15.5, 16.0, 15.5, 0, 0.2, 0];
        if (mode === 'shading') return [14.5, 12.5, 15.0, 0, 0.4, 0];
        if (mode === 'nbc') return [34.5, 22.5, 34.5, 0, 9.2, 0];
        return [28.0, 18.5, 28.0, 0, 7.8, 0];
      }

      btnCamIso?.addEventListener('click', () => {
        pauseAutoTourExternal?.();
        const [px, py, pz, tx, ty, tz] = getIsoPresetForMode(currentViewMode);
        flyCameraTo(px, py, pz, tx, ty, tz);
        setCamActive(btnCamIso);
      });
      btnCamTop?.addEventListener('click', () => {
        pauseAutoTourExternal?.();
        if (currentViewMode === 'daylight' || currentViewMode === 'shading') {
          flyCameraTo(0.01, 16.5, 0, 0, 0.3, 0);
        } else {
          flyCameraTo(0.01, 28.5, 0, 0, 0, 0);
        }
        setCamActive(btnCamTop);
      });
      resetBtn?.addEventListener('click', () => {
        pauseAutoTourExternal?.();
        const [px, py, pz, tx, ty, tz] = getIsoPresetForMode(currentViewMode);
        flyCameraTo(px, py, pz, tx, ty, tz);
        setCamActive(btnCamIso);
      });

      // Dark Site Plot Plane (Matching Studio 3,334m² Site)
      const sitePlane = new THREE.Mesh(
        new THREE.PlaneGeometry(28, 26),
        new THREE.MeshStandardMaterial({ color: 0x090d15, roughness: 0.95 })
      );
      sitePlane.rotation.x = -Math.PI / 2;
      sitePlane.position.y = -0.02;
      sitePlane.receiveShadow = true;
      scene.add(sitePlane);

      // Cyan Dashed Property Setback Perimeter (Matching Studio Twin)
      const setbackHalfW = 8.8;
      const setbackHalfD = 7.6;
      const setbackPoints = [
        new THREE.Vector3(-setbackHalfW, 0.02, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.02, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.02, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.02, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.02, -setbackHalfD),
      ];
      const setbackGeo = new THREE.BufferGeometry().setFromPoints(setbackPoints);
      const setbackMat = new THREE.LineDashedMaterial({
        color: 0x00e5ff,
        dashSize: 0.8,
        gapSize: 0.45,
        transparent: true,
        opacity: 0.75,
      });
      const setbackLine = new THREE.Line(setbackGeo, setbackMat);
      setbackLine.computeLineDistances();
      scene.add(setbackLine);

      // Subtle Grid Datum
      const gridHelper = new THREE.GridHelper(30, 16, 0x00c4df, 0x1e293b);
      gridHelper.position.y = -0.01;
      const gridMat = gridHelper.material as THREE.Material;
      gridMat.transparent = true;
      gridMat.opacity = 0.22;
      scene.add(gridHelper);

      // Studio Lighting
      const ambientLight = new THREE.AmbientLight(0x1e293b, 1.6);
      scene.add(ambientLight);

      const hemiLight = new THREE.HemisphereLight(0x00e5ff, 0x090d16, 0.75);
      scene.add(hemiLight);

      const sunLight = new THREE.DirectionalLight(0xfffbeb, 2.6);
      sunLight.position.set(18, 25, 16);
      sunLight.castShadow = true;
      sunLight.shadow.mapSize.width = 1024;
      sunLight.shadow.mapSize.height = 1024;
      sunLight.shadow.camera.near = 1;
      sunLight.shadow.camera.far = 70;
      sunLight.shadow.camera.left = -16;
      sunLight.shadow.camera.right = 16;
      sunLight.shadow.camera.top = 22;
      sunLight.shadow.camera.bottom = -10;
      sunLight.shadow.bias = -0.0005;
      scene.add(sunLight);

      // Sun Indicator Orb
      const sunOrb = new THREE.Mesh(
        new THREE.SphereGeometry(0.55, 16, 16),
        new THREE.MeshBasicMaterial({ color: 0xfbbf24 })
      );
      sunOrb.position.copy(sunLight.position);
      scene.add(sunOrb);

      // 12-Story Commercial Office Asset (Clearinfra Studio Digital Twin)
      const numFloors = 12;
      const floorHeight = 1.35;
      const slabH = 0.16;
      const towerW = 9.2;
      const towerD = 6.8;
      const clearHeight = floorHeight - slabH;

      const buildingGroup = new THREE.Group();
      scene.add(buildingGroup);

      // Materials
      const slabMat = new THREE.MeshStandardMaterial({
        color: 0x18202c,
        roughness: 0.6,
        metalness: 0.35,
      });
      const slabEdgeMat = new THREE.LineBasicMaterial({
        color: 0x00c4df,
        transparent: true,
        opacity: 0.35,
      });

      const coreMat = new THREE.MeshStandardMaterial({
        color: 0x0f1522,
        roughness: 0.9,
      });

      const columnMat = new THREE.MeshStandardMaterial({
        color: 0x27354a,
        roughness: 0.4,
        metalness: 0.5,
      });

      const spandrelMat = new THREE.MeshStandardMaterial({
        color: 0x141b26,
        roughness: 0.55,
        metalness: 0.3,
      });

      const mullionMat = new THREE.MeshStandardMaterial({
        color: 0x222c3d,
        roughness: 0.4,
        metalness: 0.55,
      });

      // Signature Electric Cyan Glazing Material
      const glassMat = new THREE.MeshPhysicalMaterial({
        color: new THREE.Color(0x00c4df),
        emissive: new THREE.Color(0x0891b2),
        emissiveIntensity: 0.32,
        roughness: 0.05,
        metalness: 0.1,
        transmission: 0.6,
        transparent: true,
        opacity: 0.78,
        depthWrite: false,
        side: THREE.FrontSide,
      });

      const glassEdgeMat = new THREE.LineBasicMaterial({
        color: 0x22d3ee,
        transparent: true,
        opacity: 0.45,
      });

      // Target material states for smooth, organic transitions (zero visual flash/strobe)
      const targetGlassColor = new THREE.Color(0x00c4df);
      const targetGlassEmissive = new THREE.Color(0x0891b2);
      let targetGlassEmissiveIntensity = 0.32;
      let targetGlassOpacity = 0.78;
      const targetGlassEdgeColor = new THREE.Color(0x22d3ee);

      // Central Structural Core
      const coreMesh = new THREE.Mesh(
        new THREE.BoxGeometry(3.6, numFloors * floorHeight, 2.8),
        coreMat
      );
      coreMesh.position.set(0, (numFloors * floorHeight) / 2, 0);
      coreMesh.castShadow = true;
      buildingGroup.add(coreMesh);

      // Arrays for dynamic update & mode cutaway
      const glassMeshes: THREE.Mesh[] = [];
      const mullionGroups: THREE.Group[] = [];
      const slabMeshes: THREE.Mesh[] = [];
