---
// Self-contained Clearinfra Studio Interactive CAD Card (Cinema-Wide Edition)
---

<div id="interactive-demo" class="w-full">
  <div id="studio-cad-card" class="rounded-2xl border border-white/[0.1] bg-[#0B0F17] text-slate-100 shadow-2xl shadow-black/60 overflow-hidden transition-all duration-300">
    
    <!-- Top Window Bar -->
    <div class="cad-card-topbar flex items-center justify-between gap-3 px-4 sm:px-6 py-2.5 bg-[#0E1420] border-b border-white/[0.07] text-xs font-mono">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="hidden sm:flex items-center gap-1.5 shrink-0">
          <span class="w-2.5 h-2.5 rounded-full bg-slate-700/90"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-slate-700/90"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-slate-700/90"></span>
        </div>
        <span class="text-white font-semibold whitespace-nowrap text-xs tracking-wider">CLEARINFRA STUDIO</span>
        <span class="hidden sm:inline-block text-slate-600">·</span>
        <span id="cad-top-title" class="hidden sm:inline-block text-slate-400 truncate">12-Story Commercial Digital Twin</span>
      </div>
      <div class="flex items-center gap-2 text-slate-400 shrink-0 text-[11px]">
        <span id="viz-climate-label" class="hidden">Bengaluru</span>
        <span id="three-layer-dot" class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="three-layer-status" class="hidden sm:inline-block text-emerald-400 uppercase tracking-wider font-medium">3D Twin</span>
        <span class="hidden md:inline text-slate-700">|</span>
        <span class="hidden md:inline text-slate-400">ISO 52016-1 · NBC 2026</span>
        
        <!-- Launch Button for Inline View -->
        <button
          type="button"
          id="btn-launch-studio-topbar"
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 hover:text-white border border-emerald-400/40 text-[10.5px] sm:text-[11px] font-mono font-medium transition-all shadow-sm shadow-emerald-500/20 cursor-pointer ml-1 active:scale-[0.98]"
          title="Open Full-Screen Interactive CAD Studio"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Open Studio</span>
          <span class="text-emerald-400 text-[10px]">↗</span>
        </button>

        <!-- Close button for Mobile Full-Screen Mode -->
        <button
          type="button"
          id="btn-close-mobile-studio"
          class="hidden items-center gap-1.5 px-2.5 py-1 rounded-lg text-slate-200 hover:text-white hover:bg-red-500/20 border border-white/20 bg-white/10 transition-all cursor-pointer ml-2 text-xs font-mono"
          aria-label="Close Clearinfra Studio Preview"
        >
          <span class="hidden sm:inline text-[11px] font-mono">Close [Esc]</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Main Cinema Grid: 7 Cols 3D Stage | 5 Cols Controls & Scoreboard -->
    <div class="grid grid-cols-1 lg:grid-cols-12">
      
      <!-- Left 7 Cols: Pure Uninterrupted 3D Twin Stage -->
      <div id="studio-stage-column" class="lg:col-span-7 flex flex-col bg-blueprint-sub border-b lg:border-b-0 lg:border-r border-white/[0.07] relative min-h-[340px] sm:min-h-[400px] lg:min-h-[520px] overflow-hidden">
        
        <div id="three-container" class="relative w-full flex-1 min-h-[340px] sm:min-h-[400px] lg:min-h-[520px] overflow-hidden bg-[#090D15]/70">
          <canvas id="three-building-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>

          <!-- Floating Top-Left: 4-Mode Layer Switcher Pill -->
          <div id="cad-viewport-toolbar" class="absolute top-3.5 left-3.5 z-10 flex items-center select-none font-mono">
            <div class="flex items-center gap-0.5 sm:gap-1 bg-[#111826]/90 backdrop-blur-md p-1 rounded-lg border border-white/12 text-[9px] sm:text-[10px] shadow-lg">
              <button id="btn-mode-twin" type="button" title="01 Architectural 3D Twin" class="mode-btn relative overflow-hidden px-2 py-1 rounded border border-emerald-500/40 bg-emerald-500/20 text-emerald-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                <span>Twin</span>
                <span id="prog-mode-twin" class="pointer-events-none absolute bottom-0 left-0 h-[1.5px] bg-emerald-400/90" style="width: 0%;"></span>
              </button>
              <button id="btn-mode-daylight" type="button" title="02 Daylight sDA Lux Heatmap (LM-83)" class="mode-btn relative overflow-hidden px-2 py-1 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
                <span>Daylight</span>
                <span id="prog-mode-daylight" class="pointer-events-none absolute bottom-0 left-0 h-[1.5px] bg-amber-400/90" style="width: 0%;"></span>
              </button>
              <button id="btn-mode-shading" type="button" title="03 Facade Shading Lab" class="mode-btn relative overflow-hidden px-2 py-1 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-400 shrink-0"></span>
                <span>Shading</span>
                <span id="prog-mode-shading" class="pointer-events-none absolute bottom-0 left-0 h-[1.5px] bg-orange-400/90" style="width: 0%;"></span>
              </button>
              <button id="btn-mode-nbc" type="button" title="04 NBC 2026 Statutory Setbacks & Refuge" class="mode-btn relative overflow-hidden px-2 py-1 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shrink-0"></span>
                <span>NBC</span>
                <span id="prog-mode-nbc" class="pointer-events-none absolute bottom-0 left-0 h-[1.5px] bg-sky-400/90" style="width: 0%;"></span>
              </button>
              <button id="btn-mode-autoplay" type="button" title="Pause / Resume Auto-Tour" aria-label="Pause or resume layer auto-tour" class="ml-0.5 px-1.5 py-1 rounded-r border-l border-white/10 text-emerald-400 hover:text-white transition-colors duration-200 cursor-pointer flex items-center justify-center">
                <span id="autoplay-icon" class="text-[9px] leading-none">⏸</span>
              </button>
            </div>
          </div>

          <!-- Floating Top-Right (Desktop) / Bottom-Right (Mobile): 3D / Plan Camera Pill -->
          <div class="absolute bottom-3.5 sm:bottom-auto sm:top-3.5 right-3.5 flex items-center gap-0.5 bg-[#111826]/90 backdrop-blur-md p-1 rounded-lg border border-white/12 text-[9px] sm:text-[10px] font-mono shadow-lg select-none z-10">
            <button id="btn-cam-iso" type="button" title="3D Isometric View" class="cam-btn px-2 py-1 rounded border border-emerald-500/35 bg-emerald-500/20 text-emerald-300 transition-colors duration-200 cursor-pointer font-medium">3D</button>
            <button id="btn-cam-top" type="button" title="Top-down Floor Plan View" class="cam-btn px-2 py-1 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium">Plan</button>
            <button id="btn-reset-cam" type="button" title="Reset Camera Orbit" class="px-1.5 py-1 rounded text-slate-400 hover:text-white hover:bg-white/[0.06] border-l border-white/10 transition-colors duration-200 cursor-pointer" aria-label="Reset Camera Orbit">↺</button>
          </div>

          <!-- Overlay Bottom-Left: Daylight Lux Scale Bar (Visible in Daylight Mode) -->
          <div id="daylight-lux-legend" class="opacity-0 pointer-events-none transition-opacity duration-300 absolute bottom-3.5 left-3.5 flex items-center gap-2 px-2.5 py-1 rounded-lg bg-[#111826]/90 border border-white/12 text-[9.5px] font-mono text-slate-300 backdrop-blur-md shadow-lg z-10">
            <span class="text-amber-300 font-semibold" id="daylight-sda-callout">sDA: 55%</span>
            <span class="text-slate-600">|</span>
            <span class="text-slate-400">0 lx</span>
            <div class="w-16 h-1.5 rounded-xs border border-white/20" style="background: linear-gradient(90deg, #060914 0%, #1e3a8a 18%, #16a34a 38%, #84cc16 56%, #eab308 74%, #ea580c 88%, #dc2626 100%);"></div>
            <span class="text-red-400 font-semibold">2k+ lx</span>
          </div>

          <!-- Overlay Bottom-Left: Real-time Status Pill -->
          <div id="status-pill-container" class="absolute bottom-3.5 left-3.5 pointer-events-none flex items-center gap-1.5 text-[10px] font-mono text-slate-400 bg-[#111826]/90 px-2.5 py-1 rounded-lg border border-white/12 backdrop-blur-md transition-opacity duration-200">
            <span id="viz-wwr-callout" class="text-emerald-400 font-semibold">WWR: 40%</span>
            <span class="text-slate-600">·</span>
            <span id="viz-dni-label" class="text-amber-300">760 W/m²</span>
          </div>

          <!-- Floating Bottom-Right (Inline View): Launch Studio Trigger Badge -->
          <button
            type="button"
            id="btn-launch-studio-overlay"
            class="group absolute bottom-3.5 right-3.5 z-10 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#0B111E]/90 hover:bg-emerald-950/80 border border-white/15 hover:border-emerald-400/50 backdrop-blur-md shadow-xl text-[11px] font-mono text-slate-200 transition-all cursor-pointer active:scale-[0.98]"
            title="Click to launch interactive CAD Studio"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Click Building to <strong class="text-emerald-400 font-semibold group-hover:underline decoration-emerald-500/50">Open Studio &amp; Tune Parameters</strong></span>
            <span class="text-emerald-400 text-xs">↗</span>
          </button>
        </div>
      </div>

      <!-- Right 5 Cols: Breathable Controls & 2x2 Hairline Scoreboard -->
      <div id="studio-controls-column" class="lg:col-span-5 p-5 sm:p-6 lg:p-7 flex flex-col justify-between gap-6 bg-[#0E1420]">
        
        <!-- Top Section: Parametric Controls -->
        <div id="charrette-params-container" class="order-2 lg:order-1 flex flex-col gap-4 hidden lg:flex">
          
          <!-- Header + Compact Auto-Optimize Action -->
          <div class="flex items-center justify-between gap-2 pb-3 border-b border-white/[0.07]">
            <span class="text-[11px] font-mono uppercase tracking-widest text-slate-400 font-medium">Envelope &amp; Climate</span>
            <button
              type="button"
              id="btn-auto-optimize"
              class="px-3 py-1.5 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-400/40 text-emerald-300 hover:text-white font-mono text-[11px] font-medium flex items-center gap-1.5 transition-all duration-200 active:scale-[0.98] cursor-pointer"
              title="Run AI Pareto sweep to find lowest CAPEX sweet spot"
            >
              <span>⚡</span>
              <span>Auto-Optimize</span>
            </button>
          </div>

          <!-- 1. Climate Zone -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="ctrl-climate" class="text-xs text-slate-300 font-medium">Climate Zone (ECBC)</label>
              <span id="climate-quick-desc" class="text-[10px] font-mono text-emerald-400 lg:hidden">Temperate</span>
            </div>
            <!-- Mobile Chips -->
            <div class="grid grid-cols-5 gap-1 lg:hidden" id="ctrl-climate-chips">
              <button type="button" data-climate="bengaluru" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-emerald-500/50 bg-emerald-500/20 text-emerald-300 font-medium transition-all text-center cursor-pointer truncate">Bengaluru</button>
              <button type="button" data-climate="mumbai" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#161F30] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate">Mumbai</button>
              <button type="button" data-climate="delhi" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#161F30] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate">Delhi</button>
              <button type="button" data-climate="ahmedabad" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#161F30] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate">Ahmedabad</button>
              <button type="button" data-climate="shimla" class="climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#161F30] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate">Shimla</button>
            </div>
            <!-- Desktop Select -->
            <select
              id="ctrl-climate"
              class="hidden lg:block w-full rounded-lg bg-[#151D2B] border border-white/12 px-3 py-2 text-xs text-white font-mono focus:outline-none focus:border-emerald-500 transition-colors cursor-pointer"
            >
              <option value="bengaluru" selected>Bengaluru — Temperate</option>
              <option value="mumbai">Mumbai — Warm-Humid</option>
              <option value="delhi">New Delhi — Composite</option>
              <option value="ahmedabad">Ahmedabad — Hot-Dry</option>
              <option value="shimla">Shimla — Cold</option>
            </select>
          </div>

          <!-- 2. WWR Slider -->
          <div>
            <div class="flex items-center justify-between text-xs mb-1.5">
              <label for="ctrl-wwr" class="text-slate-300 font-medium">Window-to-Wall Ratio (WWR)</label>
              <span id="val-wwr" class="font-mono font-semibold text-emerald-400">40%</span>
            </div>
            <input
              id="ctrl-wwr"
              type="range"
              min="20"
              max="70"
              step="1"
              value="40"
              class="ci-slider"
            />
            <div class="flex justify-between text-[10px] font-mono text-slate-500 mt-1">
              <span>20%</span>
              <span>40% ECBC</span>
              <span>70%</span>
            </div>
          </div>

          <!-- 3. Glazing Spec -->
          <div>
            <span class="block text-xs text-slate-300 mb-1.5 font-medium">Glazing System (SHGC)</span>
            <div class="grid grid-cols-3 gap-2" id="ctrl-glazing-group">
              <button
                type="button"
                data-glazing="single"
                class="glazing-btn px-2.5 py-2 rounded-lg text-[11px] font-mono border border-white/10 bg-[#151D2B] text-slate-400 hover:text-white hover:border-white/25 transition-all text-center cursor-pointer"
              >
                Clear DGU <span class="block text-[10px] opacity-70 mt-0.5">0.58</span>
              </button>
              <button
                type="button"
                data-glazing="lowe"
                class="glazing-btn px-2.5 py-2 rounded-lg text-[11px] font-mono font-semibold border border-emerald-400/60 bg-emerald-500/20 text-emerald-200 transition-all text-center cursor-pointer"
              >
                Low-E DGU <span class="block text-[10px] text-emerald-300 mt-0.5">0.28</span>
              </button>
              <button
                type="button"
                data-glazing="triple"
                class="glazing-btn px-2.5 py-2 rounded-lg text-[11px] font-mono border border-white/10 bg-[#151D2B] text-slate-400 hover:text-white hover:border-white/25 transition-all text-center cursor-pointer"
              >
                Selective <span class="block text-[10px] opacity-70 mt-0.5">0.22</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Bottom Section: Real-App Clearinfra Studio Strategic Targets KPI Deck -->
        <div id="charrette-kpi-container" class="order-1 lg:order-2 flex flex-col gap-2">
          <div class="flex items-center justify-between pb-0.5">
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500/80 shrink-0"></span>
              <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-widest text-slate-300 font-bold">Strategic Targets</span>
              <span class="px-1.5 py-0.2 rounded bg-white/[0.06] border border-white/10 text-[8.5px] font-mono text-slate-400">ESTIMATE</span>
            </div>
            <span id="out-badge" class="text-[10px] sm:text-[11px] font-mono text-emerald-400 font-medium">Optimized Balance</span>
          </div>

          <!-- Sweet Spot Alert Banner (Appears on Auto-Optimize) -->
          <div id="sweet-spot-banner" class="hidden px-3 py-2 rounded-lg bg-emerald-500/15 border border-emerald-400/40 text-[11px] font-mono text-emerald-200 flex items-center justify-between gap-2">
            <span class="truncate">⚡ <strong>Sweet Spot:</strong> Chiller -60 TR cuts ₹27.0L CAPEX</span>
            <span class="text-[10px] text-emerald-300 font-semibold shrink-0">Optimal</span>
          </div>

          <!-- 2x3 Real Studio Metric Grid: 1 Hero Full-Width Card (EPI) + 4 Compact Cards (2x2) -->
          <div id="real-kpi-deck" class="grid grid-cols-2 gap-2">

            <!-- ROW 1 (Hero Col-Span 2): Energy Performance Index (EPI) -->
            <div class="col-span-2 bg-[#0C1322] border border-white/[0.09] hover:border-white/20 rounded-xl p-2.5 sm:p-3 relative overflow-hidden flex flex-col justify-between transition-all group/card">
              <div class="flex items-center justify-between gap-1.5 mb-1.5">
                <div class="flex items-center gap-1.5 min-w-0">
                  <div class="w-5 h-5 rounded-md bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center text-xs shrink-0">
                    <svg class="w-3 h-3 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <span class="text-[10px] sm:text-[10.5px] font-bold uppercase tracking-wider text-slate-300">EPI</span>
                </div>
                <span class="text-[8.5px] font-mono text-slate-400 uppercase tracking-tight">Physics Engine</span>
              </div>

              <!-- EpiPairView Split Columns: Statutory vs After-PV -->
              <div class="grid grid-cols-2 gap-2 pt-0.5">
                <!-- Statutory Column -->
                <div class="flex flex-col min-w-0">
                  <div class="flex items-baseline gap-1">
                    <span id="out-epi" class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-white">59.7</span>
                    <span class="text-[9px] font-bold uppercase tracking-tight text-slate-400">kWh/m²</span>
                  </div>
                  <span class="text-[8.5px] font-semibold uppercase tracking-wider text-slate-400 truncate">Statutory (Code)</span>
                </div>

                <!-- After-PV Column -->
                <div class="flex flex-col min-w-0 border-l border-white/10 pl-2 sm:pl-2.5">
                  <div class="flex items-baseline gap-1">
                    <span id="real-after-pv-epi" class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-emerald-400">41.7</span>
                    <span class="text-[9px] font-bold uppercase tracking-tight text-slate-400">kWh/m²</span>
                  </div>
                  <span class="text-[8.5px] font-semibold uppercase tracking-wider text-slate-400 truncate">After On-Site PV</span>
                </div>
              </div>

              <!-- Renewable Contribution Pill / Bridge -->
              <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/[0.04] border border-white/10 text-[9px] sm:text-[9.5px] font-medium text-slate-400 w-fit mt-1.5">
                <span class="text-amber-400">☀</span>
                <span>Solar offset:</span>
                <span id="real-solar-offset" class="font-bold font-mono text-slate-200">18.0</span>
                <span>kWh/m²</span>
              </div>

              <!-- Performance Visualizer Bar -->
              <div class="metric-bar relative h-1 bg-slate-800 rounded-full overflow-hidden mt-2">
                <div id="real-epi-bar" class="absolute inset-0 bg-emerald-400 transition-all duration-500 rounded-full" style="width: 72%"></div>
              </div>
            </div>

            <!-- ROW 2, COL 1: Carbon Intensity -->
            <div class="bg-[#0C1322] border border-white/[0.09] hover:border-white/20 rounded-xl p-2.5 sm:p-3 relative overflow-hidden flex flex-col justify-between transition-all group/card">
              <div class="flex items-center justify-between gap-1.5 mb-1.5">
                <div class="flex items-center gap-1.5 min-w-0">
                  <div class="w-5 h-5 rounded-md bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xs shrink-0">
                    <svg class="w-3 h-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                  </div>
                  <span class="text-[10px] sm:text-[10.5px] font-bold uppercase tracking-wider text-slate-300">Carbon</span>
                </div>
              </div>

              <div>
                <div class="flex items-baseline gap-1">
                  <span id="out-carbon" class="text-lg sm:text-xl font-bold font-mono tracking-tight text-white">57.5</span>
                  <span class="text-[8.5px] font-bold uppercase tracking-tight text-slate-400">kgCO₂e/m²/yr</span>
                </div>
                <div class="mt-1">
                  <div class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-white/[0.04] border border-white/10 text-[8.5px] font-medium text-slate-400">
                    <span>🚗</span>
                    <span>EV offset:</span>
                    <span id="real-ev-offset" class="font-bold font-mono text-slate-200">-2.6</span>
                    <span>kg/m²/yr</span>
                  </div>
                </div>
              </div>

              <!-- Performance Visualizer Bar -->
              <div class="metric-bar relative h-1 bg-slate-800 rounded-full overflow-hidden mt-2">
                <div id="real-carbon-bar" class="absolute inset-0 bg-emerald-400 transition-all duration-500 rounded-full" style="width: 65%"></div>
              </div>
            </div>

            <!-- ROW 2, COL 2: CAPEX (₹/sqft) -->
            <div class="bg-[#0C1322] border border-white/[0.09] hover:border-white/20 rounded-xl p-2.5 sm:p-3 relative overflow-hidden flex flex-col justify-between transition-all group/card">
              <div class="flex items-center justify-between gap-1.5 mb-1.5">
                <div class="flex items-center gap-1.5 min-w-0">
                  <div class="w-5 h-5 rounded-md bg-sky-500/15 border border-sky-500/30 text-sky-400 flex items-center justify-center text-xs shrink-0">
                    <svg class="w-3 h-3 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
