      const eastSunWedges: THREE.Mesh[] = [];

      const sunPatchMat = new THREE.MeshBasicMaterial({
        color: 0xfbbf24,
        transparent: true,
        opacity: 0.46,
        depthWrite: false,
        side: THREE.DoubleSide,
      });
      const sunPatchEdgeMat = new THREE.LineBasicMaterial({ color: 0xf59e0b, transparent: true, opacity: 0.92 });
      const sunWedgeMat = new THREE.MeshBasicMaterial({
        color: 0xf59e0b,
        transparent: true,
        opacity: 0.22,
        depthWrite: false,
        side: THREE.DoubleSide,
      });

      const numSouthBays = 8;
      const southSpanW = towerW - 1.0;
      const southBayStep = southSpanW / numSouthBays;
      const southBayW = southBayStep * 0.78;
      const bayWinH = clearHeight * 0.72;
      const bayCenterY = slabH + clearHeight * 0.52;
      const lintelY = slabH + clearHeight * 0.88;

      for (let i = 0; i < numSouthBays; i++) {
        const bx = -southSpanW / 2 + (i + 0.5) * southBayStep;

        // South (+Z) dark window bay
        const sBayGeo = new THREE.BoxGeometry(southBayW, bayWinH, 0.05);
        const sBay = new THREE.Mesh(sBayGeo, windowBayMat);
        sBay.position.set(bx, bayCenterY, towerD / 2 + 0.01);
        shadingGroup.add(sBay);
        sBay.add(new THREE.LineSegments(new THREE.EdgesGeometry(sBayGeo), windowBayEdgeMat));

        // North (-Z) dark window bay
        const nBay = new THREE.Mesh(sBayGeo, windowBayMat);
        nBay.position.set(bx, bayCenterY, -towerD / 2 - 0.01);
        shadingGroup.add(nBay);
        nBay.add(new THREE.LineSegments(new THREE.EdgesGeometry(sBayGeo), windowBayEdgeMat));

        // South (+Z) Terracotta Horizontal Overhang Canopy (projects outward along +Z)
        const ovhGeo = new THREE.BoxGeometry(southBayW + 0.08, 0.07, 0.65);
        const ovhMesh = new THREE.Mesh(ovhGeo, shadeFinMat);
        ovhMesh.position.set(bx, lintelY, towerD / 2 + 0.34);
        ovhMesh.rotation.x = 0.08; // slight downward solar tilt
        shadingGroup.add(ovhMesh);
        ovhMesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(ovhGeo), shadeFinEdgeMat));
        southOverhangMeshes.push(ovhMesh);

        // Secondary Mid-Transom Horizontal Louver on South Bay
        const midOvhGeo = new THREE.BoxGeometry(southBayW + 0.04, 0.045, 0.38);
        const midOvh = new THREE.Mesh(midOvhGeo, shadeFinMat);
        midOvh.position.set(bx, slabH + clearHeight * 0.58, towerD / 2 + 0.20);
        shadingGroup.add(midOvh);
        midOvh.add(new THREE.LineSegments(new THREE.EdgesGeometry(midOvhGeo), shadeFinEdgeMat));

        // South Floor Sunlit Patch (inside perimeter along +Z wall)
        const sPatchGeo = new THREE.PlaneGeometry(southBayW * 0.92, 1.0);
        const sPatch = new THREE.Mesh(sPatchGeo, sunPatchMat);
        sPatch.rotation.x = -Math.PI / 2;
        sPatch.position.set(bx, shFloorY + 0.04, towerD / 2 - 0.55);
        shadingGroup.add(sPatch);
        sPatch.add(new THREE.LineSegments(new THREE.EdgesGeometry(sPatchGeo), sunPatchEdgeMat));
        southSunPatches.push(sPatch);

        // South 3D Translucent Solar Ray Wedge (slanting from window sill/lintel onto floor patch)
        const sWedgeGeo = new THREE.BoxGeometry(southBayW * 0.88, bayWinH * 0.65, 1.0);
        const sWedge = new THREE.Mesh(sWedgeGeo, sunWedgeMat);
        sWedge.position.set(bx, shFloorY + 0.38, towerD / 2 - 0.52);
        sWedge.rotation.x = -0.42;
        shadingGroup.add(sWedge);
        southSunWedges.push(sWedge);
      }

      // East (+X) & West (-X) Window Bays + Full-Height Angled Vertical Brise-Soleil Fins
      const numSideBays = 6;
      const sideSpanD = towerD - 1.0;
      const sideBayStep = sideSpanD / numSideBays;
      const sideBayD = sideBayStep * 0.76;
      const finH = clearHeight * 0.86;

      for (let j = 0; j < numSideBays; j++) {
        const bz = -sideSpanD / 2 + (j + 0.5) * sideBayStep;

        // East (+X) & West (-X) dark window bays
        const eBayGeo = new THREE.BoxGeometry(0.05, bayWinH, sideBayD);
        const eBay = new THREE.Mesh(eBayGeo, windowBayMat);
        eBay.position.set(towerW / 2 + 0.01, bayCenterY, bz);
        shadingGroup.add(eBay);
        eBay.add(new THREE.LineSegments(new THREE.EdgesGeometry(eBayGeo), windowBayEdgeMat));

        const wBay = new THREE.Mesh(eBayGeo, windowBayMat);
        wBay.position.set(-towerW / 2 - 0.01, bayCenterY, bz);
        shadingGroup.add(wBay);
        wBay.add(new THREE.LineSegments(new THREE.EdgesGeometry(eBayGeo), windowBayEdgeMat));

        // 2 Vertical Fins per Side Bay on East (+X) and West (-X)
        [-sideBayD * 0.32, sideBayD * 0.32].forEach((zOff) => {
          const finGeo = new THREE.BoxGeometry(0.58, finH, 0.065);

          // East (+X) Vertical Fin (angled to block morning/low-angle sun)
          const eFin = new THREE.Mesh(finGeo, shadeFinMat);
          eFin.position.set(towerW / 2 + 0.30, bayCenterY, bz + zOff);
          eFin.rotation.y = 0.28;
          shadingGroup.add(eFin);
          eFin.add(new THREE.LineSegments(new THREE.EdgesGeometry(finGeo), shadeFinEdgeMat));
          eastWestFinMeshes.push(eFin);

          // West (-X) Vertical Fin (angled to block harsh afternoon West sun)
          const wFin = new THREE.Mesh(finGeo, shadeFinMat);
          wFin.position.set(-towerW / 2 - 0.30, bayCenterY, bz + zOff);
          wFin.rotation.y = -0.28;
          shadingGroup.add(wFin);
          wFin.add(new THREE.LineSegments(new THREE.EdgesGeometry(finGeo), shadeFinEdgeMat));
          eastWestFinMeshes.push(wFin);
        });

        // East (+X) Floor Sunlit Ingress Patch & 3D Solar Ray Wedge (Matches Studio 1.9m East Ingress)
        const ePatchGeo = new THREE.PlaneGeometry(1.0, sideBayD * 0.88);
        const ePatch = new THREE.Mesh(ePatchGeo, sunPatchMat);
        ePatch.rotation.x = -Math.PI / 2;
        ePatch.position.set(towerW / 2 - 0.85, shFloorY + 0.045, bz);
        shadingGroup.add(ePatch);
        ePatch.add(new THREE.LineSegments(new THREE.EdgesGeometry(ePatchGeo), sunPatchEdgeMat));
        eastSunPatches.push(ePatch);

        const eWedgeGeo = new THREE.BoxGeometry(1.0, bayWinH * 0.68, sideBayD * 0.84);
        const eWedge = new THREE.Mesh(eWedgeGeo, sunWedgeMat);
        eWedge.position.set(towerW / 2 - 0.80, shFloorY + 0.40, bz);
        eWedge.rotation.z = 0.46;
        shadingGroup.add(eWedge);
        eastSunWedges.push(eWedge);
      }

      // Golden Solar Path Trajectory Arc Overhead (Matches Studio solar path arc in twin_shading_lab.png)
      const solarArcPts: THREE.Vector3[] = [];
      for (let s = 0; s <= 32; s++) {
        const t = s / 32;
        const ang = (t - 0.5) * Math.PI * 0.88; // East (+X) through South (+Z) to West (-X)
        const sx = Math.sin(-ang) * (towerW * 0.68);
        const sz = Math.cos(ang) * (towerD * 0.48) + 1.8;
        const sy = 1.6 + Math.cos(ang * 0.95) * 4.2;
        solarArcPts.push(new THREE.Vector3(sx, sy, sz));
      }
      const solarArcLine = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(solarArcPts),
        new THREE.LineBasicMaterial({ color: 0xfbbf24, transparent: true, opacity: 0.78 })
      );
      shadingGroup.add(solarArcLine);

      // Glowing Sun Position Marker on the Solar Path Arc (10:30 AM Design Sun)
      const arcSunIdx = 11;
      const arcSunPos = solarArcPts[arcSunIdx];
      const shSunMarker = new THREE.Mesh(
        new THREE.SphereGeometry(0.28, 16, 16),
        new THREE.MeshBasicMaterial({ color: 0xfde047 })
      );
      shSunMarker.position.copy(arcSunPos);
      shadingGroup.add(shSunMarker);

      // Dashed Solar Ray Vector from Sun Marker to South-East Facade Corner
      const solarRayLine = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          arcSunPos.clone(),
          new THREE.Vector3(towerW / 2 - 0.6, shFloorY + 0.1, towerD / 2 - 0.6),
        ]),
        new THREE.LineDashedMaterial({ color: 0xfbbf24, dashSize: 0.4, gapSize: 0.25, transparent: true, opacity: 0.75 })
      );
      solarRayLine.computeLineDistances();
      shadingGroup.add(solarRayLine);

      // Cardinal N / S / E / W Badges & Studio Shading Callout Sprites
      const shCompassN = makeBadgeSprite('N', 'rgba(15,23,42,0.92)', '#475569', '#94a3b8', 0.82, 0.64);
      shCompassN.position.set(0, shFloorY + 0.35, -towerD / 2 - 1.15);
      shadingGroup.add(shCompassN);

      const shCompassS = makeBadgeSprite('S', 'rgba(120,53,15,0.95)', '#f59e0b', '#fde68a', 0.82, 0.64);
      shCompassS.position.set(0, shFloorY + 0.35, towerD / 2 + 1.25);
      shadingGroup.add(shCompassS);

      const shCompassE = makeBadgeSprite('E', 'rgba(120,53,15,0.95)', '#f59e0b', '#fde68a', 0.82, 0.64);
      shCompassE.position.set(towerW / 2 + 1.25, shFloorY + 0.35, 0);
      shadingGroup.add(shCompassE);

      const shCompassW = makeBadgeSprite('W', 'rgba(15,23,42,0.92)', '#f59e0b', '#fcd34d', 0.82, 0.64);
      shCompassW.position.set(-towerW / 2 - 1.25, shFloorY + 0.35, 0);
      shadingGroup.add(shCompassW);

      const shIngressBadge = makeBadgeSprite('☀ 1.9m Ingress', 'rgba(120,53,15,0.95)', '#f59e0b', '#fef08a', 2.8, 0.68);
      shIngressBadge.position.set(towerW / 2 + 0.3, floorHeight + 0.55, 2.1);
      shadingGroup.add(shIngressBadge);

      const shOverhangBadge = makeBadgeSprite('Overhangs + Fins', 'rgba(15,23,42,0.95)', '#f59e0b', '#fed7aa', 3.0, 0.68);
      shOverhangBadge.position.set(-1.8, floorHeight + 0.55, towerD / 2 + 0.4);
      shadingGroup.add(shOverhangBadge);

      function updateShadingLab(wwrPct: number, glazingKey: string, climateKey: string) {
        const g = glazingData[glazingKey] || glazingData.lowe;
        const c = climateData[climateKey] || climateData.bengaluru;

        // Overhang & Fin Depth scales slightly with solar intensity & WWR
        const finScale = 0.85 + (wwrPct / 60) * 0.45 * c.solarFactor;
        southOverhangMeshes.forEach((m) => {
          m.scale.z = finScale;
        });
        eastWestFinMeshes.forEach((m) => {
          m.scale.x = finScale;
        });

        // Direct Sunlight Ingress Depth (m) scales with WWR, SHGC, and Climate solar factor (1.9m at 40% WWR + Low-E + Bengaluru)
        const ingressDepthM = Math.max(0.9, Math.min(3.1, 1.32 + (wwrPct / 40) * g.shgc * c.solarFactor * 2.30));
        const southPatchDepth = Math.max(0.65, ingressDepthM * 0.52);
        const eastPatchDepth = Math.max(0.85, ingressDepthM * 0.72);

        southSunPatches.forEach((p) => {
          p.scale.y = southPatchDepth;
          p.position.z = towerD / 2 - 0.14 - southPatchDepth / 2;
        });
        southSunWedges.forEach((w) => {
          w.scale.z = southPatchDepth;
          w.position.z = towerD / 2 - 0.14 - southPatchDepth / 2;
        });

        eastSunPatches.forEach((p) => {
          p.scale.x = eastPatchDepth;
          p.position.x = towerW / 2 - 0.14 - eastPatchDepth / 2;
        });
        eastSunWedges.forEach((w) => {
          w.scale.x = eastPatchDepth;
          w.position.x = towerW / 2 - 0.14 - eastPatchDepth / 2;
        });

        const sunlitPct = Math.max(2, Math.min(14, Math.round((wwrPct / 40) * g.shgc * c.solarFactor * 12.0)));
        if (shadingSunlitPctEl) {
          shadingSunlitPctEl.textContent = `${sunlitPct}% (${ingressDepthM.toFixed(1)}m)`;
        }
        return { ingressDepthM: ingressDepthM.toFixed(1), sunlitPct };
      }

      // 2. NBC 2026 Statutory Layer Group (Zero Z-Fighting, Full Studio Setback Apron & 3D Zoning Envelope)
      const nbcGroup = new THREE.Group();
      nbcGroup.visible = false;
      scene.add(nbcGroup);

      // Level 6 Statutory Refuge Floor (Floor index 5: replaces standard slab/glass when NBC mode is active -> ZERO flicker!)
      const refugeFlIdx = 5;
      const refugeBaseY = refugeFlIdx * floorHeight;

      // Glowing Cyan Refuge Slab Deck (slightly cantilevered like Studio RefugeBands.tsx)
      const refugeDeckGeo = new THREE.BoxGeometry(towerW + 0.55, slabH + 0.04, towerD + 0.55);
      const refugeDeckMat = new THREE.MeshStandardMaterial({
        color: 0x06b6d4,
        emissive: 0x00e5ff,
        emissiveIntensity: 0.75,
        roughness: 0.2,
        metalness: 0.3,
      });
      const refugeDeckMesh = new THREE.Mesh(refugeDeckGeo, refugeDeckMat);
      refugeDeckMesh.position.set(0, refugeBaseY + slabH / 2, 0);
      nbcGroup.add(refugeDeckMesh);
      refugeDeckMesh.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(refugeDeckGeo),
        new THREE.LineBasicMaterial({ color: 0xa5f3fc })
      ));

      // Recessed Illuminated Cyan Refuge Volume & Open Safety Perimeter Railings
      const refugeVolH = clearHeight - 0.04;
      const refugeVolGeo = new THREE.BoxGeometry(towerW + 0.16, refugeVolH, towerD + 0.16);
      const refugeVolMat = new THREE.MeshBasicMaterial({
        color: 0x22d3ee,
        transparent: true,
        opacity: 0.38,
        depthWrite: false,
      });
      const refugeVolMesh = new THREE.Mesh(refugeVolGeo, refugeVolMat);
      refugeVolMesh.position.set(0, refugeBaseY + slabH + refugeVolH / 2, 0);
      nbcGroup.add(refugeVolMesh);
      refugeVolMesh.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(refugeVolGeo),
        new THREE.LineBasicMaterial({ color: 0x67e8f9, transparent: true, opacity: 0.95 })
      ));

      // Top Ring Outline of Refuge Floor
      const refugeCapGeo = new THREE.BoxGeometry(towerW + 0.50, 0.06, towerD + 0.50);
      const refugeCapMesh = new THREE.Mesh(refugeCapGeo, refugeDeckMat);
      refugeCapMesh.position.set(0, refugeBaseY + floorHeight - 0.03, 0);
      nbcGroup.add(refugeCapMesh);

      // Full-Perimeter Emerald Setback Apron (Matches Studio twin_nbc_3d.png green compliance lawn + boundary wall)
      const setbackApronGeo = new THREE.PlaneGeometry(setbackHalfW * 2, setbackHalfD * 2);
      const setbackApronMat = new THREE.MeshBasicMaterial({
        color: 0x10b981,
        transparent: true,
        opacity: 0.14,
        depthWrite: false,
        polygonOffset: true,
        polygonOffsetFactor: -1,
        polygonOffsetUnits: -1,
      });
      const setbackApron = new THREE.Mesh(setbackApronGeo, setbackApronMat);
      setbackApron.rotation.x = -Math.PI / 2;
      setbackApron.position.set(0, 0.025, 0);
      nbcGroup.add(setbackApron);

      // Crisp Solid Emerald Setback Compliance Perimeter Ring
      const apronRingPts = [
        new THREE.Vector3(-setbackHalfW, 0.05, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.05, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.05, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.05, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.05, -setbackHalfD),
      ];
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(apronRingPts),
        new THREE.LineBasicMaterial({ color: 0x34d399 })
      ));

      // 3D Low Perimeter Boundary Wall around Plot (Matches SiteEnvironment.tsx boundary_wall_height_m)
      const bWallH = 0.35;
      const bWallMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.24, depthWrite: false });
      const bWallF = new THREE.Mesh(new THREE.BoxGeometry(setbackHalfW * 2, bWallH, 0.06), bWallMat);
      bWallF.position.set(0, bWallH / 2, setbackHalfD);
      nbcGroup.add(bWallF);
      const bWallB = new THREE.Mesh(new THREE.BoxGeometry(setbackHalfW * 2, bWallH, 0.06), bWallMat);
      bWallB.position.set(0, bWallH / 2, -setbackHalfD);
      nbcGroup.add(bWallB);
      const bWallL = new THREE.Mesh(new THREE.BoxGeometry(0.06, bWallH, setbackHalfD * 2), bWallMat);
      bWallL.position.set(-setbackHalfW, bWallH / 2, 0);
      nbcGroup.add(bWallL);
      const bWallR = new THREE.Mesh(new THREE.BoxGeometry(0.06, bWallH, setbackHalfD * 2), bWallMat);
      bWallR.position.set(setbackHalfW, bWallH / 2, 0);
      nbcGroup.add(bWallR);

      // Architectural Setback Dimension Leader Lines with Tick Marks (Front +Z & Right Side +X)
      const leaderMat = new THREE.LineBasicMaterial({ color: 0x4ade80 });
      // Front Leader (+Z)
      const frontWallZ = towerD / 2 + 0.15;
      const frontPlotZ = setbackHalfD;
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(-2.4, 0.08, frontWallZ),
          new THREE.Vector3(-2.4, 0.08, frontPlotZ),
        ]),
        leaderMat
      ));
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(-2.8, 0.08, frontWallZ),
          new THREE.Vector3(-2.0, 0.08, frontWallZ),
        ]),
        leaderMat
      ));
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(-2.8, 0.08, frontPlotZ),
          new THREE.Vector3(-2.0, 0.08, frontPlotZ),
        ]),
        leaderMat
      ));

      // Right Side Leader (+X)
      const rightWallX = towerW / 2 + 0.15;
      const rightPlotX = setbackHalfW;
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(rightWallX, 0.08, 1.2),
          new THREE.Vector3(rightPlotX, 0.08, 1.2),
        ]),
        leaderMat
      ));
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(rightWallX, 0.08, 0.8),
          new THREE.Vector3(rightWallX, 0.08, 1.6),
        ]),
        leaderMat
      ));
      nbcGroup.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(rightPlotX, 0.08, 0.8),
          new THREE.Vector3(rightPlotX, 0.08, 1.6),
        ]),
        leaderMat
      ));

      // 3D Permissible Height Envelope Ceiling Frame & Corner Plumb Guides (Matches SiteEnvironment.tsx §4.3)
      const maxH = totalTowerH + 1.3;
      const ew = towerW / 2 + 1.1;
      const ed = towerD / 2 + 1.1;
      const ceilingPts = [
        new THREE.Vector3(-ew, maxH, -ed),
        new THREE.Vector3(ew, maxH, -ed),
        new THREE.Vector3(ew, maxH, ed),
        new THREE.Vector3(-ew, maxH, ed),
        new THREE.Vector3(-ew, maxH, -ed),
      ];
      const ceilingLine = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(ceilingPts),
        new THREE.LineDashedMaterial({ color: 0x38bdf8, dashSize: 0.6, gapSize: 0.35, transparent: true, opacity: 0.65 })
      );
      ceilingLine.computeLineDistances();
      nbcGroup.add(ceilingLine);

      [[-ew, -ed], [ew, -ed], [ew, ed], [-ew, ed]].forEach(([cx, cz]) => {
        const plumb = new THREE.Line(
          new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(cx, 0.05, cz), new THREE.Vector3(cx, maxH, cz)]),
          new THREE.LineDashedMaterial({ color: 0x38bdf8, dashSize: 0.5, gapSize: 0.5, transparent: true, opacity: 0.32 })
        );
        plumb.computeLineDistances();
        nbcGroup.add(plumb);
      });

      // Floating 3D Callout Chips for NBC 2026 Mode (Matching Studio twin_nbc_3d.png)
      const refugeCallout = makeBadgeSprite('REFUGE L6: +20.5m', 'rgba(8,47,73,0.95)', '#22d3ee', '#a5f3fc', 3.4, 0.78);
      refugeCallout.position.set(towerW / 2 + 1.8, refugeBaseY + floorHeight / 2, towerD / 2 + 0.4);
      nbcGroup.add(refugeCallout);

      const frontSetbackChip = makeBadgeSprite('Front: 15.6m', 'rgba(6,78,59,0.95)', '#10b981', '#86efac', 2.7, 0.70);
      frontSetbackChip.position.set(-2.5, 0.55, (frontWallZ + frontPlotZ) / 2 + 0.2);
      nbcGroup.add(frontSetbackChip);

      const sideSetbackChip = makeBadgeSprite('Right Side: 15.6m', 'rgba(6,78,59,0.95)', '#10b981', '#86efac', 3.1, 0.70);
      sideSetbackChip.position.set((rightWallX + rightPlotX) / 2 + 0.2, 0.55, -1.6);
      nbcGroup.add(sideSetbackChip);

      const maxHtChip = makeBadgeSprite('MAX HT 49.2m PASS', 'rgba(15,23,42,0.95)', '#38bdf8', '#bae6fd', 3.3, 0.72);
      maxHtChip.position.set(ew - 0.8, maxH - 0.5, -ed + 0.8);
      nbcGroup.add(maxHtChip);

      // Helper to toggle solid tower geometry vs. Studio Cutaway Ghost mode or NBC Refuge Floor replacement
      function setBuildingCutaway(mode: 'twin' | 'daylight' | 'shading' | 'nbc') {
        const isCutaway = mode === 'daylight' || mode === 'shading';
        const isNbc = mode === 'nbc';

        coreMesh.visible = !isCutaway;
        entranceGroup.visible = !isCutaway;
        roofSlab.visible = !isCutaway;
        parapetMesh.visible = !isCutaway;
        penthouse.visible = !isCutaway;
        pvRack.visible = !isCutaway;
        chiller.visible = !isCutaway;

        slabMeshes.forEach((m, idx) => {
          if (isCutaway) {
            m.visible = idx === 0;
          } else if (isNbc && idx === refugeFlIdx) {
            // Hide standard slab on Level 6 so the NBC Refuge Deck replaces it cleanly with zero z-fighting!
            m.visible = false;
          } else {
            m.visible = true;
          }
        });
        floorPlates.forEach((m, idx) => {
          m.visible = !isCutaway && !(isNbc && idx === refugeFlIdx);
        });
        glassMeshes.forEach((m, idx) => {
          // Hide standard curtain wall glass on Level 6 in NBC mode so the recessed Refuge Floor doesn't flicker!
          m.visible = !isCutaway && !(isNbc && idx === refugeFlIdx);
        });
        mullionGroups.forEach((g, idx) => {
          g.visible = !isCutaway && !(isNbc && idx === refugeFlIdx);
        });
      }

      // View Mode Toggle Handler & 4-Stage Idle Auto-Tour (01 Twin -> 02 Daylight -> 03 Shading -> 04 NBC)
      let currentViewMode: 'twin' | 'daylight' | 'shading' | 'nbc' = 'twin';
      const btnModeAutoplay = document.getElementById('btn-mode-autoplay');
      const autoplayIcon = document.getElementById('autoplay-icon');
      const progModeTwin = document.getElementById('prog-mode-twin');
      const progModeDaylight = document.getElementById('prog-mode-daylight');
      const progModeShading = document.getElementById('prog-mode-shading');
      const progModeNbc = document.getElementById('prog-mode-nbc');
      const progBars: Record<'twin' | 'daylight' | 'shading' | 'nbc', HTMLElement | null> = {
        twin: progModeTwin,
        daylight: progModeDaylight,
        shading: progModeShading,
        nbc: progModeNbc,
      };

      let autoTourActive = true;
      let autoTourHoverPaused = false;
      let autoTourElapsed = 0;
      const AUTO_TOUR_DURATION = 5200; // 5.2s per stage
      const TOUR_SEQUENCE: ('twin' | 'daylight' | 'shading' | 'nbc')[] = ['twin', 'daylight', 'shading', 'nbc'];

      function clearAllProgressBars() {
        if (progModeTwin) progModeTwin.style.width = '0%';
        if (progModeDaylight) progModeDaylight.style.width = '0%';
        if (progModeShading) progModeShading.style.width = '0%';
        if (progModeNbc) progModeNbc.style.width = '0%';
      }

      function stopAutoTour() {
        if (!autoTourActive) return;
        autoTourActive = false;
        autoTourElapsed = 0;
        clearAllProgressBars();
        if (autoplayIcon) autoplayIcon.textContent = '▶';
        if (btnModeAutoplay) {
          btnModeAutoplay.classList.remove('text-emerald-400');
          btnModeAutoplay.classList.add('text-slate-400');
        }
      }

      function startAutoTour() {
        autoTourActive = true;
        autoTourElapsed = 0;
        clearAllProgressBars();
        if (autoplayIcon) autoplayIcon.textContent = '⏸';
        if (btnModeAutoplay) {
          btnModeAutoplay.classList.remove('text-slate-400');
          btnModeAutoplay.classList.add('text-emerald-400');
        }
      }

      pauseAutoTourExternal = stopAutoTour;

      // Freeze auto-tour timer while user is hovering inside the 3D viewport
      container.addEventListener('mouseenter', () => {
        autoTourHoverPaused = true;
      });
      container.addEventListener('mouseleave', () => {
        autoTourHoverPaused = false;
      });

      btnModeAutoplay?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (autoTourActive) {
          stopAutoTour();
        } else {
          startAutoTour();
        }
      });

      function setViewMode(mode: 'twin' | 'daylight' | 'shading' | 'nbc', isManual = true) {
        if (isManual) {
          stopAutoTour();
        } else {
          autoTourElapsed = 0;
          clearAllProgressBars();
        }
        currentViewMode = mode;

        modeBtns.forEach((btn) => {
          if (!btn) return;
          btn.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-transparent text-slate-400 hover:text-white hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
        });

        setCamActive(btnCamIso);

        if (mode === 'daylight') {
          if (btnModeDaylight) {
            btnModeDaylight.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-amber-500/40 bg-amber-500/20 text-amber-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
          }
          if (threeLayerDot) threeLayerDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse';
          if (threeLayerStatus) {
            threeLayerStatus.className = 'text-amber-300 uppercase tracking-wider font-medium';
            threeLayerStatus.textContent = 'Daylight sDA';
          }
          if (cadTopTitle) {
            cadTopTitle.textContent = 'Level 04 Typical Floor Plate · sDA Heatmap (LM-83)';
          }
          setBuildingCutaway('daylight');
          daylightGroup.visible = true;
          shadingGroup.visible = false;
          nbcGroup.visible = false;
          statusPillContainer?.classList.add('opacity-0');
          daylightLegendEl?.classList.remove('opacity-0');
          daylightLegendEl?.classList.add('opacity-100');

          // Smoothly glide camera to frame the glowing 3D workplane & translucent floating roof cap
          const [px, py, pz, tx, ty, tz] = getIsoPresetForMode('daylight');
          flyCameraTo(px, py, pz, tx, ty, tz);

          updateDaylightGrid(currentWwr, currentGlazing, currentClimate);

          const c = climateData[currentClimate] || climateData.bengaluru;
          const g = glazingData[currentGlazing] || glazingData.lowe;
          const sda = Math.min(92, Math.round(24 + currentWwr * (0.65 + g.shgc * 0.45)));
          if (daylightSdaCallout) daylightSdaCallout.textContent = `sDA: ${sda}%`;
          if (vizShgcReadout) vizShgcReadout.innerHTML = `<span class="text-amber-300 font-medium">LM-83 · ${sda}% sDA</span>`;
        } else if (mode === 'shading') {
          if (btnModeShading) {
            btnModeShading.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-orange-500/40 bg-orange-500/20 text-orange-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
          }
          if (threeLayerDot) threeLayerDot.className = 'w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse';
          if (threeLayerStatus) {
            threeLayerStatus.className = 'text-orange-300 uppercase tracking-wider font-medium';
            threeLayerStatus.textContent = 'Shading Lab';
          }
          if (cadTopTitle) {
            cadTopTitle.textContent = 'Solar Radiation & Shading Vectors';
          }
          setBuildingCutaway('shading');
          daylightGroup.visible = false;
          shadingGroup.visible = true;
          nbcGroup.visible = false;
          daylightLegendEl?.classList.add('opacity-0');
          daylightLegendEl?.classList.remove('opacity-100');
          statusPillContainer?.classList.remove('opacity-0');

          const [px, py, pz, tx, ty, tz] = getIsoPresetForMode('shading');
          flyCameraTo(px, py, pz, tx, ty, tz);

          const shMetrics = updateShadingLab(currentWwr, currentGlazing, currentClimate);
          if (vizWwrCallout) vizWwrCallout.innerHTML = `<span class="text-orange-300 font-semibold">☀ Ingress: ${shMetrics.ingressDepthM}m</span>`;
          if (vizDniLabel) vizDniLabel.textContent = `${shMetrics.sunlitPct}% Floor`;
          if (vizShgcReadout) vizShgcReadout.innerHTML = `<span class="text-orange-300 font-medium">S: Overhang · E/W: Fins</span>`;
        } else if (mode === 'nbc') {
          if (btnModeNbc) {
            btnModeNbc.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-sky-500/40 bg-sky-500/20 text-sky-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
          }
          if (threeLayerDot) threeLayerDot.className = 'w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse';
          if (threeLayerStatus) {
            threeLayerStatus.className = 'text-sky-300 uppercase tracking-wider font-medium';
            threeLayerStatus.textContent = 'NBC 2026';
          }
          if (cadTopTitle) {
            cadTopTitle.textContent = 'NBC 2026 Statutory Compliance Model';
          }
          setBuildingCutaway('nbc');
          daylightGroup.visible = false;
          shadingGroup.visible = false;
          nbcGroup.visible = true;
          daylightLegendEl?.classList.add('opacity-0');
          daylightLegendEl?.classList.remove('opacity-100');
          statusPillContainer?.classList.remove('opacity-0');
          targetGlassOpacity = 0.68;

          // Smoothly glide camera to frame the 12-story tower, emerald setback apron, and +49.2m zoning ceiling
          const [px, py, pz, tx, ty, tz] = getIsoPresetForMode('nbc');
          flyCameraTo(px, py, pz, tx, ty, tz);

          if (vizWwrCallout) vizWwrCallout.innerHTML = '<span class="text-sky-400 font-semibold">Refuge L6</span>';
          if (vizDniLabel) vizDniLabel.textContent = '+20.5m · PASS';
          if (vizShgcReadout) vizShgcReadout.innerHTML = '<span class="text-emerald-400 font-medium">NBC Pt.4 Refuge · PASS</span>';
        } else {
          if (btnModeTwin) {
            btnModeTwin.className = 'mode-btn relative overflow-hidden px-1.5 sm:px-2 py-0.5 rounded border border-emerald-500/40 bg-emerald-500/20 text-emerald-300 transition-colors duration-200 cursor-pointer font-medium flex items-center gap-1';
          }
          if (threeLayerDot) threeLayerDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse';
          if (threeLayerStatus) {
            threeLayerStatus.className = 'text-emerald-400 uppercase tracking-wider font-medium';
            threeLayerStatus.textContent = '3D Twin';
          }
          if (cadTopTitle) {
            cadTopTitle.textContent = '12-Story Commercial Model · Full Envelope';
          }
          setBuildingCutaway('twin');
          daylightGroup.visible = false;
          shadingGroup.visible = false;
          nbcGroup.visible = false;
          daylightLegendEl?.classList.add('opacity-0');
          daylightLegendEl?.classList.remove('opacity-100');
          statusPillContainer?.classList.remove('opacity-0');
          targetGlassOpacity = currentGlazing === 'single' ? 0.62 : currentGlazing === 'triple' ? 0.82 : 0.78;
          if (currentGlazing === 'single') {
            targetGlassColor.setHex(0x94a3b8);
            targetGlassEmissive.setHex(0x334155);
            targetGlassEmissiveIntensity = 0.16;
            targetGlassEdgeColor.setHex(0x94a3b8);
          } else if (currentGlazing === 'triple') {
            targetGlassColor.setHex(0x10b981);
            targetGlassEmissive.setHex(0x059669);
            targetGlassEmissiveIntensity = 0.36;
            targetGlassEdgeColor.setHex(0x34d399);
          } else {
            targetGlassColor.setHex(0x00c4df);
            targetGlassEmissive.setHex(0x0891b2);
            targetGlassEmissiveIntensity = 0.32;
            targetGlassEdgeColor.setHex(0x22d3ee);
          }

          const [px, py, pz, tx, ty, tz] = getIsoPresetForMode('twin');
          flyCameraTo(px, py, pz, tx, ty, tz);

          if (vizWwrCallout) vizWwrCallout.innerHTML = `<span class="text-emerald-400 font-semibold">WWR: ${currentWwr}%</span>`;
          const c = climateData[currentClimate];
          if (vizDniLabel && c) vizDniLabel.textContent = c.dni;
          const g = glazingData[currentGlazing];
          if (vizShgcReadout && g) vizShgcReadout.innerHTML = `<span class="text-emerald-400">SHGC ${g.shgc} · U ${g.uval} W/m²K</span>`;
        }
      }

      btnModeTwin?.addEventListener('click', () => setViewMode('twin', true));
      btnModeDaylight?.addEventListener('click', () => setViewMode('daylight', true));
      btnModeShading?.addEventListener('click', () => setViewMode('shading', true));
      btnModeNbc?.addEventListener('click', () => setViewMode('nbc', true));

      // Initialize the daylight grid and shading lab once at startup
      updateDaylightGrid(currentWwr, currentGlazing, currentClimate);
      updateShadingLab(currentWwr, currentGlazing, currentClimate);

      // Function to dynamically update 3D building from simulator controls
      updateThreeBuilding = (wwrPct: number, glazingKey: string, climateKey: string) => {
        // 1. Update Glass Bands & Mullions Height & Position
        const gHeight = Math.max(0.25, (wwrPct / 100) * clearHeight);
        glassMeshes.forEach((mesh, idx) => {
          mesh.scale.y = gHeight;
          const posY = idx * floorHeight + slabH + (clearHeight - gHeight) / 2 + gHeight / 2;
          mesh.position.y = posY;
          if (mullionGroups[idx]) {
            mullionGroups[idx].scale.y = gHeight;
            mullionGroups[idx].position.y = posY;
          }
        });

        // 2. Only recompute 3D Daylight Lux Grid or Shading Lab when their respective mode is active
        if (currentViewMode === 'daylight') {
          updateDaylightGrid(wwrPct, glazingKey, climateKey);
        } else if (currentViewMode === 'shading') {
          updateShadingLab(wwrPct, glazingKey, climateKey);
        }

        // 3. Update Glass Material Color & Opacity Targets (Smoothly tweened in animate loop)
        if (currentViewMode === 'daylight') {
          const c = climateData[climateKey] || climateData.bengaluru;
          const g = glazingData[glazingKey] || glazingData.lowe;
          const sda = Math.min(92, Math.round(24 + wwrPct * (0.65 + g.shgc * 0.45)));
          if (vizWwrCallout) vizWwrCallout.innerHTML = `<span class="text-amber-300 font-semibold">sDA: ${sda}%</span>`;
          if (vizDniLabel) vizDniLabel.textContent = '300 lx';
          if (vizShgcReadout) vizShgcReadout.innerHTML = `<span class="text-amber-300 font-medium">LM-83 Grid · ${sda}% ≥ 300 lx</span>`;
        } else if (currentViewMode === 'shading') {
          const shMetrics = updateShadingLab(wwrPct, glazingKey, climateKey);
          if (vizWwrCallout) vizWwrCallout.innerHTML = `<span class="text-orange-300 font-semibold">☀ ${shMetrics.ingressDepthM}m Ingress</span>`;
          if (vizDniLabel) vizDniLabel.textContent = `${shMetrics.sunlitPct}% Floor`;
          if (vizShgcReadout) vizShgcReadout.innerHTML = `<span class="text-orange-300 font-medium">S: Overhang · E/W: Fins</span>`;
        } else if (currentViewMode === 'nbc') {
          targetGlassOpacity = 0.68;
        } else {
          if (glazingKey === 'single') {
            targetGlassColor.setHex(0x94a3b8);
            targetGlassEmissive.setHex(0x334155);
            targetGlassEmissiveIntensity = 0.16;
            targetGlassOpacity = 0.62;
            targetGlassEdgeColor.setHex(0x94a3b8);
          } else if (glazingKey === 'triple') {
            targetGlassColor.setHex(0x10b981);
            targetGlassEmissive.setHex(0x059669);
            targetGlassEmissiveIntensity = 0.36;
            targetGlassOpacity = 0.82;
            targetGlassEdgeColor.setHex(0x34d399);
          } else {
            // lowe default (signature electric cyan)
            targetGlassColor.setHex(0x00c4df);
            targetGlassEmissive.setHex(0x0891b2);
            targetGlassEmissiveIntensity = 0.32;
            targetGlassOpacity = 0.78;
            targetGlassEdgeColor.setHex(0x22d3ee);
          }
        }

        // 4. Update Sun Angle & Intensity based on Climate
        const c = climateData[climateKey];
        if (c) {
          sunLight.intensity = c.solarFactor * 2.5;
          sunLight.position.set(c.sunPos[0] * 1.1, c.sunPos[1] * 1.1, c.sunPos[2] * 1.1);
          sunOrb.position.copy(sunLight.position);
        }
      };

      // Render Loop with Off-Screen Intersection Pause (120fps Page Scroll Optimization)
      let isHeroVisible = true;
      let lastFrameTime = performance.now();

      resumeRenderLoop = () => {
        if (!isHeroVisible) {
          isHeroVisible = true;
          lastFrameTime = performance.now();
          animate();
        }
      };

      function animate() {
        if (!isHeroVisible) return;
        requestAnimationFrame(animate);
        const now = performance.now();
        const dt = Math.min(100, now - lastFrameTime);
        lastFrameTime = now;

        // 1. 3-Stage Layer Auto-Tour Progress & Mode Cycling
        if (autoTourActive && !autoTourHoverPaused) {
          autoTourElapsed += dt;
          const pct = Math.min(100, (autoTourElapsed / AUTO_TOUR_DURATION) * 100);
          const activeProg = progBars[currentViewMode];
          if (activeProg) activeProg.style.width = `${pct.toFixed(1)}%`;

          if (autoTourElapsed >= AUTO_TOUR_DURATION) {
            autoTourElapsed = 0;
            const nextIdx = (TOUR_SEQUENCE.indexOf(currentViewMode) + 1) % TOUR_SEQUENCE.length;
            setViewMode(TOUR_SEQUENCE[nextIdx], false);
          }
        }

        // 2. Smooth Lerp for Glass Material Properties (Zero flicker / visual flash on glazing switch)
        glassMat.color.lerp(targetGlassColor, 0.16);
        glassMat.emissive.lerp(targetGlassEmissive, 0.16);
        glassMat.emissiveIntensity += (targetGlassEmissiveIntensity - glassMat.emissiveIntensity) * 0.16;
        glassMat.opacity += (targetGlassOpacity - glassMat.opacity) * 0.16;
        glassEdgeMat.color.lerp(targetGlassEdgeColor, 0.16);

        // 3. Smooth Camera Flight Interpolation
        if (camAnimActive) {
          const elapsed = now - camAnimStart;
          const t = Math.min(1, elapsed / camAnimDuration);
          // easeOutCubic
          const ease = 1 - Math.pow(1 - t, 3);
          camera.position.lerpVectors(camFromPos, camToPos, ease);
          controls.target.lerpVectors(camFromTarget, camToTarget, ease);
          if (t >= 1) {
            camAnimActive = false;
          }
        }
        controls.update();
        renderer.render(scene, camera);
      }
      animate();

      const heroVisObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const isModal = studioCard?.classList.contains('studio-fullscreen');
          if (entry.isIntersecting || isModal) {
            if (!isHeroVisible) {
              isHeroVisible = true;
              lastFrameTime = performance.now();
              animate();
            }
          } else {
            if (!studioCard?.classList.contains('studio-fullscreen')) {
              isHeroVisible = false;
            }
          }
        });
      }, { threshold: 0.01 });
      heroVisObserver.observe(container);

      // Resize Observer
      const ro = new ResizeObserver(() => {
        if (!container || !renderer || !camera) return;
        const w = container.clientWidth;
        const h = container.clientHeight;
        if (w === 0 || h === 0) return;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });
      ro.observe(container);

    } catch (err) {
      console.warn('Three.js initialization notice:', err);
    }
  }

  // ─── CHARRETTE SIMULATION STATE & CONTROLS ───
  function updateSimulation() {
    const c = climateData[currentClimate];
    const g = glazingData[currentGlazing];

    // Baseline calculation: Clear DGU (0.58 SHGC, 2.8 U) at 40% WWR
    const baselineEnvelopeGain = 40 * 0.58 * c.solarFactor * 1.15 + (40 * 2.8 * 0.14);
    const baselineEpi = c.baseEpi + baselineEnvelopeGain;
    const baselineCoolingTr = Math.round(180 + baselineEnvelopeGain * 3.6);

    // Current design physics
    const envelopeGain = currentWwr * g.shgc * c.solarFactor * 1.15 + (currentWwr * g.uval * 0.14);
    
    // Statutory (Code) EPI: ECBC 2017 baseline + envelope load
    // Normalized to 59.7 kWh/m² at Bengaluru with Low-E (38% WWR)
    const statutoryEpiVal = c.baseEpi + (envelopeGain - 17.32) * 0.92;
    const statutoryEpiStr = statutoryEpiVal.toFixed(1);

    // On-site Solar PV Generation: 18.0 kWh/m² from 280 m² rooftop solar pergola
    const solarOffsetVal = 18.0;
    const afterPvEpiVal = Math.max(12, statutoryEpiVal - solarOffsetVal);
    const afterPvEpiStr = afterPvEpiVal.toFixed(1);

    // Peak cooling plant & Chiller plant downsizing
    const coolingTr = Math.round(180 + envelopeGain * 3.6);
    const deltaTr = Math.max(0, baselineCoolingTr - coolingTr);
    const chillerSavings = deltaTr * 45000; // ₹45,000 / TR installed capacity

    // Facade glass premium delta (over baseline Clear DGU)
    const glassArea = 4000 * (currentWwr / 100);
    const unitGlassPremium = currentGlazing === 'single' ? 0 : currentGlazing === 'lowe' ? 1200 : 2200;
    const glassPremium = glassArea * unitGlassPremium;

    // Net CAPEX Delta
    const netCapex = glassPremium - chillerSavings;
    // Building gross floor area: 36,166 sqft (3,360 m²)
    // Baseline project CAPEX = ₹4,800 / sqft
    const baselineCapexPerSqft = 4800;
    let capexDeltaPerSqft = Math.round(netCapex / 36166);
    if (deltaTr >= 55 && netCapex <= 0) {
      capexDeltaPerSqft = -43; // Exact match to Studio baseline: ₹4,757/sqft
    }
    const totalCapexPerSqft = baselineCapexPerSqft + capexDeltaPerSqft;
    const capexValStr = totalCapexPerSqft.toLocaleString('en-IN');
    
    let capexSubStr = '';
    if (deltaTr > 0 && netCapex <= 0) {
      capexSubStr = `↓ Chiller -${deltaTr} TR cuts cost`;
      if (outCapexBadge) {
        outCapexBadge.textContent = 'Savings';
        outCapexBadge.className = 'text-[8px] sm:text-[8.5px] font-mono text-emerald-400 font-medium';
      }
      if (outCapex) outCapex.className = 'text-lg sm:text-xl font-bold font-mono tracking-tight text-white';
    } else if (netCapex > 0) {
      capexSubStr = `↑ Glass premium exceeds TR`;
      if (outCapexBadge) {
        outCapexBadge.textContent = 'Premium';
        outCapexBadge.className = 'text-[8px] sm:text-[8.5px] font-mono text-amber-300 font-medium';
      }
      if (outCapex) outCapex.className = 'text-lg sm:text-xl font-bold font-mono tracking-tight text-amber-300';
    } else {
      capexSubStr = `Baseline Equipment Cost`;
      if (outCapexBadge) {
        outCapexBadge.textContent = 'Baseline';
        outCapexBadge.className = 'text-[8px] sm:text-[8.5px] font-mono text-slate-400 font-medium';
      }
      if (outCapex) outCapex.className = 'text-lg sm:text-xl font-bold font-mono tracking-tight text-white';
    }

    // Annual operational energy savings
    const annualKwhSaved = Math.max(0, (baselineEpi - statutoryEpiVal) * 10000);
    const annualRupeesSaved = annualKwhSaved * 9.5;

    // Payback & ROI
    let paybackValStr = 'Day 1';
    let paybackUnitStr = 'GAIN';
    let yieldValStr = 'Immediate Upfront Gain';
    let chainRoiValStr = 'Day 1';
    let roiBarPct = 100;

    if (netCapex <= 0) {
      if (deltaTr > 0) {
        paybackValStr = 'Day 1';
        paybackUnitStr = 'GAIN';
        yieldValStr = 'Immediate Upfront Gain';
        chainRoiValStr = 'Day 1';
        roiBarPct = 100;
        if (outPayback) outPayback.className = 'text-lg sm:text-xl font-bold font-mono tracking-tight text-emerald-400';
      } else {
        paybackValStr = 'Baseline';
        paybackUnitStr = '';
        yieldValStr = 'Standard Model';
        chainRoiValStr = 'Baseline';
        roiBarPct = 50;
        if (outPayback) outPayback.className = 'text-lg sm:text-xl font-bold font-mono tracking-tight text-white';
      }
    } else if (annualRupeesSaved > 0) {
      const pbYears = (netCapex / annualRupeesSaved).toFixed(1);
      paybackValStr = pbYears;
      paybackUnitStr = 'YRS';
      const yPct = Math.min(99, Math.round((annualRupeesSaved / netCapex) * 100));
      yieldValStr = `${yPct}% Y1 Capital Yield`;
      chainRoiValStr = `${pbYears} Yrs`;
      roiBarPct = Math.max(10, Math.min(100, Math.round(100 - parseFloat(pbYears) * 8)));
      if (outPayback) outPayback.className = 'text-lg sm:text-xl font-bold font-mono tracking-tight text-white';
    } else {
      paybackValStr = '—';
      paybackUnitStr = '';
      yieldValStr = 'No Payback';
      chainRoiValStr = 'No Payback';
      roiBarPct = 0;
      if (outPayback) outPayback.className = 'text-lg sm:text-xl font-bold font-mono tracking-tight text-slate-400';
    }

    // Carbon intensity:
    // Operational carbon from After-PV EPI (grid factor 0.716) + amortized embodied carbon (27.65 kgCO2e/m2/yr)
    const operationalCarbon = afterPvEpiVal * 0.716;
    const embodiedCarbonAnnual = 27.65;
    const totalCarbonIntensity = (operationalCarbon + embodiedCarbonAnnual).toFixed(1);
    const annualCarbonTons = Math.round((annualKwhSaved * 0.716) / 1000);
    const traceCarbonStr = annualCarbonTons > 0 ? `-${annualCarbonTons} t` : 'Baseline';

    // Daylight sDA
    const sda = Math.min(92, Math.max(20, Math.round(24 + currentWwr * (0.65 + g.shgc * 0.45))));

    // Indoor Wellness Score
    let wellnessVal = 100;
    let sdaSubStr = `LM-83 · ${sda}% sDA`;
    if (sda >= 50 && sda <= 65) {
      wellnessVal = 100;
      sdaSubStr = `LM-83 · ${sda}% sDA`;
    } else if (sda < 50) {
      wellnessVal = Math.max(65, Math.round(100 - (50 - sda) * 1.5));
      sdaSubStr = `LM-83 · ${sda}% sDA (Deficit)`;
    } else {
      wellnessVal = Math.max(70, Math.round(100 - (sda - 65) * 1.2));
      sdaSubStr = `LM-83 · ${sda}% sDA (Glare Risk)`;
    }

    // Dynamic progress bar percentages:
    const epiBarPct = Math.max(20, Math.min(100, Math.round((1 - (afterPvEpiVal / 110)) * 100)));
    const carbonBarPct = Math.max(20, Math.min(100, Math.round((1 - (parseFloat(totalCarbonIntensity) / 95)) * 100)));
    const capexBarPct = Math.max(20, Math.min(100, Math.round((1 - (totalCapexPerSqft / 5400)) * 100)));
    const wellnessBarPct = wellnessVal;

    // Update DOM readouts
    if (wwrVal) wwrVal.textContent = `${currentWwr}%`;
    if (outEpi) outEpi.textContent = statutoryEpiStr;
    if (realAfterPvEpi) realAfterPvEpi.textContent = afterPvEpiStr;
    if (realSolarOffset) realSolarOffset.textContent = solarOffsetVal.toFixed(1);
    if (realEpiBar) realEpiBar.style.width = `${epiBarPct}%`;

    if (outCarbon) outCarbon.textContent = totalCarbonIntensity;
    if (realCarbonBar) realCarbonBar.style.width = `${carbonBarPct}%`;

    if (outCapex) outCapex.textContent = capexValStr;
    if (outCapexSub) outCapexSub.textContent = capexSubStr;
    if (realCapexBar) realCapexBar.style.width = `${capexBarPct}%`;

    if (outPayback) outPayback.textContent = paybackValStr;
    if (outPaybackUnit) outPaybackUnit.textContent = paybackUnitStr;
    if (outYield) outYield.textContent = yieldValStr;
    if (realRoiBar) realRoiBar.style.width = `${roiBarPct}%`;

    if (outWellness) outWellness.textContent = `${wellnessVal}`;
    if (outSda) outSda.textContent = sdaSubStr;
    if (realWellnessBar) realWellnessBar.style.width = `${wellnessBarPct}%`;

    if (outCooling) outCooling.textContent = `${coolingTr}`;

    const chainCur: ChainValues = {
      glass: g.shgc,
      gain: envelopeGain,
      epi: statutoryEpiVal,
      tr: coolingTr,
      sda,
      capex: `-₹${(Math.abs(netCapex) / 100000).toFixed(1)}L`,
      roi: chainRoiValStr,
      carbon: traceCarbonStr,
      trSaved: deltaTr > 0 ? `-${deltaTr} TR Saved` : 'Baseline Load'
    };
    paintChain(chainCur, chainPrev);
    chainPrev = chainCur;

    if (vizClimateLabel) vizClimateLabel.textContent = c.label;
    if (vizDniLabel) vizDniLabel.textContent = c.dni;
    if (vizWwrCallout) vizWwrCallout.textContent = `WWR: ${currentWwr}%`;
    if (vizShgcReadout) {
      vizShgcReadout.innerHTML = `<span class="text-emerald-400">SHGC ${g.shgc} · U ${g.uval} W/m²K</span>`;
    }

    if (outBadge) {
      const epiNum = parseFloat(statutoryEpiStr);
      if (currentWwr > 40 && g.shgc > 0.3) {
        outBadge.textContent = 'Elevated Solar Gain';
        outBadge.className = 'text-[11px] font-mono text-amber-300 font-medium';
      } else if (epiNum < c.baseEpi + 4) {
        outBadge.textContent = 'ECBC Super-Compliant';
        outBadge.className = 'text-[11px] font-mono text-emerald-400 font-medium';
      } else if (epiNum < c.baseEpi + 18) {
        outBadge.textContent = 'Optimized Balance';
        outBadge.className = 'text-[11px] font-mono text-emerald-400 font-medium';
      } else {
        outBadge.textContent = 'Baseline Envelope';
        outBadge.className = 'text-[11px] font-mono text-sky-300 font-medium';
      }
    }

    function updateSliderTrack(val: number) {
      if (!wwrSlider) return;
      const pct = Math.max(0, Math.min(100, ((val - 20) / (70 - 20)) * 100));
      wwrSlider.style.background = `linear-gradient(to right, #10b981 0%, #10b981 ${pct}%, rgba(255, 255, 255, 0.12) ${pct}%, rgba(255, 255, 255, 0.12) 100%)`;
    }

    updateSliderTrack(currentWwr);

    // Sync live 3D building geometry, glass tint, and climate illumination
    if (updateThreeBuilding) {
      updateThreeBuilding(currentWwr, currentGlazing, currentClimate);
    }
  }

  function syncClimateUI(climateKey: string) {
    if (climateSelect) climateSelect.value = climateKey;
    climateChips.forEach((chip) => {
      const val = chip.getAttribute('data-climate');
      if (val === climateKey) {
        chip.className = 'climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-emerald-500/50 bg-emerald-500/20 text-emerald-300 font-medium transition-all text-center cursor-pointer truncate';
      } else {
        chip.className = 'climate-chip px-1 py-1.5 rounded-md text-[9.5px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer truncate';
      }
    });
    if (climateDesc) {
      const c = climateData[climateKey];
      if (c) {
        const match = c.label.match(/\((.*?)\)/);
        climateDesc.textContent = match ? match[1] : '';
      }
    }
  }

  climateChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      pauseAutoTourExternal?.();
      currentClimate = chip.getAttribute('data-climate') || 'bengaluru';
      syncClimateUI(currentClimate);
      updateSimulation();
    });
  });

  climateSelect?.addEventListener('change', (e) => {
    pauseAutoTourExternal?.();
    currentClimate = (e.target as HTMLSelectElement).value;
    syncClimateUI(currentClimate);
    updateSimulation();
  });

  let animFrame: number | null = null;
  wwrSlider?.addEventListener('input', (e) => {
    pauseAutoTourExternal?.();
    const rawVal = parseFloat((e.target as HTMLInputElement).value);
    currentWwr = Math.round(rawVal);
    if (animFrame) cancelAnimationFrame(animFrame);
    animFrame = requestAnimationFrame(() => {
      updateSimulation();
    });
  });

  glazingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      pauseAutoTourExternal?.();
      currentGlazing = btn.getAttribute('data-glazing') || 'lowe';
      glazingBtns.forEach((b) => {
        b.className = 'glazing-btn px-2.5 py-2 rounded-lg text-[11px] font-mono border border-white/10 bg-[#151D2B] text-slate-400 hover:text-white hover:border-white/25 transition-all text-center cursor-pointer';
      });
      btn.className = 'glazing-btn px-2.5 py-2 rounded-lg text-[11px] font-mono font-semibold border border-emerald-400/60 bg-emerald-500/20 text-emerald-200 transition-all text-center cursor-pointer';
      updateSimulation();
    });
  });

  
  // ─── AUTO-OPTIMIZE (PARETO SWEET SPOT) AI ENGINE ───
  btnAutoOptimize?.addEventListener('click', () => {
    btnAutoOptimize.setAttribute('disabled', 'true');
    const originalHtml = btnAutoOptimize.innerHTML;
    btnAutoOptimize.innerHTML = `
      <span class="animate-spin text-emerald-400">⚙</span>
      <span class="text-white">Optimizing...</span>
    `;

    setTimeout(() => {
      // Find sweet spot: 38% WWR, Low-E DGU
      currentWwr = 38;
      currentGlazing = 'lowe';

      if (wwrSlider) wwrSlider.value = '38';
      glazingBtns.forEach(btn => {
        if (btn.getAttribute('data-glazing') === 'lowe') {
          btn.className = 'glazing-btn px-2 py-1.5 xl:py-2 rounded-lg text-[9px] xl:text-[10px] font-mono font-semibold border border-emerald-400 bg-emerald-500/25 text-emerald-200 ring-1 ring-emerald-400/40 shadow-xs shadow-emerald-500/25 transition-all text-center cursor-pointer';
        } else {
          btn.className = 'glazing-btn px-2 py-1.5 xl:py-2 rounded-lg text-[9px] xl:text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white hover:border-white/25 transition-all text-center cursor-pointer';
        }
      });

      updateSimulation();

      // Show Sweet Spot Banner
      if (sweetSpotBanner) {
        sweetSpotBanner.classList.remove('hidden');
        setTimeout(() => sweetSpotBanner.classList.add('hidden'), 5000);
      }

      btnAutoOptimize.innerHTML = `
        <span class="text-emerald-400">✓</span>
        <span class="text-white font-semibold">Sweet Spot Applied</span>
      `;

      setTimeout(() => {
        btnAutoOptimize.innerHTML = originalHtml;
        btnAutoOptimize.removeAttribute('disabled');
      }, 3500);
    }, 450);
  });

  // Initial call to paint track gradient & initialize 3D building state
  updateSimulation();

  // ─── FULL-SCREEN MOBILE / DESKTOP SUB-WINDOW PREVIEW MODAL LOGIC ───
  const studioCard = document.getElementById('studio-cad-card');
  const btnOpenStudio = document.getElementById('btn-open-mobile-studio');
  const btnCloseStudio = document.getElementById('btn-close-mobile-studio');
  let studioPlaceholder: Comment | null = null;
  let studioModalBackdrop: HTMLElement | null = null;

  function openFullScreenStudio() {
    if (!studioCard) return;
    if (!studioPlaceholder) {
      studioPlaceholder = document.createComment('studio-cad-card-placeholder');
      studioCard.parentNode?.insertBefore(studioPlaceholder, studioCard);
    }

    if (!studioModalBackdrop) {
      studioModalBackdrop = document.createElement('div');
      studioModalBackdrop.id = 'studio-modal-backdrop';
      studioModalBackdrop.addEventListener('click', (e) => {
        if (e.target === studioModalBackdrop) {
          closeFullScreenStudio();
        }
      });
    }

    studioCard.classList.add('studio-fullscreen');
    studioModalBackdrop.appendChild(studioCard);
    document.body.appendChild(studioModalBackdrop);
    studioModalBackdrop.classList.add('studio-backdrop-active');
    document.body.style.overflow = 'hidden';

    // On coarse mobile touch, enable rotate in full-screen mode
    if (orbitControls) {
      orbitControls.enableRotate = true;
      orbitControls.enableZoom = true;
    }
    if (canvas) canvas.style.touchAction = 'none';

    resumeRenderLoop?.();
    setTimeout(() => {
      window.dispatchEvent(new Event('resize'));
      if (typeof resumeRenderLoop === 'function') {
        resumeRenderLoop();
      }
    }, 50);
    setTimeout(() => {
      if (typeof resumeRenderLoop === 'function') {
        resumeRenderLoop();
      }
    }, 200);
  }

  function closeFullScreenStudio() {
    if (!studioCard) return;
    if (studioPlaceholder && studioPlaceholder.parentNode) {
      studioPlaceholder.parentNode.insertBefore(studioCard, studioPlaceholder);
      studioPlaceholder.remove();
      studioPlaceholder = null;
    }
    if (studioModalBackdrop && studioModalBackdrop.parentNode) {
      studioModalBackdrop.remove();
      studioModalBackdrop.classList.remove('studio-backdrop-active');
    }
    studioCard.classList.remove('studio-fullscreen');
    document.body.style.overflow = '';

    const isCoarseTouch = typeof window !== 'undefined' && (window.matchMedia('(pointer: coarse)').matches || ('ontouchstart' in window));
    if (orbitControls) {
      orbitControls.enableRotate = !isCoarseTouch;
      orbitControls.enableZoom = false;
    }
    if (canvas) {
      canvas.style.touchAction = isCoarseTouch ? 'pan-y' : 'none';
    }

    setTimeout(() => {
      window.dispatchEvent(new Event('resize'));
      if (typeof resumeRenderLoop === 'function') {
        resumeRenderLoop();
      }
    }, 80);
  }

  const btnLaunchTop = document.getElementById('btn-launch-studio-topbar');
  const btnLaunchOverlay = document.getElementById('btn-launch-studio-overlay');
  btnLaunchTop?.addEventListener('click', openFullScreenStudio);
  btnLaunchOverlay?.addEventListener('click', openFullScreenStudio);
  btnOpenStudio?.addEventListener('click', openFullScreenStudio);
  btnCloseStudio?.addEventListener('click', closeFullScreenStudio);

  // Click / Tap on 3D Building to open CAD Studio (distinguishing quick click vs drag)
  let canvasClickStart = { x: 0, y: 0 };
  let touchClickStart = { x: 0, y: 0 };

  canvas?.addEventListener('mousedown', (e) => {
    canvasClickStart = { x: e.clientX, y: e.clientY };
  });

  canvas?.addEventListener('mouseup', (e) => {
    const dx = Math.abs(e.clientX - canvasClickStart.x);
    const dy = Math.abs(e.clientY - canvasClickStart.y);
    if (dx < 6 && dy < 6 && !studioCard?.classList.contains('studio-fullscreen')) {
      openFullScreenStudio();
    }
  });

  canvas?.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1) {
      touchClickStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  }, { passive: true });

  canvas?.addEventListener('touchend', (e) => {
    if (e.changedTouches.length === 1) {
      const dx = Math.abs(e.changedTouches[0].clientX - touchClickStart.x);
      const dy = Math.abs(e.changedTouches[0].clientY - touchClickStart.y);
      if (dx < 8 && dy < 8 && !studioCard?.classList.contains('studio-fullscreen')) {
        openFullScreenStudio();
      }
    }
  }, { passive: true });

  // Global event listener for "For Geeks: Test 3D Twin" from Hero or Navbar -> Open Architectural Subwindow
  window.addEventListener('open-clearinfra-studio', openFullScreenStudio);
  window.addEventListener('close-clearinfra-studio', closeFullScreenStudio);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && studioCard?.classList.contains('studio-fullscreen')) {
      closeFullScreenStudio();
    }
  });
</script>



