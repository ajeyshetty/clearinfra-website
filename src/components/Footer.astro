---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0F172A] text-slate-400 py-14 text-sm border-t border-slate-800">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/[0.08]">
      <!-- Brand -->
      <div class="md:col-span-5 space-y-3">
        <a href="/" class="inline-flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#07090e] border border-white/10 flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 40 40" fill="none">
              <path d="M27 9H13L8 14V26L13 31H27" stroke="#f8fafc" stroke-width="2.8" stroke-linecap="square" stroke-linejoin="miter"/>
              <line x1="22" y1="14" x2="22" y2="26" stroke="#10b981" stroke-width="2.5" stroke-linecap="square"/>
              <line x1="27.5" y1="12" x2="27.5" y2="28" stroke="#10b981" stroke-width="2.5" stroke-linecap="square" stroke-opacity="0.55"/>
              <line x1="33" y1="9" x2="33" y2="31" stroke="#10b981" stroke-width="3" stroke-linecap="square"/>
            </svg>
          </div>
          <span class="text-base font-semibold tracking-tight text-white">
            Clearinfra
          </span>
        </a>
        <p class="text-xs sm:text-sm text-slate-400 max-w-md leading-relaxed">
          Building physics, thermal &amp; daylight engineering, and code compliance consulting—powered by our proprietary physics engine, native AI optimizer, and NBC/ECBC compliance platform.
        </p>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-3 space-y-2.5">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-200 block">Practice</span>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
          <li><a href="#services" class="hover:text-white transition-colors">Advisory Services</a></li>
          <li><a href="#engine" class="hover:text-white transition-colors">Native AI &amp; Physics Engine</a></li>
          <li><a href="#compliance" class="hover:text-white transition-colors">NBC &amp; ECBC Compliance Module</a></li>
          <li><a href="#workflow" class="hover:text-white transition-colors">How We Work</a></li>
          <li><a href="#contact" class="hover:text-white transition-colors">Discuss a Project</a></li>
        </ul>
      </div>

      <!-- Standards Reference -->
      <div class="md:col-span-4 space-y-2.5">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-200 block">Codes &amp; Standards</span>
        <ul class="space-y-2 text-xs font-mono text-slate-400">
          <li>National Building Code of India (NBC 2016 Part 3, 4 &amp; 8)</li>
          <li>Energy Conservation Building Code (ECBC 2017)</li>
          <li>IGBC, GRIHA &amp; LEED Compliance Pathways</li>
          <li>ISO 13790 &amp; ASHRAE Psychrometrics</li>
          <li>EnergyPlus v25.1 Simulation Submittals</li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        &copy; {currentYear} Clearinfra. All rights reserved.
      </div>
      <div class="font-mono">
        <a href="mailto:contact@clearinfra.in" class="hover:text-slate-300 transition-colors">contact@clearinfra.in</a>
      </div>
    </div>
  </div>
</footer>
