---
---

<header class="sticky top-0 z-50 w-full border-b border-slate-900/[0.08] bg-[#F7F6F2]/85 backdrop-blur-xl">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24 h-18 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
      <svg class="w-7 h-7 shrink-0 transition-transform duration-200 group-hover:scale-105" viewBox="0 0 40 40" fill="none">
        <path d="M27 9H13L8 14V26L13 31H27" stroke="#0f172a" stroke-width="2.8" stroke-linecap="square" stroke-linejoin="miter"/>
        <line x1="22" y1="14" x2="22" y2="26" stroke="#0d9488" stroke-width="2.5" stroke-linecap="square"/>
        <line x1="27.5" y1="12" x2="27.5" y2="28" stroke="#0d9488" stroke-width="2.5" stroke-linecap="square" stroke-opacity="0.6"/>
        <line x1="33" y1="9" x2="33" y2="31" stroke="#0d9488" stroke-width="3" stroke-linecap="square"/>
      </svg>
      <div class="flex items-baseline gap-2.5">
        <span class="text-lg font-semibold tracking-tight text-slate-900 group-hover:text-slate-950 transition-colors">
          Clearinfra
        </span>
        <span class="hidden sm:inline-block text-[10px] font-mono uppercase tracking-widest text-slate-500 border-l border-slate-900/15 pl-2.5">
          Engineering &amp; Advisory
        </span>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
      <a href="#services" class="hover:text-slate-950 transition-colors">Advisory Services</a>
      <a href="#engine" class="hover:text-slate-950 transition-colors">AI &amp; Physics Engine</a>
      <a href="#compliance" class="hover:text-slate-950 transition-colors">NBC &amp; ECBC Module</a>
      <a href="#workflow" class="hover:text-slate-950 transition-colors">How We Work</a>
    </nav>

    <!-- Single Refined CTA -->
    <div class="flex items-center">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-medium bg-teal-900 hover:bg-teal-950 text-white shadow-sm shadow-teal-950/20 transition-all duration-200"
      >
        <span>Discuss a Project</span>
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
