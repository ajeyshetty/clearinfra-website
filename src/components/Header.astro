---
---

<header class="sticky top-0 z-50 w-full border-b border-white/[0.06] bg-[#07090e]/80 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-8 h-8 rounded-lg bg-slate-900 border border-white/10 group-hover:border-emerald-500/40 flex items-center justify-center transition-colors duration-300">
        <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5"></path>
          <path d="M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-base font-semibold tracking-tight text-white">
          Clearinfra
        </span>
        <span class="hidden sm:inline-block text-[10px] font-mono uppercase tracking-widest text-slate-500">
          Engineering &amp; Advisory
        </span>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm text-slate-400">
      <a href="#services" class="hover:text-white transition-colors">Advisory Services</a>
      <a href="#engine" class="hover:text-white transition-colors">Proprietary Engine</a>
      <a href="#interactive-demo" class="hover:text-white transition-colors">Live Simulation</a>
      <a href="#workflow" class="hover:text-white transition-colors">How We Work</a>
    </nav>

    <!-- Single Refined CTA -->
    <div class="flex items-center">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs sm:text-sm font-medium bg-white/[0.06] hover:bg-white/[0.1] text-white border border-white/10 hover:border-emerald-500/40 transition-all duration-200"
      >
        <span>Discuss a Project</span>
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
