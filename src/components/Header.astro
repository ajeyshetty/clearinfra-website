---
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#131924]/95 backdrop-blur-xl">
  <div class="w-full max-w-[1680px] mx-auto px-5 sm:px-8 xl:px-16 2xl:px-24 h-18 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
      <svg class="w-7 h-7 shrink-0 transition-transform duration-200 group-hover:scale-105" viewBox="0 0 40 40" fill="none">
        <path d="M27 9H13L8 14V26L13 31H27" stroke="#ffffff" stroke-width="2.8" stroke-linecap="square" stroke-linejoin="miter"/>
        <line x1="22" y1="14" x2="22" y2="26" stroke="#00c4df" stroke-width="2.5" stroke-linecap="square"/>
        <line x1="27.5" y1="12" x2="27.5" y2="28" stroke="#00c4df" stroke-width="2.5" stroke-linecap="square" stroke-opacity="0.6"/>
        <line x1="33" y1="9" x2="33" y2="31" stroke="#00c4df" stroke-width="3" stroke-linecap="square"/>
      </svg>
      <div class="flex items-center gap-2.5">
        <span class="text-lg font-semibold tracking-tight text-white group-hover:text-cyan-300 transition-colors whitespace-nowrap">
          Clearinfra
        </span>
        <span class="hidden xl:inline-block text-[10px] font-mono uppercase tracking-widest text-slate-400 border-l border-white/15 pl-2.5 whitespace-nowrap">
          Engineering &amp; Advisory
        </span>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-xs xl:text-sm font-medium text-slate-300">
      <a href="#services" class="hover:text-white transition-colors whitespace-nowrap">Services</a>
      <a href="#engine" class="hover:text-white transition-colors whitespace-nowrap">Technology</a>
      <a href="#compliance" class="hover:text-white transition-colors whitespace-nowrap">Compliance</a>
      <a href="#workflow" class="hover:text-white transition-colors whitespace-nowrap">Methodology</a>
    </nav>

    <!-- Single Refined CTA -->
    <div class="flex items-center shrink-0">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-medium bg-[#1C2536] hover:bg-[#232F44] text-white border border-white/15 hover:border-emerald-500/40 shadow-sm transition-all duration-200 whitespace-nowrap shrink-0"
      >
        <span>Discuss a Project</span>
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
