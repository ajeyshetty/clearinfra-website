---
---

<header id="site-header" class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#131924]/92 backdrop-blur-xl transition-all duration-300">
  <div id="header-nav-container" class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24 h-18 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
      <svg class="w-7 h-7 shrink-0 transition-transform duration-200 group-hover:scale-105" viewBox="0 0 40 40" fill="none">
        <path d="M27 9H13L8 14V26L13 31H27" stroke="#ffffff" stroke-width="2.8" stroke-linecap="square" stroke-linejoin="miter"/>
        <line x1="22" y1="14" x2="22" y2="26" stroke="#00c4df" stroke-width="2.5" stroke-linecap="square"/>
        <line x1="27.5" y1="12" x2="27.5" y2="28" stroke="#00c4df" stroke-width="2.5" stroke-linecap="square" stroke-opacity="0.6"/>
        <line x1="33" y1="9" x2="33" y2="31" stroke="#00c4df" stroke-width="3" stroke-linecap="square"/>
      </svg>
      <div class="flex items-center gap-2.5">
        <span class="text-lg font-semibold tracking-tight text-white group-hover:text-cyan-300 transition-colors whitespace-nowrap">
          Clearinfra
        </span>
        <span class="hidden xl:inline-block text-[10px] font-mono uppercase tracking-widest text-slate-400 border-l border-white/15 pl-2.5 whitespace-nowrap">
          Engineering &amp; Advisory
        </span>
      </div>
    </a>

    <!-- Navigation with Live Section Scroll-Spy -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-xs xl:text-sm font-medium text-slate-300">
      <a href="#services" data-spy-link="services" class="spy-nav-link flex items-center gap-1.5 hover:text-white transition-colors whitespace-nowrap">
        <span class="spy-dot w-1.5 h-1.5 rounded-full bg-emerald-400 opacity-0 scale-0 transition-all duration-200"></span>
        <span>Services</span>
      </a>
      <a href="#engine" data-spy-link="engine" class="spy-nav-link flex items-center gap-1.5 hover:text-white transition-colors whitespace-nowrap">
        <span class="spy-dot w-1.5 h-1.5 rounded-full bg-emerald-400 opacity-0 scale-0 transition-all duration-200"></span>
        <span>Technology</span>
      </a>
      <a href="#compliance" data-spy-link="compliance" class="spy-nav-link flex items-center gap-1.5 hover:text-white transition-colors whitespace-nowrap">
        <span class="spy-dot w-1.5 h-1.5 rounded-full bg-emerald-400 opacity-0 scale-0 transition-all duration-200"></span>
        <span>Compliance</span>
      </a>
      <a href="#workflow" data-spy-link="workflow" class="spy-nav-link flex items-center gap-1.5 hover:text-white transition-colors whitespace-nowrap">
        <span class="spy-dot w-1.5 h-1.5 rounded-full bg-emerald-400 opacity-0 scale-0 transition-all duration-200"></span>
        <span>Methodology</span>
      </a>
    </nav>

    <!-- Right Actions: CTA + Mobile Hamburger -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      <a
        href="#contact"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-medium bg-[#1C2536] hover:bg-[#232F44] text-white border border-white/15 hover:border-emerald-500/40 shadow-sm transition-all duration-200 whitespace-nowrap shrink-0"
      >
        <span>Discuss a Project</span>
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="lg:hidden p-1.5 sm:p-2 rounded-lg text-slate-300 hover:text-white border border-white/12 bg-[#1C2536] hover:bg-[#232F44] transition-colors flex items-center justify-center shrink-0"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-4.5 h-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Precision 1.5px Architectural Scroll Progress Hairline -->
  <div id="header-scroll-track" class="pointer-events-none absolute bottom-0 left-0 right-0 h-[1.5px] max-h-[1.5px] bg-transparent overflow-hidden">
    <div
      id="header-scroll-progress"
      class="h-[1.5px] max-h-[1.5px] w-0 bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-400 transition-[width] duration-75 ease-out"
    ></div>
  </div>

  <!-- Architectural Mobile Navigation Drawer (< lg) -->
  <div
    id="mobile-nav-drawer"
    class="hidden lg:hidden border-t border-white/10 bg-[#0F141E]/98 backdrop-blur-2xl px-5 sm:px-8 py-4 transition-all duration-200 shadow-2xl"
  >
    <div class="space-y-1">
      <span class="text-[9px] font-mono uppercase tracking-widest text-slate-500 block mb-2 px-3">
        Navigation Index // 01 — 05
      </span>
      
      <a
        href="#services"
        class="mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-lg text-xs sm:text-sm font-medium text-slate-200 hover:text-white hover:bg-white/[0.05] transition-colors"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-mono text-emerald-400 font-semibold">01</span>
          <span>Advisory Services</span>
        </div>
        <span class="text-[10px] font-mono text-slate-500 uppercase">Consulting</span>
      </a>

      <a
        href="#engine"
        class="mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-lg text-xs sm:text-sm font-medium text-slate-200 hover:text-white hover:bg-white/[0.05] transition-colors"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-mono text-emerald-400 font-semibold">02</span>
          <span>Core Technology</span>
        </div>
        <span class="text-[10px] font-mono text-slate-500 uppercase">Topology</span>
      </a>

      <a
        href="#compliance"
        class="mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-lg text-xs sm:text-sm font-medium text-slate-200 hover:text-white hover:bg-white/[0.05] transition-colors"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-mono text-emerald-400 font-semibold">03</span>
          <span>NBC &amp; ECBC Compliance</span>
        </div>
        <span class="text-[10px] font-mono text-slate-500 uppercase">Graph-RAG</span>
      </a>

      <a
        href="#workflow"
        class="mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-lg text-xs sm:text-sm font-medium text-slate-200 hover:text-white hover:bg-white/[0.05] transition-colors"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-mono text-emerald-400 font-semibold">04</span>
          <span>Practice Methodology</span>
        </div>
        <span class="text-[10px] font-mono text-slate-500 uppercase">Workflow</span>
      </a>

      <a
        href="#contact"
        class="mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-lg text-xs sm:text-sm font-medium text-emerald-300 hover:bg-emerald-500/10 transition-colors"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-mono text-emerald-400 font-semibold">05</span>
          <span>Engage Practice / Contact</span>
        </div>
        <span class="text-[10px] font-mono text-emerald-400">Inquiry →</span>
      </a>
    </div>

    <div class="mt-3.5 pt-3 border-t border-white/10 flex items-center justify-between text-[10px] font-mono text-slate-400 px-3">
      <span>Clearinfra Studio</span>
      <span class="text-emerald-400">Bengaluru, IN</span>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      drawer?.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'true');
    } else {
      drawer?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  toggleBtn?.addEventListener('click', toggleMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });

  // Scroll Progress Hairline, Header Elevation & Section Scroll-Spy
  const siteHeader = document.getElementById('site-header');
  const progressBar = document.getElementById('header-scroll-progress');
  const spyLinks = document.querySelectorAll<HTMLAnchorElement>('.spy-nav-link');
  const spyTargets = ['services', 'engine', 'compliance', 'workflow'];

  function updateHeaderScroll() {
    const scrollY = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollY / docHeight) * 100)) : 0;

    if (progressBar) {
      progressBar.style.width = `${pct.toFixed(1)}%`;
    }

    if (siteHeader) {
      if (scrollY > 24) {
        siteHeader.classList.add('shadow-xl', 'shadow-slate-950/30', 'bg-[#0F141E]/95');
        siteHeader.classList.remove('bg-[#131924]/92');
      } else {
        siteHeader.classList.remove('shadow-xl', 'shadow-slate-950/30', 'bg-[#0F141E]/95');
        siteHeader.classList.add('bg-[#131924]/92');
      }
    }

    // Determine active section in viewport
    let activeId = '';
    const triggerLine = scrollY + window.innerHeight * 0.32;
    for (const id of spyTargets) {
      const el = document.getElementById(id);
      if (el) {
        const top = el.getBoundingClientRect().top + scrollY;
        if (triggerLine >= top) {
          activeId = id;
        }
      }
    }

    spyLinks.forEach((link) => {
      const id = link.getAttribute('data-spy-link');
      const dot = link.querySelector('.spy-dot');
      if (id === activeId && scrollY > 180) {
        link.classList.add('text-white');
        link.classList.remove('text-slate-300');
        dot?.classList.remove('opacity-0', 'scale-0');
        dot?.classList.add('opacity-100', 'scale-100');
      } else {
        link.classList.remove('text-white');
        link.classList.add('text-slate-300');
        dot?.classList.add('opacity-0', 'scale-0');
        dot?.classList.remove('opacity-100', 'scale-100');
      }
    });
  }

  window.addEventListener('scroll', updateHeaderScroll, { passive: true });
  updateHeaderScroll();
</script>

<style>
  @media (max-height: 760px) {
    #site-header #header-nav-container {
      height: 3.5rem !important;
    }
  }
  @media (max-height: 640px) {
    #site-header #header-nav-container {
      height: 3rem !important;
    }
  }
  #header-scroll-track {
    height: 1.5px !important;
    max-height: 1.5px !important;
  }
  #header-scroll-progress {
    height: 1.5px !important;
    max-height: 1.5px !important;
  }
</style>
