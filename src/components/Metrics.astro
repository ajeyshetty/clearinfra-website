---
const specs = [
  {
    value: "8,760 hrs",
    label: "Hourly Thermal Resolution",
    desc: "Full-year dry-bulb, wet-bulb, and solar radiation simulation across all 5 Indian climate zones."
  },
  {
    value: "Native AI",
    label: "Agentic Design Optimizer",
    desc: "Built-in engineering agent wired directly to the 3D geometry and physics engine for live Pareto search."
  },
  {
    value: "NBC + ECBC",
    label: "Graph-RAG Code Engine",
    desc: "Automated clause-level verification against NBC 2016 (Part 3, 4 & 8) and ECBC 2017 standards."
  },
  {
    value: "IDF Export",
    label: "EnergyPlus Interoperability",
    desc: "Generates validated EnergyPlus v25.1 input files for downstream audit and green rating submittals."
  }
];
---

<section class="border-y border-slate-900/10 bg-[#F7F6F2] py-8 sm:py-12 lg:py-14">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-6 sm:gap-8 lg:gap-12">
      {specs.map((item, idx) => (
        <div class={`reveal reveal-delay-${Math.min(idx, 3)} flex flex-col space-y-1 sm:space-y-1.5 border-l-2 border-emerald-600/60 pl-3.5 sm:pl-6`}>
          <span class="text-xl sm:text-2xl lg:text-3xl font-semibold text-slate-900 font-mono tracking-tight">
            {item.value}
          </span>
          <span class="text-[10px] sm:text-xs font-mono text-emerald-800 font-semibold uppercase tracking-wider leading-snug">
            {item.label}
          </span>
          <p class="text-[11px] sm:text-xs lg:text-sm text-slate-600 leading-relaxed pt-0.5 sm:pt-1">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Software & BIM/CAD Interoperability Pipeline Strip -->
    <div class="mt-12 pt-7 border-t border-slate-900/10 flex flex-col xl:flex-row xl:items-center justify-between gap-4 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-800 font-semibold text-[11px] uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
        <span>Compatible Practice Pipelines:</span>
      </div>
      <div class="flex flex-wrap items-center gap-x-3 sm:gap-x-5 gap-y-2 text-slate-600 text-xs">
        <span class="hover:text-slate-900 transition-colors whitespace-nowrap">Autodesk Revit (BIM)</span>
        <span class="text-slate-300 hidden sm:inline">·</span>
        <span class="hover:text-slate-900 transition-colors whitespace-nowrap">Rhino 3D &amp; Grasshopper</span>
        <span class="text-slate-300 hidden sm:inline">·</span>
        <span class="hover:text-slate-900 transition-colors whitespace-nowrap">AutoCAD .dwg / .dxf</span>
        <span class="text-slate-300 hidden sm:inline">·</span>
        <span class="hover:text-slate-900 transition-colors whitespace-nowrap">EnergyPlus v25.1 (.idf)</span>
        <span class="text-slate-300 hidden sm:inline">·</span>
        <span class="hover:text-slate-900 transition-colors whitespace-nowrap">OpenStudio &amp; Radiance</span>
      </div>
    </div>
  </div>
</section>
