---
const specs = [
  {
    value: "8,760 hrs",
    label: "Hourly Thermal Resolution",
    desc: "Full-year dry-bulb, wet-bulb, and solar radiation simulation across all 5 Indian climate zones."
  },
  {
    value: "Built-in AI",
    label: "27-Tool Copilot",
    desc: "Built-in engineering agent wired directly to 3D geometry and ISO 52016-1 physics for automated scenario evaluation."
  },
  {
    value: "NBC 2026 + ECBC",
    label: "Clause-Level Code Engine",
    desc: "Structured clause checks across NBC 2026 (Parts B–F), local development control byelaws, and ECBC 2017 with human review."
  },
  {
    value: "IDF Export",
    label: "EnergyPlus Interoperability",
    desc: "Generates syntax-verified EnergyPlus v25.1 input files (.idf) for downstream design review and supporting statutory submittals."
  }
];
---

<section class="border-y border-slate-900/10 bg-[#F7F6F2] py-8 sm:py-12 lg:py-14">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-6 sm:gap-8 lg:gap-12">
      {specs.map((item, idx) => (
        <div class={`reveal reveal-delay-${Math.min(idx, 3)} flex flex-col space-y-1 sm:space-y-1.5 border-l-2 border-emerald-600/60 pl-3.5 sm:pl-6`}>
          <span class="text-xl sm:text-2xl lg:text-3xl font-semibold text-slate-900 font-mono tracking-tight">
            {item.value}
          </span>
          <span class="text-[10px] sm:text-xs font-mono text-emerald-800 font-semibold uppercase tracking-wider leading-snug">
            {item.label}
          </span>
          <p class="text-[11px] sm:text-xs lg:text-sm text-slate-600 leading-relaxed pt-0.5 sm:pt-1">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Software & BIM/CAD Interoperability Pipeline Strip -->
    <div class="mt-8 sm:mt-12 pt-6 sm:pt-7 border-t border-slate-900/10">
      <div class="rounded-xl bg-white/70 border border-slate-900/10 p-3 sm:p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3 lg:gap-4 shadow-xs">
        <div class="flex items-center gap-2 text-slate-800 font-mono font-semibold text-[10.5px] sm:text-[11px] uppercase tracking-wider shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>Supported Formats &amp; Toolchains:</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:flex lg:flex-wrap items-center gap-2 sm:gap-2.5 text-slate-700 text-xs font-mono">
          <div class="flex items-center justify-between sm:justify-start gap-2 px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-xs shadow-2xs">
            <span class="font-medium text-slate-900">AutoCAD .dwg / .dxf</span>
            <span class="text-[9px] uppercase font-mono px-1.5 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200 font-semibold shrink-0">Import</span>
          </div>
          <div class="flex items-center justify-between sm:justify-start gap-2 px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-xs shadow-2xs">
            <span class="font-medium text-slate-900">EnergyPlus v25.1</span>
            <span class="text-[9px] uppercase font-mono px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold shrink-0">.idf Export</span>
          </div>
          <div class="flex items-center justify-between sm:justify-start gap-2 px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-xs shadow-2xs">
            <span class="font-medium text-slate-900">Revit · Rhino 3D</span>
            <span class="text-[9px] uppercase font-mono px-1.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 font-semibold shrink-0">Coordinate Export</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
