---
const outcomes = [
  {
    kpi: "Right-size",
    label: "Mechanical plant",
    sub: "Screen before procurement",
    desc: "Compare envelope, glazing, internal-load and ventilation options before plant capacity is fixed. The aim is to avoid unnecessary cooling capacity; savings depend on the project."
  },
  {
    kpi: "Compare",
    label: "Energy demand",
    sub: "Option by option",
    desc: "Test design choices on estimated annual energy use and peak load. The result is an option comparison, not a bill forecast or a certification outcome."
  },
  {
    kpi: "Pre-check",
    label: "Code and byelaws",
    sub: "Clause-cited review",
    desc: "Run applicable NBC 2026 and ECBC checks where the project inputs exist, with engineer review. A pass is a design-stage check; statutory approval remains with the authority."
  },
  {
    kpi: "Live",
    label: "Design charrettes",
    sub: "Same-room decisions",
    desc: "Architects, MEP engineers and developers compare options in one working session. The output is a documented set of trade-offs for the design team to take forward."
  }
];
---

<section id="outcomes" class="border-y border-white/10 bg-[#0A0E17] py-12 sm:py-16 lg:py-20 relative overflow-hidden text-white">
  <!-- Subtle Blueprint Grid -->
  <div class="absolute inset-0 bg-blueprint-sub pointer-events-none opacity-20" aria-hidden="true"></div>
  
  <!-- Subtle Ambient Depth Mesh -->
  <div class="absolute -top-32 right-1/4 w-[600px] h-[600px] bg-emerald-500/[0.04] rounded-full blur-3xl pointer-events-none"></div>

  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24 relative z-10">
    
    <!-- Section Header: 50/50 Split Datum -->
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-10 items-end text-center sm:text-left mb-8 sm:mb-12">
      <div class="lg:col-span-6 space-y-2 mx-auto sm:mx-0">
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/[0.06] border border-white/15 text-emerald-300 text-[10px] sm:text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>WHERE WE FOCUS</span>
        </div>
        <h2 class="ci-section-title text-white">
          <span class="block">Engineering decisions</span>
          <span class="block text-emerald-400">that shape cost and performance.</span>
        </h2>
      </div>
      <div class="lg:col-span-6 relative sm:pl-6 lg:pl-8 py-1 mx-auto sm:mx-0">
        <div class="hidden sm:block datum-line-v absolute left-0 top-1 bottom-1 w-[2px] rounded-full bg-gradient-to-b from-emerald-500 via-emerald-500/40 to-transparent" aria-hidden="true"></div>
        <p class="ci-section-lead text-slate-300">
          Cooling capacity is often fixed before envelope and internal-load assumptions are tested. We test those assumptions together, so the design team can make a more informed plant, envelope and code decision. Results remain project-specific.
        </p>
      </div>
    </div>

    <!-- MOBILE SNAP-SCROLL TOUCH DECK (< 768px) -->
    <div class="md:hidden">
      <!-- Status & Swipe Hint -->
      <div class="flex items-center justify-between mb-3 px-1 text-slate-400 font-mono text-[10px]">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="outcome-deck-counter" class="font-semibold text-slate-200">01 / 04 FOCUS AREAS</span>
        </div>
        <div class="flex items-center gap-1 text-[11px] text-slate-400">
          <span class="text-[9px] uppercase tracking-wider">Swipe deck</span>
          <span>→</span>
        </div>
      </div>

      <!-- Snap Track with peek on right -->
      <div 
        id="outcome-carousel"
        class="flex gap-3.5 overflow-x-auto pb-3 pt-1 snap-x snap-mandatory scrollbar-none -mx-6 px-6"
        style="scroll-behavior: smooth; -webkit-overflow-scrolling: touch;"
      >
        {outcomes.map((item, idx) => (
          <div 
            data-outcome-card={idx}
            class="snap-center shrink-0 w-[82vw] max-w-[310px] rounded-2xl bg-[#131924] border border-white/10 p-5 shadow-xl flex flex-col justify-between text-left"
          >
            <div>
              <div class="flex items-center justify-between pb-2.5 mb-2.5 border-b border-white/[0.08]">
                <span class="text-xs font-mono text-slate-400 font-medium">0{idx + 1}</span>
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              </div>
              
              <div class="text-2xl font-semibold text-white font-mono tracking-tight tabular-nums">
                {item.kpi}
              </div>
              
              <h3 class="text-sm font-semibold text-white mt-1.5 leading-snug">
                {item.label}
              </h3>
              
              <p class="text-[11px] font-mono text-emerald-400 font-medium mt-1 leading-snug">
                {item.sub}
              </p>
              
              <p class="text-xs text-slate-300 leading-relaxed mt-2.5 pt-2.5 border-t border-white/[0.08]">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Dot Indicators -->
      <div class="flex items-center justify-center gap-1.5 pt-2" id="outcome-dots">
        {outcomes.map((_, idx) => (
          <button
            type="button"
            data-outcome-dot-index={idx}
            class={`outcome-dot h-1.5 rounded-full transition-all duration-200 ${idx === 0 ? 'w-5 bg-emerald-400' : 'w-1.5 bg-slate-700'}`}
            aria-label={`Jump to focus area ${idx + 1}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- DESKTOP / TABLET GRID (>= 768px) -->
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-6 xl:gap-8">
      {outcomes.map((item, idx) => (
        <div class={`reveal reveal-delay-${idx + 1} rounded-2xl bg-[#131924] border border-white/10 p-5 sm:p-6 shadow-xl hover:shadow-2xl hover:border-emerald-500/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between text-left group`}>
          <div>
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/[0.08]">
              <span class="text-xs font-mono text-slate-400 font-medium">0{idx + 1}</span>
              <span class="w-2 h-2 rounded-full bg-slate-700 group-hover:bg-emerald-400 transition-colors"></span>
            </div>
            
            <div class="text-2xl sm:text-3xl lg:text-3xl xl:text-4xl font-semibold text-white font-mono tracking-tight tabular-nums">
              {item.kpi}
            </div>
            
            <h3 class="text-sm sm:text-base font-semibold text-white mt-2 leading-snug">
              {item.label}
            </h3>
            
            <p class="text-[11px] sm:text-xs font-mono text-emerald-400 font-medium mt-1 leading-snug">
              {item.sub}
            </p>
            
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mt-3 pt-3 border-t border-white/[0.08]">
              {item.desc}
            </p>
          </div>
          
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const outcomeCarousel = document.getElementById('outcome-carousel');
  const outcomeCounter = document.getElementById('outcome-deck-counter');
  const outcomeDots = document.querySelectorAll('.outcome-dot');
  const outcomeCards = document.querySelectorAll<HTMLElement>('[data-outcome-card]');

  let outcomeCurrentIndex = 0;
  const outcomeTotal = outcomeCards.length;

  function updateActiveOutcomeCard(index: number) {
    if (index < 0 || index >= outcomeTotal) return;
    outcomeCurrentIndex = index;
    if (outcomeCounter) {
      outcomeCounter.textContent = `0${index + 1} / 0${outcomeTotal} FOCUS AREAS`;
    }
    outcomeDots.forEach((dot, idx) => {
      if (idx === index) {
        dot.className = 'outcome-dot h-1.5 rounded-full transition-all duration-200 w-5 bg-emerald-400';
      } else {
        dot.className = 'outcome-dot h-1.5 rounded-full transition-all duration-200 w-1.5 bg-slate-700';
      }
    });
  }

  function scrollToOutcomeCard(index: number) {
    if (!outcomeCarousel || !outcomeCards[index]) return;
    const card = outcomeCards[index];
    outcomeCarousel.scrollTo({
      left: card.offsetLeft - outcomeCarousel.offsetLeft,
      behavior: 'smooth'
    });
    updateActiveOutcomeCard(index);
  }

  if (outcomeCarousel) {
    let scrollTimeout: number | undefined;
    outcomeCarousel.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(() => {
        const scrollLeft = outcomeCarousel.scrollLeft;
        let closestIndex = 0;
        let minDiff = Infinity;
        outcomeCards.forEach((card, idx) => {
          const cardLeft = card.offsetLeft - outcomeCarousel.offsetLeft;
          const diff = Math.abs(cardLeft - scrollLeft);
          if (diff < minDiff) {
            minDiff = diff;
            closestIndex = idx;
          }
        });
        updateActiveOutcomeCard(closestIndex);
      }, 50);
    }, { passive: true });
  }

  outcomeDots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.getAttribute('data-outcome-dot-index'));
      scrollToOutcomeCard(idx);
    });
  });
</script>
