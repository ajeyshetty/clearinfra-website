---
---

<section id="hero" class="relative min-h-[calc(100dvh-var(--header-height,4.5rem))] lg:h-[calc(100dvh-var(--header-height,4.5rem))] flex flex-col justify-center bg-[#0A0E17] text-white overflow-hidden border-b border-white/10">
  
  <!-- Full-Bleed Landmark Architectural Tower Background with Cinematic Video -->
  <div class="absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <img
      src="/images/landmark-glass-tower.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-[center_20%] lg:object-right filter brightness-[0.92] contrast-[1.08]"
      loading="eager"
    />
    <video
      id="hero-bg-video"
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      disablepictureinpicture
      preload="auto"
      poster="/images/landmark-glass-tower.jpg"
      class="absolute inset-0 w-full h-full object-cover object-[center_20%] lg:object-right filter brightness-[0.92] contrast-[1.08] pointer-events-none"
    >
      <source src="/videos/hero-tower-loop.mp4" type="video/mp4" />
    </video>

    <!-- Desktop Asymmetric Gradient (Slate on Left for Typography, Clear on Right for Tower) -->
    <div class="hidden lg:block absolute inset-0 bg-gradient-to-r from-[#0A0E17] via-[#0A0E17]/90 to-[#0A0E17]/35 pointer-events-none"></div>
    <div class="hidden lg:block absolute -left-20 top-1/2 -translate-y-1/2 w-[760px] h-[680px] bg-[#0A0E17]/95 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Atmospheric Emerald Ambient Backlight Glow behind typography -->
    <div class="hidden lg:block absolute left-10 top-1/2 -translate-y-1/2 w-[540px] h-[480px] bg-emerald-500/[0.08] rounded-full blur-[110px] pointer-events-none"></div>

    <!-- Mobile Architectural Scrim: Rich Translucent Vignette that Keeps Tower Facade & Light Vivid -->
    <div class="lg:hidden absolute inset-0 bg-gradient-to-b from-[#0A0E17]/75 via-[#0A0E17]/55 to-[#0A0E17]/92 pointer-events-none"></div>
    
    <!-- Ambient Emerald Backlight Pool on Mobile to give Depth & Eliminate Pale Black Void -->
    <div class="lg:hidden absolute left-1/2 top-1/3 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-emerald-500/[0.16] rounded-full blur-3xl pointer-events-none"></div>

    <!-- Subtle Architectural Drafting Grid Watermark -->
    <div class="absolute inset-0 bg-blueprint-sub opacity-20 pointer-events-none"></div>
  </div>

  <div class="w-full max-w-[1680px] mx-auto px-5 sm:px-10 lg:px-16 2xl:px-24 py-6 sm:py-10 relative z-10 flex flex-col justify-center flex-1 h-full">
    
    <!-- Main Content: Centered on Mobile, Left-Aligned on Desktop with Architectural Datum Line -->
    <div class="max-w-5xl relative lg:pl-8 text-center lg:text-left mx-auto lg:mx-0 my-auto">
      
      <!-- Architectural Emerald Datum Line (Left Edge Precision Anchor) -->
      <div class="hidden lg:block absolute left-0 top-2 bottom-2 w-[2px] bg-gradient-to-b from-emerald-400 via-emerald-500/50 to-emerald-500/10 rounded-full shadow-[0_0_12px_rgba(52,211,153,0.35)] origin-top hero-anim-datum" aria-hidden="true"></div>

      <div class="space-y-4 sm:space-y-5 lg:space-y-6">
        
        <!-- Eyebrow Pill with Live Radar Beacon -->
        <div class="hero-anim-1 inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-950/80 backdrop-blur-md border border-emerald-500/30 text-emerald-300 text-[10px] sm:text-xs font-mono tracking-wider mx-auto lg:mx-0 shadow-lg shadow-emerald-950/40">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-medium text-emerald-200">BUILDING SCIENCE &amp; STATUTORY ADVISORY</span>
          <span class="hidden sm:inline-block text-[10px] text-emerald-400/80 border-l border-emerald-500/30 pl-2">EARLY-DESIGN ADVISORY</span>
        </div>

        <!-- Monumental H1 Question: Scaled, Muscular, Cinematic -->
        <h1 class="hero-anim-2 hero-headline text-white font-semibold tracking-[-0.035em] leading-[1.08] text-center lg:text-left drop-shadow-md">
          <span class="block text-white">Who said a <span class="whitespace-nowrap">high-performance</span> building</span>
          <span class="block text-slate-100">has to cost more <span class="relative inline-block whitespace-nowrap text-emerald-400 drop-shadow-[0_0_24px_rgba(52,211,153,0.35)] hero-accent-pulse">to build?<svg class="absolute -bottom-1 sm:-bottom-1.5 left-0 w-full h-2 text-emerald-400/80 pointer-events-none overflow-visible" viewBox="0 0 120 8" fill="none" preserveAspectRatio="none"><path d="M0 4 Q 15 0, 30 4 T 60 4 T 90 4 T 120 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg></span></span>
        </h1>

        <!-- The Commercial Hook & Interactive "smarter." 3D Gateway (Option 1) -->
        <div class="hero-anim-3 max-w-2xl mx-auto lg:mx-0">
          <div class="flex items-center justify-center lg:justify-start flex-wrap gap-x-2.5 gap-y-2 text-base sm:text-lg lg:text-xl xl:text-2xl font-normal text-slate-200/90 leading-snug drop-shadow-sm">
            <span class="text-slate-200/95 font-normal whitespace-nowrap">
              Together, we engineer
            </span>

            <!-- Interactive "smarter." Gateway Pill (Launches 3D Twin) -->
            <button
              type="button"
              id="hero-smarter-science-trigger"
              class="tech-badge-container relative -top-[1.5px] sm:-top-[2px] inline-flex items-center group cursor-pointer select-none focus:outline-none align-middle"
              aria-label="Launch Clearinfra Studio 3D Twin Sandbox"
            >
              <!-- Circuit Trace Accent Line (extending delicately from the right) -->
              <svg class="circuit-trace-svg absolute left-full top-1/2 -translate-y-1/2 w-8 h-4 pointer-events-none overflow-visible text-emerald-400/60 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 32 16" fill="none">
                <path class="circuit-trace-path" d="M0 8h14l5-5h11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                <circle cx="29" cy="3" r="1.5" fill="currentColor" />
              </svg>

              <!-- Core Pill / Chip Container -->
              <span class="smarter-science-pill relative inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1 rounded-full bg-[#0A1419]/90 hover:bg-[#0E1B22] backdrop-blur-md border border-emerald-400/40 hover:border-emerald-300 text-emerald-300 hover:text-emerald-200 font-mono text-xs sm:text-sm font-medium tracking-tight shadow-[0_0_16px_rgba(52,211,153,0.22)] hover:shadow-[0_0_24px_rgba(52,211,153,0.45)] transition-all duration-200 active:scale-[0.97]">
                <!-- Sparkle / Asterisk Icon ✻ -->
                <svg class="w-3.5 h-3.5 text-emerald-400 group-hover:rotate-45 transition-transform duration-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                  <path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14" />
                </svg>
                <span class="font-semibold tracking-wide text-emerald-200">smarter.</span>
                <!-- Subtle indicator cue -->
                <span class="text-[11px] text-emerald-400 font-mono pl-0.5 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
              </span>
            </button>
          </div>
        </div>

        <!-- Action CTAs: High-Prestige Emerald Sheen + Frosted Glass -->
        <div class="hero-anim-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-3.5 pt-1 sm:pt-2 w-full max-w-md mx-auto lg:mx-0">
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-400 hover:bg-emerald-300 text-slate-950 shadow-[0_0_24px_rgba(52,211,153,0.3)] hover:shadow-[0_0_32px_rgba(52,211,153,0.5)] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 whitespace-nowrap group"
          >
            <span>Discuss a Project</span>
            <svg class="w-4 h-4 text-slate-950 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#outcomes"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs sm:text-sm font-medium bg-slate-950/80 hover:bg-slate-900 text-slate-100 hover:text-white border border-white/25 hover:border-emerald-400/50 backdrop-blur-xl transition-all duration-200 whitespace-nowrap group shadow-lg"
          >
            <span>See What We Optimize</span>
            <svg class="w-4 h-4 text-emerald-400 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Institutional Engineering Credentials + Geek Fast-Track Trigger (Option A) -->
        <div class="hero-anim-5 hidden lg:flex pt-2 flex-wrap items-center justify-start gap-x-3 gap-y-2 text-xs font-mono tracking-wider text-slate-400">
          <span class="text-slate-500 font-normal">BUILT ON:</span>
          <span class="text-slate-200 font-medium">ISO 52016-1</span>
          <span class="text-slate-600">·</span>
          <span class="text-slate-200 font-medium">NBC 2026 &amp; ECBC</span>
          <span class="text-slate-600">·</span>
          <span class="text-slate-200 font-medium">EnergyPlus v25.1</span>
          <span class="text-slate-600">·</span>
          <button
            type="button"
            id="hero-geek-trigger"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 hover:text-emerald-300 border border-emerald-500/30 transition-all duration-200 group text-[10px] sm:text-xs font-mono tracking-normal shadow-sm cursor-pointer"
            aria-label="Open 3D Physics Simulation Sandbox"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-slate-400 font-normal">For Geeks:</span>
            <span class="font-medium text-emerald-300 group-hover:underline">Test 3D Twin</span>
            <span class="text-emerald-400 transition-transform group-hover:translate-x-0.5">→</span>
          </button>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Cinematic Staggered Entrance Animation ─── */
  .hero-anim-datum {
    animation: heroFadeScale 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-anim-1 {
    opacity: 0;
    transform: translateY(10px);
    animation: heroFadeUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }
  .hero-anim-2 {
    opacity: 0;
    transform: translateY(14px);
    animation: heroFadeUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.16s forwards;
  }
  .hero-anim-3 {
    opacity: 0;
    transform: translateY(10px);
    animation: heroFadeUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.28s forwards;
  }
  /* "smarter science." Tech Badge with Deliberate ~300ms Micro-Pause Reveal */
  .tech-badge-container {
    opacity: 0;
    transform: scale(0.92) translateY(5px);
    animation: techBadgeReveal 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.85s forwards;
  }
  @keyframes techBadgeReveal {
    0% {
      opacity: 0;
      transform: scale(0.92) translateY(5px);
      filter: drop-shadow(0 0 0px rgba(52, 211, 153, 0));
    }
    60% {
      opacity: 1;
      transform: scale(1.02) translateY(0);
      filter: drop-shadow(0 0 24px rgba(52, 211, 153, 0.45));
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: drop-shadow(0 0 14px rgba(52, 211, 153, 0.22));
    }
  }
  .circuit-trace-path {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: circuitTraceDraw 0.5s ease-out 1.05s forwards;
  }
  @keyframes circuitTraceDraw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .hero-anim-4 {
    opacity: 0;
    transform: translateY(10px);
    animation: heroFadeUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) 1.05s forwards;
  }
  .hero-anim-5 {
    opacity: 0;
    transform: translateY(8px);
    animation: heroFadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) 1.15s forwards;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroFadeScale {
    from {
      opacity: 0;
      transform: scaleY(0.4);
    }
    to {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  /* Soft ambient breathing pulse on the emerald punchline */
  .hero-accent-pulse {
    animation: heroAccentGlow 5.5s ease-in-out infinite;
  }

  @keyframes heroAccentGlow {
    0%, 100% {
      filter: drop-shadow(0 0 16px rgba(52, 211, 153, 0.3));
    }
    50% {
      filter: drop-shadow(0 0 28px rgba(52, 211, 153, 0.55));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-bg-video {
      display: none;
    }
    .hero-anim-datum,
    .hero-anim-1,
    .hero-anim-2,
    .hero-anim-3,
    .hero-anim-4,
    .hero-anim-5,
    .tech-badge-container,
    .circuit-trace-path,
    .hero-accent-pulse {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Pixel-perfect viewport lock to eliminate any gap or white sliver at the fold */
  @media (min-width: 1024px) {
    #hero {
      height: calc(100dvh - var(--header-height, 4.5rem)) !important;
      min-height: calc(100dvh - var(--header-height, 4.5rem)) !important;
      max-height: calc(100dvh - var(--header-height, 4.5rem)) !important;
    }
  }

  /* Monumental fluid typography scale */
  .hero-headline {
    font-size: clamp(1.65rem, 3.6vw, 4.1rem);
    text-wrap: balance;
  }

  /* Responsive tuning for compact laptop heights without crushing the text */
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero-headline {
      font-size: clamp(1.85rem, 3.2vw, 3.1rem);
    }
  }
</style>

<script>
  const geekBtn = document.getElementById('hero-geek-trigger');
  geekBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    window.dispatchEvent(new CustomEvent('open-clearinfra-studio'));
  });

  const smarterScienceBtn = document.getElementById('hero-smarter-science-trigger');
  smarterScienceBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    window.dispatchEvent(new CustomEvent('open-clearinfra-studio'));
  });
</script>
