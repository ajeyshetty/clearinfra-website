---
---

<section class="relative min-h-[calc(100vh-4.5rem)] flex items-center py-8 sm:py-12 lg:py-16 bg-[#F7F6F2] overflow-hidden">
  <!-- Option 2: Architectural Drafting Grid with Radial Vignette Fade -->
  <div class="absolute inset-0 bg-architectural-grid-vignette pointer-events-none z-0" aria-hidden="true"></div>

  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24 relative z-10">
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 sm:gap-12 xl:gap-10 2xl:gap-16 items-center">
      
      <!-- Left 5 Cols: Architectural Editorial Consulting Copy on Warm Stone -->
      <div class="xl:col-span-5 space-y-4 sm:space-y-7 text-center sm:text-left max-w-3xl xl:max-w-none">
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-slate-900/[0.04] border border-slate-900/10 text-slate-700 text-[10px] sm:text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>COMPUTATIONAL BUILDING SCIENCE PRACTICE</span>
        </div>

        <h1 class="text-[clamp(1.65rem,5.5vw,3rem)] sm:text-4xl lg:text-[44px] 2xl:text-[48px] font-semibold tracking-[-0.03em] text-slate-900 leading-[1.12]">
          <span class="block">High-performance</span>
          <span class="block">building advisory.</span>
          <span class="block text-[clamp(1.15rem,3.8vw,2.125rem)] sm:text-3xl lg:text-[32px] 2xl:text-[34px] text-slate-500 font-normal tracking-[-0.02em] mt-1.5 sm:mt-2">Powered by proprietary physics.</span>
        </h1>

        <p class="text-sm sm:text-base lg:text-[17px] text-slate-600 leading-relaxed font-normal max-w-xl mx-auto sm:mx-0">
          We partner with institutional developers and architectural practices to de-risk commercial assets—resolving envelope physics, daylight autonomy, and checking code compliance in real time.
        </p>

        <div class="flex flex-row items-center justify-center sm:justify-start gap-2.5 sm:gap-4 pt-1">
          <a
            href="#contact"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 sm:gap-2.5 px-3.5 sm:px-6 py-2.5 sm:py-3 rounded-lg text-xs sm:text-sm font-medium bg-[#131924] hover:bg-[#1A2230] text-white border border-slate-700/60 shadow-lg shadow-slate-950/15 transition-all duration-200 whitespace-nowrap"
          >
            <span>Discuss a Project</span>
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#interactive-demo"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3 sm:px-6 py-2.5 sm:py-3 rounded-lg text-xs sm:text-sm font-medium bg-white hover:bg-slate-50 text-slate-800 border border-slate-300/80 shadow-xs transition-all duration-200 whitespace-nowrap"
          >
            <span class="sm:hidden">Concept Demo ↓</span>
            <span class="hidden sm:inline">Explore Technology Stack</span>
          </a>
        </div>

        <!-- Rigorous Engineering Proof Points (Standards & Outputs) -->
        <div class="pt-4 sm:pt-6 border-t border-slate-900/10 grid grid-cols-3 divide-x divide-slate-900/12 sm:divide-x-0 sm:gap-4 text-xs font-mono max-w-lg">
          <div class="group/tip relative px-1 sm:px-0 sm:border-l-2 sm:border-slate-300 sm:pl-3 text-center sm:text-left cursor-help">
            <span class="text-slate-900 block font-semibold text-[11px] sm:text-xs whitespace-nowrap">ISO 52016-1</span>
            <span class="text-slate-500 text-[10px] sm:text-[11px] block mt-0.5 leading-tight">Hourly engine</span>
            <div class="pointer-events-none absolute bottom-full left-1/2 sm:left-0 -translate-x-1/2 sm:translate-x-0 mb-2 w-52 p-2.5 rounded-lg bg-[#131924] border border-white/12 text-[10.5px] font-sans text-slate-200 shadow-xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-left leading-tight">
              Multi-node hourly thermal RC network; first-principles heat transfer with tracked empirical factors.
            </div>
          </div>
          <div class="group/tip relative px-1 sm:px-0 sm:border-l-2 sm:border-slate-300 sm:pl-3 text-center sm:text-left cursor-help">
            <span class="text-slate-900 block font-semibold text-[11px] sm:text-xs whitespace-nowrap">NBC 2026 &amp; ECBC</span>
            <span class="text-slate-500 text-[10px] sm:text-[11px] block mt-0.5 leading-tight">Code review</span>
            <div class="pointer-events-none absolute bottom-full left-1/2 sm:left-0 -translate-x-1/2 sm:translate-x-0 mb-2 w-52 p-2.5 rounded-lg bg-[#131924] border border-white/12 text-[10.5px] font-sans text-slate-200 shadow-xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-left leading-tight">
              Clause-level checks across NBC 2026 (Parts B–F) and ECBC 2017 paired with expert engineering review.
            </div>
          </div>
          <div class="group/tip relative px-1 sm:px-0 sm:border-l-2 sm:border-slate-300 sm:pl-3 text-center sm:text-left cursor-help">
            <span class="text-slate-900 block font-semibold text-[11px] sm:text-xs whitespace-nowrap">EnergyPlus v25.1</span>
            <span class="text-slate-500 text-[10px] sm:text-[11px] block mt-0.5 leading-tight">Run-checked .idf</span>
            <div class="pointer-events-none absolute bottom-full right-0 left-auto translate-x-0 mb-2 w-52 p-2.5 rounded-lg bg-[#131924] border border-white/12 text-[10.5px] font-sans text-slate-200 shadow-xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-left leading-tight">
              Syntax-verified EnergyPlus 25.1 IDF export; run-checked engineering models for design review.
            </div>
          </div>
        </div>
      </div>

      <!-- Right 7 Cols: Architectural Matte CAD Viewport (Clearinfra Studio) -->
      <div id="interactive-demo" class="xl:col-span-7">
        <div id="studio-cad-card" class="rounded-2xl border border-slate-700/60 ring-1 ring-white/10 bg-[#131924] text-slate-100 shadow-2xl shadow-slate-950/30 overflow-hidden transition-all duration-300">
          <!-- Top CAD Window Bar (Matte Slate) -->
          <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-2.5 sm:py-3 bg-[#171E2B] border-b border-white/[0.08] text-xs font-mono">
            <div class="flex items-center gap-2 min-w-0">
              <div class="hidden sm:flex items-center gap-1.5 shrink-0">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
              </div>
              <span class="text-slate-200 font-medium whitespace-nowrap text-[11px] sm:text-xs tracking-wide">CLEARINFRA STUDIO</span>
              <span class="hidden sm:inline-block text-slate-600">|</span>
              <span class="hidden sm:inline-block text-slate-400 truncate">12-Story Commercial Model</span>
            </div>
            <div class="flex items-center gap-1.5 sm:gap-2 text-sky-400 shrink-0 text-[11px] sm:text-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
              <span class="hidden sm:inline">Illustrative Envelope Demo</span>
              <span class="sm:hidden font-mono text-[10px] uppercase tracking-wider font-semibold">Concept Demo</span>
              
              <!-- Close button for Full-Screen Studio Mode -->
              <button
                type="button"
                id="btn-close-mobile-studio"
                class="hidden p-1 rounded-md text-slate-300 hover:text-white border border-white/20 bg-white/10 transition-colors cursor-pointer ml-1"
                aria-label="Close Full-Screen Studio"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Main Interactive Grid inside Matte CAD Viewport -->
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <!-- Left 7 Cols of Card: Animated Isometric Building + Solar Path Canvas -->
            <div class="lg:col-span-7 p-4 sm:p-7 flex flex-col justify-between bg-blueprint-sub border-b lg:border-b-0 lg:border-r border-white/[0.07] relative min-h-[290px] sm:min-h-[360px]">
              <div class="flex items-center justify-between gap-2 text-[11px] sm:text-xs font-mono text-slate-400 z-10">
                <div class="truncate">
                  <span class="text-slate-500 hidden sm:inline">LOCATION:</span>
                  <span id="viz-climate-label" class="text-slate-200 sm:ml-1">Bengaluru (Temperate)</span>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span>Solar</span>
                  </span>
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                    <span>Glazing</span>
                  </span>
                </div>
              </div>

              <!-- Central 3D Three.js Building Viewport (Clearinfra Studio Twin) -->
              <div id="three-container" class="relative w-full h-[230px] sm:h-[320px] lg:h-[360px] my-auto overflow-hidden rounded-xl border border-white/[0.08] bg-[#0E131E]/80 backdrop-blur-xs">
                <canvas id="three-building-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>
                
                <!-- Overlay Top-Left: Asset Site & Floor Parameters HUD -->
                <div class="absolute top-2.5 left-2.5 pointer-events-none flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#161D2B]/90 border border-white/12 text-[9px] sm:text-[10px] font-mono text-slate-300 backdrop-blur-xs shadow-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span class="font-medium text-white">SITE 3,334m²</span>
                  <span class="text-slate-600">·</span>
                  <span class="text-slate-400">12 FLOORS</span>
                </div>

                <!-- Overlay Top-Right: Illustrative Concept Model Badge -->
                <div class="absolute top-2.5 right-2.5 pointer-events-none flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#161D2B]/90 border border-sky-500/30 text-[9.5px] font-mono text-sky-400 backdrop-blur-xs shadow-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                  <span>ILLUSTRATIVE DEMO</span>
                </div>

                <!-- Overlay Bottom-Left: Real-time Dynamic WWR & Solar DNI callout badge -->
                <div class="absolute bottom-2.5 left-2.5 pointer-events-none flex items-center gap-2 text-[10px] font-mono text-slate-400 bg-[#161D2B]/90 px-2.5 py-1 rounded-md border border-white/12 backdrop-blur-xs">
                  <span id="viz-wwr-callout" class="text-emerald-400 font-semibold">WWR: 40%</span>
                  <span class="text-slate-600">|</span>
                  <span id="viz-dni-label" class="text-amber-300">760 W/m²</span>
                </div>

                <!-- Overlay Bottom-Right: Camera View Presets & Reset -->
                <div class="absolute bottom-2.5 right-2.5 flex items-center gap-1 bg-[#161D2B]/90 p-1 rounded-md border border-white/12 text-[9px] font-mono shadow-sm">
                  <button id="btn-cam-iso" type="button" title="Isometric View" class="cam-btn px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 transition-colors cursor-pointer">ISO</button>
                  <button id="btn-cam-top" type="button" title="Top-down Floor Plate View" class="cam-btn px-1.5 py-0.5 rounded text-slate-400 hover:text-white transition-colors cursor-pointer">TOP</button>
                  <button id="btn-cam-front" type="button" title="Front Elevation View" class="cam-btn px-1.5 py-0.5 rounded text-slate-400 hover:text-white transition-colors cursor-pointer">FRONT</button>
                  <button id="btn-cam-side" type="button" title="Side Elevation View" class="cam-btn px-1.5 py-0.5 rounded text-slate-400 hover:text-white transition-colors cursor-pointer">SIDE</button>
                  <button id="btn-reset-cam" type="button" title="Reset Camera Orbit" class="px-1.5 py-0.5 rounded text-slate-400 hover:text-white border-l border-white/10 transition-colors cursor-pointer">↺</button>
                </div>
              </div>

              <!-- Bottom Status Strip inside Canvas -->
              <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-white/[0.06] text-[11px] font-mono text-slate-400">
                <div>Model: <span class="text-slate-300">Envelope Heuristic (Engine: ISO 52016-1)</span></div>
                <div id="viz-shgc-readout"><span class="text-emerald-400">SHGC 0.28 · U 1.6 W/m²K</span></div>
              </div>
            </div>

            <!-- Right 5 Cols of Card: Interactive Controls & Live Simulation Readout -->
            <div class="lg:col-span-5 p-4 sm:p-7 flex flex-col justify-between space-y-4 sm:space-y-5 bg-[#141A25]">
              <!-- Simulated Physics Output Readout (Elevated to top on mobile for instant zero-distance feedback) -->
              <div class="order-1 lg:order-2 pt-0 lg:pt-4 border-b lg:border-b-0 lg:border-t border-white/[0.07] pb-3.5 lg:pb-0 space-y-2.5 sm:space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400">Indicative Envelope Tier</span>
                  <span id="out-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                    Optimized (Indicative)
                  </span>
                </div>

                <div class="grid grid-cols-3 gap-2 sm:gap-2.5">
                  <div class="group/tip relative p-2 sm:p-2.5 rounded-xl bg-[#18202D] hover:bg-[#1D273A] border border-white/[0.08] hover:border-white/20 transition-all cursor-help text-center sm:text-left">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap border-b border-dotted border-slate-600 inline-block">Annual EPI</span>
                    <span id="out-epi" class="text-base sm:text-lg font-semibold text-white font-mono mt-0.5 block">80.2</span>
                    <span class="text-[9px] font-mono text-slate-500">kWh/m²·yr</span>
                    <!-- Tooltip -->
                    <div class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2 rounded-lg bg-[#1A2334] border border-white/20 text-[10px] font-sans text-slate-200 shadow-2xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-center leading-tight">
                      Indicative Energy Performance Index. Statutory verification requires full engine run.
                    </div>
                  </div>

                  <div class="group/tip relative p-2 sm:p-2.5 rounded-xl bg-[#18202D] hover:bg-[#1D273A] border border-white/[0.08] hover:border-white/20 transition-all cursor-help text-center sm:text-left">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap border-b border-dotted border-slate-600 inline-block">Plant Load</span>
                    <span id="out-cooling" class="text-base sm:text-lg font-semibold text-white font-mono mt-0.5 block">246</span>
                    <span class="text-[9px] font-mono text-slate-500">Peak TR</span>
                    <!-- Tooltip -->
                    <div class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-44 p-2 rounded-lg bg-[#1A2334] border border-white/20 text-[10px] font-sans text-slate-200 shadow-2xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-center leading-tight">
                      Indicative peak chiller capacity required to offset envelope heat gain.
                    </div>
                  </div>

                  <div class="group/tip relative p-2 sm:p-2.5 rounded-xl bg-[#18202D] hover:bg-[#1D273A] border border-white/[0.08] hover:border-white/20 transition-all cursor-help text-center sm:text-left">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap border-b border-dotted border-slate-600 inline-block">Daylight</span>
                    <span id="out-sda" class="text-base sm:text-lg font-semibold text-emerald-400 font-mono mt-0.5 block">55%</span>
                    <span class="text-[9px] font-mono text-slate-500">sDA &gt;300lx</span>
                    <!-- Tooltip -->
                    <div class="pointer-events-none absolute bottom-full right-0 mb-2 w-48 p-2 rounded-lg bg-[#1A2334] border border-white/20 text-[10px] font-sans text-slate-200 shadow-2xl opacity-0 group-hover/tip:opacity-100 transition-opacity duration-150 z-50 text-center leading-tight">
                      Spatial Daylight Autonomy: indicative % of space receiving adequate daylight. Reference estimate.
                    </div>
                  </div>
                </div>

                <!-- Mobile Launch Studio Button (Displayed on Mobile Homepage) -->
                <div class="lg:hidden pt-2.5" id="mobile-studio-trigger-wrap">
                  <button
                    type="button"
                    id="btn-open-mobile-studio"
                    class="w-full py-2.5 px-3.5 rounded-xl bg-gradient-to-r from-emerald-600/25 via-sky-600/25 to-emerald-600/25 hover:from-emerald-600/35 hover:to-sky-600/35 border border-emerald-500/40 hover:border-emerald-400 text-white font-mono text-xs font-semibold flex items-center justify-between shadow-md shadow-emerald-950/25 transition-all duration-200 active:scale-[0.98] cursor-pointer"
                  >
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                      <span class="tracking-wide">Launch Full-Screen Studio</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-emerald-400 text-[11px]">
                      <span>Tune Parameters</span>
                      <span class="text-sm font-bold">⛶</span>
                    </div>
                  </button>
                </div>
              </div>

              <!-- Charrette Parameters & Interactive Sliders -->
              <div id="charrette-params-container" class="order-2 lg:order-1 space-y-3.5 sm:space-y-4 pt-1 lg:pt-0 hidden lg:block">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Charrette Parameters</span>
                  <span class="text-[10px] font-mono text-emerald-400">Interactive</span>
                </div>

                <!-- Climate Selector: Quick-Tap Chips on Mobile, Select on Desktop -->
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="text-xs text-slate-300 font-medium">Climate Zone (ECBC)</span>
                    <span id="climate-quick-desc" class="text-[10px] font-mono text-emerald-400 lg:hidden">Temperate</span>
                  </div>
                  <!-- Mobile 1-Tap Chips (Instant tactile feedback, zero popup wheel) -->
                  <div class="grid grid-cols-4 gap-1.5 lg:hidden" id="ctrl-climate-chips">
                    <button type="button" data-climate="bengaluru" class="climate-chip px-1.5 py-1.5 rounded-md text-[10px] font-mono border border-emerald-500/50 bg-emerald-500/20 text-emerald-300 font-medium transition-all text-center cursor-pointer">
                      Bengaluru
                    </button>
                    <button type="button" data-climate="mumbai" class="climate-chip px-1.5 py-1.5 rounded-md text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer">
                      Mumbai
                    </button>
                    <button type="button" data-climate="delhi" class="climate-chip px-1.5 py-1.5 rounded-md text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer">
                      Delhi
                    </button>
                    <button type="button" data-climate="ahmedabad" class="climate-chip px-1.5 py-1.5 rounded-md text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer">
                      Ahmedabad
                    </button>
                  </div>
                  <!-- Desktop Select Dropdown (Preserved for Desktop) -->
                  <select
                    id="ctrl-climate"
                    class="hidden lg:block w-full rounded-lg bg-[#1A2230] border border-white/12 px-3 py-2 text-xs text-white font-mono focus:outline-none focus:border-emerald-500 transition-colors"
                  >
                    <option value="bengaluru" selected>Bengaluru — Temperate</option>
                    <option value="mumbai">Mumbai — Warm-Humid</option>
                    <option value="delhi">New Delhi — Composite</option>
                    <option value="ahmedabad">Ahmedabad — Hot-Dry</option>
                  </select>
                </div>

                <!-- WWR Slider -->
                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <label for="ctrl-wwr" class="text-slate-300 font-medium">Window-to-Wall Ratio (WWR)</label>
                    <span id="val-wwr" class="font-mono text-emerald-400">40%</span>
                  </div>
                  <input
                    id="ctrl-wwr"
                    type="range"
                    min="20"
                    max="70"
                    step="1"
                    value="40"
                    class="ci-slider"
                  />
                  <div class="flex justify-between text-[10px] font-mono text-slate-500 mt-1">
                    <span>20%</span>
                    <span>40% (ECBC)</span>
                    <span>70%</span>
                  </div>
                </div>

                <!-- Glazing Spec Selector -->
                <div>
                  <span class="block text-xs text-slate-300 mb-1.5 font-medium">Glazing Specification</span>
                  <div class="grid grid-cols-3 gap-1.5" id="ctrl-glazing-group">
                    <button
                      type="button"
                      data-glazing="single"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white hover:border-white/20 transition-all text-center cursor-pointer"
                    >
                      Clear DGU<br/><span class="opacity-70">0.58</span>
                    </button>
                    <button
                      type="button"
                      data-glazing="lowe"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-emerald-500/50 bg-emerald-500/15 text-emerald-300 transition-all text-center cursor-pointer"
                    >
                      Low-E DGU<br/><span class="opacity-80">0.28</span>
                    </button>
                    <button
                      type="button"
                      data-glazing="triple"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white hover:border-white/20 transition-all text-center cursor-pointer"
                    >
                      Selective<br/><span class="opacity-70">0.22</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CI Agent Diagnostic Bar & Studio Bottom Dock -->
          <div id="studio-bottom-dock" class="px-3 sm:px-5 py-2 sm:py-2 bg-[#10151F] border-t border-white/[0.08] min-h-[50px] sm:min-h-[54px] sm:h-[54px] flex items-center justify-between gap-2.5 text-xs font-mono shrink-0">
            <div class="flex items-center gap-2 text-slate-300 min-w-0 flex-1">
              <span class="px-1.5 py-0.5 rounded bg-sky-500/15 text-sky-400 border border-sky-500/30 text-[9.5px] sm:text-[10px] font-mono font-medium shrink-0 whitespace-nowrap">ILLUSTRATIVE DEMO</span>
              <span id="ai-copilot-msg" class="text-slate-300 text-[10.5px] sm:text-[11px] leading-snug sm:leading-[17px] truncate sm:whitespace-normal">
                Indicative envelope sensitivity: 40% WWR with Low-E DGU balances indicative thermal load and daylight estimate. Detailed compliance requires a full engine run and engineer review.
              </span>
            </div>
            <!-- Done button visible ONLY in full-screen studio mode on mobile -->
            <button
              type="button"
              id="btn-done-mobile-studio"
              class="hidden px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-xs font-semibold shrink-0 items-center gap-1.5 shadow-md shadow-emerald-950/40 transition-colors cursor-pointer"
              aria-label="Done and return to page"
            >
              <span>Done</span>
              <span>✓</span>
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const climateData: Record<string, { label: string; baseEpi: number; solarFactor: number; dni: string; sunPos: [number, number, number] }> = {
    bengaluru: { label: 'Bengaluru (Temperate)', baseEpi: 62, solarFactor: 0.72, dni: '760 W/m²', sunPos: [16, 22, 14] },
    mumbai:    { label: 'Mumbai (Warm-Humid)',   baseEpi: 88, solarFactor: 1.05, dni: '840 W/m²', sunPos: [18, 20, 16] },
    delhi:     { label: 'New Delhi (Composite)', baseEpi: 92, solarFactor: 1.12, dni: '890 W/m²', sunPos: [20, 18, 12] },
    ahmedabad: { label: 'Ahmedabad (Hot-Dry)',   baseEpi: 98, solarFactor: 1.25, dni: '960 W/m²', sunPos: [15, 24, 10] },
  };

  const glazingData: Record<string, { shgc: number; uval: number }> = {
    single: { shgc: 0.58, uval: 2.8 },
    lowe:   { shgc: 0.28, uval: 1.6 },
    triple: { shgc: 0.22, uval: 1.1 },
  };

  let currentClimate = 'bengaluru';
  let currentWwr = 40;
  let currentGlazing = 'lowe';

  const climateSelect = document.getElementById('ctrl-climate') as HTMLSelectElement | null;
  const climateChips = document.querySelectorAll('.climate-chip');
  const climateDesc = document.getElementById('climate-quick-desc');
  const wwrSlider = document.getElementById('ctrl-wwr') as HTMLInputElement | null;
  const wwrVal = document.getElementById('val-wwr');
  const glazingBtns = document.querySelectorAll('.glazing-btn');

  const outEpi = document.getElementById('out-epi');
  const outCooling = document.getElementById('out-cooling');
  const outSda = document.getElementById('out-sda');
  const outBadge = document.getElementById('out-badge');
  const aiMsg = document.getElementById('ai-copilot-msg');

  const vizClimateLabel = document.getElementById('viz-climate-label');
  const vizDniLabel = document.getElementById('viz-dni-label');
  const vizWwrCallout = document.getElementById('viz-wwr-callout');
  const vizShgcReadout = document.getElementById('viz-shgc-readout');

  // ─── 3D THREE.JS DIGITAL TWIN (CLEARINFRA STUDIO RUNTIME) ───
  const container = document.getElementById('three-container') as HTMLDivElement | null;
  const canvas = document.getElementById('three-building-canvas') as HTMLCanvasElement | null;

  let updateThreeBuilding: ((wwr: number, glazing: string, climate: string) => void) | null = null;
  let orbitControls: any = null;

  if (container && canvas) {
    try {
      const scene = new THREE.Scene();

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const camera = new THREE.PerspectiveCamera(35, container.clientWidth / Math.max(1, container.clientHeight), 0.1, 150);
      const defaultCamPos = new THREE.Vector3(28, 19, 28);
      const defaultTarget = new THREE.Vector3(0, 7.8, 0);
      camera.position.copy(defaultCamPos);

      const controls = new OrbitControls(camera, canvas);
      orbitControls = controls;
      controls.target.copy(defaultTarget);
      controls.enableDamping = true;
      controls.enableZoom = false;
      controls.dampingFactor = 0.06;
      controls.maxPolarAngle = Math.PI / 2 - 0.05;
      controls.minDistance = 14;
      controls.maxDistance = 65;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.55;

      let idleTimer: any = null;
      controls.addEventListener('start', () => {
        controls.autoRotate = false;
        clearTimeout(idleTimer);
      });
      controls.addEventListener('end', () => {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(() => {
          controls.autoRotate = true;
        }, 4000);
      });

      // Camera Presets & Orbit Control HUD Handlers
      const btnCamIso = document.getElementById('btn-cam-iso');
      const btnCamTop = document.getElementById('btn-cam-top');
      const btnCamFront = document.getElementById('btn-cam-front');
      const btnCamSide = document.getElementById('btn-cam-side');
      const resetBtn = document.getElementById('btn-reset-cam');
      const camBtns = document.querySelectorAll('.cam-btn');

      function setCamActive(activeBtn: HTMLElement | null) {
        camBtns.forEach((b) => {
          b.className = 'cam-btn px-1.5 py-0.5 rounded text-slate-400 hover:text-white transition-colors cursor-pointer';
        });
        if (activeBtn) {
          activeBtn.className = 'cam-btn px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 transition-colors cursor-pointer';
        }
      }

      btnCamIso?.addEventListener('click', () => {
        camera.position.set(28, 19, 28);
        controls.target.set(0, 7.8, 0);
        controls.update();
        setCamActive(btnCamIso);
      });
      btnCamTop?.addEventListener('click', () => {
        camera.position.set(0.01, 38, 0);
        controls.target.set(0, 7.8, 0);
        controls.update();
        setCamActive(btnCamTop);
      });
      btnCamFront?.addEventListener('click', () => {
        camera.position.set(0, 7.8, 34);
        controls.target.set(0, 7.8, 0);
        controls.update();
        setCamActive(btnCamFront);
      });
      btnCamSide?.addEventListener('click', () => {
        camera.position.set(34, 7.8, 0);
        controls.target.set(0, 7.8, 0);
        controls.update();
        setCamActive(btnCamSide);
      });
      resetBtn?.addEventListener('click', () => {
        camera.position.set(28, 19, 28);
        controls.target.set(0, 7.8, 0);
        controls.update();
        setCamActive(btnCamIso);
      });

      // Dark Site Plot Plane (Matching Studio 3,334m² Site)
      const sitePlane = new THREE.Mesh(
        new THREE.PlaneGeometry(28, 26),
        new THREE.MeshStandardMaterial({ color: 0x090d15, roughness: 0.95 })
      );
      sitePlane.rotation.x = -Math.PI / 2;
      sitePlane.position.y = -0.02;
      sitePlane.receiveShadow = true;
      scene.add(sitePlane);

      // Cyan Dashed Property Setback Perimeter (Matching Studio Twin)
      const setbackHalfW = 8.8;
      const setbackHalfD = 7.6;
      const setbackPoints = [
        new THREE.Vector3(-setbackHalfW, 0.02, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.02, -setbackHalfD),
        new THREE.Vector3(setbackHalfW, 0.02, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.02, setbackHalfD),
        new THREE.Vector3(-setbackHalfW, 0.02, -setbackHalfD),
      ];
      const setbackGeo = new THREE.BufferGeometry().setFromPoints(setbackPoints);
      const setbackMat = new THREE.LineDashedMaterial({
        color: 0x00e5ff,
        dashSize: 0.8,
        gapSize: 0.45,
        transparent: true,
        opacity: 0.75,
      });
      const setbackLine = new THREE.Line(setbackGeo, setbackMat);
      setbackLine.computeLineDistances();
      scene.add(setbackLine);

      // Subtle Grid Datum
      const gridHelper = new THREE.GridHelper(30, 16, 0x00c4df, 0x1e293b);
      gridHelper.position.y = -0.01;
      const gridMat = gridHelper.material as THREE.Material;
      gridMat.transparent = true;
      gridMat.opacity = 0.22;
      scene.add(gridHelper);

      // Studio Lighting
      const ambientLight = new THREE.AmbientLight(0x1e293b, 1.6);
      scene.add(ambientLight);

      const hemiLight = new THREE.HemisphereLight(0x00e5ff, 0x090d16, 0.75);
      scene.add(hemiLight);

      const sunLight = new THREE.DirectionalLight(0xfffbeb, 2.6);
      sunLight.position.set(18, 25, 16);
      sunLight.castShadow = true;
      sunLight.shadow.mapSize.width = 1024;
      sunLight.shadow.mapSize.height = 1024;
      sunLight.shadow.camera.near = 1;
      sunLight.shadow.camera.far = 70;
      sunLight.shadow.camera.left = -16;
      sunLight.shadow.camera.right = 16;
      sunLight.shadow.camera.top = 22;
      sunLight.shadow.camera.bottom = -10;
      sunLight.shadow.bias = -0.0005;
      scene.add(sunLight);

      // Sun Indicator Orb
      const sunOrb = new THREE.Mesh(
        new THREE.SphereGeometry(0.55, 16, 16),
        new THREE.MeshBasicMaterial({ color: 0xfbbf24 })
      );
      sunOrb.position.copy(sunLight.position);
      scene.add(sunOrb);

      // 12-Story Commercial Office Asset (Clearinfra Studio Digital Twin)
      const numFloors = 12;
      const floorHeight = 1.35;
      const slabH = 0.16;
      const towerW = 9.2;
      const towerD = 6.8;
      const clearHeight = floorHeight - slabH;

      const buildingGroup = new THREE.Group();
      scene.add(buildingGroup);

      // Materials
      const slabMat = new THREE.MeshStandardMaterial({
        color: 0x18202c,
        roughness: 0.6,
        metalness: 0.35,
      });
      const slabEdgeMat = new THREE.LineBasicMaterial({
        color: 0x00c4df,
        transparent: true,
        opacity: 0.35,
      });

      const coreMat = new THREE.MeshStandardMaterial({
        color: 0x0f1522,
        roughness: 0.9,
      });

      const columnMat = new THREE.MeshStandardMaterial({
        color: 0x27354a,
        roughness: 0.4,
        metalness: 0.5,
      });

      const spandrelMat = new THREE.MeshStandardMaterial({
        color: 0x141b26,
        roughness: 0.55,
        metalness: 0.3,
      });

      const mullionMat = new THREE.MeshStandardMaterial({
        color: 0x222c3d,
        roughness: 0.4,
        metalness: 0.55,
      });

      // Signature Electric Cyan Glazing Material
      const glassMat = new THREE.MeshPhysicalMaterial({
        color: new THREE.Color(0x00c4df),
        emissive: new THREE.Color(0x0891b2),
        emissiveIntensity: 0.32,
        roughness: 0.05,
        metalness: 0.1,
        transmission: 0.6,
        transparent: true,
        opacity: 0.78,
        depthWrite: false,
        side: THREE.DoubleSide,
      });

      const glassEdgeMat = new THREE.LineBasicMaterial({
        color: 0x22d3ee,
        transparent: true,
        opacity: 0.45,
      });

      // Central Structural Core
      const coreMesh = new THREE.Mesh(
        new THREE.BoxGeometry(3.6, numFloors * floorHeight, 2.8),
        coreMat
      );
      coreMesh.position.set(0, (numFloors * floorHeight) / 2, 0);
      coreMesh.castShadow = true;
      buildingGroup.add(coreMesh);

      // Arrays for dynamic update
      const glassMeshes: THREE.Mesh[] = [];
      const mullionGroups: THREE.Group[] = [];

      // Build 12 Floors with Slabs, Glazing & Vertical Mullions
      for (let i = 0; i < numFloors; i++) {
        // Floor Slab / Spandrel
        const slabGeo = new THREE.BoxGeometry(towerW + 0.25, slabH, towerD + 0.25);
        const slabMesh = new THREE.Mesh(slabGeo, slabMat);
        slabMesh.position.set(0, i * floorHeight + slabH / 2, 0);
        slabMesh.castShadow = true;
        slabMesh.receiveShadow = true;
        buildingGroup.add(slabMesh);
        slabMesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(slabGeo), slabEdgeMat));

        // Floor Interior Plate
        const floorPlate = new THREE.Mesh(
          new THREE.BoxGeometry(towerW - 0.2, 0.04, towerD - 0.2),
          new THREE.MeshBasicMaterial({ color: 0x090d14 })
        );
        floorPlate.position.set(0, i * floorHeight + slabH + 0.02, 0);
        buildingGroup.add(floorPlate);

        // Dynamic Glazing Ribbon (height scaled by updateThreeBuilding)
        const glassGeo = new THREE.BoxGeometry(towerW - 0.02, 1, towerD - 0.02);
        const glassMesh = new THREE.Mesh(glassGeo, glassMat);
        glassMesh.castShadow = true;
        buildingGroup.add(glassMesh);
        glassMesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(glassGeo), glassEdgeMat));
        glassMeshes.push(glassMesh);

        // Vertical Mullion Fins (High-Tech Curtain Wall Articulation)
        const floorMullionGroup = new THREE.Group();
        const mullionGeoX = new THREE.BoxGeometry(0.06, 1, 0.1);
        const numMullionsX = 9;
        const stepX = (towerW - 0.6) / (numMullionsX - 1);
        for (let mx = 0; mx < numMullionsX; mx++) {
          const xPos = -(towerW - 0.6) / 2 + mx * stepX;
          const mF = new THREE.Mesh(mullionGeoX, mullionMat);
          mF.position.set(xPos, 0, towerD / 2 + 0.04);
          floorMullionGroup.add(mF);
          const mB = new THREE.Mesh(mullionGeoX, mullionMat);
          mB.position.set(xPos, 0, -towerD / 2 - 0.04);
          floorMullionGroup.add(mB);
        }
        const mullionGeoZ = new THREE.BoxGeometry(0.1, 1, 0.06);
        const numMullionsZ = 6;
        const stepZ = (towerD - 0.6) / (numMullionsZ - 1);
        for (let mz = 1; mz < numMullionsZ - 1; mz++) {
          const zPos = -(towerD - 0.6) / 2 + mz * stepZ;
          const mL = new THREE.Mesh(mullionGeoZ, mullionMat);
          mL.position.set(-towerW / 2 - 0.04, 0, zPos);
          floorMullionGroup.add(mL);
          const mR = new THREE.Mesh(mullionGeoZ, mullionMat);
          mR.position.set(towerW / 2 + 0.04, 0, zPos);
          floorMullionGroup.add(mR);
        }

        buildingGroup.add(floorMullionGroup);
        mullionGroups.push(floorMullionGroup);
      }

      // Ground Floor Architectural Entrance Canopy (Warm Brass/Timber Portal)
      const portalW = 3.4;
      const portalH = 1.05;
      const portalD = 1.2;
      const entranceGroup = new THREE.Group();
      entranceGroup.position.set(0, 0, towerD / 2 + 0.35);

      const entranceMat = new THREE.MeshStandardMaterial({
        color: 0xd97706, // warm gold / brass
        roughness: 0.35,
        metalness: 0.75,
      });
      const canopyRoofMat = new THREE.MeshStandardMaterial({
        color: 0xf59e0b,
        roughness: 0.25,
        metalness: 0.85,
      });
      const entranceGlassMat = new THREE.MeshBasicMaterial({
        color: 0xfef08a,
        transparent: true,
        opacity: 0.85,
      });

      // Canopy Slab projecting forward
      const canopyRoof = new THREE.Mesh(
        new THREE.BoxGeometry(portalW + 0.4, 0.08, portalD + 0.5),
        canopyRoofMat
      );
      canopyRoof.position.set(0, portalH + 0.04, 0.1);
      canopyRoof.castShadow = true;
      entranceGroup.add(canopyRoof);

      // Entrance Box Frame
      const portalBox = new THREE.Mesh(
        new THREE.BoxGeometry(portalW, portalH, portalD),
        entranceMat
      );
      portalBox.position.set(0, portalH / 2, 0);
      portalBox.castShadow = true;
      entranceGroup.add(portalBox);

      // Entrance Glass Light
      const portalGlass = new THREE.Mesh(
        new THREE.BoxGeometry(portalW - 0.5, portalH - 0.15, portalD + 0.02),
        entranceGlassMat
      );
      portalGlass.position.set(0, portalH / 2, 0);
      entranceGroup.add(portalGlass);

      // Thin Canopy Support Columns
      const colGeoP = new THREE.CylinderGeometry(0.04, 0.04, portalH, 12);
      const colL = new THREE.Mesh(colGeoP, canopyRoofMat);
      colL.position.set(-portalW / 2 - 0.12, portalH / 2, portalD / 2 + 0.2);
      entranceGroup.add(colL);
      const colR = new THREE.Mesh(colGeoP, canopyRoofMat);
      colR.position.set(portalW / 2 + 0.12, portalH / 2, portalD / 2 + 0.2);
      entranceGroup.add(colR);

      buildingGroup.add(entranceGroup);

      // Roof Slab
      const roofSlabGeo = new THREE.BoxGeometry(towerW + 0.25, slabH + 0.05, towerD + 0.25);
      const roofSlab = new THREE.Mesh(roofSlabGeo, slabMat);
      roofSlab.position.set(0, numFloors * floorHeight + slabH / 2, 0);
      roofSlab.castShadow = true;
      roofSlab.receiveShadow = true;
      buildingGroup.add(roofSlab);
      roofSlab.add(new THREE.LineSegments(new THREE.EdgesGeometry(roofSlabGeo), slabEdgeMat));

      // Roof Parapet
      const parapetGeo = new THREE.BoxGeometry(towerW + 0.25, 0.25, towerD + 0.25);
      const parapetMesh = new THREE.Mesh(parapetGeo, spandrelMat);
      parapetMesh.position.set(0, numFloors * floorHeight + slabH + 0.13, 0);
      buildingGroup.add(parapetMesh);

      // Roof Lift Penthouse
      const penthouseGeo = new THREE.BoxGeometry(3.2, 1.2, 2.6);
      const penthouse = new THREE.Mesh(penthouseGeo, slabMat);
      penthouse.position.set(-1.8, numFloors * floorHeight + slabH + 0.6, 0);
      penthouse.castShadow = true;
      buildingGroup.add(penthouse);
      penthouse.add(new THREE.LineSegments(new THREE.EdgesGeometry(penthouseGeo), slabEdgeMat));

      // Rooftop Solar PV Pergola
      const pvRack = new THREE.Group();
      pvRack.position.set(2.0, numFloors * floorHeight + slabH + 0.5, 0);
      pvRack.rotation.x = 0.18;
      const pvGeo = new THREE.BoxGeometry(3.6, 0.05, 2.6);
      const pvMat = new THREE.MeshStandardMaterial({
        color: 0x0284c7,
        roughness: 0.2,
        metalness: 0.65,
      });
      const pvMesh = new THREE.Mesh(pvGeo, pvMat);
      pvMesh.castShadow = true;
      pvRack.add(pvMesh);
      pvRack.add(new THREE.LineSegments(new THREE.EdgesGeometry(pvGeo), new THREE.LineBasicMaterial({ color: 0x38bdf8, opacity: 0.4, transparent: true })));
      buildingGroup.add(pvRack);

      // Rooftop HVAC Chiller Unit
      const chillerGeo = new THREE.BoxGeometry(1.4, 0.6, 1.1);
      const chiller = new THREE.Mesh(chillerGeo, columnMat);
      chiller.position.set(-1.8, numFloors * floorHeight + slabH + 1.2 + 0.3, 0);
      chiller.castShadow = true;
      buildingGroup.add(chiller);

      // Function to dynamically update 3D building from simulator controls
      updateThreeBuilding = (wwrPct: number, glazingKey: string, climateKey: string) => {
        // 1. Update Glass Bands & Mullions Height & Position
        const gHeight = Math.max(0.25, (wwrPct / 100) * clearHeight);
        glassMeshes.forEach((mesh, idx) => {
          mesh.scale.y = gHeight;
          const posY = idx * floorHeight + slabH + (clearHeight - gHeight) / 2 + gHeight / 2;
          mesh.position.y = posY;
          if (mullionGroups[idx]) {
            mullionGroups[idx].scale.y = gHeight;
            mullionGroups[idx].position.y = posY;
          }
        });

        // 2. Update Glass Material Color & Opacity
        if (glazingKey === 'single') {
          glassMat.color.setHex(0x94a3b8);
          glassMat.emissive.setHex(0x334155);
          glassMat.emissiveIntensity = 0.15;
          glassMat.opacity = 0.55;
          glassEdgeMat.color.setHex(0x94a3b8);
        } else if (glazingKey === 'triple') {
          glassMat.color.setHex(0x10b981);
          glassMat.emissive.setHex(0x059669);
          glassMat.emissiveIntensity = 0.38;
          glassMat.opacity = 0.82;
          glassEdgeMat.color.setHex(0x34d399);
        } else {
          // lowe default (signature electric cyan)
          glassMat.color.setHex(0x00c4df);
          glassMat.emissive.setHex(0x0891b2);
          glassMat.emissiveIntensity = 0.32;
          glassMat.opacity = 0.78;
          glassEdgeMat.color.setHex(0x22d3ee);
        }

        // 3. Update Sun Angle & Intensity based on Climate
        const c = climateData[climateKey];
        if (c) {
          sunLight.intensity = c.solarFactor * 2.5;
          sunLight.position.set(c.sunPos[0] * 1.1, c.sunPos[1] * 1.1, c.sunPos[2] * 1.1);
          sunOrb.position.copy(sunLight.position);
        }
      };

      // Render Loop
      function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
      }
      animate();

      // Resize Observer
      const ro = new ResizeObserver(() => {
        if (!container || !renderer || !camera) return;
        const w = container.clientWidth;
        const h = container.clientHeight;
        if (w === 0 || h === 0) return;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });
      ro.observe(container);

    } catch (err) {
      console.warn('Three.js initialization notice:', err);
    }
  }

  // ─── CHARRETTE SIMULATION STATE & CONTROLS ───
  function updateSimulation() {
    const c = climateData[currentClimate];
    const g = glazingData[currentGlazing];

    const envelopeGain = currentWwr * g.shgc * c.solarFactor * 1.15 + (currentWwr * g.uval * 0.14);
    const epi = (c.baseEpi + envelopeGain).toFixed(1);
    const coolingTr = Math.round(180 + envelopeGain * 3.6);
    const sda = Math.min(92, Math.round(24 + currentWwr * (0.65 + g.shgc * 0.45)));

    if (wwrVal) wwrVal.textContent = `${currentWwr}%`;
    if (outEpi) outEpi.textContent = epi;
    if (outCooling) outCooling.textContent = `${coolingTr}`;
    if (outSda) outSda.textContent = `${sda}%`;

    if (vizClimateLabel) vizClimateLabel.textContent = c.label;
    if (vizDniLabel) vizDniLabel.textContent = c.dni;
    if (vizWwrCallout) vizWwrCallout.textContent = `WWR: ${currentWwr}%`;
    if (vizShgcReadout) {
      vizShgcReadout.innerHTML = `<span class="text-emerald-400">SHGC ${g.shgc} · U ${g.uval} W/m²K</span>`;
    }

    if (outBadge && aiMsg) {
      const epiNum = parseFloat(epi);
      if (currentWwr > 40 && g.shgc > 0.3) {
        outBadge.textContent = 'Elevated Heat Gain';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30';
        aiMsg.textContent = `Sensitivity note: WWR ${currentWwr}% with SHGC ${g.shgc} elevates solar gain. Switch to Low-E/Selective DGU to cut ~${Math.round(coolingTr * 0.18)} TR indicative chiller load.`;
      } else if (epiNum < c.baseEpi + 14) {
        outBadge.textContent = 'High Efficiency (Indicative)';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
        aiMsg.textContent = `Indicative efficiency (${epi} kWh/m²·yr): Envelope minimizes indicative chiller load (${coolingTr} TR) with ~${sda}% spatial daylight estimate.`;
      } else if (epiNum < c.baseEpi + 24) {
        outBadge.textContent = 'Optimized (Indicative)';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
        aiMsg.textContent = `Indicative balance: ${currentWwr}% WWR with ${g.shgc} SHGC balances thermal gain (${coolingTr} TR) and ~${sda}% spatial daylight estimate.`;
      } else {
        outBadge.textContent = 'Baseline (Indicative)';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-sky-500/15 text-sky-300 border border-sky-500/30';
        aiMsg.textContent = `Indicative baseline: Higher solar gain observed. Upgrading glazing or lowering WWR to 40% reduces indicative peak cooling (${coolingTr} TR).`;
      }
    }

    function updateSliderTrack(val: number) {
      if (!wwrSlider) return;
      const pct = Math.max(0, Math.min(100, ((val - 20) / (70 - 20)) * 100));
      wwrSlider.style.background = `linear-gradient(to right, #10b981 0%, #10b981 ${pct}%, rgba(255, 255, 255, 0.12) ${pct}%, rgba(255, 255, 255, 0.12) 100%)`;
    }

    updateSliderTrack(currentWwr);

    // Sync live 3D building geometry, glass tint, and climate illumination
    if (updateThreeBuilding) {
      updateThreeBuilding(currentWwr, currentGlazing, currentClimate);
    }
  }

  function syncClimateUI(climateKey: string) {
    if (climateSelect) climateSelect.value = climateKey;
    climateChips.forEach((chip) => {
      const val = chip.getAttribute('data-climate');
      if (val === climateKey) {
        chip.className = 'climate-chip px-1.5 py-1.5 rounded-md text-[10px] font-mono border border-emerald-500/50 bg-emerald-500/20 text-emerald-300 font-medium transition-all text-center cursor-pointer';
      } else {
        chip.className = 'climate-chip px-1.5 py-1.5 rounded-md text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white transition-all text-center cursor-pointer';
      }
    });
    if (climateDesc) {
      const c = climateData[climateKey];
      if (c) {
        const match = c.label.match(/\((.*?)\)/);
        climateDesc.textContent = match ? match[1] : '';
      }
    }
  }

  climateChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      currentClimate = chip.getAttribute('data-climate') || 'bengaluru';
      syncClimateUI(currentClimate);
      updateSimulation();
    });
  });

  climateSelect?.addEventListener('change', (e) => {
    currentClimate = (e.target as HTMLSelectElement).value;
    syncClimateUI(currentClimate);
    updateSimulation();
  });

  let animFrame: number | null = null;
  wwrSlider?.addEventListener('input', (e) => {
    const rawVal = parseFloat((e.target as HTMLInputElement).value);
    currentWwr = Math.round(rawVal);
    if (animFrame) cancelAnimationFrame(animFrame);
    animFrame = requestAnimationFrame(() => {
      updateSimulation();
    });
  });

  glazingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentGlazing = btn.getAttribute('data-glazing') || 'lowe';
      glazingBtns.forEach((b) => {
        b.className = 'glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/12 bg-[#1A2230] text-slate-400 hover:text-white hover:border-white/20 transition-all text-center cursor-pointer';
      });
      btn.className = 'glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-emerald-500/50 bg-emerald-500/15 text-emerald-300 transition-all text-center cursor-pointer';
      updateSimulation();
    });
  });

  // Initial call to paint track gradient & initialize 3D building state
  updateSimulation();

  // ─── FULL-SCREEN MOBILE CAD STUDIO MODAL LOGIC ───
  const studioCard = document.getElementById('studio-cad-card');
  const btnOpenStudio = document.getElementById('btn-open-mobile-studio');
  const btnCloseStudio = document.getElementById('btn-close-mobile-studio');
  const btnDoneStudio = document.getElementById('btn-done-mobile-studio');

  function openFullScreenStudio() {
    if (!studioCard) return;
    studioCard.classList.add('studio-fullscreen');
    document.body.style.overflow = 'hidden';
    const globalHeader = document.querySelector('header');
    if (globalHeader) globalHeader.style.display = 'none';
    if (orbitControls) orbitControls.enableZoom = true;

    setTimeout(() => {
      if (container && renderer && camera) {
        const w = container.clientWidth;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }
    }, 60);
  }

  function closeFullScreenStudio() {
    if (!studioCard) return;
    studioCard.classList.remove('studio-fullscreen');
    document.body.style.overflow = '';
    const globalHeader = document.querySelector('header');
    if (globalHeader) globalHeader.style.display = '';
    if (orbitControls) orbitControls.enableZoom = false;

    setTimeout(() => {
      if (container && renderer && camera) {
        const w = container.clientWidth;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }
    }, 60);
  }

  btnOpenStudio?.addEventListener('click', openFullScreenStudio);
  btnCloseStudio?.addEventListener('click', closeFullScreenStudio);
  btnDoneStudio?.addEventListener('click', closeFullScreenStudio);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && studioCard?.classList.contains('studio-fullscreen')) {
      closeFullScreenStudio();
    }
  });
</script>

