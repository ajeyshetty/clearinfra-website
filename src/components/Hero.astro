                <!-- Overlay: Real-time Dynamic WWR & Solar DNI callout badge -->
                <div class="absolute bottom-2.5 left-2.5 pointer-events-none flex items-center gap-2 text-[10px] font-mono text-slate-400 bg-[#07090e]/85 px-2.5 py-1 rounded-md border border-white/10 backdrop-blur-xs">
                  <span id="viz-wwr-callout" class="text-emerald-400 font-semibold">WWR: 40%</span>
                  <span class="text-slate-600">|</span>
