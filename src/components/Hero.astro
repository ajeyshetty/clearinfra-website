---
---

<section class="relative overflow-hidden pt-16 pb-24 lg:pt-24 lg:pb-32">
  <!-- Glow background effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[450px] bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] bg-teal-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Hero Header -->
    <div class="text-center max-w-4xl mx-auto space-y-6">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/70 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-medium shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>The CI-Driven OS for Sustainable Design Intelligence</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1]">
        Design High-Performance, <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
          Net-Zero Buildings
        </span>
        <br class="hidden sm:inline" /> in Seconds.
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Compress 80+ hours of fragmented energy consulting into real-time, bank-grade physics simulation. 
        Optimize <strong class="text-white font-semibold">CAPEX</strong>, <strong class="text-white font-semibold">operational carbon</strong>, and <strong class="text-white font-semibold">building code compliance</strong> simultaneously.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href="#contact"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl text-base font-semibold bg-emerald-400 hover:bg-emerald-300 text-slate-950 shadow-lg shadow-emerald-500/25 transition-all duration-200"
        >
          <span>Schedule Enterprise Demo</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="https://app.clearinfra.in"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-base font-semibold bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700/80 hover:border-slate-600 transition-all duration-200"
        >
          <span>Launch Platform</span>
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Trust highlights -->
      <div class="flex flex-wrap items-center justify-center gap-6 pt-4 text-xs sm:text-sm text-slate-400 font-mono">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
          </svg>
          <span>EnergyPlus & IESVE Validated</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
          </svg>
          <span>NBC 2016 & ECBC Certified Logic</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
          </svg>
          <span>Sub-Second Physics Solver</span>
        </div>
      </div>
    </div>

    <!-- Product Interface Mockup Card -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="relative rounded-2xl border border-slate-800 bg-slate-900/90 shadow-2xl shadow-emerald-500/10 overflow-hidden backdrop-blur-xl">
        <!-- Window title bar -->
        <div class="flex items-center justify-between px-4 py-3 bg-slate-950/90 border-b border-slate-800 text-xs text-slate-400 font-mono">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            <span class="ml-2 text-slate-300 font-semibold">Clearinfra Studio // High-Performance Digital Twin</span>
          </div>
          <div class="hidden sm:flex items-center gap-4 text-slate-400">
            <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              Live Physics Engine Active
            </span>
            <span>Solver: &lt; 0.12s</span>
          </div>
        </div>

        <!-- UI Dashboard Preview Body -->
        <div class="p-6 sm:p-8 space-y-6">
          <!-- Top KPI Strip -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Energy Performance (EPI)</span>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl sm:text-3xl font-bold text-white font-mono">72.4</span>
                <span class="text-xs font-mono text-emerald-400 font-medium">-38% vs Code</span>
              </div>
              <span class="text-[11px] text-slate-400">kWh / m² / year</span>
            </div>

            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Annual Carbon Abated</span>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl sm:text-3xl font-bold text-emerald-400 font-mono">1,840</span>
                <span class="text-xs font-mono text-slate-400">tCO₂e / yr</span>
              </div>
              <span class="text-[11px] text-emerald-400/90 font-medium">Net Zero Champion Strategy</span>
            </div>

            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400">HVAC Plant Sizing</span>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl sm:text-3xl font-bold text-white font-mono">1,120</span>
                <span class="text-xs font-mono text-cyan-400 font-medium">-240 TR Capex</span>
              </div>
              <span class="text-[11px] text-slate-400">Tons of Refrigeration (TR)</span>
            </div>

            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Financial Payback</span>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl sm:text-3xl font-bold text-white font-mono">2.1</span>
                <span class="text-xs font-mono text-emerald-400 font-medium">Years (IRR: 34%)</span>
              </div>
              <span class="text-[11px] text-slate-400">$1.2M NPV Net Savings</span>
            </div>
          </div>

          <!-- Interactive Engine Preview Box -->
          <div class="relative rounded-xl border border-slate-800 bg-slate-950/80 p-5 sm:p-6 overflow-hidden">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
              <div class="space-y-3 max-w-xl">
                <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-emerald-400 bg-emerald-950/50 px-2.5 py-1 rounded border border-emerald-500/20">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 6v6l4 2"></path>
                  </svg>
                  AUTONOMOUS OPTIMIZATION AGENT
                </div>
                <h3 class="text-lg font-bold text-white">
                  "Found superior orientation & glazing specification saving 14% peak cooling load."
                </h3>
                <p class="text-sm text-slate-300">
                  Clearinfra's multi-node thermal engine simultaneously balanced daylight autonomy (sDA 68%), solar heat gain (SHGC 0.23), and chiller staging to yield the CFO-approved Pareto curve.
                </p>
              </div>

              <!-- Badges status -->
              <div class="flex flex-col gap-2.5 w-full md:w-auto">
                <div class="flex items-center justify-between gap-4 px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs font-mono">
                  <span class="text-slate-400">ECBC Compliance:</span>
                  <span class="text-emerald-400 font-bold">ECBC+ (Super Compliant)</span>
                </div>
                <div class="flex items-center justify-between gap-4 px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs font-mono">
                  <span class="text-slate-400">Daylight Autonomy:</span>
                  <span class="text-cyan-400 font-bold">sDA 74% / ASE 8%</span>
                </div>
                <div class="flex items-center justify-between gap-4 px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs font-mono">
                  <span class="text-slate-400">Traceability:</span>
                  <span class="text-slate-300 font-bold">Bank-Grade Audit Ready</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
