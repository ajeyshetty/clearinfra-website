---
---

<section class="relative min-h-[calc(100vh-4.5rem)] flex items-center py-12 lg:py-16 bg-[#F7F6F2] bg-architectural-grid overflow-hidden">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24 relative z-10">
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-10 2xl:gap-16 items-center">
      
      <!-- Left 5 Cols: Architectural Editorial Consulting Copy on Warm Stone -->
      <div class="xl:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 sm:px-3.5 py-1.5 rounded-full bg-slate-900/[0.05] border border-slate-900/10 text-slate-700 text-[10px] sm:text-xs font-mono tracking-wide">
          <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-teal-600 shrink-0"></span>
          <span>BUILDING PHYSICS, AI &amp; COMPLIANCE PRACTICE</span>
        </div>

        <h1 class="text-[25px] sm:text-5xl 2xl:text-6xl font-semibold tracking-tight text-slate-900 leading-[1.18] sm:leading-[1.08]">
          High-performance building advisory, <span class="text-teal-700 font-normal italic">powered by <span class="whitespace-nowrap">proprietary physics.</span></span>
        </h1>

        <p class="text-[14.5px] sm:text-lg text-slate-600 leading-[24px] sm:leading-relaxed font-normal">
          Clearinfra is a specialist building science and sustainability consulting firm. Equipped with our <span class="whitespace-nowrap">in-house</span> 3D thermal solver, <strong class="text-slate-900 font-medium">native AI optimizer</strong>, and <strong class="text-slate-900 font-medium">automated NBC &amp; ECBC engine</strong>, we work alongside architects and developers to resolve envelope, HVAC, and CAPEX trade-offs during live design charrettes.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 pt-1 sm:pt-2">
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 sm:py-3 rounded-lg text-sm font-medium bg-slate-900 hover:bg-slate-800 text-white shadow-md shadow-slate-900/10 transition-all duration-200"
          >
            <span>Discuss a Project</span>
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#engine"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 sm:py-3 rounded-lg text-sm font-medium bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 shadow-xs transition-all duration-200"
          >
            <span>Explore Proprietary Stack</span>
          </a>
        </div>

        <!-- Subtle Practice Highlights -->
        <div class="pt-5 sm:pt-6 border-t border-slate-900/10 grid grid-cols-3 gap-2.5 sm:gap-4 text-xs font-mono">
          <div class="border-l-2 border-teal-700/35 pl-2.5 sm:pl-3">
            <span class="text-slate-900 block font-semibold text-[11px] sm:text-xs whitespace-nowrap">Native AI</span>
            <span class="text-slate-500 text-[10px] sm:text-[11px] block mt-0.5 leading-tight">Pareto search</span>
          </div>
          <div class="border-l-2 border-teal-700/35 pl-2.5 sm:pl-3">
            <span class="text-slate-900 block font-semibold text-[11px] sm:text-xs whitespace-nowrap">NBC &amp; ECBC</span>
            <span class="text-slate-500 text-[10px] sm:text-[11px] block mt-0.5 leading-tight">Clause checks</span>
          </div>
          <div class="border-l-2 border-teal-700/35 pl-2.5 sm:pl-3">
            <span class="text-slate-900 block font-semibold text-[11px] sm:text-xs whitespace-nowrap">EnergyPlus</span>
            <span class="text-slate-500 text-[10px] sm:text-[11px] block mt-0.5 leading-tight">Auditable .idf</span>
          </div>
        </div>
      </div>

      <!-- Right 7 Cols: High-Contrast Dark CAD Viewport (Clearinfra Editor) -->
      <div id="interactive-demo" class="xl:col-span-7">
        <div class="rounded-2xl border border-slate-900/80 bg-[#0B0F17] text-slate-100 shadow-2xl shadow-slate-950/25 overflow-hidden">
          <!-- Top CAD Window Bar -->
          <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 bg-[#07090e] border-b border-white/[0.08] text-xs font-mono">
            <div class="flex items-center gap-2 min-w-0">
              <div class="flex items-center gap-1.5 shrink-0">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
              </div>
              <span class="text-slate-200 font-medium whitespace-nowrap">CLEARINFRA EDITOR</span>
              <span class="hidden sm:inline-block text-slate-600">|</span>
              <span class="hidden sm:inline-block text-slate-400 truncate">Physics · Native AI · NBC/ECBC</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-400 shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="hidden sm:inline">Live Charrette View</span>
              <span class="sm:hidden">Live View</span>
            </div>
          </div>

          <!-- Main Interactive Grid inside Dark CAD Viewport -->
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <!-- Left 7 Cols of Card: Animated Isometric Building + Solar Path Canvas -->
            <div class="lg:col-span-7 p-4 sm:p-7 flex flex-col justify-between bg-blueprint-sub border-b lg:border-b-0 lg:border-r border-white/[0.07] relative min-h-[290px] sm:min-h-[360px]">
              <div class="flex items-center justify-between gap-2 text-[11px] sm:text-xs font-mono text-slate-400 z-10">
                <div class="truncate">
                  <span class="text-slate-500 hidden sm:inline">LOCATION:</span>
                  <span id="viz-climate-label" class="text-slate-200 sm:ml-1">Bengaluru (Temperate)</span>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span>Solar</span>
                  </span>
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                    <span>Glazing</span>
                  </span>
                </div>
              </div>

              <!-- Central Isometric SVG Building Visualization -->
              <div class="my-auto py-2 flex items-center justify-center">
                <svg viewBox="0 0 520 290" class="w-full max-w-[450px] h-auto overflow-visible">
                  <defs>
                    <linearGradient id="solarArcGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.05" />
                      <stop offset="50%" stop-color="#f59e0b" stop-opacity="0.45" />
                      <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.05" />
                    </linearGradient>
                    <linearGradient id="roofGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#1e293b" stop-opacity="0.9" />
                      <stop offset="100%" stop-color="#0f172a" stop-opacity="0.9" />
                    </linearGradient>
                    <linearGradient id="leftWallGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#1e293b" stop-opacity="0.75" />
                      <stop offset="100%" stop-color="#0f172a" stop-opacity="0.85" />
                    </linearGradient>
                    <linearGradient id="rightWallGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#0f172a" stop-opacity="0.9" />
                      <stop offset="100%" stop-color="#090d16" stop-opacity="0.95" />
                    </linearGradient>
                  </defs>

                  <!-- Ground Isometric Compass Ring -->
                  <ellipse cx="260" cy="230" rx="175" ry="50" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="3 3" />
                  <text x="260" y="173" text-anchor="middle" fill="#64748b" font-size="9" font-family="JetBrains Mono">N</text>
                  <text x="448" y="233" text-anchor="middle" fill="#64748b" font-size="9" font-family="JetBrains Mono">E</text>
                  <text x="260" y="290" text-anchor="middle" fill="#64748b" font-size="9" font-family="JetBrains Mono">S</text>
                  <text x="72" y="233" text-anchor="middle" fill="#64748b" font-size="9" font-family="JetBrains Mono">W</text>

                  <!-- Solar Path Arc -->
                  <path d="M 85 230 C 120 45, 400 45, 435 230" fill="none" stroke="url(#solarArcGrad)" stroke-width="1.75" stroke-dasharray="4 4" />

                  <!-- Animated Sun Group -->
                  <g class="animate-float">
                    <line id="solar-ray-1" x1="152" y1="78" x2="215" y2="128" stroke="#f59e0b" stroke-width="1" stroke-opacity="0.45" class="animate-dash" />
                    <line id="solar-ray-2" x1="152" y1="78" x2="205" y2="168" stroke="#f59e0b" stroke-width="1" stroke-opacity="0.35" class="animate-dash" />
                    <line id="solar-ray-3" x1="152" y1="78" x2="260" y2="105" stroke="#f59e0b" stroke-width="1" stroke-opacity="0.4" class="animate-dash" />

                    <circle cx="152" cy="78" r="14" fill="#f59e0b" fill-opacity="0.14" />
                    <circle cx="152" cy="78" r="6" fill="#fbbf24" />
                    <text x="152" y="56" text-anchor="middle" fill="#fbbf24" font-size="9" font-family="JetBrains Mono" id="viz-dni-label">760 W/m²</text>
                  </g>

                  <!-- Isometric Building Base Shadow -->
                  <polygon points="260,264 150,214 260,164 370,214" fill="rgba(16, 185, 129, 0.04)" stroke="rgba(16, 185, 129, 0.2)" stroke-width="1" />

                  <!-- Left Facade -->
                  <polygon points="160,212 260,258 260,126 160,80" fill="url(#leftWallGrad)" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" />

                  <!-- Right Facade -->
                  <polygon points="360,212 260,258 260,126 360,80" fill="url(#rightWallGrad)" stroke="rgba(255,255,255,0.16)" stroke-width="1.2" />

                  <!-- Roof Plate -->
                  <polygon points="260,34 160,80 260,126 360,80" fill="url(#roofGrad)" stroke="rgba(16, 185, 129, 0.45)" stroke-width="1.4" />
                  <line x1="210" y1="57" x2="310" y2="103" stroke="rgba(255,255,255,0.08)" stroke-width="0.75" />
                  <line x1="310" y1="57" x2="210" y2="103" stroke="rgba(255,255,255,0.08)" stroke-width="0.75" />

                  <!-- 5 Floors of Dynamic Glazing Bands -->
                  <polygon class="wwr-band-left" points="166,89 254,130 254,142 166,101" fill="rgba(56, 189, 248, 0.32)" stroke="rgba(56, 189, 248, 0.55)" stroke-width="0.75" />
                  <polygon class="wwr-band-right" points="354,89 266,130 266,142 354,101" fill="rgba(56, 189, 248, 0.20)" stroke="rgba(56, 189, 248, 0.4)" stroke-width="0.75" />

                  <polygon class="wwr-band-left" points="166,114 254,155 254,167 166,126" fill="rgba(56, 189, 248, 0.32)" stroke="rgba(56, 189, 248, 0.55)" stroke-width="0.75" />
                  <polygon class="wwr-band-right" points="354,114 266,155 266,167 354,126" fill="rgba(56, 189, 248, 0.20)" stroke="rgba(56, 189, 248, 0.4)" stroke-width="0.75" />

                  <polygon class="wwr-band-left" points="166,139 254,180 254,192 166,151" fill="rgba(56, 189, 248, 0.32)" stroke="rgba(56, 189, 248, 0.55)" stroke-width="0.75" />
                  <polygon class="wwr-band-right" points="354,139 266,180 266,192 354,151" fill="rgba(56, 189, 248, 0.20)" stroke="rgba(56, 189, 248, 0.4)" stroke-width="0.75" />

                  <polygon class="wwr-band-left" points="166,164 254,205 254,217 166,176" fill="rgba(56, 189, 248, 0.32)" stroke="rgba(56, 189, 248, 0.55)" stroke-width="0.75" />
                  <polygon class="wwr-band-right" points="354,164 266,205 266,217 354,176" fill="rgba(56, 189, 248, 0.20)" stroke="rgba(56, 189, 248, 0.4)" stroke-width="0.75" />

                  <polygon class="wwr-band-left" points="166,189 254,230 254,242 166,201" fill="rgba(56, 189, 248, 0.32)" stroke="rgba(56, 189, 248, 0.55)" stroke-width="0.75" />
                  <polygon class="wwr-band-right" points="354,189 266,230 266,242 354,201" fill="rgba(56, 189, 248, 0.20)" stroke="rgba(56, 189, 248, 0.4)" stroke-width="0.75" />

                  <!-- Dimension Callout Lines -->
                  <line x1="375" y1="80" x2="375" y2="212" stroke="rgba(16, 185, 129, 0.4)" stroke-width="1" />
                  <text x="384" y="150" fill="#10b981" font-size="9.5" font-family="JetBrains Mono" id="viz-wwr-callout">WWR: 40%</text>
                </svg>
              </div>

              <!-- Bottom Status Strip inside Canvas -->
              <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-white/[0.06] text-[11px] font-mono text-slate-400">
                <div>Solver: <span class="text-slate-300">ISO 13790 RC Kernel</span></div>
                <div id="viz-shgc-readout"><span class="text-emerald-400">SHGC 0.28 · U 1.6 W/m²K</span></div>
              </div>
            </div>

            <!-- Right 5 Cols of Card: Interactive Controls & Live Simulation Readout -->
            <div class="lg:col-span-5 p-6 sm:p-7 flex flex-col justify-between space-y-5 bg-[#090d14]">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Charrette Parameters</span>
                  <span class="text-[10px] font-mono text-emerald-400">Interactive</span>
                </div>

                <!-- Climate Selector -->
                <div>
                  <label for="ctrl-climate" class="block text-xs text-slate-300 mb-1.5 font-medium">Project Climate Zone (ECBC)</label>
                  <select
                    id="ctrl-climate"
                    class="w-full rounded-lg bg-[#0d131f] border border-white/10 px-3 py-2 text-xs text-white font-mono focus:outline-none focus:border-emerald-500 transition-colors"
                  >
                    <option value="bengaluru" selected>Bengaluru — Temperate</option>
                    <option value="mumbai">Mumbai — Warm-Humid</option>
                    <option value="delhi">New Delhi — Composite</option>
                    <option value="ahmedabad">Ahmedabad — Hot-Dry</option>
                  </select>
                </div>

                <!-- WWR Slider -->
                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <label for="ctrl-wwr" class="text-slate-300 font-medium">Window-to-Wall Ratio (WWR)</label>
                    <span id="val-wwr" class="font-mono text-emerald-400">40%</span>
                  </div>
                  <input
                    id="ctrl-wwr"
                    type="range"
                    min="20"
                    max="70"
                    step="1"
                    value="40"
                    class="ci-slider"
                  />
                  <div class="flex justify-between text-[10px] font-mono text-slate-500 mt-1">
                    <span>20%</span>
                    <span>40% (ECBC)</span>
                    <span>70%</span>
                  </div>
                </div>

                <!-- Glazing Spec Selector -->
                <div>
                  <span class="block text-xs text-slate-300 mb-1.5 font-medium">Glazing Specification</span>
                  <div class="grid grid-cols-3 gap-1.5" id="ctrl-glazing-group">
                    <button
                      type="button"
                      data-glazing="single"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/10 bg-white/[0.02] text-slate-400 hover:text-white transition-all text-center cursor-pointer"
                    >
                      Clear DGU<br/><span class="opacity-70">0.58</span>
                    </button>
                    <button
                      type="button"
                      data-glazing="lowe"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-emerald-500/50 bg-emerald-500/10 text-emerald-300 transition-all text-center cursor-pointer"
                    >
                      Low-E DGU<br/><span class="opacity-80">0.28</span>
                    </button>
                    <button
                      type="button"
                      data-glazing="triple"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/10 bg-white/[0.02] text-slate-400 hover:text-white transition-all text-center cursor-pointer"
                    >
                      Selective<br/><span class="opacity-70">0.22</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Simulated Physics Output Readout -->
              <div class="pt-4 border-t border-white/[0.07] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400">NBC &amp; ECBC Check</span>
                  <span id="out-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                    ECBC+ Compliant
                  </span>
                </div>

                <div class="grid grid-cols-3 gap-2.5">
                  <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap">Annual EPI</span>
                    <span id="out-epi" class="text-lg font-semibold text-white font-mono mt-0.5 block">80.2</span>
                    <span class="text-[9px] font-mono text-slate-500">kWh/m²·yr</span>
                  </div>

                  <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap">Plant Load</span>
                    <span id="out-cooling" class="text-lg font-semibold text-white font-mono mt-0.5 block">246</span>
                    <span class="text-[9px] font-mono text-slate-500">Peak TR</span>
                  </div>

                  <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap">Daylight</span>
                    <span id="out-sda" class="text-lg font-semibold text-emerald-400 font-mono mt-0.5 block">55%</span>
                    <span class="text-[9px] font-mono text-slate-500">sDA &gt;300lx</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Native AI Copilot & NBC Compliance Live Diagnostic Bar -->
          <div class="px-4 sm:px-5 py-3 bg-[#07090e] border-t border-white/[0.08] flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono">
            <div class="flex items-start sm:items-center gap-2.5 text-slate-300">
              <span class="px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 text-[10px] shrink-0 whitespace-nowrap mt-0.5 sm:mt-0">CI AI AGENT</span>
              <span id="ai-copilot-msg" class="text-slate-300 text-[11px] leading-relaxed">
                Optimal balance: 40% WWR with Low-E DGU meets NBC Pt.8 daylighting and ECBC+ SHGC limits.
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const climateData: Record<string, { label: string; baseEpi: number; solarFactor: number; dni: string }> = {
    bengaluru: { label: 'Bengaluru (Temperate)', baseEpi: 62, solarFactor: 0.72, dni: '760 W/m²' },
    mumbai:    { label: 'Mumbai (Warm-Humid)',   baseEpi: 88, solarFactor: 1.05, dni: '840 W/m²' },
    delhi:     { label: 'New Delhi (Composite)', baseEpi: 92, solarFactor: 1.12, dni: '890 W/m²' },
    ahmedabad: { label: 'Ahmedabad (Hot-Dry)',   baseEpi: 98, solarFactor: 1.25, dni: '960 W/m²' },
  };

  const glazingData: Record<string, { shgc: number; uval: number; colorLeft: string; colorRight: string }> = {
    single: { shgc: 0.58, uval: 2.8, colorLeft: 'rgba(245, 158, 11, 0.38)', colorRight: 'rgba(245, 158, 11, 0.24)' },
    lowe:   { shgc: 0.28, uval: 1.6, colorLeft: 'rgba(56, 189, 248, 0.34)', colorRight: 'rgba(56, 189, 248, 0.20)' },
    triple: { shgc: 0.22, uval: 1.1, colorLeft: 'rgba(16, 185, 129, 0.35)', colorRight: 'rgba(16, 185, 129, 0.22)' },
  };

  let currentClimate = 'bengaluru';
  let currentWwr = 40;
  let currentGlazing = 'lowe';

  const climateSelect = document.getElementById('ctrl-climate') as HTMLSelectElement | null;
  const wwrSlider = document.getElementById('ctrl-wwr') as HTMLInputElement | null;
  const wwrVal = document.getElementById('val-wwr');
  const glazingBtns = document.querySelectorAll('.glazing-btn');

  const outEpi = document.getElementById('out-epi');
  const outCooling = document.getElementById('out-cooling');
  const outSda = document.getElementById('out-sda');
  const outBadge = document.getElementById('out-badge');
  const aiMsg = document.getElementById('ai-copilot-msg');

  const vizClimateLabel = document.getElementById('viz-climate-label');
  const vizDniLabel = document.getElementById('viz-dni-label');
  const vizWwrCallout = document.getElementById('viz-wwr-callout');
  const vizShgcReadout = document.getElementById('viz-shgc-readout');

  const leftBands = document.querySelectorAll('.wwr-band-left');
  const rightBands = document.querySelectorAll('.wwr-band-right');

  const baseFloorsY = [89, 114, 139, 164, 189];

  function updateSimulation() {
    const c = climateData[currentClimate];
    const g = glazingData[currentGlazing];

    const envelopeGain = currentWwr * g.shgc * c.solarFactor * 1.15 + (currentWwr * g.uval * 0.14);
    const epi = (c.baseEpi + envelopeGain).toFixed(1);
    const coolingTr = Math.round(180 + envelopeGain * 3.6);
    const sda = Math.min(92, Math.round(24 + currentWwr * (0.65 + g.shgc * 0.45)));

    if (wwrVal) wwrVal.textContent = `${currentWwr}%`;
    if (outEpi) outEpi.textContent = epi;
    if (outCooling) outCooling.textContent = `${coolingTr}`;
    if (outSda) outSda.textContent = `${sda}%`;

    if (vizClimateLabel) vizClimateLabel.textContent = c.label;
    if (vizDniLabel) vizDniLabel.textContent = c.dni;
    if (vizWwrCallout) vizWwrCallout.textContent = `WWR: ${currentWwr}%`;
    if (vizShgcReadout) {
      vizShgcReadout.innerHTML = `<span class="text-emerald-400">SHGC ${g.shgc} · U ${g.uval} W/m²K</span>`;
    }

    if (outBadge && aiMsg) {
      const epiNum = parseFloat(epi);
      if (currentWwr > 40 && g.shgc > 0.3) {
        outBadge.textContent = 'ECBC Cl.4.3 Alert';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30';
        aiMsg.textContent = `NBC/ECBC Alert: WWR ${currentWwr}% with SHGC ${g.shgc} exceeds prescriptive limit. Switch to Low-E or Selective DGU to cut ~${Math.round(coolingTr * 0.18)} TR.`;
      } else if (epiNum < c.baseEpi + 14) {
        outBadge.textContent = 'SuperECBC Aligned';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
        aiMsg.textContent = `SuperECBC achieved (${epi} kWh/m²·yr). Envelope minimizes chiller tonnage (${coolingTr} TR) while preserving ${sda}% daylight autonomy.`;
      } else if (epiNum < c.baseEpi + 24) {
        outBadge.textContent = 'ECBC+ Compliant';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
        aiMsg.textContent = `Optimal balance: ${currentWwr}% WWR meets NBC Pt.8 daylighting (${sda}% sDA) and ECBC+ whole-building performance.`;
      } else {
        outBadge.textContent = 'ECBC Baseline';
        outBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-sky-500/15 text-sky-300 border border-sky-500/30';
        aiMsg.textContent = `Meets baseline ECBC. AI Optimizer suggests reducing WWR to 40% or upgrading glazing to lower peak cooling (${coolingTr} TR).`;
      }
    }

    function updateSliderTrack(val: number) {
      if (!wwrSlider) return;
      const pct = Math.max(0, Math.min(100, ((val - 20) / (70 - 20)) * 100));
      wwrSlider.style.background = `linear-gradient(to right, #10b981 0%, #10b981 ${pct}%, rgba(255, 255, 255, 0.12) ${pct}%, rgba(255, 255, 255, 0.12) 100%)`;
    }

    updateSliderTrack(currentWwr);

    // Continuous sub-pixel scaling for fluid 3D SVG building facade animation
    const bandHeight = Math.max(3.5, ((currentWwr / 70) * 19));
    const bandHeightFixed = Number(bandHeight.toFixed(2));
    leftBands.forEach((poly, i) => {
      const yTop = baseFloorsY[i];
      const yBot = Number((yTop + bandHeightFixed).toFixed(2));
      const yBotAngle = Number((yBot + 41).toFixed(2));
      poly.setAttribute('points', `166,${yTop} 254,${yTop + 41} 254,${yBotAngle} 166,${yBot}`);
      poly.setAttribute('fill', g.colorLeft);
    });
    rightBands.forEach((poly, i) => {
      const yTop = baseFloorsY[i];
      const yBot = Number((yTop + bandHeightFixed).toFixed(2));
      const yBotAngle = Number((yBot + 41).toFixed(2));
      poly.setAttribute('points', `354,${yTop} 266,${yTop + 41} 266,${yBotAngle} 354,${yBot}`);
      poly.setAttribute('fill', g.colorRight);
    });
  }

  climateSelect?.addEventListener('change', (e) => {
    currentClimate = (e.target as HTMLSelectElement).value;
    updateSimulation();
  });

  let animFrame: number | null = null;
  wwrSlider?.addEventListener('input', (e) => {
    const rawVal = parseFloat((e.target as HTMLInputElement).value);
    currentWwr = Math.round(rawVal);
    if (animFrame) cancelAnimationFrame(animFrame);
    animFrame = requestAnimationFrame(() => {
      updateSimulation();
    });
  });

  glazingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentGlazing = btn.getAttribute('data-glazing') || 'lowe';
      glazingBtns.forEach((b) => {
        b.className = 'glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/10 bg-white/[0.02] text-slate-400 hover:text-white transition-all text-center cursor-pointer';
      });
      btn.className = 'glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-emerald-500/50 bg-emerald-500/10 text-emerald-300 transition-all text-center cursor-pointer';
      updateSimulation();
    });
  });

  // Initial call to paint track gradient
  updateSimulation();
</script>
