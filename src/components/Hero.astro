                </div>

                <!-- Glazing Spec Selector -->
                <div>
                  <span class="block text-xs text-slate-300 mb-1.5 font-medium">Glazing Specification</span>
                  <div class="grid grid-cols-3 gap-1.5" id="ctrl-glazing-group">
                    <button
                      type="button"
                      data-glazing="single"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/10 bg-white/[0.02] text-slate-400 hover:text-white transition-all text-center cursor-pointer"
                    >
                      Clear DGU<br/><span class="opacity-70">0.58</span>
                    </button>
                    <button
                      type="button"
                      data-glazing="lowe"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-emerald-500/50 bg-emerald-500/10 text-emerald-300 transition-all text-center cursor-pointer"
                    >
                      Low-E DGU<br/><span class="opacity-80">0.28</span>
                    </button>
                    <button
                      type="button"
                      data-glazing="triple"
                      class="glazing-btn px-2 py-2 rounded-lg text-[10px] font-mono border border-white/10 bg-white/[0.02] text-slate-400 hover:text-white transition-all text-center cursor-pointer"
                    >
                      Selective<br/><span class="opacity-70">0.22</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Simulated Physics Output Readout -->
              <div class="pt-4 border-t border-white/[0.07] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400">NBC &amp; ECBC Check</span>
                  <span id="out-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                    ECBC+ Compliant
                  </span>
                </div>

                <div class="grid grid-cols-3 gap-2.5">
                  <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap">Annual EPI</span>
                    <span id="out-epi" class="text-lg font-semibold text-white font-mono mt-0.5 block">80.2</span>
                    <span class="text-[9px] font-mono text-slate-500">kWh/m²·yr</span>
                  </div>

                  <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap">Plant Load</span>
                    <span id="out-cooling" class="text-lg font-semibold text-white font-mono mt-0.5 block">246</span>
                    <span class="text-[9px] font-mono text-slate-500">Peak TR</span>
                  </div>

                  <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                    <span class="text-[9px] font-mono uppercase text-slate-400 block whitespace-nowrap">Daylight</span>
                    <span id="out-sda" class="text-lg font-semibold text-emerald-400 font-mono mt-0.5 block">55%</span>
                    <span class="text-[9px] font-mono text-slate-500">sDA &gt;300lx</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Native AI Copilot & NBC Compliance Live Diagnostic Bar -->
          <div class="px-4 sm:px-5 py-3 bg-[#07090e] border-t border-white/[0.08] flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono">
            <div class="flex items-start sm:items-center gap-2.5 text-slate-300">
              <span class="px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 text-[10px] shrink-0 whitespace-nowrap mt-0.5 sm:mt-0">CI AI AGENT</span>
              <span id="ai-copilot-msg" class="text-slate-300 text-[11px] leading-relaxed">
                Optimal balance: 40% WWR with Low-E DGU meets NBC Pt.8 daylighting and ECBC+ SHGC limits.
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
