                  <span class="text-slate-500 hidden sm:inline">LOCATION:</span>
                  <span id="viz-climate-label" class="text-slate-200 sm:ml-1">Bengaluru (Temperate)</span>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span>Solar</span>
