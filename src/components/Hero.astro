                <canvas id="three-building-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>
                
                <!-- Overlay: Drag to Orbit Badge -->
                <div class="absolute top-2.5 right-2.5 pointer-events-none flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#07090e]/85 border border-white/10 text-[10px] font-mono text-emerald-400 backdrop-blur-xs shadow-sm">
