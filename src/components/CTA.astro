---
---

<section id="contact" class="py-24 bg-[#090d14] border-t border-white/[0.06] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal rounded-2xl border border-white/[0.08] bg-[#07090e] p-8 sm:p-12 lg:p-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left Copy -->
        <div class="lg:col-span-5 space-y-5">
          <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">Get in Touch</span>
          <h2 class="text-3xl font-semibold text-white tracking-tight leading-tight">
            Evaluate Clearinfra on an upcoming project.
          </h2>
          <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
            We partner with architectural practices, MEP engineering teams, and real estate developers across India to model building performance during concept and schematic design.
          </p>

          <div class="pt-4 space-y-3 text-sm text-slate-300 font-mono">
            <div class="flex items-center gap-3">
              <span class="text-slate-500">Email</span>
              <a href="mailto:contact@clearinfra.in" class="text-emerald-400 hover:underline">contact@clearinfra.in</a>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-slate-500">Base</span>
              <span>Bengaluru, India</span>
            </div>
          </div>
        </div>

        <!-- Right Form -->
        <div class="lg:col-span-7">
          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="f-name" class="block text-xs font-mono text-slate-400 mb-1.5">Name</label>
                <input
                  id="f-name"
                  name="name"
                  type="text"
                  required
                  placeholder="Your name"
                  class="w-full rounded-lg bg-[#0d131f] border border-white/10 px-3.5 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
              <div>
                <label for="f-email" class="block text-xs font-mono text-slate-400 mb-1.5">Work Email</label>
                <input
                  id="f-email"
                  name="email"
                  type="email"
                  required
                  placeholder="you@organization.com"
                  class="w-full rounded-lg bg-[#0d131f] border border-white/10 px-3.5 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="f-org" class="block text-xs font-mono text-slate-400 mb-1.5">Organization</label>
                <input
                  id="f-org"
                  name="org"
                  type="text"
                  placeholder="Firm or company name"
                  class="w-full rounded-lg bg-[#0d131f] border border-white/10 px-3.5 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
              <div>
                <label for="f-discipline" class="block text-xs font-mono text-slate-400 mb-1.5">Discipline</label>
                <select
                  id="f-discipline"
                  name="discipline"
                  class="w-full rounded-lg bg-[#0d131f] border border-white/10 px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500 transition-colors"
                >
                  <option value="Architecture & Urban Design">Architecture &amp; Urban Design</option>
                  <option value="MEP & Building Physics">MEP &amp; Building Physics</option>
                  <option value="Real Estate Development">Real Estate Development</option>
                  <option value="Sustainability & ESG">Sustainability &amp; ESG</option>
                  <option value="Research & Academia">Research &amp; Academia</option>
                </select>
              </div>
            </div>

            <div>
              <label for="f-notes" class="block text-xs font-mono text-slate-400 mb-1.5">Project Context (Optional)</label>
              <textarea
                id="f-notes"
                name="notes"
                rows="3"
                placeholder="Briefly describe your building typology, location, or simulation needs..."
                class="w-full rounded-lg bg-[#0d131f] border border-white/10 px-3.5 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition-colors"
              ></textarea>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
              <button
                type="submit"
                class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg text-sm font-medium bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-colors duration-200 cursor-pointer"
              >
                <span>Send Inquiry</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
              <span id="form-feedback" class="text-xs font-mono text-emerald-400 hidden">
                Opening your email client to send inquiry...
              </span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name') || '';
    const email = data.get('email') || '';
    const org = data.get('org') || '';
    const discipline = data.get('discipline') || '';
    const notes = data.get('notes') || '';

    const subject = encodeURIComponent(`Clearinfra Walkthrough Inquiry — ${org || name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\nOrganization: ${org}\nDiscipline: ${discipline}\n\nContext:\n${notes}`
    );

    if (feedback) {
      feedback.classList.remove('hidden');
    }
    window.location.href = `mailto:contact@clearinfra.in?subject=${subject}&body=${body}`;
  });
</script>
