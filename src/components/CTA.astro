---
---

<section id="contact" class="py-24 relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 border-t border-slate-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="rounded-3xl border border-slate-800 bg-slate-950/90 p-8 sm:p-12 lg:p-16 shadow-2xl relative overflow-hidden backdrop-blur-xl">
      <!-- Glow -->
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-[80px] pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Text details -->
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-semibold">Join the Future</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
            Deploy Real-Time Building Intelligence.
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Schedule a private walkthrough with our engineering team to see how Clearinfra optimizes your building portfolio for capital efficiency and net-zero targets.
          </p>

          <div class="pt-4 space-y-3 text-sm text-slate-400">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>contact@clearinfra.in</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Bengaluru & Hyderabad, India</span>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="lg:col-span-7">
          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for contacting Clearinfra. Our team will connect with you shortly!');">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1.5">Your Name</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Rahul Sharma"
                  class="w-full rounded-xl bg-slate-900 border border-slate-700/80 px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
              <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1.5">Work Email</label>
                <input
                  type="email"
                  required
                  placeholder="name@company.com"
                  class="w-full rounded-xl bg-slate-900 border border-slate-700/80 px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1.5">Company / Firm</label>
                <input
                  type="text"
                  placeholder="Firm or Project name"
                  class="w-full rounded-xl bg-slate-900 border border-slate-700/80 px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
              <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1.5">Primary Role</label>
                <select class="w-full rounded-xl bg-slate-900 border border-slate-700/80 px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-500 transition-colors">
                  <option value="developer">Real Estate Developer</option>
                  <option value="architect">Architect / Master Planner</option>
                  <option value="mep">MEP / HVAC Engineer</option>
                  <option value="sustainability">Sustainability Consultant</option>
                  <option value="investor">ESG / Institutional Investor</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-mono uppercase text-slate-400 mb-1.5">Project Scope / Requirements</label>
              <textarea
                rows="3"
                placeholder="Tell us about your upcoming project (commercial, residential, campus), location, and goals..."
                class="w-full rounded-xl bg-slate-900 border border-slate-700/80 px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-4 rounded-xl text-base font-bold bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 shadow-lg shadow-emerald-500/25 transition-all duration-200"
            >
              Request Enterprise Consultation &rarr;
            </button>
            <p class="text-center text-xs text-slate-400">
              No spam. Direct technical briefing with our core building science engineers.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
