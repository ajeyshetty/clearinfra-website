---
const features = [
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: "Sub-Second Physics Engine",
    description: "Multi-node thermal RC modeling, psychrometric HVAC coil calculations, and 8,760 hourly weather integration—computed instantly using first principles instead of black-box approximations."
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    title: "Interactive 3D Digital Twin",
    description: "Real-time 3D massing, parametric floor geometry, facade orientation, and automated daylight (sDA / ASE) calculation connected directly to building energy performance."
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
    title: "Proactive AI Scenario Generator",
    description: "Autonomous agents proactively hunt for savings in the background, formulating multi-variable trade-offs to present the 'Net Zero Champion' and 'CFO Winner' options."
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    title: "India NBC & ECBC Automated Compliance",
    description: "Full regulatory validation against National Building Code (NBC 2016 Part 8) and ECBC. Automatic classification across ECBC, ECBC+, and SuperECBC tiers."
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    title: "Simultaneous Carbon & Capital ROI",
    description: "Every physical decision is immediately translated into financial consequence—linking equipment sizing to upfront CAPEX, annual OPEX, Net Present Value (NPV), and IRR."
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" /></svg>`,
    title: "EnergyPlus Validation & Export",
    description: "Bank-grade auditability. Export native, fully compliant EnergyPlus IDF models with zero translation friction to satisfy any investor or regulatory authority."
  }
];
---

<section id="features" class="py-24 bg-slate-900/40 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-semibold">Engine Architecture</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Built for Speed, Auditability, and Certainty.
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Clearinfra bridges the chasm between conceptual architectural massing and high-precision mechanical engineering.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="group relative rounded-2xl bg-slate-950 border border-slate-800 p-8 hover:border-emerald-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-emerald-500/5 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-emerald-950/80 border border-emerald-500/30 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform">
              <Fragment set:html={feature.icon} />
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors">
              {feature.title}
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed">
              {feature.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-900 flex items-center text-xs font-mono text-emerald-400/80 group-hover:text-emerald-400">
            <span>Learn specification &rarr;</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
