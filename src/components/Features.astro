---
const services = [
  {
    num: "01",
    phase: "CONCEPT & SCHEMATIC",
    title: "Passive Design & Envelope Optimization",
    description: "We collaborate with design architects during early massing to evaluate orientation, window-to-wall ratios, glazing specifications, and shading geometry before architectural drawings are frozen.",
    deliverable: "3D Thermal Charrette & Glazing Trade-Off Report",
    scopeKey: "Concept Charrette & WWR Optimization"
  },
  {
    num: "02",
    phase: "PLANT VALUE ENGINEERING",
    title: "Thermal Loads & HVAC Right-Sizing",
    description: "By coupling envelope options to coil loads, we help MEP teams review chiller plant capacity and identify potential CAPEX reductions before procurement.",
    deliverable: "Coil Psychrometric & Chiller TR Sizing Matrix",
    scopeKey: "Chiller Right-Sizing & Coil Psychrometrics"
  },
  {
    num: "03",
    phase: "VISUAL & THERMAL COMFORT",
    title: "Daylight & Solar Optimization",
    description: "We execute reference-day spatial daylight estimates (sDA) and solar exposure assessments across floor plates to optimize daylight distribution without solar thermal penalties.",
    deliverable: "Reference-Day Daylight Distribution & Solar Exposure Maps",
    scopeKey: "Concept Charrette & WWR Optimization"
  },
  {
    num: "04",
    phase: "STATUTORY COMPLIANCE",
    title: "NBC 2026 & ECBC Advisory",
    description: "Comprehensive statutory engineering across National Building Code 2026 (Parts B–F), local development control byelaws, ECBC pathways, and green rating consulting (IGBC, GRIHA, LEED).",
    deliverable: "Clause-Cited NBC 2026 & ECBC Advisory Submittal",
    scopeKey: "NBC 2026 & ECBC Statutory Compliance Advisory"
  },
  {
    num: "05",
    phase: "LIFECYCLE ECONOMICS",
    title: "CAPEX vs. OPEX Trade-Off Studies",
    description: "Every facade, insulation, or chiller specification is paired with indicative benchmarks from our 2025–2026 India cost library and operational energy savings projections.",
    deliverable: "Indicative CAPEX Payback & Energy Cost Schedule",
    scopeKey: "Chiller Right-Sizing & Coil Psychrometrics"
  },
  {
    num: "06",
    phase: "AUDITABLE BEM MODELS",
    title: "EnergyPlus Model Preparation",
    description: "Beyond early charrette studies, we prepare syntax-verified EnergyPlus (.idf) simulation models and engineering calculation sheets for design team review and due diligence.",
    deliverable: "Run-Checked EnergyPlus v25.1 (.idf) Simulation Model",
    scopeKey: "EnergyPlus v25.1 Submittal Model (.idf)"
  }
];
---

<section id="services" class="py-12 sm:py-16 lg:py-20 bg-[#0A0E17] border-b border-white/10 text-white relative overflow-hidden">
  <!-- Subtle Blueprint Grid -->
  <div class="absolute inset-0 bg-blueprint-sub pointer-events-none opacity-20" aria-hidden="true"></div>
  
  <!-- Subtle Ambient Depth Mesh -->
  <div class="absolute -top-32 left-1/4 w-[600px] h-[600px] bg-teal-500/[0.035] rounded-full blur-3xl pointer-events-none"></div>

  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24 relative z-10">
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-10 items-end text-center sm:text-left mb-8 sm:mb-12">
      <div class="lg:col-span-6 space-y-2.5 sm:space-y-3 mx-auto sm:mx-0">
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/[0.06] border border-white/15 text-emerald-300 text-[10px] sm:text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
          <span>ADVISORY &amp; ENGINEERING SERVICES</span>
        </div>
        <h2 class="ci-section-title text-white">
          <span class="block">Specialist consulting across{' '}</span>
          <span class="block text-emerald-400">the building lifecycle.</span>
        </h2>
      </div>
      <div class="lg:col-span-6 relative sm:pl-6 lg:pl-8 py-1 mx-auto sm:mx-0">
        <div class="hidden sm:block datum-line-v absolute left-0 top-1 bottom-1 w-[2px] rounded-full bg-gradient-to-b from-emerald-500 via-emerald-500/40 to-transparent" aria-hidden="true"></div>
        <p class="ci-section-lead text-slate-300">
          We embed with your project team from early architectural concept through statutory compliance—combining deep building science expertise with the speed of our in-house simulation technology.
        </p>
      </div>
    </div>

    <!-- MOBILE SNAP-SCROLL TOUCH DECK (< 768px) -->
    <div class="md:hidden">
      <!-- Status & Swipe Hint -->
      <div class="flex items-center justify-between mb-3 px-1 text-slate-400 font-mono text-[10px]">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="service-deck-counter" class="font-semibold text-slate-200">01 / 06 PRACTICES</span>
        </div>
        <div class="flex items-center gap-1 text-[11px] text-slate-400">
          <span class="text-[9px] uppercase tracking-wider">Swipe deck</span>
          <span>→</span>
        </div>
      </div>

      <!-- Snap Track with peek on right -->
      <div 
        id="service-carousel"
        class="flex gap-3.5 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scrollbar-none -mx-6 px-6"
        style="scroll-behavior: smooth; -webkit-overflow-scrolling: touch;"
      >
        {services.map((item, idx) => (
          <div 
            data-service-card={idx}
            class="snap-center shrink-0 w-[84vw] max-w-[320px] rounded-xl bg-[#131924] border border-white/10 p-5 shadow-xs flex flex-col justify-between text-left"
          >
            <div>
              <!-- Top index row -->
              <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-white/[0.08]">
                <span class="text-xs font-mono font-semibold text-slate-400 shrink-0">
                  {item.num}
                </span>
                <span class="text-[10px] font-mono text-emerald-400 font-semibold tracking-wider uppercase text-right">
                  {item.phase}
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-base font-semibold text-white mb-2 leading-snug">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="text-xs text-slate-300 leading-relaxed font-normal">
                {item.description}
              </p>
            </div>

            <!-- Deliverable -->
            <a
              href="#contact"
              data-service-scope={item.scopeKey}
              class="service-scope-link mt-auto pt-3.5 border-t border-white/[0.08] flex flex-col gap-1 text-[10px] font-mono group/del hover:border-emerald-500/40 transition-colors block"
              title="Click to select this scope in project consultation form"
            >
              <div class="flex items-center justify-between text-emerald-400 font-semibold uppercase tracking-wider text-[9px]">
                <div class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                  <span>Target Deliverable</span>
                </div>
                <span class="text-[9px] text-emerald-400/80 group-hover/del:text-emerald-300 group-hover/del:translate-x-0.5 transition-all flex items-center gap-0.5">
                  <span>Scope</span>
                  <span>→</span>
                </span>
              </div>
              <div class="text-slate-200 group-hover/del:text-white font-medium text-xs leading-snug transition-colors">
                {item.deliverable}
              </div>
            </a>
          </div>
        ))}
      </div>

      <!-- Controls: Dynamic Dot Pills + Prev/Next Buttons -->
      <div class="flex items-center justify-between pt-2 px-1">
        <div class="flex items-center gap-1.5" id="service-dots">
          {services.map((_, idx) => (
            <button
              type="button"
              data-dot-index={idx}
              class={`service-dot h-1.5 rounded-full transition-all duration-200 ${idx === 0 ? 'w-5 bg-emerald-400' : 'w-1.5 bg-slate-700'}`}
              aria-label={`Jump to service ${idx + 1}`}
            ></button>
          ))}
        </div>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="service-prev-btn"
            class="w-8 h-8 rounded-lg border border-white/15 bg-[#131924] text-slate-300 hover:text-white flex items-center justify-center text-xs shadow-xs transition-colors"
            aria-label="Previous service"
          >
            ←
          </button>
          <button
            type="button"
            id="service-next-btn"
            class="w-8 h-8 rounded-lg border border-white/15 bg-[#131924] text-slate-300 hover:text-white flex items-center justify-center text-xs shadow-xs transition-colors"
            aria-label="Next service"
          >
            →
          </button>
        </div>
      </div>
    </div>

    <!-- DESKTOP / TABLET GRID (>= 768px) -->
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map((item, idx) => (
        <div class={`arch-card reveal reveal-delay-${Math.min(idx + 1, 6)} group rounded-xl bg-[#131924] border border-white/10 hover:border-emerald-500/40 p-5 sm:p-7 shadow-xs hover:shadow-xl hover:shadow-emerald-950/30 hover:-translate-y-0.5 flex flex-col justify-between text-left transition-all duration-200`}>
          <div>
            <!-- Top index row: vibrant emerald badge and phase tag -->
            <div class="flex items-center justify-between gap-2 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 border-b border-white/[0.08]">
              <span class="text-xs font-mono font-semibold text-slate-400 shrink-0">
                {item.num}
              </span>
              <span class="text-[11px] font-mono text-emerald-400 font-semibold tracking-wider uppercase text-right">
                {item.phase}
              </span>
            </div>

            <!-- Service Title with min-h for consistent 2-line baseline alignment -->
            <h3 class="text-base sm:text-xl font-semibold text-white mb-2 sm:mb-2.5 min-h-[1.75rem] sm:min-h-[3.25rem] group-hover:text-emerald-300 transition-colors">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-slate-300 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>

          <!-- Bottom Tangible Deliverable Strip with Emerald Tint (Untruncated) -->
          <a
            href="#contact"
            data-service-scope={item.scopeKey}
            class="service-scope-link mt-auto pt-3.5 sm:pt-4 border-t border-white/[0.08] flex flex-col justify-between min-h-[4.75rem] text-[11px] font-mono group/del hover:border-emerald-500/40 transition-colors block"
            title="Click to select this scope in project consultation form"
          >
            <div class="flex items-center justify-between text-emerald-400 font-semibold uppercase tracking-wider text-[10px]">
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0 group-hover/del:scale-125 transition-transform"></span>
                <span>Target Deliverable</span>
              </div>
              <span class="text-[9.5px] text-emerald-400/80 group-hover/del:text-emerald-300 group-hover/del:translate-x-0.5 transition-all flex items-center gap-0.5">
                <span>Scope</span>
                <span>→</span>
              </span>
            </div>
            <div class="text-slate-200 group-hover/del:text-white font-medium text-xs leading-snug transition-colors">
              {item.deliverable}
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const carousel = document.getElementById('service-carousel');
  const counter = document.getElementById('service-deck-counter');
  const dots = document.querySelectorAll('.service-dot');
  const prevBtn = document.getElementById('service-prev-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('service-next-btn') as HTMLButtonElement | null;
  const cards = document.querySelectorAll<HTMLElement>('[data-service-card]');

  let currentIndex = 0;
  const total = cards.length;

  function updateActiveCard(index: number) {
    if (index < 0 || index >= total) return;
    currentIndex = index;

    if (counter) {
      counter.textContent = `0${currentIndex + 1} / 0${total} PRACTICES`;
    }

    dots.forEach((dot, idx) => {
      if (idx === currentIndex) {
        dot.className = 'service-dot h-1.5 rounded-full transition-all duration-200 w-5 bg-emerald-400';
      } else {
        dot.className = 'service-dot h-1.5 rounded-full transition-all duration-200 w-1.5 bg-slate-700';
      }
    });
  }

  function scrollToCard(index: number) {
    if (index < 0 || index >= total || !carousel) return;
    const targetCard = cards[index];
    if (targetCard) {
      targetCard.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      updateActiveCard(index);
    }
  }

  // Handle native scroll
  if (carousel) {
    let scrollTimeout: number;
    carousel.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(() => {
        const scrollLeft = carousel.scrollLeft;
        let closestIndex = 0;
        let minDiff = Infinity;
        cards.forEach((card, idx) => {
          const cardLeft = card.offsetLeft - carousel.offsetLeft;
          const diff = Math.abs(cardLeft - scrollLeft);
          if (diff < minDiff) {
            minDiff = diff;
            closestIndex = idx;
          }
        });
        updateActiveCard(closestIndex);
      }, 50);
    }, { passive: true });
  }

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.getAttribute('data-dot-index'));
      scrollToCard(idx);
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        scrollToCard(currentIndex - 1);
      } else {
        scrollToCard(total - 1);
      }
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      if (currentIndex < total - 1) {
        scrollToCard(currentIndex + 1);
      } else {
        scrollToCard(0);
      }
    });
  }

  // Cross-component scope link integration with contact form
  document.querySelectorAll('.service-scope-link').forEach((link) => {
    link.addEventListener('click', () => {
      const scopeVal = link.getAttribute('data-service-scope');
      if (scopeVal) {
        window.dispatchEvent(new CustomEvent('clearinfra:select-scope', { detail: { scope: scopeVal } }));
      }
    });
  });
</script>
