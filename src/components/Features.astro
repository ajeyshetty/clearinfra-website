---
const services = [
  {
    num: "01",
    phase: "CONCEPT & SCHEMATIC",
    title: "Passive Design & Envelope Optimization",
    description: "We collaborate with design architects during early massing to evaluate orientation, window-to-wall ratios, glazing specifications, and shading geometry before architectural drawings are frozen.",
    deliverable: "3D Thermal Charrette & Glazing Trade-Off Report"
  },
  {
    num: "02",
    phase: "PLANT VALUE ENGINEERING",
    title: "Thermal Loads & HVAC Right-Sizing",
    description: "By coupling envelope upgrades directly to psychrometric coil loads, we help MEP teams avoid chiller plant oversizing and eliminate redundant upfront mechanical CAPEX.",
    deliverable: "Coil Psychrometric & Chiller TR Sizing Matrix"
  },
  {
    num: "03",
    phase: "VISUAL & THERMAL COMFORT",
    title: "Daylight & Solar Optimization",
    description: "We execute reference-day spatial daylight estimates (sDA) and solar exposure assessments across floor plates to optimize daylight distribution without solar thermal penalties.",
    deliverable: "Reference-Day Daylight Distribution & Solar Exposure Maps"
  },
  {
    num: "04",
    phase: "STATUTORY COMPLIANCE",
    title: "NBC 2026 & ECBC Advisory",
    description: "Comprehensive statutory engineering across National Building Code 2026 (Parts B–F), local development control byelaws, ECBC pathways, and green rating consulting (IGBC, GRIHA, LEED).",
    deliverable: "Clause-Cited NBC 2026 & ECBC Advisory Submittal"
  },
  {
    num: "05",
    phase: "LIFECYCLE ECONOMICS",
    title: "CAPEX vs. OPEX Trade-Off Studies",
    description: "Every facade, insulation, or chiller specification is paired with indicative benchmarks from our 2025–2026 India cost library and operational energy savings projections.",
    deliverable: "Indicative CAPEX Payback & Energy Cost Schedule"
  },
  {
    num: "06",
    phase: "AUDITABLE BEM MODELS",
    title: "EnergyPlus Model Preparation",
    description: "Beyond early charrette studies, we prepare syntax-verified EnergyPlus (.idf) simulation models and engineering calculation sheets for design team review and due diligence.",
    deliverable: "Run-Checked EnergyPlus v25.1 (.idf) Simulation Model"
  }
];
---

<section id="services" class="py-8 sm:py-20 lg:py-28 bg-[#F7F6F2] relative">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24">
    <div class="reveal flex flex-col lg:flex-row items-center sm:items-start lg:items-end justify-between text-center sm:text-left mb-9 sm:mb-12 lg:mb-16 gap-3.5 sm:gap-6">
      <div class="max-w-2xl space-y-2.5 sm:space-y-3 mx-auto sm:mx-0">
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-slate-900/[0.04] border border-slate-900/10 text-slate-700 text-[10px] sm:text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>ADVISORY &amp; ENGINEERING SERVICES</span>
        </div>
        <h2 class="text-[clamp(1.4rem,4.5vw,3rem)] sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight leading-[1.15] text-balance">
          Specialist consulting across the building lifecycle.
        </h2>
      </div>
      <p class="text-slate-600 text-sm sm:text-base max-w-xl leading-relaxed mx-auto sm:mx-0">
        We embed with your project team from early architectural concept through statutory compliance—combining deep building science expertise with the speed of our in-house simulation technology.
      </p>
    </div>

    <!-- MOBILE SNAP-SCROLL TOUCH DECK (< 768px) -->
    <div class="md:hidden">
      <!-- Status & Swipe Hint -->
      <div class="flex items-center justify-between mb-3 px-1 text-slate-500 font-mono text-[10px]">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="service-deck-counter" class="font-semibold text-slate-700">01 / 06 PRACTICES</span>
        </div>
        <div class="flex items-center gap-1 text-[11px] text-slate-400">
          <span class="text-[9px] uppercase tracking-wider">Swipe deck</span>
          <span>→</span>
        </div>
      </div>

      <!-- Snap Track with peek on right -->
      <div 
        id="service-carousel"
        class="flex gap-3.5 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scrollbar-none -mx-6 px-6"
        style="scroll-behavior: smooth; -webkit-overflow-scrolling: touch;"
      >
        {services.map((item, idx) => (
          <div 
            data-service-card={idx}
            class="snap-center shrink-0 w-[84vw] max-w-[320px] rounded-xl bg-white border border-slate-900/10 p-5 shadow-xs flex flex-col justify-between text-left"
          >
            <div>
              <!-- Top index row -->
              <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-900/[0.06]">
                <span class="text-xs font-mono font-medium text-slate-400 shrink-0">
                  {item.num}
                </span>
                <span class="text-[10px] font-mono text-emerald-700 font-semibold tracking-wider uppercase text-right">
                  {item.phase}
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-base font-semibold text-slate-900 mb-2 leading-snug">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="text-xs text-slate-600 leading-relaxed font-normal">
                {item.description}
              </p>
            </div>

            <!-- Deliverable -->
            <div class="mt-4 pt-3.5 border-t border-slate-900/[0.07] flex flex-col gap-1 text-[10px] font-mono">
              <div class="flex items-center gap-1.5 text-emerald-700 font-semibold uppercase tracking-wider text-[9px]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                <span>Target Deliverable</span>
              </div>
              <div class="text-slate-900 font-medium text-xs leading-snug">
                {item.deliverable}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Controls: Dynamic Dot Pills + Prev/Next Buttons -->
      <div class="flex items-center justify-between pt-2 px-1">
        <div class="flex items-center gap-1.5" id="service-dots">
          {services.map((_, idx) => (
            <button
              type="button"
              data-dot-index={idx}
              class={`service-dot h-1.5 rounded-full transition-all duration-200 ${idx === 0 ? 'w-5 bg-emerald-600' : 'w-1.5 bg-slate-300'}`}
              aria-label={`Jump to service ${idx + 1}`}
            ></button>
          ))}
        </div>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="service-prev-btn"
            class="w-8 h-8 rounded-lg border border-slate-900/10 bg-white text-slate-600 hover:text-slate-900 flex items-center justify-center text-xs shadow-xs transition-colors"
            aria-label="Previous service"
          >
            ←
          </button>
          <button
            type="button"
            id="service-next-btn"
            class="w-8 h-8 rounded-lg border border-slate-900/10 bg-white text-slate-600 hover:text-slate-900 flex items-center justify-center text-xs shadow-xs transition-colors"
            aria-label="Next service"
          >
            →
          </button>
        </div>
      </div>
    </div>

    <!-- DESKTOP / TABLET GRID (>= 768px) -->
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map((item, idx) => (
        <div class={`arch-card reveal reveal-delay-${Math.min(idx + 1, 6)} group rounded-xl bg-white border border-slate-900/10 hover:border-emerald-600/50 p-5 sm:p-7 shadow-xs hover:shadow-xl hover:shadow-emerald-950/5 hover:-translate-y-0.5 flex flex-col justify-between text-left`}>
          <div>
            <!-- Top index row: vibrant emerald badge and phase tag -->
            <div class="flex items-center justify-between gap-2 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 border-b border-slate-900/[0.06]">
              <span class="text-xs font-mono font-medium text-slate-400 shrink-0">
                {item.num}
              </span>
              <span class="text-[11px] font-mono text-emerald-700 font-semibold tracking-wider uppercase text-right">
                {item.phase}
              </span>
            </div>

            <!-- Service Title -->
            <h3 class="text-base sm:text-xl font-semibold text-slate-900 mb-2 sm:mb-2.5 group-hover:text-emerald-950 transition-colors">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-slate-600 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>

          <!-- Bottom Tangible Deliverable Strip with Emerald Tint (Untruncated) -->
          <div class="mt-4 sm:mt-6 pt-3.5 sm:pt-4 border-t border-slate-900/[0.07] flex flex-col gap-1.5 text-[11px] font-mono">
            <div class="flex items-center gap-1.5 text-emerald-700 font-semibold uppercase tracking-wider text-[10px]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
              <span>Target Deliverable</span>
            </div>
            <div class="text-slate-900 font-medium text-xs leading-snug">
              {item.deliverable}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const carousel = document.getElementById('service-carousel');
  const counter = document.getElementById('service-deck-counter');
  const dots = document.querySelectorAll('.service-dot');
  const prevBtn = document.getElementById('service-prev-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('service-next-btn') as HTMLButtonElement | null;
  const cards = document.querySelectorAll<HTMLElement>('[data-service-card]');

  let currentIndex = 0;
  const total = cards.length;

  function updateActiveCard(index: number) {
    if (index < 0 || index >= total) return;
    currentIndex = index;

    if (counter) {
      counter.textContent = `0${currentIndex + 1} / 0${total} PRACTICES`;
    }

    dots.forEach((dot, idx) => {
      if (idx === currentIndex) {
        dot.className = 'service-dot h-1.5 rounded-full transition-all duration-200 w-5 bg-emerald-600';
      } else {
        dot.className = 'service-dot h-1.5 rounded-full transition-all duration-200 w-1.5 bg-slate-300';
      }
    });
  }

  function scrollToCard(index: number) {
    if (index < 0 || index >= total || !carousel) return;
    const targetCard = cards[index];
    if (targetCard) {
      targetCard.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      updateActiveCard(index);
    }
  }

  // Handle native scroll
  if (carousel) {
    let scrollTimeout: number;
    carousel.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(() => {
        const scrollLeft = carousel.scrollLeft;
        let closestIndex = 0;
        let minDiff = Infinity;
        cards.forEach((card, idx) => {
          const cardLeft = card.offsetLeft - carousel.offsetLeft;
          const diff = Math.abs(cardLeft - scrollLeft);
          if (diff < minDiff) {
            minDiff = diff;
            closestIndex = idx;
          }
        });
        updateActiveCard(closestIndex);
      }, 50);
    }, { passive: true });
  }

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.getAttribute('data-dot-index'));
      scrollToCard(idx);
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        scrollToCard(currentIndex - 1);
      } else {
        scrollToCard(total - 1);
      }
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      if (currentIndex < total - 1) {
        scrollToCard(currentIndex + 1);
      } else {
        scrollToCard(0);
      }
    });
  }
</script>
