---
const workflows = [
  {
    aspect: "Design Review Cadence",
    conventionalLead: "Weeks offline:",
    conventionalBody: "Thermal models are built in isolation and returned as static reports.",
    clearinfraLead: "Live during design meetings:",
    clearinfraBody: "Our engineers join your sessions with our physics engine & AI copilot to test massing and glazing options live."
  },
  {
    aspect: "Multi-Variable Optimization",
    conventionalLead: "Manual trial-and-error:",
    conventionalBody: "A small number of envelope combinations can be compared when runtimes are slow.",
    clearinfraLead: "Multi-option exploration:",
    clearinfraBody: "Built-in AI explores orientation, WWR, glazing SHGC and HVAC plant options during the working session."
  },
  {
    aspect: "Code & Statutory Alignment",
    conventionalLead: "Late-stage checks:",
    conventionalBody: "Code checks can become a reactive, manual exercise late in design.",
    clearinfraLead: "Concept-stage integration:",
    clearinfraBody: "Clause-level NBC 2026 (Parts B–F) and ECBC guidance integrated from day one with engineer review."
  },
  {
    aspect: "Deliverables & Auditability",
    conventionalLead: "Opaque spreadsheets:",
    conventionalBody: "Disconnected calculation sheets with unverifiable simulation assumptions.",
    clearinfraLead: "Formula-level traceability:",
    clearinfraBody: "Live dependency maps, indicative Indian CAPEX payback estimates, and run-checked EnergyPlus (.idf) models."
  }
];
---

<section id="workflow" class="py-12 sm:py-16 lg:py-20 bg-[#0A0E17] border-t border-white/10 text-white relative overflow-hidden">
  <!-- Subtle Ambient Depth Mesh -->
  <div class="absolute -top-32 right-1/3 w-[650px] h-[650px] bg-emerald-500/[0.035] rounded-full blur-3xl pointer-events-none"></div>
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24">
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-10 items-end mb-8 sm:mb-10 text-center sm:text-left">
      <div class="lg:col-span-6 space-y-2.5 sm:space-y-3 mx-auto sm:mx-0">
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/[0.06] border border-white/15 text-emerald-300 text-[10px] sm:text-xs font-mono tracking-wider mx-auto sm:mx-0">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
          <span>PRACTICE METHODOLOGY</span>
        </div>
        <h2 class="ci-section-title text-white">
          <span class="block">Live engineering charrettes,{' '}</span>
          <span class="block text-emerald-400">not static reports.</span>
        </h2>
      </div>
      <div class="lg:col-span-6 relative sm:pl-6 lg:pl-8 py-1 mx-auto sm:mx-0">
        <div class="hidden sm:block datum-line-v absolute left-0 top-1 bottom-1 w-[2px] rounded-full bg-gradient-to-b from-emerald-500 via-emerald-500/40 to-transparent" aria-hidden="true"></div>
        <p class="ci-section-lead text-slate-300">
          Because we built our physics and compliance stack, and embedded an AI copilot into it, our consulting engagements operate as interactive working sessions rather than slow, disconnected hand-offs.
        </p>
      </div>
    </div>

    <!-- MOBILE COMPARISON EXPERIENCE (< 768px) -->
    <div class="md:hidden space-y-4">
      <!-- Segmented View Mode Switcher -->
      <div class="flex items-center p-1 bg-white/[0.04] border border-white/10 rounded-xl">
        <button
          type="button"
          id="wf-mode-clearinfra"
          class="wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-semibold transition-all duration-200 bg-[#131924] text-emerald-300 shadow-xs border border-emerald-500/30 flex items-center justify-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
          <span>Clearinfra Practice</span>
        </button>
        <button
          type="button"
          id="wf-mode-conventional"
          class="wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-slate-200 transition-all duration-200 flex items-center justify-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-slate-500 shrink-0 opacity-60"></span>
          <span>Conventional</span>
        </button>
      </div>

      <!-- Clearinfra Practice View (Default Active) -->
      <div id="wf-panel-clearinfra" class="space-y-3 transition-opacity duration-200">
        {workflows.map((row, idx) => (
          <div class="rounded-xl bg-[#131924] border border-emerald-500/30 p-4.5 shadow-xs text-left relative overflow-hidden pl-5">
            <div class="absolute top-0 left-0 bottom-0 w-1.5 bg-emerald-400"></div>
            <div class="flex items-center justify-between gap-2 pb-2.5 mb-2.5 border-b border-white/[0.08]">
              <span class="text-xs font-mono font-semibold text-slate-400">0{idx + 1}</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 font-semibold">
                Augmented Speed
              </span>
            </div>
            <h3 class="text-base font-semibold text-white mb-1.5 leading-snug">
              {row.aspect}
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-2.5">
              <strong class="font-semibold text-emerald-300">{row.clearinfraLead}</strong> {row.clearinfraBody}
            </p>
            <div class="pt-2.5 border-t border-white/[0.08] text-[10px] font-mono text-slate-400 flex items-center gap-1.5 font-medium">
              <span class="text-slate-500 shrink-0">Legacy:</span>
              <span class="text-slate-400 truncate">{row.conventionalLead} {row.conventionalBody}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Conventional Consulting View -->
      <div id="wf-panel-conventional" class="hidden space-y-3 transition-opacity duration-200">
        {workflows.map((row, idx) => (
          <div class="rounded-xl bg-[#111722] border border-white/10 p-4.5 shadow-xs text-left relative overflow-hidden pl-5">
            <div class="absolute top-0 left-0 bottom-0 w-1.5 bg-slate-600"></div>
            <div class="flex items-center justify-between gap-2 pb-2.5 mb-2.5 border-b border-white/[0.08]">
              <span class="text-xs font-mono font-semibold text-slate-500">0{idx + 1}</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/[0.06] text-slate-400 font-semibold border border-white/10">
                Legacy Bottleneck
              </span>
            </div>
            <h3 class="text-base font-semibold text-white mb-1.5 leading-snug">
              {row.aspect}
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-2.5">
              <strong class="font-semibold text-slate-300">{row.conventionalLead}</strong> {row.conventionalBody}
            </p>
            <div class="pt-2.5 border-t border-white/[0.08] text-[10px] font-mono text-emerald-400 flex items-center gap-1.5 font-semibold">
              <span class="shrink-0">CI Advantage:</span>
              <span class="truncate">{row.clearinfraLead} {row.clearinfraBody}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- DESKTOP / TABLET ARCHITECTURAL MONOGRAPH MATRIX (>= 768px) -->
    <div class="hidden md:block reveal rounded-2xl border border-white/10 bg-[#131924] shadow-2xl overflow-hidden">
      <!-- Matrix Header -->
      <div class="grid grid-cols-1 md:grid-cols-12 bg-[#0E141E] border-b border-white/10 text-xs font-mono uppercase tracking-wider">
        <div class="md:col-span-3 px-5 sm:px-8 py-4 sm:py-4.5 text-slate-400 font-semibold">
          Engagement Dimension
        </div>
        <div class="hidden md:flex md:col-span-4 px-5 sm:px-8 py-4 sm:py-4.5 text-slate-400 font-semibold border-l border-white/10 items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-500 shrink-0"></span>
          <span>Conventional Consulting</span>
        </div>
        <div class="hidden md:flex md:col-span-5 px-5 sm:px-8 py-4 sm:py-4.5 text-emerald-300 font-semibold items-center gap-2 bg-emerald-500/[0.08] border-l border-emerald-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
          <span>Clearinfra Practice (Physics + Built-in AI)</span>
        </div>
      </div>

      <!-- Matrix Rows with Elevated Clearinfra Column -->
      <div class="divide-y divide-white/10">
        {workflows.map((row, idx) => (
          <div class={`reveal reveal-delay-${idx + 1} group grid grid-cols-1 md:grid-cols-12 items-stretch hover:bg-white/[0.02] transition-colors`}>
            <!-- Col 1: Dimension with Monograph Index -->
            <div class="md:col-span-3 px-5 sm:px-8 py-5 sm:py-6 flex items-start gap-3">
              <span class="text-xs font-mono font-semibold text-slate-500 mt-0.5 shrink-0">0{idx + 1}</span>
              <span class="text-sm sm:text-base font-semibold text-white leading-snug">
                {row.aspect}
              </span>
            </div>

            <!-- Col 2: Conventional -->
            <div class="md:col-span-4 px-5 sm:px-8 py-5 sm:py-6 text-sm text-slate-300 leading-relaxed font-normal md:border-l md:border-white/10 flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-500 shrink-0 mt-2 hidden sm:inline-block"></span>
              <div>
                <span class="md:hidden text-[10px] font-mono uppercase text-slate-400 block mb-1.5">Conventional Consulting:</span>
                <strong class="font-semibold text-slate-200">{row.conventionalLead}</strong>{' '}
                <span class="text-slate-400">{row.conventionalBody}</span>
              </div>
            </div>

            <!-- Col 3: Clearinfra Practice -->
            <div class="md:col-span-5 px-5 sm:px-8 py-5 sm:py-6 text-sm text-slate-200 leading-relaxed bg-emerald-500/[0.03] group-hover:bg-emerald-500/[0.06] transition-colors md:border-l md:border-emerald-500/30 flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0 mt-2 hidden sm:inline-block"></span>
              <div>
                <span class="md:hidden text-[10px] font-mono uppercase text-emerald-400 font-semibold block mb-1.5">Clearinfra Practice:</span>
                <strong class="font-semibold text-emerald-300">{row.clearinfraLead}</strong>{' '}
                <span class="text-slate-300">{row.clearinfraBody}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const btnClearinfra = document.getElementById('wf-mode-clearinfra');
  const btnConventional = document.getElementById('wf-mode-conventional');
  const panelClearinfra = document.getElementById('wf-panel-clearinfra');
  const panelConventional = document.getElementById('wf-panel-conventional');

  btnClearinfra?.addEventListener('click', () => {
    btnClearinfra.className = 'wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-semibold transition-all duration-200 bg-[#131924] text-emerald-300 shadow-xs border border-emerald-500/30 flex items-center justify-center gap-1.5';
    btnConventional!.className = 'wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-slate-200 transition-all duration-200 flex items-center justify-center gap-1.5';
    panelClearinfra?.classList.remove('hidden');
    panelConventional?.classList.add('hidden');
  });

  btnConventional?.addEventListener('click', () => {
    btnConventional.className = 'wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-semibold transition-all duration-200 bg-[#131924] text-white shadow-xs border border-white/20 flex items-center justify-center gap-1.5';
    btnClearinfra!.className = 'wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-slate-200 transition-all duration-200 flex items-center justify-center gap-1.5';
    panelConventional?.classList.remove('hidden');
    panelClearinfra?.classList.add('hidden');
  });
</script>
