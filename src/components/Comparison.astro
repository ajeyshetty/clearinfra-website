---
const workflows = [
  {
    aspect: "Design Review Cadence",
    conventional: "Consultants take 2–3 weeks offline to build thermal models and return static PDF reports",
    clearinfra: "Our engineers join your design meetings with our proprietary engine & native AI copilot—testing massing and glazing options live"
  },
  {
    aspect: "Multi-Variable Optimization",
    conventional: "Manual trial-and-error across 2 or 3 envelope combinations due to slow runtimes",
    clearinfra: "Native AI Pareto optimizer sweeps orientation, WWR, glazing SHGC, and HVAC plant options in seconds"
  },
  {
    aspect: "Code & Statutory Compliance",
    conventional: "NBC 2016 and ECBC checks treated as a late-stage manual documentation exercise",
    clearinfra: "Automated clause-level NBC 2016 (Part 3, 4 & 8) and ECBC verification embedded from concept design onward"
  },
  {
    aspect: "Deliverables & Auditability",
    conventional: "Disconnected spreadsheets and opaque simulation assumptions",
    clearinfra: "Full formula-level dependency traceability, Indian CAPEX payback reports, and validated EnergyPlus (.idf) models"
  }
];
---

<section id="workflow" class="py-24 lg:py-28 bg-[#F7F6F2] border-t border-slate-900/10 relative">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24">
    <div class="reveal flex flex-col lg:flex-row lg:items-end justify-between mb-14 gap-6">
      <div class="max-w-2xl space-y-3">
        <span class="text-xs font-mono uppercase tracking-widest text-teal-700 font-semibold">How We Work</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight">
          Live engineering charrettes, not weeks-late reports.
        </h2>
      </div>
      <p class="text-slate-600 text-sm sm:text-base max-w-xl leading-relaxed">
        Because we own our underlying physics, AI, and compliance stack, our consulting engagements operate as interactive working sessions rather than slow, disconnected hand-offs.
      </p>
    </div>

    <!-- Clean Workflow Table on Stone/White -->
    <div class="reveal rounded-2xl border border-slate-900/12 bg-white shadow-sm overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-12 bg-slate-900 text-white px-8 py-5 text-xs font-mono uppercase tracking-wider">
        <div class="md:col-span-3 text-slate-300">Engagement Dimension</div>
        <div class="hidden md:block md:col-span-4 text-slate-400">Conventional Consulting</div>
        <div class="hidden md:flex md:col-span-5 text-emerald-400 items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Clearinfra Practice (Physics + Native AI + NBC Engine)</span>
        </div>
      </div>

      <div class="divide-y divide-slate-900/10">
        {workflows.map((row) => (
          <div class="grid grid-cols-1 md:grid-cols-12 px-8 py-6 gap-3 md:gap-8 items-start hover:bg-slate-50/80 transition-colors">
            <div class="md:col-span-3 text-base font-semibold text-slate-900">
              {row.aspect}
            </div>
            <div class="md:col-span-4 text-sm text-slate-500 leading-relaxed">
              <span class="md:hidden text-[10px] font-mono uppercase text-slate-400 block mb-1">Conventional Consulting:</span>
              {row.conventional}
            </div>
            <div class="md:col-span-5 text-sm text-slate-900 font-medium leading-relaxed">
              <span class="md:hidden text-[10px] font-mono uppercase text-teal-700 block mb-1">Clearinfra Practice:</span>
              {row.clearinfra}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
