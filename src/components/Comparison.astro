---
const workflows = [
  {
    aspect: "Design Review Cadence",
    conventional: "Consultants take 2–3 weeks offline to build thermal models and return static PDF reports",
    clearinfra: "Our engineers join your design meetings with our proprietary engine & native AI copilot—testing massing and glazing options live"
  },
  {
    aspect: "Multi-Variable Optimization",
    conventional: "Manual trial-and-error across 2 or 3 envelope combinations due to slow runtimes",
    clearinfra: "Native AI Pareto optimizer sweeps orientation, WWR, glazing SHGC, and HVAC plant options in seconds"
  },
  {
    aspect: "Code & Statutory Compliance",
    conventional: "NBC 2016 and ECBC checks treated as a late-stage manual documentation exercise",
    clearinfra: "Automated clause-level NBC 2016 (Part 3, 4 & 8) and ECBC verification embedded from concept design onward"
  },
  {
    aspect: "Deliverables & Auditability",
    conventional: "Disconnected spreadsheets and opaque simulation assumptions",
    clearinfra: "Full formula-level dependency traceability, Indian CAPEX payback reports, and validated EnergyPlus (.idf) models"
  }
];
---

<section id="workflow" class="py-8 sm:py-20 lg:py-28 bg-[#F7F6F2] border-t border-slate-900/10 relative">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24">
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-3.5 sm:gap-6 lg:gap-12 items-end mb-8 sm:mb-12 lg:mb-14 text-center sm:text-left">
      <div class="lg:col-span-7 space-y-2.5 sm:space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-slate-900/[0.04] border border-slate-900/10 text-slate-700 text-[10px] sm:text-xs font-mono tracking-wider mx-auto sm:mx-0">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>PRACTICE METHODOLOGY</span>
        </div>
        <h2 class="text-[clamp(1.4rem,4.5vw,3rem)] sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight leading-[1.15] text-balance">
          Live engineering charrettes, not weeks-late reports.
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-xl mx-auto sm:mx-0">
          Because we own our underlying physics, AI, and compliance stack, our consulting engagements operate as interactive working sessions rather than slow, disconnected hand-offs.
        </p>
      </div>
    </div>

    <!-- MOBILE COMPARISON EXPERIENCE (< 768px) -->
    <div class="md:hidden space-y-4">
      <!-- Segmented View Mode Switcher -->
      <div class="flex items-center p-1 bg-slate-900/[0.05] border border-slate-900/10 rounded-xl">
        <button
          type="button"
          id="wf-mode-clearinfra"
          class="wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-semibold transition-all duration-200 bg-white text-emerald-950 shadow-xs border border-emerald-600/30 flex items-center justify-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>Clearinfra Practice</span>
        </button>
        <button
          type="button"
          id="wf-mode-conventional"
          class="wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-medium text-slate-500 hover:text-slate-800 transition-all duration-200 flex items-center justify-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0 opacity-60"></span>
          <span>Conventional</span>
        </button>
      </div>

      <!-- Clearinfra Practice View (Default Active) -->
      <div id="wf-panel-clearinfra" class="space-y-3 transition-opacity duration-200">
        {workflows.map((row, idx) => (
          <div class="rounded-xl bg-white border border-emerald-600/30 p-4.5 shadow-xs text-left relative overflow-hidden pl-5">
            <div class="absolute top-0 left-0 bottom-0 w-1.5 bg-emerald-500"></div>
            <div class="flex items-center justify-between gap-2 pb-2.5 mb-2.5 border-b border-slate-900/[0.06]">
              <span class="text-xs font-mono font-semibold text-slate-400">0{idx + 1}</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-800 border border-emerald-600/20 font-semibold">
                Augmented Speed
              </span>
            </div>
            <h3 class="text-sm font-semibold text-slate-900 mb-1.5 leading-snug">
              {row.aspect}
            </h3>
            <p class="text-xs text-slate-800 font-medium leading-relaxed mb-2.5">
              {row.clearinfra}
            </p>
            <div class="pt-2.5 border-t border-slate-900/[0.06] text-[10px] font-mono text-slate-500 flex items-center gap-1.5">
              <span class="text-slate-400 shrink-0">Legacy:</span>
              <span class="text-slate-600 truncate">{row.conventional}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Conventional Consulting View -->
      <div id="wf-panel-conventional" class="hidden space-y-3 transition-opacity duration-200">
        {workflows.map((row, idx) => (
          <div class="rounded-xl bg-slate-50 border border-slate-300/80 p-4.5 shadow-xs text-left relative overflow-hidden pl-5">
            <div class="absolute top-0 left-0 bottom-0 w-1.5 bg-slate-400"></div>
            <div class="flex items-center justify-between gap-2 pb-2.5 mb-2.5 border-b border-slate-900/[0.06]">
              <span class="text-xs font-mono font-semibold text-slate-400">0{idx + 1}</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-slate-200 text-slate-600 font-semibold">
                Legacy Bottleneck
              </span>
            </div>
            <h3 class="text-sm font-semibold text-slate-900 mb-1.5 leading-snug">
              {row.aspect}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-2.5">
              {row.conventional}
            </p>
            <div class="pt-2.5 border-t border-slate-900/[0.06] text-[10px] font-mono text-emerald-700 flex items-center gap-1.5 font-semibold">
              <span class="shrink-0">CI Advantage:</span>
              <span class="truncate">{row.clearinfra}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- DESKTOP / TABLET ARCHITECTURAL MONOGRAPH MATRIX (>= 768px) -->
    <div class="hidden md:block reveal rounded-2xl border border-slate-900/12 bg-white shadow-sm overflow-hidden">
      <!-- Matrix Header on Refined Architectural Tone -->
      <div class="grid grid-cols-1 md:grid-cols-12 bg-[#EFECE6]/70 border-b border-slate-900/10 text-xs font-mono uppercase tracking-wider">
        <div class="md:col-span-3 px-5 sm:px-8 py-4 sm:py-4.5 text-slate-700 font-semibold">
          Engagement Dimension
        </div>
        <div class="hidden md:block md:col-span-4 px-5 sm:px-8 py-4 sm:py-4.5 text-slate-500 font-medium border-l border-slate-900/[0.06]">
          Conventional Consulting
        </div>
        <div class="hidden md:flex md:col-span-5 px-5 sm:px-8 py-4 sm:py-4.5 text-emerald-800 font-semibold items-center gap-2 bg-emerald-500/[0.04] border-l border-emerald-600/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>Clearinfra Practice (Physics + Native AI)</span>
        </div>
      </div>

      <!-- Matrix Rows with Elevated Clearinfra Column -->
      <div class="divide-y divide-slate-900/10">
        {workflows.map((row, idx) => (
          <div class="grid grid-cols-1 md:grid-cols-12 items-stretch hover:bg-slate-50/60 transition-colors">
            <!-- Col 1: Dimension with Monograph Index -->
            <div class="md:col-span-3 px-5 sm:px-8 py-5 sm:py-6 flex items-start gap-3">
              <span class="text-xs font-mono font-medium text-slate-400 mt-0.5 shrink-0">0{idx + 1}</span>
              <span class="text-sm sm:text-base font-semibold text-slate-900 leading-snug">
                {row.aspect}
              </span>
            </div>

            <!-- Col 2: Conventional (Legible Slate-600, Not Faded) -->
            <div class="md:col-span-4 px-5 sm:px-8 py-5 sm:py-6 text-sm text-slate-600 leading-relaxed font-normal md:border-l md:border-slate-900/[0.06]">
              <span class="md:hidden text-[10px] font-mono uppercase text-slate-400 block mb-1.5">Conventional Consulting:</span>
              {row.conventional}
            </div>

            <!-- Col 3: Clearinfra Practice (Elevated Column Tint + Emerald Datum Dot) -->
            <div class="md:col-span-5 px-5 sm:px-8 py-5 sm:py-6 text-sm text-slate-900 font-medium leading-relaxed bg-emerald-500/[0.025] md:border-l md:border-emerald-600/20 flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0 mt-2 hidden sm:inline-block"></span>
              <div>
                <span class="md:hidden text-[10px] font-mono uppercase text-emerald-800 font-semibold block mb-1.5">Clearinfra Practice:</span>
                {row.clearinfra}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const btnClearinfra = document.getElementById('wf-mode-clearinfra');
  const btnConventional = document.getElementById('wf-mode-conventional');
  const panelClearinfra = document.getElementById('wf-panel-clearinfra');
  const panelConventional = document.getElementById('wf-panel-conventional');

  btnClearinfra?.addEventListener('click', () => {
    btnClearinfra.className = 'wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-semibold transition-all duration-200 bg-white text-emerald-950 shadow-xs border border-emerald-600/30 flex items-center justify-center gap-1.5';
    btnConventional!.className = 'wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-medium text-slate-500 hover:text-slate-800 transition-all duration-200 flex items-center justify-center gap-1.5';
    panelClearinfra?.classList.remove('hidden');
    panelConventional?.classList.add('hidden');
  });

  btnConventional?.addEventListener('click', () => {
    btnConventional.className = 'wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-semibold transition-all duration-200 bg-white text-slate-900 shadow-xs border border-slate-300 flex items-center justify-center gap-1.5';
    btnClearinfra!.className = 'wf-mode-btn flex-1 py-2 px-2 rounded-lg text-[11px] font-mono font-medium text-slate-500 hover:text-slate-800 transition-all duration-200 flex items-center justify-center gap-1.5';
    panelConventional?.classList.remove('hidden');
    panelClearinfra?.classList.add('hidden');
  });
</script>
