---
const workflows = [
  {
    aspect: "Design Review Cadence",
    conventional: "Consultants take 2–3 weeks offline to build thermal models and return static PDF reports",
    clearinfra: "Our engineers join your design meetings with our proprietary engine & native AI copilot—testing massing and glazing options live"
  },
  {
    aspect: "Multi-Variable Optimization",
    conventional: "Manual trial-and-error across 2 or 3 envelope combinations due to slow runtimes",
    clearinfra: "Native AI Pareto optimizer sweeps orientation, WWR, glazing SHGC, and HVAC plant options in seconds"
  },
  {
    aspect: "Code & Statutory Compliance",
    conventional: "NBC 2016 and ECBC checks treated as a late-stage manual documentation exercise",
    clearinfra: "Automated clause-level NBC 2016 (Part 3, 4 & 8) and ECBC verification embedded from concept design onward"
  },
  {
    aspect: "Deliverables & Auditability",
    conventional: "Disconnected spreadsheets and opaque simulation assumptions",
    clearinfra: "Full formula-level dependency traceability, Indian CAPEX payback reports, and validated EnergyPlus (.idf) models"
  }
];
---

<section id="workflow" class="py-24 lg:py-28 bg-[#F7F6F2] border-t border-slate-900/10 relative">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24">
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-14">
      <div class="lg:col-span-7 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/[0.04] border border-slate-900/10 text-slate-700 text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>PRACTICE METHODOLOGY</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight text-balance">
          Live engineering charrettes, not weeks-late reports.
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Because we own our underlying physics, AI, and compliance stack, our consulting engagements operate as interactive working sessions rather than slow, disconnected hand-offs.
        </p>
      </div>
    </div>

    <!-- Option A: Refined Architectural Monograph Matrix -->
    <div class="reveal rounded-2xl border border-slate-900/12 bg-white shadow-sm overflow-hidden">
      <!-- Matrix Header on Refined Architectural Tone -->
      <div class="grid grid-cols-1 md:grid-cols-12 bg-[#EFECE6]/70 border-b border-slate-900/10 text-xs font-mono uppercase tracking-wider">
        <div class="md:col-span-3 px-5 sm:px-8 py-4 sm:py-4.5 text-slate-700 font-semibold">
          Engagement Dimension
        </div>
        <div class="hidden md:block md:col-span-4 px-5 sm:px-8 py-4 sm:py-4.5 text-slate-500 font-medium border-l border-slate-900/[0.06]">
          Conventional Consulting
        </div>
        <div class="hidden md:flex md:col-span-5 px-5 sm:px-8 py-4 sm:py-4.5 text-emerald-800 font-semibold items-center gap-2 bg-emerald-500/[0.04] border-l border-emerald-600/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>Clearinfra Practice (Physics + Native AI)</span>
        </div>
      </div>

      <!-- Matrix Rows with Elevated Clearinfra Column -->
      <div class="divide-y divide-slate-900/10">
        {workflows.map((row, idx) => (
          <div class="grid grid-cols-1 md:grid-cols-12 items-stretch hover:bg-slate-50/60 transition-colors">
            <!-- Col 1: Dimension with Monograph Index -->
            <div class="md:col-span-3 px-5 sm:px-8 py-5 sm:py-6 flex items-start gap-3">
              <span class="text-xs font-mono font-medium text-slate-400 mt-0.5 shrink-0">0{idx + 1}</span>
              <span class="text-sm sm:text-base font-semibold text-slate-900 leading-snug">
                {row.aspect}
              </span>
            </div>

            <!-- Col 2: Conventional (Legible Slate-600, Not Faded) -->
            <div class="md:col-span-4 px-5 sm:px-8 py-5 sm:py-6 text-sm text-slate-600 leading-relaxed font-normal md:border-l md:border-slate-900/[0.06]">
              <span class="md:hidden text-[10px] font-mono uppercase text-slate-400 block mb-1.5">Conventional Consulting:</span>
              {row.conventional}
            </div>

            <!-- Col 3: Clearinfra Practice (Elevated Column Tint + Emerald Datum Dot) -->
            <div class="md:col-span-5 px-5 sm:px-8 py-5 sm:py-6 text-sm text-slate-900 font-medium leading-relaxed bg-emerald-500/[0.025] md:border-l md:border-emerald-600/20 flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0 mt-2 hidden sm:inline-block"></span>
              <div>
                <span class="md:hidden text-[10px] font-mono uppercase text-emerald-800 font-semibold block mb-1.5">Clearinfra Practice:</span>
                {row.clearinfra}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
