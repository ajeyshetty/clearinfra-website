---
const pillars = [
  {
    code: "01",
    title: "Multi-Node Thermal RC Network",
    detail: "Models heat flux through multi-layered wall, roof, and glazing assemblies with dynamic capacitance and solar radiation absorption."
  },
  {
    code: "02",
    title: "Psychrometric HVAC Coil Modeling",
    detail: "Rigorous sensible and latent heat balance calculations with real-time chiller COP curves, fan affinity laws, and economizer cycles."
  },
  {
    code: "03",
    title: "Continuous 8,760 Hourly Weather Integration",
    detail: "High-resolution solar positioning, dry-bulb, wet-bulb, and direct normal irradiance (DNI) mapping across Indian and global climate zones."
  },
  {
    code: "04",
    title: "Spatial Daylight Autonomy (sDA / ASE)",
    detail: "Calculates natural daylight penetration and glare thresholds to balance visual comfort against cooling penalty in real time."
  }
];
---

<section id="physics" class="py-24 bg-slate-950 border-t border-slate-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Narrative -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-700 text-xs font-mono text-emerald-400">
          <span>THE SCIENTIFIC ENGINE</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          First-Principles Physics. Zero Empirical Guesswork.
        </h2>
        <p class="text-slate-300 text-base leading-relaxed">
          Clearinfra is engineered from ground-up physical laws—not coarse statistical averages or brittle spreadsheets. Every formula aligns with ASHRAE Handbook of Fundamentals, ECBC 2017, and ISO 13790.
        </p>
        <p class="text-slate-400 text-sm leading-relaxed">
          Results are rigorously cross-validated against EnergyPlus benchmarks across all major climate classifications—from hot-dry to warm-humid—guaranteeing bank-grade accuracy for investor decarbonization reporting.
        </p>
        <div class="pt-2 flex items-center gap-4">
          <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center flex-1">
            <span class="block text-2xl font-bold font-mono text-white">5</span>
            <span class="text-xs text-slate-400">Indian Climate Zones</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center flex-1">
            <span class="block text-2xl font-bold font-mono text-emerald-400">8,760</span>
            <span class="text-xs text-slate-400">Hourly Time-Steps</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center flex-1">
            <span class="block text-2xl font-bold font-mono text-cyan-400">100%</span>
            <span class="text-xs text-slate-400">Audit Traceable</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Technical Cards -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {pillars.map((pillar) => (
          <div class="p-6 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-colors space-y-3">
            <span class="text-xs font-mono text-emerald-400 font-bold bg-emerald-950/70 px-2.5 py-1 rounded border border-emerald-500/20">
              {pillar.code}
            </span>
            <h3 class="text-base font-bold text-white">
              {pillar.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
              {pillar.detail}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
