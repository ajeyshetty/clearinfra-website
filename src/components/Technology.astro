---
const complianceModules = [
  {
    tag: "ENVELOPE & HVAC",
    title: "Prescriptive & Whole-Building Code Guidance",
    clauses: "ECBC Clauses 4.2, 4.3, 5.2 & Appendix D (EPI Ratio)",
    detail: "Code checks with expert engineering review covering Window-to-Wall Ratio (WWR), roof and wall U-factor limits, and SHGC across climate zones, alongside whole-building EPI estimates against ECBC 2017 thresholds."
  },
  {
    tag: "BUILDING SERVICES",
    title: "Daylighting & HVAC Systems Alignment",
    clauses: "NBC 2026 Part D: Sec. 1 (Lighting) & Sec. 3 (HVAC)",
    detail: "Evaluates spatial daylight estimates, fresh air ventilation requirements per occupancy category, and HVAC plant configurations against NBC 2026 engineering standards."
  },
  {
    tag: "STATUTORY CLAUSES",
    title: "Graph-RAG Statutory Clause Retrieval",
    clauses: "NBC 2026 Parts B–F & Local Byelaws",
    detail: "Backed by our structured Graph-RAG knowledge base of the National Building Code 2026 (SP 7:2026), enabling engineers to verify life safety and building services clauses with exact citations, while coordinating with local development control byelaws for FAR and setbacks."
  }
];
---

<section id="engine" class="scroll-mt-20 sm:scroll-mt-24 py-8 sm:py-20 lg:py-28 bg-[#F7F6F2] border-t border-slate-900/10 relative overflow-hidden">
  <!-- Option 2: Architectural Drafting Grid with Radial Vignette Fade -->
  <div class="absolute inset-0 bg-architectural-grid-vignette pointer-events-none z-0" aria-hidden="true"></div>

  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24 space-y-8 sm:space-y-12 lg:space-y-16 relative z-10">
    
    <!-- Part 1 Header: Unified Split Datum (Matching Services & Compliance) -->
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-10 items-end text-center sm:text-left">
      <div class="lg:col-span-6 space-y-2.5 sm:space-y-3 mx-auto sm:mx-0">
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-slate-900/[0.04] border border-slate-900/10 text-slate-700 text-[10px] sm:text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>PROPRIETARY TECHNOLOGY</span>
        </div>
        <h2 class="ci-section-title text-slate-900">
          <span class="block">First-principles physics{' '}</span>
          <span class="block">meets built-in agentic AI.</span>
        </h2>
      </div>
      <div class="lg:col-span-6 relative sm:pl-6 lg:pl-8 py-1 mx-auto sm:mx-0">
        <div class="hidden sm:block datum-line-v absolute left-0 top-1 bottom-1 w-[2px] rounded-full bg-gradient-to-b from-emerald-500 via-emerald-500/40 to-transparent" aria-hidden="true"></div>
        <p class="ci-section-lead text-slate-600">
          In conventional consulting, energy models take weeks to assemble across disconnected third-party tools. To eliminate this bottleneck, we built <strong class="text-slate-900 font-semibold">Clearinfra Studio</strong> in-house—coupling an hourly ISO 52016-1 thermal physics engine with a built-in 27-tool engineering AI copilot and proactive Pareto optimizer.
        </p>
      </div>
    </div>

    <!-- Part 1 Content: 2 Capability Cards (Left 5 Cols) + System Topology CAD Card (Right 7 Cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-8 xl:gap-10 items-stretch">
      <!-- Left: 2 Architectural Feature Cards -->
      <div class="reveal lg:col-span-5 flex flex-col justify-between gap-4 text-left">
        <div class="arch-card p-5 sm:p-6 rounded-xl bg-white border border-slate-900/10 hover:border-emerald-600/40 shadow-xs hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-900/[0.06]">
              <span class="text-xs font-mono font-semibold text-slate-500">01</span>
              <span class="text-[10px] font-mono text-emerald-700 font-semibold tracking-wider uppercase">BUILT-IN AI COPILOT &amp; PARETO OPTIMIZER</span>
            </div>
            <h3 class="text-base sm:text-lg font-semibold text-slate-900 mb-2">Automated Multi-Objective Optimization</h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed">
              Wired directly into 3D geometry and the ISO 52016-1 physics kernel via 27 engineering tools—allowing consultants to sweep glazing, shading, orientation, and HVAC combinations live to isolate lowest-CAPEX and lowest-EPI designs.
            </p>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-100 flex items-center gap-2 text-[10px] font-mono text-slate-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>27 Autonomous Tools · Instant Trade-off Sweeps</span>
          </div>
        </div>

        <div class="arch-card p-5 sm:p-6 rounded-xl bg-white border border-slate-900/10 hover:border-emerald-600/40 shadow-xs hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-900/[0.06]">
              <span class="text-xs font-mono font-semibold text-slate-500">02</span>
              <span class="text-[10px] font-mono text-emerald-700 font-semibold tracking-wider uppercase">TRACEABLE DEPENDENCY GRAPH</span>
            </div>
            <h3 class="text-base sm:text-lg font-semibold text-slate-900 mb-2">First-Principles Impact Propagation</h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed">
              Every parameter change is tracked through a live dependency graph—showing exactly how a change in facade SHGC propagates to sensible coil load, chiller plant tonnage, and project payback estimates with zero black-box disconnect.
            </p>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-100 flex items-center gap-2 text-[10px] font-mono text-slate-500">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
            <span>Complete Audit Trail · Real-time Physics Ledger</span>
          </div>
        </div>
      </div>

      <!-- Right: Matte CAD Window with Animated Architecture Schematic -->
      <div class="reveal reveal-delay-1 lg:col-span-7 flex flex-col">
        <div class="rounded-2xl border border-slate-700/60 ring-1 ring-white/10 bg-[#131924] p-4 sm:p-5 lg:p-6 shadow-2xl shadow-slate-950/30 bg-blueprint-sub relative overflow-hidden flex-1 flex flex-col justify-between">
          <!-- CAD Window Header Bar: Strictly Fixed Height & Zero Layout Shift -->
          <div class="flex items-center justify-between gap-2 text-[11px] sm:text-xs font-mono text-slate-400 mb-5 sm:mb-6 pb-3.5 sm:pb-4 border-b border-white/[0.08] min-h-[2.5rem] max-h-[2.5rem] overflow-hidden select-none">
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-slate-200 font-medium whitespace-nowrap">
                <span class="sm:hidden">CLEARINFRA // TOPOLOGY</span>
                <span class="hidden sm:inline">CLEARINFRA STUDIO // SYSTEM TOPOLOGY</span>
              </span>
            </div>
            <div id="topology-status" class="text-emerald-400 text-[10px] sm:text-xs flex items-center gap-1.5 min-w-0 justify-end shrink">
              <span id="topology-status-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0 transition-colors duration-200"></span>
              <span id="topology-status-text" class="truncate whitespace-nowrap text-right font-medium transition-colors duration-200">Physics + 27-Tool Copilot + Graph-RAG</span>
            </div>
          </div>

          <!-- MOBILE UNIFIED VERTICAL TOPOLOGY PIPELINE (< 640px) -->
          <div class="sm:hidden space-y-2 select-none" id="mobile-topology-pipeline">
            
            <!-- Tier 1: Practice & BIM Inputs -->
            <div>
              <div class="flex items-center justify-between px-1 mb-1.5">
                <span class="text-[9px] font-mono uppercase tracking-widest text-sky-400 font-semibold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                  01 // Practice &amp; BIM Inputs
                </span>
                <span class="text-[8.5px] font-mono text-slate-500">Tap node to trace</span>
              </div>
              <div class="grid grid-cols-3 gap-1.5">
                <button
                  type="button"
                  data-mobile-node="node-massing"
                  class="mobile-topo-node p-2 rounded-lg bg-[#111827] border border-white/10 text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400 mb-1 block"></span>
                  <span class="text-[10px] font-semibold text-slate-100 block leading-tight">Building Model</span>
                  <span class="text-[8px] font-mono text-slate-400 block mt-0.5 truncate">Massing · Envelope</span>
                </button>

                <button
                  type="button"
                  data-mobile-node="node-weather"
                  class="mobile-topo-node p-2 rounded-lg bg-[#111827] border border-white/10 text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400 mb-1 block"></span>
                  <span class="text-[10px] font-semibold text-slate-100 block leading-tight">8,760 Climate</span>
                  <span class="text-[8px] font-mono text-slate-400 block mt-0.5 truncate">DBT · WBT · DNI</span>
                </button>

                <button
                  type="button"
                  data-mobile-node="node-cost"
                  class="mobile-topo-node p-2 rounded-lg bg-[#111827] border border-white/10 text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400 mb-1 block"></span>
                  <span class="text-[10px] font-semibold text-slate-100 block leading-tight">Cost DB</span>
                  <span class="text-[8px] font-mono text-slate-400 block mt-0.5 truncate">India Specs</span>
                </button>
              </div>
            </div>

            <!-- Connector 1: Animated Dataflow Pulse Lines -->
            <div class="flex items-center justify-around px-8 py-0.5">
              <div class="mobile-flow-line h-3.5 w-0.5 rounded-full bg-sky-400/30 relative overflow-hidden">
                <div class="absolute inset-x-0 top-0 h-1.5 bg-sky-400 animate-pulse"></div>
              </div>
              <div class="mobile-flow-line h-3.5 w-0.5 rounded-full bg-sky-400/30 relative overflow-hidden">
                <div class="absolute inset-x-0 top-0 h-1.5 bg-sky-400 animate-pulse"></div>
              </div>
              <div class="mobile-flow-line h-3.5 w-0.5 rounded-full bg-amber-400/30 relative overflow-hidden">
                <div class="absolute inset-x-0 top-0 h-1.5 bg-amber-400 animate-pulse"></div>
              </div>
            </div>

            <!-- Tier 2: Clearinfra Core Engine Container -->
            <div class="rounded-xl bg-[#0c1420] border border-emerald-500/40 p-2.5 space-y-1.5 shadow-lg shadow-emerald-950/20 relative">
              <div class="flex items-center justify-between px-1">
                <span class="text-[9px] font-mono uppercase tracking-widest text-emerald-400 font-bold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  02 // Clearinfra Core Engine
                </span>
                <span class="flex items-center gap-1 text-[8.5px] font-mono text-emerald-400/90">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Active Kernel
                </span>
              </div>

              <div class="space-y-1.5">
                <button
                  type="button"
                  data-mobile-node="node-agent"
                  class="mobile-topo-node w-full rounded-lg bg-[#111c2d] border border-sky-500/40 px-3 py-2 flex items-center justify-between text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <div class="min-w-0 pr-2">
                    <span class="text-[8.5px] font-mono text-sky-400 uppercase tracking-wider block">Built-in AI Agent</span>
                    <span class="text-xs font-semibold text-white block mt-0.5 truncate">27-Tool Copilot &amp; Pareto Optimizer</span>
                  </div>
                  <span class="text-[8.5px] font-mono px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 shrink-0 font-medium">AI</span>
                </button>

                <button
                  type="button"
                  data-mobile-node="node-physics"
                  class="mobile-topo-node w-full rounded-lg bg-[#0d1f1d] border border-emerald-500/45 px-3 py-2 flex items-center justify-between text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <div class="min-w-0 pr-2">
                    <span class="text-[8.5px] font-mono text-emerald-400 uppercase tracking-wider block">Physics Solver</span>
                    <span class="text-xs font-semibold text-white block mt-0.5 truncate">Multi-Node ISO 52016-1 + Psychrometric HVAC</span>
                  </div>
                  <span class="text-[8.5px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 shrink-0 font-medium">ISO 52016</span>
                </button>

                <button
                  type="button"
                  data-mobile-node="node-compliance"
                  class="mobile-topo-node w-full rounded-lg bg-[#1a1814] border border-amber-500/40 px-3 py-2 flex items-center justify-between text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <div class="min-w-0 pr-2">
                    <span class="text-[8.5px] font-mono text-amber-400 uppercase tracking-wider block">Compliance Engine</span>
                    <span class="text-xs font-semibold text-white block mt-0.5 truncate">NBC 2026 Graph-RAG &amp; ECBC Guidance</span>
                  </div>
                  <span class="text-[8.5px] font-mono px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 shrink-0 font-medium">RAG</span>
                </button>
              </div>
            </div>

            <!-- Connector 2: Animated Dataflow Pulse Lines -->
            <div class="flex items-center justify-around px-8 py-0.5">
              <div class="mobile-flow-line h-3.5 w-0.5 rounded-full bg-emerald-400/30 relative overflow-hidden">
                <div class="absolute inset-x-0 top-0 h-1.5 bg-emerald-400 animate-pulse"></div>
              </div>
              <div class="mobile-flow-line h-3.5 w-0.5 rounded-full bg-amber-400/30 relative overflow-hidden">
                <div class="absolute inset-x-0 top-0 h-1.5 bg-amber-400 animate-pulse"></div>
              </div>
              <div class="mobile-flow-line h-3.5 w-0.5 rounded-full bg-sky-400/30 relative overflow-hidden">
                <div class="absolute inset-x-0 top-0 h-1.5 bg-sky-400 animate-pulse"></div>
              </div>
            </div>

            <!-- Tier 3: Engineering Deliverables -->
            <div>
              <div class="flex items-center justify-between px-1 mb-1.5">
                <span class="text-[9px] font-mono uppercase tracking-widest text-emerald-400 font-semibold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  03 // Engineering Deliverables
                </span>
                <span class="text-[8.5px] font-mono text-slate-500">Statutory &amp; Financial</span>
              </div>
              <div class="grid grid-cols-3 gap-1.5">
                <button
                  type="button"
                  data-mobile-node="node-capex"
                  class="mobile-topo-node p-2 rounded-lg bg-[#111827] border border-white/10 text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mb-1 block"></span>
                  <span class="text-[10px] font-semibold text-slate-100 block leading-tight">CAPEX &amp; Load</span>
                  <span class="text-[8px] font-mono text-emerald-400 block mt-0.5 truncate">Peak TR · Payback</span>
                </button>

                <button
                  type="button"
                  data-mobile-node="node-statutory"
                  class="mobile-topo-node p-2 rounded-lg bg-[#111827] border border-white/10 text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400 mb-1 block"></span>
                  <span class="text-[10px] font-semibold text-slate-100 block leading-tight">Submittals</span>
                  <span class="text-[8px] font-mono text-amber-400 block mt-0.5 truncate">NBC 2026 Dossier</span>
                </button>

                <button
                  type="button"
                  data-mobile-node="node-eplus"
                  class="mobile-topo-node p-2 rounded-lg bg-[#111827] border border-white/10 text-left transition-all duration-200 cursor-pointer active:scale-[0.98]"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400 mb-1 block"></span>
                  <span class="text-[10px] font-semibold text-slate-100 block leading-tight">EnergyPlus</span>
                  <span class="text-[8px] font-mono text-sky-400 block mt-0.5 truncate">Run-Checked .idf</span>
                </button>
              </div>
            </div>

          </div>

          <!-- DESKTOP / TABLET HORIZONTAL SVG TOPOLOGY SCHEMATIC (>= 640px) -->
          <div class="hidden sm:flex flex-1 items-center justify-center my-auto">
            <svg id="system-topology-svg" viewBox="0 0 620 340" class="w-full h-auto select-none">
              <!-- Background Connecting Paths (Static Dim Track) -->
              <g class="path-track" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" fill="none">
                <path d="M 165 66 C 200 66, 200 100, 235 100" />
                <path d="M 165 66 C 200 66, 200 180, 235 180" />
                <path d="M 165 170 C 200 170, 200 180, 235 180" />
                <path d="M 165 274 C 200 274, 200 100, 235 100" />
                <path d="M 165 274 C 200 274, 200 180, 235 180" />
                <path d="M 405 100 C 430 100, 430 66, 455 66" />
                <path d="M 405 180 C 430 180, 430 66, 455 66" />
                <path d="M 405 180 C 430 180, 430 274, 455 274" />
                <path d="M 405 260 C 430 260, 430 170, 455 170" />
              </g>

              <!-- Animated Active Connecting Paths (Grouped by Data Flow) -->
              <!-- Massing Paths -->
              <path id="path-massing-agent" d="M 165 66 C 200 66, 200 100, 235 100" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-massing-physics" d="M 165 66 C 200 66, 200 180, 235 180" fill="none" stroke="#00c4df" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />

              <!-- Weather Path -->
              <path id="path-weather-physics" d="M 165 170 C 200 170, 200 180, 235 180" fill="none" stroke="#38bdf8" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />

              <!-- Cost DB Paths -->
              <path id="path-cost-agent" d="M 165 274 C 200 274, 200 100, 235 100" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-cost-physics" d="M 165 274 C 200 274, 200 180, 235 180" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />

              <!-- Core to Output Paths -->
              <path id="path-agent-capex" d="M 405 100 C 430 100, 430 66, 455 66" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-physics-capex" d="M 405 180 C 430 180, 430 66, 455 66" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-physics-eplus" d="M 405 180 C 430 180, 430 274, 455 274" fill="none" stroke="#38bdf8" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-compliance-statutory" d="M 405 260 C 430 260, 430 170, 455 170" fill="none" stroke="#f59e0b" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />

              <!-- Left Input Nodes (Hover Interactive) -->
              <g id="node-massing" class="topo-node cursor-pointer transition-all duration-200" transform="translate(10, 40)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">Building Model</text>
                <text x="14" y="39" fill="#94a3b8" font-size="9.5" font-family="JetBrains Mono">Massing · Envelope · MEP</text>
              </g>

              <g id="node-weather" class="topo-node cursor-pointer transition-all duration-200" transform="translate(10, 144)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">8,760 Weather File</text>
                <text x="14" y="39" fill="#94a3b8" font-size="9.5" font-family="JetBrains Mono">DBT · WBT · Solar DNI</text>
              </g>

              <g id="node-cost" class="topo-node cursor-pointer transition-all duration-200" transform="translate(10, 248)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">India Cost &amp; Spec DB</text>
                <text x="14" y="39" fill="#94a3b8" font-size="9.5" font-family="JetBrains Mono">U-Value · SHGC · INR</text>
              </g>

              <!-- Central Proprietary Core Container -->
              <g id="node-core-container" transform="translate(235, 28)">
                <rect width="170" height="284" rx="12" fill="#0d1520" stroke="rgba(16, 185, 129, 0.45)" stroke-width="1.5" />
                <text x="85" y="24" text-anchor="middle" fill="#10b981" font-size="9" font-family="JetBrains Mono">CLEARINFRA CORE</text>

                <!-- Sub-box 1: Built-in AI Copilot -->
                <g id="node-agent" class="topo-node cursor-pointer transition-all duration-200" transform="translate(14, 38)">
                  <rect width="142" height="68" rx="8" fill="#111c2d" stroke="rgba(56, 189, 248, 0.45)" class="node-box transition-all duration-200" />
                  <text x="71" y="22" text-anchor="middle" fill="#38bdf8" font-size="9" font-family="JetBrains Mono">BUILT-IN AI AGENT</text>
                  <text x="71" y="40" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="600">27-Tool Copilot &amp;</text>
                  <text x="71" y="55" text-anchor="middle" fill="#cbd5e1" font-size="10">Pareto Optimizer</text>
                </g>

                <!-- Sub-box 2: Physics Kernel -->
                <g id="node-physics" class="topo-node cursor-pointer transition-all duration-200" transform="translate(14, 118)">
                  <rect width="142" height="68" rx="8" fill="#0d1f1d" stroke="rgba(16, 185, 129, 0.5)" class="node-box transition-all duration-200" />
                  <text x="71" y="22" text-anchor="middle" fill="#10b981" font-size="9" font-family="JetBrains Mono">PHYSICS SOLVER</text>
                  <text x="71" y="40" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="600">Multi-Node ISO 52016 +</text>
                  <text x="71" y="55" text-anchor="middle" fill="#cbd5e1" font-size="10">Psychrometric HVAC</text>
                </g>

                <!-- Sub-box 3: NBC 2026 & ECBC Compliance Engine -->
                <g id="node-compliance" class="topo-node cursor-pointer transition-all duration-200" transform="translate(14, 198)">
                  <rect width="142" height="68" rx="8" fill="#1a1814" stroke="rgba(245, 158, 11, 0.45)" class="node-box transition-all duration-200" />
                  <text x="71" y="22" text-anchor="middle" fill="#fbbf24" font-size="9" font-family="JetBrains Mono">COMPLIANCE ENGINE</text>
                  <text x="71" y="40" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="600">NBC 2026 Graph-RAG</text>
                  <text x="71" y="55" text-anchor="middle" fill="#cbd5e1" font-size="10">&amp; ECBC Rule Checker</text>
                </g>
              </g>

              <!-- Physics → Compliance: the computed EPI is graded against the code thresholds.
                   Drawn after the core container so its fill does not paint over the link. -->
              <path id="path-physics-compliance" d="M 320 213 L 320 227" fill="none" stroke="#f59e0b" stroke-width="2" class="animate-dash topo-flow-path" stroke-opacity="0.9" />

              <!-- Right Output Nodes (Hover Interactive) -->
              <g id="node-capex" class="topo-node cursor-pointer transition-all duration-200" transform="translate(455, 40)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">CAPEX &amp; Load Study</text>
                <text x="14" y="39" fill="#10b981" font-size="9.5" font-family="JetBrains Mono">Peak TR · Payback Est.</text>
              </g>

              <g id="node-statutory" class="topo-node cursor-pointer transition-all duration-200" transform="translate(455, 144)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">Statutory Submittals</text>
                <text x="14" y="39" fill="#fbbf24" font-size="9.5" font-family="JetBrains Mono">Clause-Cited NBC 2026</text>
              </g>

              <g id="node-eplus" class="topo-node cursor-pointer transition-all duration-200" transform="translate(455, 248)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">EnergyPlus Model</text>
                <text x="14" y="39" fill="#38bdf8" font-size="9.5" font-family="JetBrains Mono">Run-Checked .idf</text>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Part 2: Dedicated NBC 2026 & ECBC Compliance Module Breakdown -->
    <div id="compliance" class="scroll-mt-20 sm:scroll-mt-24 pt-8 sm:pt-16 border-t border-slate-900/10">
      <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-10 items-end text-center sm:text-left mb-8 sm:mb-12 lg:mb-14">
        <div class="lg:col-span-6 space-y-2.5 sm:space-y-3 mx-auto sm:mx-0">
          <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-slate-900/[0.04] border border-slate-900/10 text-slate-700 text-[10px] sm:text-xs font-mono tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
            <span>STATUTORY &amp; CODE INTELLIGENCE</span>
          </div>
          <h3 class="ci-section-title text-slate-900">
            <span class="block">Built-in NBC 2026 &amp; ECBC{' '}</span>
            <span class="block">compliance module.</span>
          </h3>
        </div>
        <div class="lg:col-span-6 relative sm:pl-6 lg:pl-8 py-1 mx-auto sm:mx-0">
          <div class="hidden sm:block datum-line-v absolute left-0 top-1 bottom-1 w-[2px] rounded-full bg-gradient-to-b from-emerald-500 via-emerald-500/40 to-transparent" aria-hidden="true"></div>
          <p class="ci-section-lead text-slate-600">
            Our proprietary engine embeds a deterministic rule evaluator alongside a Graph-RAG knowledge base of Indian building codes (NBC 2026 &amp; ECBC 2017)—supporting our engineers during design reviews.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
        {complianceModules.map((mod, idx) => (
          <div class={`arch-card reveal reveal-delay-${idx + 1} group rounded-xl bg-white border border-slate-900/10 hover:border-emerald-600/50 p-5 sm:p-7 shadow-xs hover:shadow-xl hover:shadow-emerald-950/5 hover:-translate-y-0.5 flex flex-col justify-between text-left`}>
            <div>
              <!-- Top index row: numeral and category tag matching Features.astro -->
              <div class="flex items-center justify-between gap-2 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 border-b border-slate-900/[0.06]">
                <span class="text-xs font-mono font-semibold text-slate-500 shrink-0">
                  0{idx + 1}
                </span>
                <span class="text-[10px] font-mono text-emerald-700 font-semibold tracking-wider uppercase text-right">
                  {mod.tag}
                </span>
              </div>

              <!-- Title -->
              <h4 class="text-base sm:text-xl font-semibold text-slate-900 mb-2 sm:mb-2.5 group-hover:text-emerald-950 transition-colors">
                {mod.title}
              </h4>

              <!-- Narrative -->
              <p class="text-sm text-slate-600 leading-relaxed font-normal">
                {mod.detail}
              </p>
            </div>

            <!-- Bottom Statutory Scope Strip: matching Features.astro deliverable anatomy -->
            <div class="mt-4 sm:mt-6 pt-3.5 sm:pt-4 border-t border-slate-900/[0.07] flex flex-col gap-1.5 text-[11px] font-mono">
              <div class="flex items-center gap-1.5 text-emerald-700 font-semibold uppercase tracking-wider text-[10px]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                <span>Statutory Scope</span>
              </div>
              <div class="text-slate-900 font-medium text-xs leading-snug">
                {mod.clauses}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  // Interactive Topology Dependency Graph
  const topoNodes = document.querySelectorAll('.topo-node');
  const allPaths = document.querySelectorAll('.topo-flow-path');
  const statusText = document.getElementById('topology-status-text');
  const statusDot = document.getElementById('topology-status-dot');

  // Cache initial stroke & stroke-width values for pristine restoration
  topoNodes.forEach((node) => {
    const box = node.querySelector('.node-box');
    if (box) {
      box.setAttribute('data-default-stroke', box.getAttribute('stroke') || 'rgba(255,255,255,0.18)');
      box.setAttribute('data-default-width', box.getAttribute('stroke-width') || '1');
    }
  });

  const traceMap: Record<string, { label: string; dotColor: string; nodes: string[]; paths: string[] }> = {
    'node-massing': {
      label: 'TRACING: Building Model → Physics → Loads · .idf · Code · Submittals',
      dotColor: '#00e5ff',
      nodes: ['node-massing', 'node-agent', 'node-physics', 'node-capex', 'node-eplus', 'node-compliance', 'node-statutory'],
      paths: ['path-massing-agent', 'path-massing-physics', 'path-agent-capex', 'path-physics-capex', 'path-physics-eplus', 'path-physics-compliance', 'path-compliance-statutory']
    },
    'node-weather': {
      label: 'TRACING: 8,760 Climate → ISO 52016 → Loads · .idf · Code · Submittals',
      dotColor: '#38bdf8',
      nodes: ['node-weather', 'node-physics', 'node-capex', 'node-eplus', 'node-compliance', 'node-statutory'],
      paths: ['path-weather-physics', 'path-physics-capex', 'path-physics-eplus', 'path-physics-compliance', 'path-compliance-statutory']
    },
    'node-cost': {
      label: 'TRACING: India Cost DB → AI Pareto + Finance Module → CAPEX Payback',
      dotColor: '#fbbf24',
      nodes: ['node-cost', 'node-agent', 'node-physics', 'node-capex'],
      paths: ['path-cost-agent', 'path-cost-physics', 'path-agent-capex', 'path-physics-capex']
    },
    'node-agent': {
      label: 'TRACING: Built-in AI → 27-Tool Sweeps → Cost Pareto',
      dotColor: '#38bdf8',
      nodes: ['node-massing', 'node-cost', 'node-agent', 'node-capex'],
      paths: ['path-massing-agent', 'path-cost-agent', 'path-agent-capex']
    },
    'node-physics': {
      label: 'TRACING: ISO 52016 Engine → Chiller TR · Code Check · .idf',
      dotColor: '#10b981',
      nodes: ['node-massing', 'node-weather', 'node-cost', 'node-physics', 'node-capex', 'node-eplus', 'node-compliance'],
      paths: ['path-massing-physics', 'path-weather-physics', 'path-cost-physics', 'path-physics-capex', 'path-physics-eplus', 'path-physics-compliance']
    },
    'node-compliance': {
      label: 'TRACING: ISO 52016 EPI → NBC 2026 / ECBC → Submittals',
      dotColor: '#fbbf24',
      nodes: ['node-physics', 'node-compliance', 'node-statutory'],
      paths: ['path-physics-compliance', 'path-compliance-statutory']
    },
    'node-capex': {
      label: 'TRACE: CAPEX & Load ← Thermal Solver & AI Optimizer',
      dotColor: '#10b981',
      nodes: ['node-capex', 'node-agent', 'node-physics', 'node-massing', 'node-weather', 'node-cost'],
      paths: ['path-agent-capex', 'path-physics-capex', 'path-massing-agent', 'path-massing-physics', 'path-weather-physics', 'path-cost-physics']
    },
    'node-statutory': {
      label: 'TRACE: Statutory Submittals ← NBC 2026 Graph-RAG',
      dotColor: '#fbbf24',
      nodes: ['node-statutory', 'node-compliance', 'node-physics'],
      paths: ['path-compliance-statutory', 'path-physics-compliance']
    },
    'node-eplus': {
      label: 'TRACE: EnergyPlus .idf ← ISO 52016-1 Thermal Core',
      dotColor: '#38bdf8',
      nodes: ['node-eplus', 'node-physics', 'node-massing', 'node-weather'],
      paths: ['path-physics-eplus', 'path-massing-physics', 'path-weather-physics']
    }
  };

  const defaultStatus = 'Physics + 27-Tool Copilot + Graph-RAG';

  topoNodes.forEach((node) => {
    node.addEventListener('mouseenter', () => {
      const id = node.id;
      const config = traceMap[id];
      if (!config) return;

      if (statusText) statusText.textContent = config.label;
      if (statusDot) statusDot.style.backgroundColor = config.dotColor;

      // Dim non-matching nodes with smooth opacity and highlight active nodes
      topoNodes.forEach((n) => {
        const el = n as HTMLElement;
        const box = n.querySelector('.node-box');
        if (config.nodes.includes(n.id)) {
          el.style.opacity = '1';
          if (box) {
            box.setAttribute('stroke', config.dotColor);
            box.setAttribute('stroke-width', '2');
          }
        } else {
          el.style.opacity = '0.22';
          if (box) {
            const defStroke = box.getAttribute('data-default-stroke') || 'rgba(255,255,255,0.18)';
            box.setAttribute('stroke', defStroke);
            box.setAttribute('stroke-width', '1');
          }
        }
      });

      // Highlight matching paths smoothly without GPU-heavy filter lag
      allPaths.forEach((p) => {
        const pathEl = p as SVGPathElement;
        if (config.paths.includes(p.id)) {
          pathEl.style.strokeOpacity = '1';
          pathEl.style.strokeWidth = '2.4';
        } else {
          pathEl.style.strokeOpacity = '0.1';
          pathEl.style.strokeWidth = '1';
        }
      });
    });

    node.addEventListener('mouseleave', () => {
      if (statusText) statusText.textContent = defaultStatus;
      if (statusDot) statusDot.style.backgroundColor = '#10b981';

      topoNodes.forEach((n) => {
        const el = n as HTMLElement;
        el.style.opacity = '1';
        const box = n.querySelector('.node-box');
        if (box) {
          const defStroke = box.getAttribute('data-default-stroke') || 'rgba(255,255,255,0.18)';
          const defWidth = box.getAttribute('data-default-width') || '1';
          box.setAttribute('stroke', defStroke);
          box.setAttribute('stroke-width', defWidth);
        }
      });

      allPaths.forEach((p) => {
        const pathEl = p as SVGPathElement;
        pathEl.style.strokeOpacity = '0.75';
        pathEl.style.strokeWidth = '1.5';
      });
    });
  });

  // Mobile Tap-to-Trace Pipeline Logic (< 640px)
  const mobileNodes = document.querySelectorAll<HTMLButtonElement>('.mobile-topo-node');
  let activeMobileNode: string | null = null;

  function setMobileNodeHighlight(nodeId: string | null) {
    if (!nodeId || activeMobileNode === nodeId) {
      activeMobileNode = null;
      if (statusText) statusText.textContent = defaultStatus;
      if (statusDot) statusDot.style.backgroundColor = '#10b981';
      mobileNodes.forEach((btn) => {
        btn.style.opacity = '1';
        btn.style.borderColor = '';
        btn.style.boxShadow = '';
      });
      return;
    }

    const config = traceMap[nodeId];
    if (!config) return;

    activeMobileNode = nodeId;
    if (statusText) statusText.textContent = config.label;
    if (statusDot) statusDot.style.backgroundColor = config.dotColor;

    mobileNodes.forEach((btn) => {
      const id = btn.getAttribute('data-mobile-node');
      if (id && config.nodes.includes(id)) {
        btn.style.opacity = '1';
        if (id === nodeId) {
          btn.style.borderColor = config.dotColor;
          btn.style.boxShadow = `0 0 12px ${config.dotColor}50`;
        } else {
          btn.style.borderColor = `${config.dotColor}80`;
          btn.style.boxShadow = `0 0 6px ${config.dotColor}25`;
        }
      } else {
        btn.style.opacity = '0.28';
        btn.style.borderColor = '';
        btn.style.boxShadow = '';
      }
    });
  }

  mobileNodes.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-mobile-node');
      setMobileNodeHighlight(id);
    });
  });

  document.getElementById('mobile-topology-pipeline')?.addEventListener('click', () => {
    if (activeMobileNode) setMobileNodeHighlight(null);
  });
</script>

<style>
  /* Butter-smooth SVG topology transitions */
  .topo-node {
    transition: opacity 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .topo-node text {
    pointer-events: none;
    user-select: none;
  }
  .node-box {
    transition: stroke 0.22s ease, stroke-width 0.22s ease;
  }
  .topo-flow-path {
    transition: stroke-opacity 0.22s ease, stroke-width 0.22s ease;
  }
</style>

