                <path d="M 30 0 C 30 12, 60 12, 60 24" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash" stroke-opacity="0.7" />
                <path d="M 60 0 L 60 24" fill="none" stroke="#38bdf8" stroke-width="1.5" class="animate-dash" stroke-opacity="0.7" />
