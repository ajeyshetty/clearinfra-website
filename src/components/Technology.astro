              </span>
              <span class="text-[10px] text-slate-500 font-mono hidden md:inline tracking-normal">(Hover nodes to trace)</span>
            </div>
            <span id="topology-status" class="text-emerald-400 text-[10px] sm:text-xs transition-all flex items-center gap-1.5">
              <span id="topology-status-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
