<script>
  // Interactive Topology Dependency Graph
  const topoNodes = document.querySelectorAll('.topo-node');
  const allPaths = document.querySelectorAll('.topo-flow-path');
  const statusText = document.getElementById('topology-status-text');
  const statusDot = document.getElementById('topology-status-dot');

  const traceMap: Record<string, { label: string; dotColor: string; nodes: string[]; paths: string[] }> = {
    'node-massing': {
      label: 'TRACING: 3D Massing & WWR → Native AI + Physics → CAPEX & EnergyPlus',
      dotColor: '#00e5ff',
      nodes: ['node-massing', 'node-agent', 'node-physics', 'node-capex', 'node-eplus'],
      paths: ['path-massing-agent', 'path-massing-physics', 'path-agent-capex', 'path-physics-capex', 'path-physics-eplus']
    },
    'node-weather': {
      label: 'TRACING: 8,760 Climate File → Hourly Multi-Node RC Thermal Solver → Chiller TR Sizing',
      dotColor: '#38bdf8',
      nodes: ['node-weather', 'node-physics', 'node-capex', 'node-eplus'],
      paths: ['path-weather-physics', 'path-physics-capex', 'path-physics-eplus']
    },
    'node-cost': {
      label: 'TRACING: India Cost Database → NBC/ECBC Rule Evaluator → Clause-Cited Submittal',
      dotColor: '#fbbf24',
      nodes: ['node-cost', 'node-compliance', 'node-statutory', 'node-agent', 'node-capex'],
      paths: ['path-cost-compliance', 'path-cost-agent', 'path-compliance-statutory', 'path-agent-capex']
    },
    'node-agent': {
      label: 'TRACING: Native AI Copilot → 12-Tool Pareto Sweeps → Least-Cost ROI Solutions',
      dotColor: '#38bdf8',
      nodes: ['node-massing', 'node-cost', 'node-agent', 'node-capex'],
      paths: ['path-massing-agent', 'path-cost-agent', 'path-agent-capex']
    },
    'node-physics': {
      label: 'TRACING: Physics Solver → Hourly ISO 13790 RC + Psychrometrics → EnergyPlus Model',
      dotColor: '#10b981',
      nodes: ['node-massing', 'node-weather', 'node-physics', 'node-capex', 'node-eplus'],
      paths: ['path-massing-physics', 'path-weather-physics', 'path-physics-capex', 'path-physics-eplus']
    },
    'node-compliance': {
      label: 'TRACING: Compliance Engine → Clause-Level NBC 2016 Graph-RAG & ECBC Checker',
      dotColor: '#fbbf24',
      nodes: ['node-cost', 'node-compliance', 'node-statutory'],
      paths: ['path-cost-compliance', 'path-compliance-statutory']
    },
    'node-capex': {
      label: 'TRACE BACK: CAPEX & Load Study ← Hourly Thermal Solver & AI Pareto Optimizer',
      dotColor: '#10b981',
      nodes: ['node-capex', 'node-agent', 'node-physics', 'node-massing', 'node-weather'],
      paths: ['path-agent-capex', 'path-physics-capex', 'path-massing-agent', 'path-massing-physics', 'path-weather-physics']
    },
    'node-statutory': {
      label: 'TRACE BACK: Statutory Submittals ← NBC 2016 Graph-RAG & ECBC Prescriptive Rules',
      dotColor: '#fbbf24',
      nodes: ['node-statutory', 'node-compliance', 'node-cost'],
      paths: ['path-compliance-statutory', 'path-cost-compliance']
    },
    'node-eplus': {
      label: 'TRACE BACK: EnergyPlus Model ← Validated ISO 13790 Multi-Node RC Thermal Core',
      dotColor: '#38bdf8',
      nodes: ['node-eplus', 'node-physics', 'node-massing', 'node-weather'],
      paths: ['path-physics-eplus', 'path-massing-physics', 'path-weather-physics']
    }
  };

  const defaultStatus = 'Physics + Agentic AI + Graph-RAG';

  topoNodes.forEach((node) => {
    node.addEventListener('mouseenter', () => {
      const id = node.id;
      const config = traceMap[id];
      if (!config) return;

      if (statusText) statusText.textContent = config.label;
      if (statusDot) statusDot.style.backgroundColor = config.dotColor;

      // Dim non-matching nodes
      topoNodes.forEach((n) => {
        const el = n as HTMLElement;
        if (config.nodes.includes(n.id)) {
          el.style.opacity = '1';
          const box = n.querySelector('.node-box');
          if (box) {
            box.setAttribute('stroke', config.dotColor);
            box.setAttribute('stroke-width', '2');
          }
        } else {
          el.style.opacity = '0.22';
        }
      });

      // Highlight matching paths
      allPaths.forEach((p) => {
        const pathEl = p as SVGPathElement;
        if (config.paths.includes(p.id)) {
          pathEl.style.strokeOpacity = '1';
          pathEl.style.strokeWidth = '2.8';
          pathEl.style.filter = `drop-shadow(0 0 6px ${config.dotColor})`;
        } else {
          pathEl.style.strokeOpacity = '0.08';
          pathEl.style.strokeWidth = '1';
          pathEl.style.filter = 'none';
        }
      });
    });

    node.addEventListener('mouseleave', () => {
      if (statusText) statusText.textContent = defaultStatus;
      if (statusDot) statusDot.style.backgroundColor = '#10b981';

      topoNodes.forEach((n) => {
        const el = n as HTMLElement;
        el.style.opacity = '1';
        const box = n.querySelector('.node-box');
        if (box) {
          box.setAttribute('stroke', 'rgba(255,255,255,0.18)');
          box.setAttribute('stroke-width', '1');
        }
      });

      allPaths.forEach((p) => {
        const pathEl = p as SVGPathElement;
        pathEl.style.strokeOpacity = '0.75';
        pathEl.style.strokeWidth = '1.5';
        pathEl.style.filter = 'none';
      });
    });
  });
</script>
