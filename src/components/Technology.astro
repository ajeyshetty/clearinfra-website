---
const complianceModules = [
  {
    tag: "ENVELOPE & HVAC",
    title: "Prescriptive & Whole-Building Code Guidance",
    clauses: "ECBC Clauses 4.2, 4.3, 5.2 & Appendix D (EPI Ratio)",
    detail: "Code checks with expert engineering review covering Window-to-Wall Ratio (WWR), roof and wall U-factor limits, and SHGC across climate zones, alongside whole-building EPI estimates against ECBC 2017 thresholds."
  },
  {
    tag: "BUILDING SERVICES",
    title: "Daylighting & HVAC Systems Alignment",
    clauses: "NBC 2026 Part D: Sec. 1 (Lighting) & Sec. 3 (HVAC)",
    detail: "Evaluates spatial daylight estimates, fresh air ventilation requirements per occupancy category, and HVAC plant configurations against NBC 2026 engineering standards."
  },
  {
    tag: "STATUTORY CLAUSES",
    title: "Graph-RAG Statutory Clause Retrieval",
    clauses: "NBC 2026 Parts B–F & Local Byelaws",
    detail: "Backed by our structured Graph-RAG knowledge base of the National Building Code 2026 (SP 7:2026), enabling engineers to verify life safety and building services clauses with exact citations, while coordinating with local development control byelaws for FAR and setbacks."
  }
];
---

<section id="engine" class="py-8 sm:py-20 lg:py-28 bg-[#F7F6F2] border-t border-slate-900/10 relative overflow-hidden">
  <!-- Option 2: Architectural Drafting Grid with Radial Vignette Fade -->
  <div class="absolute inset-0 bg-architectural-grid-vignette pointer-events-none z-0" aria-hidden="true"></div>

  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 2xl:px-24 space-y-8 sm:space-y-16 lg:space-y-24 relative z-10">
    
    <!-- Part 1: Proprietary Engine + Built-in AI Integration -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 lg:gap-16 items-center">
      <!-- Left Narrative -->
      <div class="reveal lg:col-span-5 space-y-4 sm:space-y-6 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-slate-900/[0.04] border border-slate-900/10 text-slate-700 text-[10px] sm:text-xs font-mono tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>PROPRIETARY TECHNOLOGY</span>
        </div>
        <h2 class="text-[clamp(1.4rem,4.5vw,3rem)] sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight leading-[1.15] text-balance">
          First-principles physics meets built-in agentic AI.
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          In conventional consulting, energy and daylight models take weeks to assemble across disconnected third-party tools—meaning engineering feedback often arrives after architectural decisions have already moved on.
        </p>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          To change this, we built <strong class="text-slate-900 font-semibold">Clearinfra Studio</strong> in-house. It combines an hourly ISO 52016-1 thermal &amp; psychrometric physics engine with a <strong class="text-slate-900 font-semibold">built-in 27-tool engineering AI copilot</strong> and proactive Pareto optimizer.
        </p>

        <!-- 2 Pillar Cards on Stone (Left-Aligned Inside Cards) -->
        <div class="space-y-3 pt-2 text-left">
          <div class="p-4 rounded-xl bg-white border border-slate-900/10 hover:border-emerald-600/40 transition-colors shadow-2xs">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="text-xs font-mono font-medium text-slate-400">01</span>
              <span class="text-[11px] font-mono font-semibold text-emerald-700 uppercase tracking-wider">Built-in AI Copilot &amp; Pareto Optimizer</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Wired directly into the 3D geometry and ISO 52016-1 physics kernel via 27 engineering tools—allowing our consultants to sweep glazing, shading, orientation, and HVAC combinations live to isolate lowest-CAPEX and lowest-EPI designs.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-white border border-slate-900/10 hover:border-emerald-600/40 transition-colors shadow-2xs">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="text-xs font-mono font-medium text-slate-400">02</span>
              <span class="text-[11px] font-mono font-semibold text-emerald-700 uppercase tracking-wider">Traceable Dependency Graph</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Every parameter change is tracked through a live dependency map—showing exactly how a change in facade SHGC propagates to sensible coil load, chiller tonnage, and project payback estimates.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Matte CAD Window with Animated Architecture Schematic -->
      <div class="reveal reveal-delay-1 lg:col-span-7">
        <div class="rounded-2xl border border-slate-700/60 ring-1 ring-white/10 bg-[#131924] p-5 sm:p-9 shadow-2xl shadow-slate-950/30 bg-blueprint-sub relative overflow-hidden">
          <!-- CAD Window Header Bar: Strictly Fixed Height & Zero Layout Shift -->
          <div class="flex items-center justify-between gap-2 text-[11px] sm:text-xs font-mono text-slate-400 mb-5 sm:mb-6 pb-3.5 sm:pb-4 border-b border-white/[0.08] min-h-[2.5rem] max-h-[2.5rem] overflow-hidden select-none">
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-slate-200 font-medium whitespace-nowrap">
                <span class="sm:hidden">CLEARINFRA // TOPOLOGY</span>
                <span class="hidden sm:inline">CLEARINFRA STUDIO // SYSTEM TOPOLOGY</span>
              </span>
            </div>
            <div id="topology-status" class="text-emerald-400 text-[10px] sm:text-xs flex items-center gap-1.5 min-w-0 justify-end shrink">
              <span id="topology-status-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0 transition-colors duration-200"></span>
              <span id="topology-status-text" class="truncate whitespace-nowrap text-right font-medium transition-colors duration-200">Physics + 27-Tool Copilot + Graph-RAG</span>
            </div>
          </div>

          <!-- MOBILE INTERACTIVE 3-STAGE PIPELINE STEPPER (< 640px) -->
          <div class="sm:hidden space-y-3" id="mobile-topology-stepper">
            <!-- Stage Selector Tabs -->
            <div class="flex items-center justify-between gap-1 p-1 bg-black/40 border border-white/10 rounded-xl">
              <button
                type="button"
                data-stage="1"
                class="mobile-stage-btn flex-1 py-2 px-1 text-center rounded-lg text-[10px] font-mono tracking-wider transition-all duration-200 border text-slate-400 border-transparent hover:text-slate-200"
              >
                <span class="block text-[8px] opacity-70">STAGE 01</span>
                <span class="font-semibold text-slate-300">INPUTS</span>
              </button>
              
              <svg class="w-3.5 h-3.5 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>

              <button
                type="button"
                data-stage="2"
                class="mobile-stage-btn flex-1 py-2 px-1 text-center rounded-lg text-[10px] font-mono tracking-wider transition-all duration-200 border bg-emerald-500/15 border-emerald-500/50 text-emerald-300 shadow-sm shadow-emerald-950/40"
              >
                <span class="block text-[8px] text-emerald-400 font-bold">STAGE 02</span>
                <span class="font-bold text-white">CI CORE</span>
              </button>

              <svg class="w-3.5 h-3.5 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>

              <button
                type="button"
                data-stage="3"
                class="mobile-stage-btn flex-1 py-2 px-1 text-center rounded-lg text-[10px] font-mono tracking-wider transition-all duration-200 border text-slate-400 border-transparent hover:text-slate-200"
              >
                <span class="block text-[8px] opacity-70">STAGE 03</span>
                <span class="font-semibold text-slate-300">DELIVER</span>
              </button>
            </div>

            <!-- Stage 1 Content: Project Inputs -->
            <div id="mobile-stage-panel-1" class="mobile-stage-panel hidden space-y-2 transition-opacity duration-200">
              <div class="flex items-center justify-between px-1">
                <span class="text-[9px] font-mono uppercase tracking-widest text-sky-400 font-semibold">01 // Practice &amp; BIM Inputs</span>
                <span class="text-[9px] font-mono text-slate-500">3 Ingestion Feeds</span>
              </div>
              <div class="grid grid-cols-1 gap-1.5">
                <div class="px-3.5 py-2.5 rounded-lg bg-[#111827] border border-sky-500/30 flex items-center justify-between gap-2 shadow-sm">
                  <div class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                    <span class="text-xs font-semibold text-slate-100">3D Massing &amp; WWR</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">Geometry · Orientation</span>
                </div>
                <div class="px-3.5 py-2.5 rounded-lg bg-[#111827] border border-sky-500/30 flex items-center justify-between gap-2 shadow-sm">
                  <div class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                    <span class="text-xs font-semibold text-slate-100">8,760 Weather File</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">DBT · WBT · Solar DNI</span>
                </div>
                <div class="px-3.5 py-2.5 rounded-lg bg-[#111827] border border-sky-500/30 flex items-center justify-between gap-2 shadow-sm">
                  <div class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                    <span class="text-xs font-semibold text-slate-100">India Cost &amp; Spec DB</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">U-Value · SHGC · INR</span>
                </div>
              </div>
              <button type="button" data-goto-stage="2" class="w-full mt-1 py-1.5 px-3 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-[10px] font-mono text-slate-300 flex items-center justify-center gap-1.5 transition-colors">
                <span>Feed Into Clearinfra Core</span>
                <span class="text-emerald-400 font-bold">→</span>
              </button>
            </div>

            <!-- Stage 2 Content: Clearinfra Core (Default Active) -->
            <div id="mobile-stage-panel-2" class="mobile-stage-panel space-y-2 transition-opacity duration-200">
              <div class="flex items-center justify-between px-1">
                <span class="text-[9px] font-mono uppercase tracking-widest text-emerald-400 font-semibold">02 // Clearinfra Core Engine</span>
                <span class="flex items-center gap-1 text-[9px] font-mono text-emerald-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Active Engine
                </span>
              </div>
              <div class="space-y-1.5">
                <div class="rounded-lg bg-[#111c2d] border border-sky-500/40 px-3.5 py-2.5 flex items-center justify-between gap-2 shadow-sm">
                  <div>
                    <span class="text-[9px] font-mono text-sky-400 uppercase tracking-wider block">Built-in AI Agent</span>
                    <span class="text-xs font-semibold text-white block mt-0.5">27-Tool Copilot &amp; Pareto Optimizer</span>
                  </div>
                  <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 shrink-0">AI</span>
                </div>

                <div class="rounded-lg bg-[#0d1f1d] border border-emerald-500/45 px-3.5 py-2.5 flex items-center justify-between gap-2 shadow-sm">
                  <div>
                    <span class="text-[9px] font-mono text-emerald-400 uppercase tracking-wider block">Physics Solver</span>
                    <span class="text-xs font-semibold text-white block mt-0.5">Multi-Node ISO 52016-1 + Psychrometric HVAC</span>
                  </div>
                  <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 shrink-0">ISO 52016</span>
                </div>

                <div class="rounded-lg bg-[#1a1814] border border-amber-500/40 px-3.5 py-2.5 flex items-center justify-between gap-2 shadow-sm">
                  <div>
                    <span class="text-[9px] font-mono text-amber-400 uppercase tracking-wider block">Compliance Engine</span>
                    <span class="text-xs font-semibold text-white block mt-0.5">NBC 2026 Graph-RAG &amp; ECBC Guidance</span>
                  </div>
                  <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 shrink-0">RAG</span>
                </div>
              </div>
              <div class="flex items-center gap-2 mt-1">
                <button type="button" data-goto-stage="1" class="flex-1 py-1.5 px-2 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-[10px] font-mono text-slate-400 flex items-center justify-center gap-1 transition-colors">
                  <span>← Inputs</span>
                </button>
                <button type="button" data-goto-stage="3" class="flex-1 py-1.5 px-2 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/40 text-[10px] font-mono text-emerald-300 flex items-center justify-center gap-1 transition-colors">
                  <span>Deliverables →</span>
                </button>
              </div>
            </div>

            <!-- Stage 3 Content: Deliverables -->
            <div id="mobile-stage-panel-3" class="mobile-stage-panel hidden space-y-2 transition-opacity duration-200">
              <div class="flex items-center justify-between px-1">
                <span class="text-[9px] font-mono uppercase tracking-widest text-emerald-400 font-semibold">03 // Engineering Deliverables</span>
                <span class="text-[9px] font-mono text-slate-500">Statutory &amp; Financial</span>
              </div>
              <div class="grid grid-cols-1 gap-1.5">
                <div class="px-3.5 py-2.5 rounded-lg bg-[#111827] border border-emerald-500/30 flex items-center justify-between gap-2 shadow-sm">
                  <div class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span class="text-xs font-semibold text-slate-100">CAPEX &amp; Load Study</span>
                  </div>
                  <span class="text-[10px] font-mono text-emerald-400">Peak TR · Payback Estimate</span>
                </div>
                <div class="px-3.5 py-2.5 rounded-lg bg-[#111827] border border-amber-500/30 flex items-center justify-between gap-2 shadow-sm">
                  <div class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <span class="text-xs font-semibold text-slate-100">Statutory Submittals</span>
                  </div>
                  <span class="text-[10px] font-mono text-amber-400">Clause-Cited NBC 2026</span>
                </div>
                <div class="px-3.5 py-2.5 rounded-lg bg-[#111827] border border-sky-500/30 flex items-center justify-between gap-2 shadow-sm">
                  <div class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                    <span class="text-xs font-semibold text-slate-100">EnergyPlus Model</span>
                  </div>
                  <span class="text-[10px] font-mono text-sky-400">Run-Checked .idf</span>
                </div>
              </div>
              <button type="button" data-goto-stage="2" class="w-full mt-1 py-1.5 px-3 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-[10px] font-mono text-slate-300 flex items-center justify-center gap-1.5 transition-colors">
                <span class="text-emerald-400 font-bold">←</span>
                <span>Back to Clearinfra Core</span>
              </button>
            </div>
          </div>

          <!-- DESKTOP / TABLET HORIZONTAL SVG TOPOLOGY SCHEMATIC (>= 640px) -->
          <div class="hidden sm:block">
            <svg id="system-topology-svg" viewBox="0 0 620 340" class="w-full h-auto select-none">
              <!-- Background Connecting Paths (Static Dim Track) -->
              <g class="path-track" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" fill="none">
                <path d="M 165 66 C 200 66, 200 100, 235 100" />
                <path d="M 165 66 C 200 66, 200 180, 235 180" />
                <path d="M 165 170 C 200 170, 200 180, 235 180" />
                <path d="M 165 274 C 200 274, 200 260, 235 260" />
                <path d="M 165 274 C 200 274, 200 100, 235 100" />
                <path d="M 405 100 C 430 100, 430 66, 455 66" />
                <path d="M 405 180 C 430 180, 430 66, 455 66" />
                <path d="M 405 180 C 430 180, 430 274, 455 274" />
                <path d="M 405 260 C 430 260, 430 170, 455 170" />
              </g>

              <!-- Animated Active Connecting Paths (Grouped by Data Flow) -->
              <!-- Massing Paths -->
              <path id="path-massing-agent" d="M 165 66 C 200 66, 200 100, 235 100" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-massing-physics" d="M 165 66 C 200 66, 200 180, 235 180" fill="none" stroke="#00c4df" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />

              <!-- Weather Path -->
              <path id="path-weather-physics" d="M 165 170 C 200 170, 200 180, 235 180" fill="none" stroke="#38bdf8" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />

              <!-- Cost DB Paths -->
              <path id="path-cost-compliance" d="M 165 274 C 200 274, 200 260, 235 260" fill="none" stroke="#f59e0b" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-cost-agent" d="M 165 274 C 200 274, 200 100, 235 100" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />

              <!-- Core to Output Paths -->
              <path id="path-agent-capex" d="M 405 100 C 430 100, 430 66, 455 66" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-physics-capex" d="M 405 180 C 430 180, 430 66, 455 66" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-physics-eplus" d="M 405 180 C 430 180, 430 274, 455 274" fill="none" stroke="#38bdf8" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />
              <path id="path-compliance-statutory" d="M 405 260 C 430 260, 430 170, 455 170" fill="none" stroke="#f59e0b" stroke-width="1.5" class="animate-dash topo-flow-path" stroke-opacity="0.75" />

              <!-- Left Input Nodes (Hover Interactive) -->
              <g id="node-massing" class="topo-node cursor-pointer transition-all duration-200" transform="translate(10, 40)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">3D Massing &amp; WWR</text>
                <text x="14" y="39" fill="#94a3b8" font-size="9.5" font-family="JetBrains Mono">Geometry · Orientation</text>
              </g>

              <g id="node-weather" class="topo-node cursor-pointer transition-all duration-200" transform="translate(10, 144)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">8,760 Weather File</text>
                <text x="14" y="39" fill="#94a3b8" font-size="9.5" font-family="JetBrains Mono">DBT · WBT · Solar DNI</text>
              </g>

              <g id="node-cost" class="topo-node cursor-pointer transition-all duration-200" transform="translate(10, 248)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">India Cost &amp; Spec DB</text>
                <text x="14" y="39" fill="#94a3b8" font-size="9.5" font-family="JetBrains Mono">U-Value · SHGC · INR</text>
              </g>

              <!-- Central Proprietary Core Container -->
              <g id="node-core-container" transform="translate(235, 28)">
                <rect width="170" height="284" rx="12" fill="#0d1520" stroke="rgba(16, 185, 129, 0.45)" stroke-width="1.5" />
                <text x="85" y="24" text-anchor="middle" fill="#10b981" font-size="9" font-family="JetBrains Mono">CLEARINFRA CORE</text>

                <!-- Sub-box 1: Built-in AI Copilot -->
                <g id="node-agent" class="topo-node cursor-pointer transition-all duration-200" transform="translate(14, 38)">
                  <rect width="142" height="68" rx="8" fill="#111c2d" stroke="rgba(56, 189, 248, 0.45)" class="node-box transition-all duration-200" />
                  <text x="71" y="22" text-anchor="middle" fill="#38bdf8" font-size="9" font-family="JetBrains Mono">BUILT-IN AI AGENT</text>
                  <text x="71" y="40" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="600">27-Tool Copilot &amp;</text>
                  <text x="71" y="55" text-anchor="middle" fill="#cbd5e1" font-size="10">Pareto Optimizer</text>
                </g>

                <!-- Sub-box 2: Physics Kernel -->
                <g id="node-physics" class="topo-node cursor-pointer transition-all duration-200" transform="translate(14, 118)">
                  <rect width="142" height="68" rx="8" fill="#0d1f1d" stroke="rgba(16, 185, 129, 0.5)" class="node-box transition-all duration-200" />
                  <text x="71" y="22" text-anchor="middle" fill="#10b981" font-size="9" font-family="JetBrains Mono">PHYSICS SOLVER</text>
                  <text x="71" y="40" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="600">Multi-Node ISO 52016 +</text>
                  <text x="71" y="55" text-anchor="middle" fill="#cbd5e1" font-size="10">Psychrometric HVAC</text>
                </g>

                <!-- Sub-box 3: NBC 2026 & ECBC Compliance Engine -->
                <g id="node-compliance" class="topo-node cursor-pointer transition-all duration-200" transform="translate(14, 198)">
                  <rect width="142" height="68" rx="8" fill="#1a1814" stroke="rgba(245, 158, 11, 0.45)" class="node-box transition-all duration-200" />
                  <text x="71" y="22" text-anchor="middle" fill="#fbbf24" font-size="9" font-family="JetBrains Mono">COMPLIANCE ENGINE</text>
                  <text x="71" y="40" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="600">NBC 2026 Graph-RAG</text>
                  <text x="71" y="55" text-anchor="middle" fill="#cbd5e1" font-size="10">&amp; ECBC Rule Checker</text>
                </g>
              </g>

              <!-- Right Output Nodes (Hover Interactive) -->
              <g id="node-capex" class="topo-node cursor-pointer transition-all duration-200" transform="translate(455, 40)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">CAPEX &amp; Load Study</text>
                <text x="14" y="39" fill="#10b981" font-size="9.5" font-family="JetBrains Mono">Peak TR · Payback Est.</text>
              </g>

              <g id="node-statutory" class="topo-node cursor-pointer transition-all duration-200" transform="translate(455, 144)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">Statutory Submittals</text>
                <text x="14" y="39" fill="#fbbf24" font-size="9.5" font-family="JetBrains Mono">Clause-Cited NBC 2026</text>
              </g>

              <g id="node-eplus" class="topo-node cursor-pointer transition-all duration-200" transform="translate(455, 248)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">EnergyPlus Model</text>
                <text x="14" y="39" fill="#38bdf8" font-size="9.5" font-family="JetBrains Mono">Run-Checked .idf</text>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Part 2: Dedicated NBC 2026 & ECBC Compliance Module Breakdown -->
    <div id="compliance" class="pt-8 sm:pt-16 border-t border-slate-900/10">
      <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-3.5 sm:gap-6 lg:gap-12 items-end text-center sm:text-left mb-8 sm:mb-12 lg:mb-14">
        <div class="lg:col-span-7 space-y-2.5 sm:space-y-3 mx-auto sm:mx-0">
          <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-slate-900/[0.04] border border-slate-900/10 text-slate-700 text-[10px] sm:text-xs font-mono tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
            <span>STATUTORY &amp; CODE INTELLIGENCE</span>
          </div>
          <h3 class="text-[clamp(1.4rem,4.5vw,3rem)] sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight leading-[1.15] text-balance">
            Built-in NBC 2026 &amp; ECBC compliance module.
          </h3>
        </div>
        <div class="lg:col-span-5 mx-auto sm:mx-0">
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Our proprietary engine embeds a deterministic rule evaluator alongside a Graph-RAG knowledge base of Indian building codes (NBC 2026 &amp; ECBC 2017)—supporting our engineers during design reviews.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
        {complianceModules.map((mod, idx) => (
          <div class={`reveal reveal-delay-${idx % 3} group rounded-xl bg-white border border-slate-900/10 hover:border-emerald-600/50 p-5 sm:p-7 shadow-xs hover:shadow-xl hover:shadow-emerald-950/5 hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between text-left`}>
            <div>
              <!-- Top index row: numeral and category tag matching Features.astro -->
              <div class="flex items-center justify-between gap-2 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 border-b border-slate-900/[0.06]">
                <span class="text-xs font-mono font-medium text-slate-400 shrink-0">
                  0{idx + 1}
                </span>
                <span class="text-[10px] font-mono text-emerald-700 font-semibold tracking-wider uppercase text-right">
                  {mod.tag}
                </span>
              </div>

              <!-- Title -->
              <h4 class="text-base sm:text-xl font-semibold text-slate-900 mb-2 sm:mb-2.5 group-hover:text-emerald-950 transition-colors">
                {mod.title}
              </h4>

              <!-- Narrative -->
              <p class="text-sm text-slate-600 leading-relaxed font-normal">
                {mod.detail}
              </p>
            </div>

            <!-- Bottom Statutory Scope Strip: matching Features.astro deliverable anatomy -->
            <div class="mt-4 sm:mt-6 pt-3.5 sm:pt-4 border-t border-slate-900/[0.07] flex flex-col gap-1.5 text-[11px] font-mono">
              <div class="flex items-center gap-1.5 text-emerald-700 font-semibold uppercase tracking-wider text-[10px]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                <span>Statutory Scope</span>
              </div>
              <div class="text-slate-900 font-medium text-xs leading-snug">
                {mod.clauses}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  // Interactive Topology Dependency Graph
  const topoNodes = document.querySelectorAll('.topo-node');
  const allPaths = document.querySelectorAll('.topo-flow-path');
  const statusText = document.getElementById('topology-status-text');
  const statusDot = document.getElementById('topology-status-dot');

  // Cache initial stroke & stroke-width values for pristine restoration
  topoNodes.forEach((node) => {
    const box = node.querySelector('.node-box');
    if (box) {
      box.setAttribute('data-default-stroke', box.getAttribute('stroke') || 'rgba(255,255,255,0.18)');
      box.setAttribute('data-default-width', box.getAttribute('stroke-width') || '1');
    }
  });

  const traceMap: Record<string, { label: string; dotColor: string; nodes: string[]; paths: string[] }> = {
    'node-massing': {
      label: 'TRACING: Massing & WWR → AI + Physics → CAPEX & .idf',
      dotColor: '#00e5ff',
      nodes: ['node-massing', 'node-agent', 'node-physics', 'node-capex', 'node-eplus'],
      paths: ['path-massing-agent', 'path-massing-physics', 'path-agent-capex', 'path-physics-capex', 'path-physics-eplus']
    },
    'node-weather': {
      label: 'TRACING: 8,760 Climate → ISO 52016 Solver → Chiller TR',
      dotColor: '#38bdf8',
      nodes: ['node-weather', 'node-physics', 'node-capex', 'node-eplus'],
      paths: ['path-weather-physics', 'path-physics-capex', 'path-physics-eplus']
    },
    'node-cost': {
      label: 'TRACING: India Cost DB → NBC 2026 / ECBC → Submittals',
      dotColor: '#fbbf24',
      nodes: ['node-cost', 'node-compliance', 'node-statutory', 'node-agent', 'node-capex'],
      paths: ['path-cost-compliance', 'path-cost-agent', 'path-compliance-statutory', 'path-agent-capex']
    },
    'node-agent': {
      label: 'TRACING: Built-in AI → 27-Tool Sweeps → Cost Pareto',
      dotColor: '#38bdf8',
      nodes: ['node-massing', 'node-cost', 'node-agent', 'node-capex'],
      paths: ['path-massing-agent', 'path-cost-agent', 'path-agent-capex']
    },
    'node-physics': {
      label: 'TRACING: ISO 52016 Engine + Psychrometrics → .idf Model',
      dotColor: '#10b981',
      nodes: ['node-massing', 'node-weather', 'node-physics', 'node-capex', 'node-eplus'],
      paths: ['path-massing-physics', 'path-weather-physics', 'path-physics-capex', 'path-physics-eplus']
    },
    'node-compliance': {
      label: 'TRACING: NBC 2026 Graph-RAG & ECBC Rule Checker',
      dotColor: '#fbbf24',
      nodes: ['node-cost', 'node-compliance', 'node-statutory'],
      paths: ['path-cost-compliance', 'path-compliance-statutory']
    },
    'node-capex': {
      label: 'TRACE: CAPEX & Load ← Thermal Solver & AI Optimizer',
      dotColor: '#10b981',
      nodes: ['node-capex', 'node-agent', 'node-physics', 'node-massing', 'node-weather'],
      paths: ['path-agent-capex', 'path-physics-capex', 'path-massing-agent', 'path-massing-physics', 'path-weather-physics']
    },
    'node-statutory': {
      label: 'TRACE: Statutory Submittals ← NBC 2026 Graph-RAG',
      dotColor: '#fbbf24',
      nodes: ['node-statutory', 'node-compliance', 'node-cost'],
      paths: ['path-compliance-statutory', 'path-cost-compliance']
    },
    'node-eplus': {
      label: 'TRACE: EnergyPlus .idf ← ISO 52016-1 Thermal Core',
      dotColor: '#38bdf8',
      nodes: ['node-eplus', 'node-physics', 'node-massing', 'node-weather'],
      paths: ['path-physics-eplus', 'path-massing-physics', 'path-weather-physics']
    }
  };

  const defaultStatus = 'Physics + 27-Tool Copilot + Graph-RAG';

  topoNodes.forEach((node) => {
    node.addEventListener('mouseenter', () => {
      const id = node.id;
      const config = traceMap[id];
      if (!config) return;

      if (statusText) statusText.textContent = config.label;
      if (statusDot) statusDot.style.backgroundColor = config.dotColor;

      // Dim non-matching nodes with smooth opacity and highlight active nodes
      topoNodes.forEach((n) => {
        const el = n as HTMLElement;
        const box = n.querySelector('.node-box');
        if (config.nodes.includes(n.id)) {
          el.style.opacity = '1';
          if (box) {
            box.setAttribute('stroke', config.dotColor);
            box.setAttribute('stroke-width', '2');
          }
        } else {
          el.style.opacity = '0.22';
          if (box) {
            const defStroke = box.getAttribute('data-default-stroke') || 'rgba(255,255,255,0.18)';
            box.setAttribute('stroke', defStroke);
            box.setAttribute('stroke-width', '1');
          }
        }
      });

      // Highlight matching paths smoothly without GPU-heavy filter lag
      allPaths.forEach((p) => {
        const pathEl = p as SVGPathElement;
        if (config.paths.includes(p.id)) {
          pathEl.style.strokeOpacity = '1';
          pathEl.style.strokeWidth = '2.4';
        } else {
          pathEl.style.strokeOpacity = '0.1';
          pathEl.style.strokeWidth = '1';
        }
      });
    });

    node.addEventListener('mouseleave', () => {
      if (statusText) statusText.textContent = defaultStatus;
      if (statusDot) statusDot.style.backgroundColor = '#10b981';

      topoNodes.forEach((n) => {
        const el = n as HTMLElement;
        el.style.opacity = '1';
        const box = n.querySelector('.node-box');
        if (box) {
          const defStroke = box.getAttribute('data-default-stroke') || 'rgba(255,255,255,0.18)';
          const defWidth = box.getAttribute('data-default-width') || '1';
          box.setAttribute('stroke', defStroke);
          box.setAttribute('stroke-width', defWidth);
        }
      });

      allPaths.forEach((p) => {
        const pathEl = p as SVGPathElement;
        pathEl.style.strokeOpacity = '0.75';
        pathEl.style.strokeWidth = '1.5';
      });
    });
  });

  // Mobile Pipeline Stepper Logic (< 640px)
  const stageButtons = document.querySelectorAll<HTMLButtonElement>('.mobile-stage-btn');
  const stagePanels = document.querySelectorAll<HTMLElement>('.mobile-stage-panel');
  const gotoButtons = document.querySelectorAll<HTMLButtonElement>('[data-goto-stage]');

  const stageMeta: Record<string, { label: string; dotColor: string }> = {
    '1': {
      label: '01 // Ingestion: Massing, TMYx & Specs',
      dotColor: '#38bdf8'
    },
    '2': {
      label: '02 // Core: Physics + Agentic AI + NBC RAG',
      dotColor: '#10b981'
    },
    '3': {
      label: '03 // Deliverables: CAPEX, NBC & .idf',
      dotColor: '#fbbf24'
    }
  };

  function setMobileStage(stageId: string) {
    // Update Stage Buttons
    stageButtons.forEach((btn) => {
      const isTarget = btn.getAttribute('data-stage') === stageId;
      if (isTarget) {
        btn.className = 'mobile-stage-btn flex-1 py-2 px-1 text-center rounded-lg text-[10px] font-mono tracking-wider transition-all duration-200 border bg-emerald-500/15 border-emerald-500/50 text-emerald-300 shadow-sm shadow-emerald-950/40';
        const label1 = btn.children[0] as HTMLElement;
        const label2 = btn.children[1] as HTMLElement;
        if (label1) {
          label1.className = 'block text-[8px] text-emerald-400 font-bold';
        }
        if (label2) {
          label2.className = 'font-bold text-white';
        }
      } else {
        btn.className = 'mobile-stage-btn flex-1 py-2 px-1 text-center rounded-lg text-[10px] font-mono tracking-wider transition-all duration-200 border text-slate-400 border-transparent hover:text-slate-200';
        const label1 = btn.children[0] as HTMLElement;
        const label2 = btn.children[1] as HTMLElement;
        if (label1) {
          label1.className = 'block text-[8px] opacity-70';
        }
        if (label2) {
          label2.className = 'font-semibold text-slate-300';
        }
      }
    });

    // Update Stage Panels
    stagePanels.forEach((panel) => {
      if (panel.id === `mobile-stage-panel-${stageId}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    // Update Status Header if on mobile
    if (window.innerWidth < 640 && stageMeta[stageId]) {
      if (statusText) statusText.textContent = stageMeta[stageId].label;
      if (statusDot) statusDot.style.backgroundColor = stageMeta[stageId].dotColor;
    }
  }

  stageButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const stage = btn.getAttribute('data-stage');
      if (stage) setMobileStage(stage);
    });
  });

  gotoButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const stage = btn.getAttribute('data-goto-stage');
      if (stage) setMobileStage(stage);
    });
  });
</script>

<style>
  /* Butter-smooth SVG topology transitions */
  .topo-node {
    transition: opacity 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .topo-node text {
    pointer-events: none;
    user-select: none;
  }
  .node-box {
    transition: stroke 0.22s ease, stroke-width 0.22s ease;
  }
  .topo-flow-path {
    transition: stroke-opacity 0.22s ease, stroke-width 0.22s ease;
  }
</style>

