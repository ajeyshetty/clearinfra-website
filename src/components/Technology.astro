                  <text x="71" y="22" text-anchor="middle" fill="#fbbf24" font-size="9" font-family="JetBrains Mono">COMPLIANCE ENGINE</text>
                  <text x="71" y="40" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="600">NBC 2016 Graph-RAG</text>
                  <text x="71" y="55" text-anchor="middle" fill="#cbd5e1" font-size="10">&amp; ECBC Rule Checker</text>
                </g>
              </g>

              <!-- Right Output Nodes (Hover Interactive) -->
              <g id="node-capex" class="topo-node cursor-pointer transition-all duration-200" transform="translate(455, 40)">
                <rect width="155" height="52" rx="8" fill="#111827" stroke="rgba(255,255,255,0.18)" class="node-box transition-all duration-200" />
                <text x="14" y="23" fill="#f8fafc" font-size="11" font-weight="600">CAPEX &amp; Load Study</text>
                <text x="14" y="39" fill="#10b981" font-size="9.5" font-family="JetBrains Mono">Peak TR · ROI Payback</text>
