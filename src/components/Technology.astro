---
---

<section id="methodology" class="py-24 bg-[#090d14] border-t border-white/[0.06] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Narrative -->
      <div class="reveal lg:col-span-5 space-y-5">
        <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">Physics Architecture</span>
        <h2 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight leading-tight">
          Transparent calculations, grounded in physical laws.
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          Rather than relying on static rules of thumb or pre-computed lookup tables, Clearinfra solves hourly heat balance equations across walls, glazing, and internal thermal mass.
        </p>
        <p class="text-slate-400 text-sm leading-relaxed">
          Every output metric—from peak cooling tonnage to annual Energy Performance Index—is linked through a live dependency graph, allowing engineers to trace how a change in facade glazing ripples through coil loads, fan power, and plant sizing.
        </p>

        <div class="pt-3 space-y-2.5 text-xs font-mono text-slate-300">
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>ASHRAE Fundamental Psychrometrics & Solar Models</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>ISO 13790 Dynamic Multi-Node Capacitance</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Verified against EnergyPlus v25.1 Reference Runs</span>
          </div>
        </div>
      </div>

      <!-- Right Animated Schematic Pipeline Diagram -->
      <div class="reveal reveal-delay-1 lg:col-span-7">
        <div class="rounded-2xl border border-white/[0.08] bg-[#07090e] p-6 sm:p-8 bg-blueprint-sub">
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 mb-6">
            <span>SYSTEM TOPOLOGY // CALCULATION PIPELINE</span>
            <span class="text-emerald-400">Continuous Evaluation</span>
          </div>

          <svg viewBox="0 0 600 310" class="w-full h-auto">
            <!-- Animated Connecting Paths (Left Inputs to Central Engine) -->
            <path d="M 165 55 C 210 55, 210 155, 245 155" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
            <path d="M 165 55 C 210 55, 210 155, 245 155" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash" stroke-opacity="0.6" />

            <path d="M 165 155 L 245 155" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
            <path d="M 165 155 L 245 155" fill="none" stroke="#38bdf8" stroke-width="1.5" class="animate-dash" stroke-opacity="0.6" />

            <path d="M 165 255 C 210 255, 210 155, 245 155" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
            <path d="M 165 255 C 210 255, 210 155, 245 155" fill="none" stroke="#f59e0b" stroke-width="1.5" class="animate-dash" stroke-opacity="0.6" />

            <!-- Animated Connecting Paths (Central Engine to Right Outputs) -->
            <path d="M 385 155 C 415 155, 415 55, 445 55" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
            <path d="M 385 155 C 415 155, 415 55, 445 55" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash" stroke-opacity="0.6" />

            <path d="M 385 155 L 445 155" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
            <path d="M 385 155 L 445 155" fill="none" stroke="#10b981" stroke-width="1.5" class="animate-dash" stroke-opacity="0.6" />

            <path d="M 385 155 C 415 155, 415 255, 445 255" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
            <path d="M 385 155 C 415 155, 415 255, 445 255" fill="none" stroke="#38bdf8" stroke-width="1.5" class="animate-dash" stroke-opacity="0.6" />

            <!-- Left Input Nodes -->
            <g transform="translate(10, 30)">
              <rect width="155" height="50" rx="8" fill="#0d131f" stroke="rgba(255,255,255,0.12)" />
              <text x="14" y="22" fill="#e2e8f0" font-size="11" font-weight="600">3D Massing &amp; WWR</text>
              <text x="14" y="38" fill="#64748b" font-size="9.5" font-family="JetBrains Mono">Orientation · Shading</text>
            </g>

            <g transform="translate(10, 130)">
              <rect width="155" height="50" rx="8" fill="#0d131f" stroke="rgba(255,255,255,0.12)" />
              <text x="14" y="22" fill="#e2e8f0" font-size="11" font-weight="600">8,760 Weather Data</text>
              <text x="14" y="38" fill="#64748b" font-size="9.5" font-family="JetBrains Mono">DBT · WBT · Solar DNI</text>
            </g>

            <g transform="translate(10, 230)">
              <rect width="155" height="50" rx="8" fill="#0d131f" stroke="rgba(255,255,255,0.12)" />
              <text x="14" y="22" fill="#e2e8f0" font-size="11" font-weight="600">Envelope &amp; Plant</text>
              <text x="14" y="38" fill="#64748b" font-size="9.5" font-family="JetBrains Mono">U-Value · SHGC · COP</text>
            </g>

            <!-- Central Solver Kernel Node -->
            <g transform="translate(245, 95)">
              <rect width="140" height="120" rx="12" fill="#0d1817" stroke="rgba(16, 185, 129, 0.45)" stroke-width="1.5" />
              <text x="70" y="38" text-anchor="middle" fill="#10b981" font-size="9.5" font-family="JetBrains Mono">SOLVER KERNEL</text>
              <text x="70" y="60" text-anchor="middle" fill="#ffffff" font-size="12" font-weight="600">Multi-Node RC</text>
              <text x="70" y="77" text-anchor="middle" fill="#ffffff" font-size="12" font-weight="600">+ Psychrometrics</text>
              <text x="70" y="100" text-anchor="middle" fill="#94a3b8" font-size="9" font-family="JetBrains Mono">Hourly Heat Balance</text>
            </g>

            <!-- Right Output Nodes -->
            <g transform="translate(445, 30)">
              <rect width="145" height="50" rx="8" fill="#0d131f" stroke="rgba(255,255,255,0.12)" />
              <text x="14" y="22" fill="#e2e8f0" font-size="11" font-weight="600">EPI &amp; HVAC Loads</text>
              <text x="14" y="38" fill="#10b981" font-size="9.5" font-family="JetBrains Mono">kWh/m² · Peak TR</text>
            </g>

            <g transform="translate(445, 130)">
              <rect width="145" height="50" rx="8" fill="#0d131f" stroke="rgba(255,255,255,0.12)" />
              <text x="14" y="22" fill="#e2e8f0" font-size="11" font-weight="600">Code Verification</text>
              <text x="14" y="38" fill="#10b981" font-size="9.5" font-family="JetBrains Mono">NBC 2016 · ECBC</text>
            </g>

            <g transform="translate(445, 230)">
              <rect width="145" height="50" rx="8" fill="#0d131f" stroke="rgba(255,255,255,0.12)" />
              <text x="14" y="22" fill="#e2e8f0" font-size="11" font-weight="600">EnergyPlus Model</text>
              <text x="14" y="38" fill="#38bdf8" font-size="9.5" font-family="JetBrains Mono">Verified .idf Export</text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
