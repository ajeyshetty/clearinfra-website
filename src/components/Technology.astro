            <!-- Stage 3: Outputs -->
            <div class="space-y-1.5">
              <span class="text-[9px] font-mono uppercase tracking-widest text-slate-500 block">03 // Engineering Deliverables</span>
              <div class="grid grid-cols-1 gap-1.5">
                <div class="px-3.5 py-2.5 rounded-lg bg-[#111827] border border-white/12 flex items-center justify-between gap-2">
                  <span class="text-xs font-semibold text-slate-100">CAPEX &amp; Load Study</span>
