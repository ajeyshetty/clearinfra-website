import TechAdvantage from '../components/TechAdvantage.astro';
import Comparison from '../components/Comparison.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Clearinfra // High-Performance Building Engineering & Advisory">
  <Header />
