import Header from '../components/Header.astro';
import ExecutiveHero from '../components/ExecutiveHero.astro';
import ExecutiveOutcomes from '../components/ExecutiveOutcomes.astro';
import AssetTypologies from '../components/AssetTypologies.astro';
